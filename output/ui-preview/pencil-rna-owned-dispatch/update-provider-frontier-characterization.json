    "RNA_property_update": {
      "sha256": "dfdd2d992507c6a37f5c204c83d364707406b58055766caf64912049e1e254e3",
      "source": "void RNA_property_update(bContext *C, PointerRNA *ptr, PropertyRNA *prop)\n{\n  rna_property_update(C, CTX_data_main(C), CTX_data_scene(C), ptr, prop);\n}"
    },
    "ctx_data_pointer_verify": {
      "sha256": "fcc2e65ff9837ddea19edd007afcd6b4ed5422e44ab003f42c373ec0f93df297",
      "source": "static bool ctx_data_pointer_verify(const bContext *C, const char *member, void **pointer)\n{\n  /* if context is nullptr, pointer must be nullptr too and that is a valid return */\n  if (C == nullptr) {\n    *pointer = nullptr;\n    return true;\n  }\n\n  bContextDataResult result;\n  if (ctx_data_get((bContext *)C, member, &result) == CTX_RESULT_OK) {\n    BLI_assert(result.type == CTX_DATA_TYPE_POINTER);\n    *pointer = result.ptr.data;\n    return true;\n  }\n\n  *pointer = nullptr;\n  return false;\n}"
    },
    "CTX_data_main_and_scene": {
      "sha256": "72ede7f01a7e8a9231f264f11705b63053cd77da96e5ef003e71f29e63a4492f",
      "source": "Main *CTX_data_main(const bContext *C)\n{\n  Main *bmain;\n  if (ctx_data_pointer_verify(C, \"blend_data\", (void **)&bmain)) {\n    return bmain;\n  }\n\n  return C->data.main;\n}\nScene *CTX_data_scene(const bContext *C)\n{\n  Scene *scene;\n  if (ctx_data_pointer_verify(C, \"scene\", (void **)&scene)) {\n    return scene;\n  }\n\n  return C->data.scene;\n}"
    },
    "rna_material_assignment_profile": {
      "sha256": "b1c9f8bd0c6c0f1b0eefdf429087cd54efed9e8132801d96dbc6cb433020acd9",
      "source": "static int rna_material_assignment_profile(PropertyRNA *prop)\n{\n  if (!prop || prop->magic != RNA_MAGIC || prop->type != PROP_POINTER) return 0;\n  const PointerPropertyRNA *pprop = reinterpret_cast<PointerPropertyRNA *>(prop);\n  if (pprop->set == Object_active_material_set) return 1;\n  if (pprop->set == MaterialSlot_material_set) return 2;\n  return 0;\n}"
    },
    "rna_material_assignment_owner_absent": {
      "sha256": "7d2aa5b9ec9af752f86bad1f7c404bbc5938990c092d4c6635a89ccecde091cc",
      "source": "static bool rna_material_assignment_owner_absent(PropertyRNA *prop, ReportList *reports)\n{\n  if (!rna_material_assignment_profile(prop)) return true;\n  if (G_MAIN &&\n      WM_event_ipad_pencil_paint_owner_teardown_next(nullptr, G_MAIN, nullptr))\n  {\n    return true;\n  }\n  if (reports) BKE_report(reports, RPT_ERROR, \"Material assignment was refused while a Pencil paint owner is active\");\n  return false;\n}"
    },
    "rna_property_update_prefix_before_suffix": {
      "sha256": "63ec781498ee254171bcd6c8e3f4ab076f9496e2b369b95f659a9340d3401d8a",
      "source": "static void rna_property_update(\n    bContext *C, Main *bmain, Scene *scene, PointerRNA *ptr, PropertyRNA *prop)\n{\n  const bool is_rna = (prop->magic == RNA_MAGIC);\n  prop = rna_ensure_property(prop);\n#ifdef WITH_APPLE_CROSSPLATFORM\n  /* UI callers can update after a void setter refusal. Do not tag/evaluate its\n   * data through that fallback while the same paint owner is still registered. */\n  if (!rna_material_assignment_owner_absent(prop, nullptr)) return;\n#endif"
    }
  },
