+  return tab && tab->region_type == 0 && inspector_side(tab->area);
+}
+
+static void preferred_sizes(const bScreen *screen, policy::State &state,
+                            const ScrArea *side_editor)
+{
+  auto size = [](float value) {
+    return std::isfinite(value) && value > 0 ?
+               int(std::clamp(value, 1.0f, 4000.0f) * UI_SCALE_FAC) : 0;
+  };
+  state.side_width = size(inspector_side(side_editor) ? screen->ipad_inspector_width :
+                                                     screen->ipad_panel_size[0]);
+  state.bottom_height = size(screen->ipad_panel_size[1]);
+  state.side_height = size(screen->ipad_panel_extent[0]);
+  state.bottom_width = size(screen->ipad_panel_extent[1]);
+}
+
+static Rect content_bounds(const wmWindow *win, const ScrArea *main)
+{
+  /* Headers and tool headers have already been laid out by Blender. Their count,
+   * alignment and height vary by workspace, mode and user configuration. */
+  const ARegion *region = BKE_area_find_region_type(main, RGN_TYPE_WINDOW);
+  if (region && region->winx > 1 && region->winy > 1) {
+    Rect bounds{region->winrct.xmin, region->winrct.ymin,
+                region->winrct.xmax + 1, region->winrct.ymax + 1};
+    /* An overlapping Sculpt tool header does not reduce WINDOW.winrct. Reserve
+     * its actual edge rectangle too, without querying our panel-aware visible
+     * rectangle (which would feed the previous panel layout back into itself). */
+    LISTBASE_FOREACH (const ARegion *, header, &main->regionbase) {
+      if (!ELEM(header->regiontype, RGN_TYPE_HEADER, RGN_TYPE_TOOL_HEADER, RGN_TYPE_FOOTER) ||
+          (header->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED)) ||
+          header->winx <= 1 || header->winy <= 1)
+      {
+        continue;
+      }
+      const rcti &rect = header->winrct;
+      const int alignment = RGN_ALIGN_ENUM_FROM_MASK(header->alignment);
+      if (rect.xmin < bounds.xmax && rect.xmax >= bounds.xmin) {
+        if (alignment == RGN_ALIGN_TOP && rect.ymax >= bounds.ymax - 2) {
+          bounds.ymax = std::max(bounds.ymin, std::min(bounds.ymax, rect.ymin));
+        }
+        else if (alignment == RGN_ALIGN_BOTTOM && rect.ymin <= bounds.ymin + 1) {
+          bounds.ymin = std::min(bounds.ymax, std::max(bounds.ymin, rect.ymax + 1));
+        }
+      }
+      if (rect.ymin < bounds.ymax && rect.ymax >= bounds.ymin) {
+        if (alignment == RGN_ALIGN_LEFT && rect.xmin <= bounds.xmin + 1) {
+          bounds.xmin = std::min(bounds.xmax, std::max(bounds.xmin, rect.xmax + 1));
+        }
+        else if (alignment == RGN_ALIGN_RIGHT && rect.xmax >= bounds.xmax - 2) {
+          bounds.xmax = std::max(bounds.xmin, std::min(bounds.xmax, rect.xmin));
+        }
+      }
+    }
+    return bounds;
+  }
+  rcti rect;
+  WM_window_screen_rect_calc(win, &rect);
+  return {rect.xmin, rect.ymin, rect.xmax, rect.ymax};
+}
+
+static Rect workspace_content_bounds(const wmWindow *win, const std::vector<ScrArea *> &areas)
+{
+  Rect result;
+  bool initialized = false;
+  for (const ScrArea *area : areas) {
+    const Rect rect = content_bounds(win, area);
+    if (rect.empty()) {
+      continue;
+    }
+    if (!initialized) {
+      result = rect;
+      initialized = true;
+    }
+    else {
+      result.xmin = std::min(result.xmin, rect.xmin);
+      result.ymin = std::min(result.ymin, rect.ymin);
+      result.xmax = std::max(result.xmax, rect.xmax);
+      result.ymax = std::max(result.ymax, rect.ymax);
+    }
+  }
+  return result;
+}
+
+/* Launcher ranks belong to editor identity or a stable native category name. */
+static int *launcher_rank(bScreen *screen, const Tab &tab, const bool create)
+{
+  if (tab.region_type == 0) { return &tab.area->ipad_launcher_order; }
+  const int kind = tab.id == tools_id ? 1 : tab.id == shelf_id ? 2 : 3;
+  LISTBASE_FOREACH (iPadPanelOrder *, entry, &screen->ipad_panel_order) {
+    if (entry->kind == kind && (kind != 3 || tab.category == entry->category)) { return &entry->rank; }
+  }
+  if (!create) { return nullptr; }
+  auto *entry = MEM_callocN<iPadPanelOrder>(__func__);
+  entry->kind = kind;
+  STRNCPY(entry->category, tab.category.c_str());
+  BLI_addtail(&screen->ipad_panel_order, entry);
+  return &entry->rank;
+}
+
+static std::string launcher_key(const Tab &tab)
+{
+  if (tab.region_type == 0) { return "editor:" + std::to_string(tab.area->runtime.ipad_launcher_session); }
+  if (tab.id == tools_id) { return "tools"; }
+  if (tab.id == shelf_id) { return "shelf"; }
+  return "category:" + tab.category;
+}
+
+static std::string launcher_signature(const bScreen *screen, const Model &model)
+{
+  std::string result = std::to_string(screen->id.session_uid) + ":" + std::to_string(screen->ipad_panel_owner);
+  LISTBASE_FOREACH (const ScrArea *, area, &screen->areabase) {
+    result += ":" + std::to_string(area->runtime.ipad_launcher_session) + "/" + std::to_string(area->spacetype);
+  }
+  result += ":owner=" + std::to_string(model.main ? model.main->runtime.ipad_launcher_session : 0);
+  for (const Tab &tab : model.tabs) {
+    const auto key = launcher_key(tab);
+    result += ":" + std::to_string(key.size()) + ":" + key;
+  }
+  return result;
+}
+
+static bool move_launcher(bScreen *screen, const Model &model, const std::string &key,
+                          const std::string &signature, const int direction)
+{
+  if (signature != launcher_signature(screen, model) || (direction != -1 && direction != 1)) { return false; }
+  const auto found = std::find_if(model.tabs.begin(), model.tabs.end(), [&](const Tab &tab) {
+    return launcher_key(tab) == key;
+  });
+  if (found == model.tabs.end()) { return false; }
+  std::vector<const Tab *> rail;
+  for (const Tab &tab : model.tabs) {
+    if ((tab.edge == Edge::Side) == (found->edge == Edge::Side)) { rail.push_back(&tab); }
+  }
+  const int index = int(std::find(rail.begin(), rail.end(), &*found) - rail.begin());
+  const int target = index + direction;
+  if (target < 0 || target >= int(rail.size())) { return false; }
+  /* Normalize all saved ranks, including currently hidden launchers. New visible
+   * entries append in natural order. Swap visible positions without discarding
+   * hidden records or modifying editor content, lock or size state. */
+  std::vector<int *> ranked;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (area->ipad_launcher_order > 0) { ranked.push_back(&area->ipad_launcher_order); }
+  }
+  LISTBASE_FOREACH (iPadPanelOrder *, entry, &screen->ipad_panel_order) {
+    if (entry->rank > 0) { ranked.push_back(&entry->rank); }
+  }
+  std::stable_sort(ranked.begin(), ranked.end(), [](const int *a, const int *b) { return *a < *b; });
+  for (const Tab &tab : model.tabs) {
+    int *rank = launcher_rank(screen, tab, true);
+    if (std::find(ranked.begin(), ranked.end(), rank) == ranked.end()) { ranked.push_back(rank); }
+  }
+  for (size_t i = 0; i < ranked.size(); ++i) { *ranked[i] = int(i + 1); }
+  std::swap(*launcher_rank(screen, *rail[index], false), *launcher_rank(screen, *rail[target], false));
+  return true;
+}
+
+static void sort_launchers(bScreen *screen, Model &model)
+{
+  std::stable_sort(model.tabs.begin(), model.tabs.end(), [&](const Tab &a, const Tab &b) {
+    const int *ra = launcher_rank(screen, a, false), *rb = launcher_rank(screen, b, false);
+    return (ra && *ra > 0 ? *ra : INT_MAX) < (rb && *rb > 0 ? *rb : INT_MAX);
+  });
+}
+
+static Model make_model(bContext *C, wmWindow *win)
+{
+  Model model;
+  bScreen *screen = WM_window_get_active_screen(win);
+  std::vector<policy::Area> inputs;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    static uint64_t next_launcher_session = 1;
+    if (area->runtime.ipad_launcher_session == 0) { area->runtime.ipad_launcher_session = next_launcher_session++; }
+    const int id = int(model.areas.size());
+    model.areas.push_back(area);
+    const bool service = ELEM(area->spacetype, SPACE_OUTLINER, SPACE_PROPERTIES, SPACE_FILE);
+    const auto *clip = area->spacetype == SPACE_CLIP ?
+                          static_cast<const SpaceClip *>(area->spacedata.first) : nullptr;
+    inputs.push_back({id,
+                      {area->v1->vec.x, area->v1->vec.y,
+                       area->v4->vec.x + 1, area->v2->vec.y + 1},
+                      area->ipad_keep_working ? policy::Role::Working :
+                      clip && clip->view == SC_VIEW_CLIP ? policy::Role::Canvas :
+                      service ? policy::Role::Service : policy::Role::Content});
+  }
+  model.inputs = inputs;
+  const policy::Mapping mapping = policy::classify(inputs, int(2 * UI_SCALE_FAC));
+  if (mapping.primary_id < 0) {
+    return model;
+  }
+  model.main = model.areas[mapping.primary_id];
+  model.working = mapping.working;
+  rcti workspace;
+  WM_window_screen_rect_calc(win, &workspace);
+  working_controls(screen, model.working,
+                   {workspace.xmin, workspace.ymin, workspace.xmax, workspace.ymax}, model.seams);
+  std::vector<ScrArea *> working_areas;
+  for (const policy::Area &working : model.working) {
+    ScrArea *area = model.areas[working.id];
+    working_areas.push_back(area);
+    if (screen->ipad_panel_owner == working.id + 1) {
+      model.main = area;
+    }
+  }
+  model.bounds = workspace_content_bounds(win, working_areas);
+
+  ScrArea *previous_area = CTX_wm_area(C);
+  ARegion *previous_region = CTX_wm_region(C);
+  CTX_wm_area_set(C, model.main);
+  ARegion *sidebar = BKE_area_find_region_type(model.main, RGN_TYPE_UI);
+  if (sidebar && !(sidebar->flag & RGN_FLAG_POLL_FAILED) && !sidebar->runtime->type) {
+    /* File load precedes region type initialization. Preserve a saved category
+     * until Blender can poll its native panels during the first layout. */
+    const std::string category = screen->ipad_panel_active[0] == -1 ?
+                                     screen->ipad_panel_category : "";
+    model.tabs.push_back({category_first_id, Edge::Side,
+                          category.empty() ? "Sidebar" : category,
+                          model.main, RGN_TYPE_UI, category});
+  }
+  if (sidebar && !(sidebar->flag & RGN_FLAG_POLL_FAILED) && sidebar->runtime->type) {
+    CTX_wm_region_set(C, sidebar);
+    std::vector<std::string> categories;
+    LISTBASE_FOREACH (PanelType *, pt, &sidebar->runtime->type->paneltypes) {
+      if (!pt->category[0] || !ED_ipad_panel_category_poll(C, pt)) {
+        continue;
+      }
+      if (std::find(categories.begin(), categories.end(), pt->category) == categories.end()) {
+        categories.emplace_back(pt->category);
+        model.tabs.push_back({category_first_id + int(categories.size()), Edge::Side,
+                              pt->category, model.main, RGN_TYPE_UI, pt->category});
+      }
+    }
+    if (categories.empty()) {
+      model.tabs.push_back({category_first_id, Edge::Side, "Sidebar", model.main, RGN_TYPE_UI, ""});
+    }
+  }
+  ARegion *tools = BKE_area_find_region_type(model.main, RGN_TYPE_TOOLS);
+  if (tools && !(tools->flag & RGN_FLAG_POLL_FAILED)) {
+    model.tabs.push_back({tools_id, Edge::Tools, "Tools", model.main, RGN_TYPE_TOOLS, ""});
+  }
+  const char *mode = CTX_data_mode_string(C);
+  model.sculpt = model.main->spacetype == SPACE_VIEW3D && mode && STREQ(mode, "SCULPT");
+  model.object_mode = model.main->spacetype == SPACE_VIEW3D && mode && STREQ(mode, "OBJECT");
+  ARegion *shelf = BKE_area_find_region_type(model.main, RGN_TYPE_ASSET_SHELF);
+  if (shelf && !(shelf->flag & RGN_FLAG_POLL_FAILED)) {
+    model.tabs.push_back({shelf_id, Edge::Bottom, "Brushes", model.main, RGN_TYPE_ASSET_SHELF, ""});
+  }
+  CTX_wm_area_set(C, previous_area);
+  CTX_wm_region_set(C, previous_region);
+  for (const policy::Panel &panel : mapping.panels) {
+    ScrArea *area = model.areas[panel.id];
+    model.tabs.push_back({panel.id, panel.edge, area_label(area), area, 0, ""});
+  }
+  for (int axis = 0; axis < 2; axis++) {
+    const Edge edge = axis == 0 ? Edge::Side : Edge::Bottom;
+    for (const Tab &tab : model.tabs) {
+      const int saved = screen->ipad_panel_active[axis];
+      const bool match = tab.region_type == 0 ? saved == tab.id + 1 :
+                         tab.region_type == RGN_TYPE_UI ?
+                             saved == -1 && tab.category == screen->ipad_panel_category :
+                         tab.region_type == RGN_TYPE_TOOLS ? saved == -2 : saved == -3;
+      if (edge == tab.edge && match) {
+        model.state.slot(edge) = {tab.id, false};
+        break;
+      }
+    }
+  }
+  /* Migrate the old per-edge pins and right-side Tools selection on first save. */
+  model.state.panels_locked = screen->ipad_panels_locked ||
+                             screen->ipad_panel_locked[0] || screen->ipad_panel_locked[1];
+  if ((screen->ipad_tools_open || screen->ipad_panel_active[0] == -2) && find_tab(model, tools_id)) {
+    model.state.tools.active_id = tools_id;
+  }
+  if (!screen->ipad_panel_initialized) {
+    /* Honor native startup visibility on first adaptation. In particular Sculpt
+     * must not lose its open brush shelf merely because tablet slots start at 0. */
+    if (!model.state.tools.open() && tools && !(tools->flag & RGN_FLAG_HIDDEN) &&
+        find_tab(model, tools_id)) {
+      model.state.tools.active_id = tools_id;
+    }
+    if (!model.state.bottom.open() && shelf && !(shelf->flag & RGN_FLAG_HIDDEN) &&
+        find_tab(model, shelf_id)) {
+      model.state.bottom.active_id = shelf_id;
+    }
+  }
+  model.default_sculpt_shelf = policy::open_default_sculpt_shelf(
+      model.state, model.sculpt, screen->ipad_sculpt_shelf_initialized,
+      find_tab(model, shelf_id) != nullptr, shelf_id);
+  const Tab *side_tab = find_tab(model, model.state.side.active_id);
+  preferred_sizes(screen, model.state,
+                  side_tab && side_tab->region_type == 0 ? side_tab->area : nullptr);
+  model.metrics = panel_metrics(model.main,
+                                side_tab && side_tab->region_type == 0 ? side_tab->area : nullptr);
+  model.layout = policy::layout(model.bounds, model.state, model.metrics);
+  sort_launchers(screen, model);
+  return model;
+}
+
+static void save_slot(bScreen *screen, const Model &model, Edge edge)
+{
+  screen->ipad_panel_initialized = 1;
+  if (model.sculpt && find_tab(model, shelf_id)) {
+    screen->ipad_sculpt_shelf_initialized = 1;
+  }
+  screen->ipad_panels_locked = model.state.panels_locked;
+  screen->ipad_panel_locked[0] = screen->ipad_panel_locked[1] = 0;
+  screen->ipad_tools_open = model.state.tools.open();
+  if (screen->ipad_panel_active[0] == -2) {
+    screen->ipad_panel_active[0] = 0;
+  }
+  if (edge == Edge::Tools) {
+    return;
+  }
+  const int axis = edge == Edge::Side ? 0 : 1;
+  const policy::Slot &slot = model.state.slot(edge);
+  const Tab *tab = find_tab(model, slot.active_id);
+  screen->ipad_panel_active[axis] = !tab ? 0 :
+                                   tab->region_type == 0 ? tab->id + 1 :
+                                   tab->region_type == RGN_TYPE_UI ? -1 :
+                                   tab->region_type == RGN_TYPE_TOOLS ? -2 : -3;
+  if (tab && tab->region_type == RGN_TYPE_UI) {
+    STRNCPY(screen->ipad_panel_category, tab->category.c_str());
+    if (!tab->category.empty()) {
+      UI_panel_category_active_set(BKE_area_find_region_type(tab->area, RGN_TYPE_UI),
+                                   tab->category.c_str());
+    }
+  }
+}
+
+static Rect panel_content(const Model &model, Edge edge)
+{
+  return policy::panel_content(model.layout, edge);
+}
+
+enum class Action { Tab, ToolHeader, Previous, Next, Resize, Lock, Seam };
+struct Button {
+  Rect rect;
+  std::string label;
+  Action action;
+  Edge edge;
+  int id = -1;
+  bool selected = false;
+  bool native = false;
+};
+
+static std::vector<Button> buttons(const Model &model, const bScreen *screen)
+{
+  std::vector<Button> result;
+  ARegion *tool_header = model.main && model.main->spacetype == SPACE_VIEW3D ?
+                             BKE_area_find_region_type(model.main, RGN_TYPE_TOOL_HEADER) : nullptr;
+  for (const bool left : {false, true}) {
+    Rect rail = left ? model.layout.left_rail : model.layout.side_rail;
+    std::vector<const Tab *> tabs;
+    bool tool_header_added = false;
+    for (const Tab &tab : model.tabs) {
+      if ((tab.edge != Edge::Side) == left) {
+        tabs.push_back(&tab);
+        if (left && tool_header && tab.id == tools_id) {
+          /* Reopen Blender's complete native tool row without leaving it above
+           * the canvas when the iPad workspace first opens. */
+          tabs.push_back(nullptr);
+          tool_header_added = true;
+        }
+      }
+    }
+    if (left && tool_header && !tool_header_added) {
+      tabs.insert(tabs.begin(), nullptr);
+    }
+    const uiFontStyle *font = &UI_style_get_dpi()->widget;
+    UI_fontstyle_set(font);
+    int label_extent = int(44 * UI_SCALE_FAC);
+    for (const Tab *tab : tabs) {
+      label_extent = std::max(label_extent,
+                              int(std::ceil(BLF_width(font->uifont_id,
+                                                      tab ? tab->label.c_str() : "Settings",
+                                                      tab ? tab->label.size() : 8) +
+                                            20 * UI_SCALE_FAC)));
+    }
+    const policy::RailPage page = policy::rail_page(
+        tabs.size(), rail.height(), std::max(0, screen->ipad_panel_page[left ? 1 : 0]),
+        label_extent, int(4 * UI_SCALE_FAC));
+    int offset = 0;
+    auto add = [&](const std::string &label, Action action, Edge edge, int id, bool selected) {
+      Rect rect = rail;
+      rect.ymax -= offset;
+      rect.ymin = rect.ymax - page.button_extent;
+      result.push_back({rect, label, action, edge, id, selected});
+      offset += page.button_extent + page.gap;
+    };
+    const Edge page_edge = left ? Edge::Bottom : Edge::Side;
+    if (page.paged) {
+      add("Prev", Action::Previous, page_edge, int(page.page > 0 ? page.page - 1 : 0), false);
+    }
+    for (size_t i = page.first; i < page.first + page.count; i++) {
+      const Tab *tab = tabs[i];
+      if (tab) {
+        add(tab->label, Action::Tab, tab->edge, tab->id,
+            model.state.slot(tab->edge).active_id == tab->id);
+      }
+      else {
+        add("Settings", Action::ToolHeader, Edge::Tools, -1,
+            !(tool_header->flag & RGN_FLAG_HIDDEN_BY_USER));
+      }
+    }
+    if (page.paged) {
+      add("Next", Action::Next, page_edge, int(std::min(page.page + 1, page.pages - 1)), false);
+    }
+  }
+  /* Editors without a navigation gizmo keep the same global lock reachable. */
+  const bool native_pin = std::any_of(model.areas.begin(), model.areas.end(),
+                                      [&](const ScrArea *area) {
+                                        return ED_ipad_panels_native_pin(screen, area);
+                                      });
+  if (native_pin) {
+    for (const ScrArea *area : model.areas) {
+      if (ED_ipad_panels_native_pin(screen, area)) {
+        const rcti &r = area->runtime.ipad_pin_rect;
+        if (r.xmax > r.xmin && r.ymax > r.ymin) {
+          result.push_back({{r.xmin, r.ymin, r.xmax + 1, r.ymax + 1}, "", Action::Lock,
+                             Edge::Side, -1, model.state.panels_locked, true});
+        }
+      }
+    }
+  }
+  if (model.main && !native_pin) {
+    const int size = std::min(int(32 * UI_SCALE_FAC), model.layout.canvas.width());
+    const Rect &canvas = model.layout.canvas;
+    result.push_back({{canvas.xmax - size, std::max(canvas.ymin, canvas.ymax - size),
+                        canvas.xmax, canvas.ymax},
+                       "", Action::Lock, Edge::Side, -1, model.state.panels_locked});
+  }
+  for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+    if (model.state.slot(edge).open()) {
+      const Rect resize = edge == Edge::Side ? model.layout.side_resize : model.layout.bottom_resize;
+      const Rect corner = edge == Edge::Side ? model.layout.side_corner : model.layout.bottom_corner;
+      result.push_back({corner, "", Action::Resize, edge, 1});
+      result.push_back({resize, "", Action::Resize, edge});
+    }
+  }
+  /* Local grips keep the rest of each seam available to native editor UI.
+   * Never place a hit target over panels, rails or another chrome control. */
+  std::vector<Rect> occluders{model.layout.side_panel, model.layout.bottom_panel,
+                              model.layout.tools_panel, model.layout.left_rail, model.layout.side_rail};
+  for (const Button &button : result) { occluders.push_back(button.rect); }
+  for (const ScrArea *area : model.areas) {
+    if (area->runtime.ipad_layer != 1) { continue; }
+    LISTBASE_FOREACH (const ARegion *, region, &area->regionbase) {
+      if (region->runtime->visible &&
+          ELEM(region->regiontype, RGN_TYPE_HEADER, RGN_TYPE_TOOL_HEADER, RGN_TYPE_FOOTER)) {
+        occluders.push_back({region->winrct.xmin, region->winrct.ymin,
+                             region->winrct.xmax + 1, region->winrct.ymax + 1});
+      }
+    }
+    occluders.push_back({area->runtime.ipad_navigation_rect.xmin,
+                         area->runtime.ipad_navigation_rect.ymin,
+                         area->runtime.ipad_navigation_rect.xmax + 1,
+                         area->runtime.ipad_navigation_rect.ymax + 1});
+  }
+  for (size_t i = 0; !(U.app_flag & USER_APP_LOCK_EDGE_RESIZE) && i < model.seams.size(); ++i) {
+    const auto &seam = model.seams[i].seam;
+    const int extent = int(44 * UI_SCALE_FAC);
+    const bool native_edge = [&]() {
+      LISTBASE_FOREACH (const ScrEdge *, edge, &screen->edgebase) {
+        const int a = seam.vertical ? edge->v1->vec.x : edge->v1->vec.y;
+        const int b = seam.vertical ? edge->v2->vec.x : edge->v2->vec.y;
+        const int u = seam.vertical ? edge->v1->vec.y : edge->v1->vec.x;
+        const int v = seam.vertical ? edge->v2->vec.y : edge->v2->vec.x;
+        const int start = seam.vertical ? seam.saved_bounds.ymin : seam.saved_bounds.xmin;
+        const int end = seam.vertical ? seam.saved_bounds.ymax : seam.saved_bounds.xmax;
+        if (a == seam.coordinate && b == a && u != v &&
+            std::max(u,v) > start && std::min(u,v) < end) { return true; }
+      }
+      return false;
+    }();
+    if (!native_edge) { continue; }
+    const Rect handle = policy::seam_handle_rect(seam, model.bounds, occluders, extent);
+    if (!handle.empty()) {
+      result.push_back({handle, "", Action::Seam,
+                         seam.vertical ? Edge::Side : Edge::Bottom, int(i)});
+      occluders.push_back(handle);
+    }
+  }
+  return result;
+}
+
+struct IPadHUDChrome {
+  uintptr_t screen_address = 0;
+  uint32_t screen_uid = 0;
+  uint64_t window_id = 0;
+  int width = 0, height = 0;
+  float scale = 0;
+  Rect canvas;
+  std::vector<Rect> blockers;
+};
+static std::unordered_map<uintptr_t, IPadHUDChrome> ipad_hud_chrome;
+
+static void ipad_hud_chrome_capture(wmWindow *win, bScreen *screen, const Model &model)
+{
+  IPadHUDChrome next;
+  next.screen_address = uintptr_t(screen); next.screen_uid = screen->id.session_uid;
+  next.window_id = uint64_t(win->winid);
+  next.width = WM_window_native_pixel_x(win); next.height = WM_window_native_pixel_y(win);
+  next.scale = UI_SCALE_FAC; next.canvas = model.layout.canvas;
+  for (const Button &button : buttons(model, screen)) next.blockers.push_back(button.rect);
+  for (const Rect &panel : {model.layout.tools_panel, model.layout.side_panel,
+                            model.layout.bottom_panel}) {
+    if (!panel.empty()) next.blockers.push_back(panel);
+  }
+  const auto previous = ipad_hud_chrome.find(uintptr_t(win));
+  auto same_rect = [](const Rect &a, const Rect &b) {
+    return a.xmin == b.xmin && a.ymin == b.ymin && a.xmax == b.xmax && a.ymax == b.ymax;
+  };
+  const bool same = previous != ipad_hud_chrome.end() &&
+      previous->second.screen_address == next.screen_address &&
+      previous->second.screen_uid == next.screen_uid && previous->second.window_id == next.window_id &&
+      previous->second.width == next.width && previous->second.height == next.height &&
+      previous->second.scale == next.scale && same_rect(previous->second.canvas, next.canvas) &&
+      previous->second.blockers.size() == next.blockers.size() &&
+      std::equal(previous->second.blockers.begin(), previous->second.blockers.end(),
+                 next.blockers.begin(), same_rect);
+  ipad_hud_chrome[uintptr_t(win)] = std::move(next);
+  if (!same) {
+    LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+      if (area->runtime.ipad_layer != 1) continue;
+      if (ARegion *hud = BKE_area_find_region_type(area, RGN_TYPE_HUD)) ED_region_tag_redraw(hud);
+    }
+  }
+}
+
+static void tag_layout(bContext *C, wmWindow *win, const bool refresh_cursor = true)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  screen->do_refresh = true;
+  screen->do_draw = true;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    ED_area_tag_redraw(area);
+  }
+  LISTBASE_FOREACH (ScrArea *, area, &win->global_areas.areabase) {
+    if (area->spacetype == SPACE_STATUSBAR) {
+      ED_area_tag_redraw(area);
+    }
+  }
+  if (refresh_cursor) {
+    WM_event_add_mousemove(win);
+  }
+  /* Refresh before the next queued input event can use the old hit rectangles. */
+  ED_screen_ensure_updated(C, CTX_wm_manager(C), win);
+}
+
+static void activate_button(bContext *C, wmWindow *win, Model &model, const Button &button)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  const int axis = button.edge == Edge::Side ? 0 : 1;
+  if (button.action == Action::Lock) {
+    model.state.toggle_panels_lock();
+    save_slot(screen, model, Edge::Tools);
+  }
+  else if (button.action == Action::Tab) {
+    model.state.tap(button.edge, button.id);
+    save_slot(screen, model, button.edge);
+  }
+  else if (button.action == Action::ToolHeader) {
+    ARegion *header = model.main ?
+                          BKE_area_find_region_type(model.main, RGN_TYPE_TOOL_HEADER) : nullptr;
+    if (header) {
+      ScrArea *previous_area = CTX_wm_area(C);
+      ARegion *previous_region = CTX_wm_region(C);
+      CTX_wm_area_set(C, model.main);
+      CTX_wm_region_set(C, header);
+      /* Match SpaceView3D.show_region_tool_header: its getter reads the user
+       * flag while its setter updates both flags. Keep native RNA, saving and
+       * workspace switching consistent with the rail's selected state. */
+      if (header->flag & RGN_FLAG_HIDDEN_BY_USER) {
+        header->flag &= ~(RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER);
+      }
+      else {
+        header->flag |= RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER;
+      }
+      ED_region_visibility_change_update(C, model.main, header);
+      CTX_wm_area_set(C, previous_area);
+      CTX_wm_region_set(C, previous_region);
+    }
+  }
+  else if (ELEM(button.action, Action::Previous, Action::Next)) {
+    screen->ipad_panel_page[axis] = button.id;
+  }
+  tag_layout(C, win);
+}
+
+static void draw_box(const Rect &rect, const char *label, bool selected, bool hovered = false)
+{
+  if (rect.empty()) {
+    return;
+  }
+  float color[4];
+  UI_GetThemeColor4fv(selected || hovered ? TH_TAB_ACTIVE : TH_TAB_INACTIVE, color);
+  color[3] = 1.0f;
+  rctf box = {float(rect.xmin), float(rect.xmax), float(rect.ymin), float(rect.ymax)};
+  UI_draw_roundbox_corner_set(UI_CNR_ALL);
+  UI_draw_roundbox_4fv(&box, true, 6 * UI_SCALE_FAC, color);
+  if (selected && label && label[0]) {
+    float accent[4];
+    UI_GetThemeColor4fv(TH_TAB_OUTLINE_ACTIVE, accent);
+    accent[3] = 1.0f;
+    rctf mark = {box.xmin, box.xmin + 3 * UI_SCALE_FAC,
+                 box.ymin + 7 * UI_SCALE_FAC, box.ymax - 7 * UI_SCALE_FAC};
+    UI_draw_roundbox_4fv(&mark, true, UI_SCALE_FAC, accent);
+  }
+  if (label && label[0]) {
+    const uiStyle *style = UI_style_get_dpi();
+    uchar text_color[4];
+    UI_GetThemeColor4ubv(selected ? TH_TAB_TEXT_HI : TH_TAB_TEXT, text_color);
+    /* Match the direction and font of Blender's native right sidebar tabs. */
+    const uiFontStyle *font = &style->widget;
+    UI_fontstyle_set(font);
+    const int fontid = font->uifont_id;
+    /* BLF clipping is evaluated before rotation: a narrow screen-space clip
+     * rectangle cuts almost every glyph. Fit text first, like native tabs. */
+    BLF_disable(fontid, BLF_CLIPPING);
+    std::string fitted = label;
+    const float available = std::max(0.0f, rect.height() - 16 * UI_SCALE_FAC);
+    if (BLF_width(fontid, fitted.c_str(), fitted.size()) > available) {
+      const std::string suffix = "...";
+      while (!fitted.empty() &&
+             BLF_width(fontid, (fitted + suffix).c_str(), fitted.size() + suffix.size()) > available)
+      {
+        size_t last = fitted.size() - 1;
+        while (last && (static_cast<unsigned char>(fitted[last]) & 0xc0) == 0x80) {
+          last--;
+        }
+        fitted.resize(last);
+      }
+      fitted += suffix;
+      if (BLF_width(fontid, fitted.c_str(), fitted.size()) > available) {
+        fitted.clear();
+      }
+    }
+    BLF_enable(fontid, BLF_ROTATION);
+    BLF_rotation(fontid, -float(M_PI_2));
+    const float length = BLF_width(fontid, fitted.c_str(), fitted.size());
+    const float padding = std::max(6 * UI_SCALE_FAC, (rect.height() - length) * 0.5f);
+    BLF_position(fontid, (rect.xmin + rect.xmax) * 0.5f - font->points * UI_SCALE_FAC * 0.35f,
+                 rect.ymax - padding, 0.0f);
+    BLF_color4ubv(fontid, text_color);
+    BLF_draw(fontid, fitted.c_str(), fitted.size());
+    BLF_disable(fontid, BLF_ROTATION);
+  }
+}
+
+struct ResizeData {
+  unsigned int screen_uid;
+  wmWindow *window;
+  int axis;
+  int start[2];
+  float original;
+  float initial_size;
+  float original_extent;
+  float initial_extent;
+  policy::Rect bounds;
+  bool inspector_width;
+};
