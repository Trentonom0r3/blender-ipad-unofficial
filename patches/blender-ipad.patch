diff --git a/intern/ghost/intern/GHOST_ProjectImportIOS.hh b/intern/ghost/intern/GHOST_ProjectImportIOS.hh
new file mode 100644
--- /dev/null
+++ b/intern/ghost/intern/GHOST_ProjectImportIOS.hh
@@ -0,0 +1,1293 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* Included only by GHOST_SystemIOS.mm. The explicit linked-project route
+ * keeps a local working file while ordinary Save updates its Files original. */
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+@interface GHOST_IOSProjectImporter : NSObject <UIDocumentPickerDelegate,
+                                               UIAdaptivePresentationControllerDelegate>
+{
+  UIViewController *_presenter;
+  UIDocumentPickerViewController *_picker;
+  UIAlertController *_progress;
+  NSProgress *_copyProgress;
+  NSURL *_pendingProject;
+  NSUInteger _generation;
+  BOOL _busy;
+  BOOL _folderMode;
+  BOOL _linkedMode;
+}
++ (BOOL)copyItemAtURL:(NSURL *)source
+                toURL:(NSURL *)destination
+              manager:(NSFileManager *)manager
+             progress:(NSProgress *)copyProgress
+                error:(NSError **)outError;
+- (BOOL)presentWithFolderMode:(BOOL)folderMode linkedMode:(BOOL)linkedMode;
+@end
+
+@implementation GHOST_IOSProjectImporter
+
+- (BOOL)hasLivePresenter
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!system || !system->current_active_window_) {
+    return NO;
+  }
+  return system->current_active_window_->rootWindow.rootViewController == _presenter &&
+         _presenter.view.window != nil;
+}
+
+- (void)finish
+{
+  _busy = NO;
+  _folderMode = NO;
+  _linkedMode = NO;
+  if (_copyProgress) {
+    [_copyProgress cancel];
+    [_copyProgress release];
+    _copyProgress = nil;
+  }
+  if (_picker) {
+    _picker.delegate = nil;
+    _picker.presentationController.delegate = nil;
+    [_picker dismissViewControllerAnimated:NO completion:nil];
+    [_picker release];
+    _picker = nil;
+  }
+  if (_progress) {
+    [_progress dismissViewControllerAnimated:NO completion:nil];
+    [_progress release];
+    _progress = nil;
+  }
+  if (_pendingProject) {
+    NSURL *project = _pendingProject;
+    _pendingProject = nil;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+      @autoreleasepool {
+        [[NSFileManager defaultManager] removeItemAtURL:project error:nullptr];
+        [project release];
+      }
+    });
+  }
+  [_presenter release];
+  _presenter = nil;
+}
+
+- (void)showError:(NSString *)message
+{
+  if ([self hasLivePresenter]) {
+    UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"Project Import"
+                                                                  message:message
+                                                           preferredStyle:UIAlertControllerStyleAlert];
+    [alert addAction:[UIAlertAction actionWithTitle:@"OK"
+                                             style:UIAlertActionStyleCancel
+                                           handler:nil]];
+    [_presenter presentViewController:alert animated:YES completion:nil];
+  }
+  else {
+    NSLog(@"Project import: %@", message);
+  }
+  [self finish];
+}
+
+- (void)openImportedProject:(NSURL *)file
+               projectRoot:(NSURL *)project
+                  bookmark:(NSData *)bookmark
+                    digest:(NSData *)digest
+              documentPath:(NSString *)documentPath
+                generation:(NSUInteger)generation
+{
+  if (generation != _generation) {
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+      [[NSFileManager defaultManager] removeItemAtURL:project error:nullptr];
+    });
+    return;
+  }
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (![self hasLivePresenter] || !system || !system->handleOpenDocumentRequest(file.path)) {
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+      [[NSFileManager defaultManager] removeItemAtURL:project error:nullptr];
+    });
+    [self showError:@"The project could not be opened. Check that the file is a valid Blender project."];
+    return;
+  }
+  if (bookmark && documentPath.length) {
+    GHOST_IOS_remember_imported_project_bookmark(file.path, documentPath, bookmark, digest);
+    GHOST_IOS_recent_project_mark_fresh(file.path.UTF8String);
+  }
+  /* Normal GHOST open event retains Blender's unsaved-changes dialog and script
+   * policy. No operator/context pointer survives UIKit. */
+  if (_pendingProject == project) {
+    [_pendingProject release];
+    _pendingProject = nil;
+  }
+  [self finish];
+}
+
+- (void)dismissPicker:(void (^)(void))completion
+{
+  UIDocumentPickerViewController *picker = _picker;
+  _picker = nil;
+  picker.delegate = nil;
+  picker.presentationController.delegate = nil;
+  [picker dismissViewControllerAnimated:YES completion:completion];
+  [picker release];
+}
+
+- (BOOL)presentWithFolderMode:(BOOL)folderMode linkedMode:(BOOL)linkedMode
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (_busy && ![self hasLivePresenter]) {
+    ++_generation;
+    [self finish];
+  }
+  if (_busy || !system || !system->current_active_window_) {
+    return NO;
+  }
+  UIViewController *presenter = system->current_active_window_->rootWindow.rootViewController;
+  if (!presenter.view.window || presenter.presentedViewController) {
+    return NO;
+  }
+  _presenter = [presenter retain];
+  _busy = YES;
+  _folderMode = folderMode;
+  _linkedMode = linkedMode;
+  ++_generation;
+  UTType *blend = [UTType typeWithFilenameExtension:@"blend" conformingToType:UTTypeData];
+  NSArray<UTType *> *types = folderMode ? @[UTTypeFolder] : @[blend ?: UTTypeData];
+  _picker = [[UIDocumentPickerViewController alloc]
+      initForOpeningContentTypes:types asCopy:NO];
+  if (!_picker) {
+    [self finish];
+    return NO;
+  }
+  _picker.allowsMultipleSelection = NO;
+  _picker.delegate = self;
+  _picker.modalPresentationStyle = UIModalPresentationFormSheet;
+  _picker.title = folderMode ? @"Import a Project Folder" :
+                  linkedMode ? @"Open Project from Files" : @"Open a Project Copy";
+  [_presenter presentViewController:_picker animated:YES completion:nil];
+  _picker.presentationController.delegate = self;
+  return YES;
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller
+{
+  if (controller != _picker) {
+    return;
+  }
+  ++_generation;
+  [self dismissPicker:^{ [self finish]; }];
+}
+
+- (void)presentationControllerDidDismiss:(UIPresentationController *)controller
+{
+  if (controller.presentedViewController != _picker) {
+    return;
+  }
+  ++_generation;
+  _picker.delegate = nil;
+  _picker.presentationController.delegate = nil;
+  [_picker release];
+  _picker = nil;
+  [self finish];
+}
+
+/* Coordinate each item separately. A coordinated read of an ordinary directory
+ * does not coordinate writes to files inside it. Enumerate names while holding
+ * the directory read, then coordinate each child using its original provider URL.
+ * Never nest coordinator calls inside an accessor. */
++ (BOOL)copyItemAtURL:(NSURL *)source
+                toURL:(NSURL *)destination
+              manager:(NSFileManager *)manager
+             progress:(NSProgress *)copyProgress
+                error:(NSError **)outError
+{
+  if (copyProgress.cancelled) {
+    if (outError) {
+      *outError = [NSError errorWithDomain:NSCocoaErrorDomain
+                                      code:NSUserCancelledError userInfo:nil];
+    }
+    return NO;
+  }
+  __block BOOL copied = NO;
+  __block NSArray<NSString *> *childNames = nil;
+  NSError *coordinationError = nil;
+  NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+  [coordinator coordinateReadingItemAtURL:source options:0 error:&coordinationError
+                               byAccessor:^(NSURL *readURL) {
+    NSNumber *directory = nil;
+    NSNumber *symbolicLink = nil;
+    if (![readURL getResourceValue:&directory forKey:NSURLIsDirectoryKey error:outError] ||
+        ![readURL getResourceValue:&symbolicLink forKey:NSURLIsSymbolicLinkKey error:outError]) {
+      return;
+    }
+    if (!directory.boolValue || symbolicLink.boolValue) {
+      copied = [manager copyItemAtURL:readURL toURL:destination error:outError];
+      return;
+    }
+    if (![manager createDirectoryAtURL:destination
+            withIntermediateDirectories:YES attributes:nil error:outError]) {
+      return;
+    }
+    NSArray<NSURL *> *children = [manager contentsOfDirectoryAtURL:readURL
+                                       includingPropertiesForKeys:nil
+                                                          options:0 error:outError];
+    if (!children) {
+      return;
+    }
+    NSMutableArray<NSString *> *names = [NSMutableArray arrayWithCapacity:children.count];
+    for (NSURL *child in children) {
+      [names addObject:child.lastPathComponent];
+    }
+    childNames = [names copy];
+    copied = YES;
+  }];
+  [coordinator release];
+  if (!copied && outError && !*outError) {
+    *outError = coordinationError;
+  }
+  if (copied && childNames) {
+    for (NSString *name in childNames) {
+      NSURL *childSource = [source URLByAppendingPathComponent:name];
+      NSURL *childDestination = [destination URLByAppendingPathComponent:name];
+      if (![GHOST_IOSProjectImporter copyItemAtURL:childSource toURL:childDestination manager:manager
+                       progress:copyProgress error:outError]) {
+        copied = NO;
+        break;
+      }
+    }
+  }
+  [childNames release];
+  if (copyProgress.cancelled) {
+    if (outError) {
+      *outError = [NSError errorWithDomain:NSCocoaErrorDomain
+                                      code:NSUserCancelledError userInfo:nil];
+    }
+    return NO;
+  }
+  return copied;
+}
+
+- (void)importURL:(NSURL *)source
+{
+  if (![self hasLivePresenter]) {
+    [self finish];
+    return;
+  }
+  const BOOL folderMode = _folderMode;
+  const BOOL linkedMode = _linkedMode;
+  if (!source.isFileURL ||
+      (!folderMode && [source.pathExtension caseInsensitiveCompare:@"blend"] != NSOrderedSame))
+  {
+    [self showError:folderMode ? @"Choose a project folder." : @"Choose a Blender (.blend) project."];
+    return;
+  }
+  const NSUInteger generation = _generation;
+  _copyProgress = [[NSProgress progressWithTotalUnitCount:1] retain];
+  NSProgress *copyProgress = _copyProgress;
+  _progress = [[UIAlertController alertControllerWithTitle:folderMode ? @"Importing Project Folder" :
+                                                                    @"Opening Project"
+                                                  message:linkedMode ? @"Preparing a local working file. Save will update the Files project." :
+                                                                       @"Copying project into Blender's Projects folder."
+                                           preferredStyle:UIAlertControllerStyleAlert] retain];
+  [_progress setModalInPresentation:YES];
+  [_progress addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                               style:UIAlertActionStyleCancel
+                                             handler:^(UIAlertAction *action) {
+    /* File-provider work may finish later. Its generation cannot open a project
+     * or dismiss UI belonging to a newer request. */
+    ++_generation;
+    [copyProgress cancel];
+    [_progress release];
+    _progress = nil;
+    [self finish];
+  }]];
+  [_presenter presentViewController:_progress animated:YES completion:^{
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+      @autoreleasepool {
+        NSFileManager *manager = [NSFileManager defaultManager];
+        NSURL *documents = [[manager URLsForDirectory:NSDocumentDirectory
+                                            inDomains:NSUserDomainMask] firstObject];
+        /* Never overwrite an existing import, even for equal filenames. Keep the
+         * original filename inside its own visible project directory. */
+        NSString *identifier = [NSUUID UUID].UUIDString;
+        NSString *folder = [NSString stringWithFormat:@"%@ - %@",
+                            folderMode ? source.lastPathComponent :
+                                         source.lastPathComponent.stringByDeletingPathExtension,
+                            identifier];
+        NSURL *projects = [documents URLByAppendingPathComponent:@"Projects" isDirectory:YES];
+        NSURL *project = [projects URLByAppendingPathComponent:folder isDirectory:YES];
+        NSURL *stagingProject = [projects URLByAppendingPathComponent:
+            [@".BlenderImport-" stringByAppendingString:identifier] isDirectory:YES];
+        NSURL *destination = folderMode ? project :
+                                           [project URLByAppendingPathComponent:source.lastPathComponent];
+        NSURL *stagingDestination = folderMode ? stagingProject :
+            [stagingProject URLByAppendingPathComponent:source.lastPathComponent];
+        __block NSError *copy_error = nil;
+        BOOL copied = NO;
+        const BOOL scoped = [source startAccessingSecurityScopedResource];
+        if ([manager createDirectoryAtURL:folderMode ? projects : stagingProject
+                    withIntermediateDirectories:YES attributes:nil error:&copy_error]) {
+          copied = [GHOST_IOSProjectImporter copyItemAtURL:source toURL:stagingDestination
+                                 manager:manager progress:copyProgress error:&copy_error];
+        }
+        /* A bookmark from the picked URL preserves access for later coordinated
+         * Saves. A failed bookmark must never create an apparently linked file. */
+        NSData *linkedBookmark = nil;
+        NSData *linkedDigest = nil;
+        if (copied && linkedMode) {
+          linkedBookmark = [source bookmarkDataWithOptions:0
+                                  includingResourceValuesForKeys:nil relativeToURL:nil
+                                                         error:&copy_error];
+          NSData *sourceBytes = [NSData dataWithContentsOfURL:stagingDestination
+                                                       options:NSDataReadingMappedIfSafe
+                                                         error:&copy_error];
+          linkedDigest = GHOST_IOS_project_digest(sourceBytes);
+          if (!linkedBookmark.length || !linkedDigest.length) {
+            copied = NO;
+          }
+        }
+        if (scoped) {
+          [source stopAccessingSecurityScopedResource];
+        }
+        NSMutableArray<NSURL *> *blendFiles = [NSMutableArray array];
+        __block BOOL enumerationFailed = NO;
+        if (copied && folderMode) {
+          NSDirectoryEnumerator<NSURL *> *contents = [manager
+              enumeratorAtURL:stagingDestination
+              includingPropertiesForKeys:@[NSURLIsRegularFileKey]
+              options:NSDirectoryEnumerationSkipsHiddenFiles |
+                      NSDirectoryEnumerationSkipsPackageDescendants
+              errorHandler:^BOOL(NSURL *url, NSError *error) {
+                copy_error = error;
+                enumerationFailed = YES;
+                return NO;
+              }];
+          for (NSURL *item in contents) {
+            if (copyProgress.cancelled) {
+              copied = NO;
+              break;
+            }
+            if ([item.pathExtension caseInsensitiveCompare:@"blend"] != NSOrderedSame) {
+              continue;
+            }
+            NSNumber *regular = nil;
+            if (![item getResourceValue:&regular forKey:NSURLIsRegularFileKey error:&copy_error]) {
+              enumerationFailed = YES;
+              break;
+            }
+            if (regular.boolValue) {
+              [blendFiles addObject:item];
+            }
+          }
+          if (copyProgress.cancelled) {
+            copied = NO;
+          }
+          else {
+            [blendFiles sortUsingComparator:^NSComparisonResult(NSURL *a, NSURL *b) {
+              return [a.path localizedStandardCompare:b.path];
+            }];
+          }
+        }
+        NSString *failure = copy_error.localizedDescription;
+        if (copied && folderMode && (enumerationFailed || !blendFiles.count)) {
+          copied = NO;
+          if (!enumerationFailed) {
+            failure = @"This folder has no .blend file. Choose a folder containing a project file.";
+          }
+        }
+        BOOL moved = NO;
+        if (copied && !copyProgress.cancelled) {
+          moved = [manager moveItemAtURL:stagingProject toURL:project error:&copy_error];
+          copied = moved;
+          if (!moved) {
+            failure = copy_error.localizedDescription;
+          }
+        }
+        else {
+          copied = NO;
+        }
+        if (copied && folderMode) {
+          NSString *prefix = [stagingDestination.path stringByAppendingString:@"/"];
+          for (NSUInteger i = 0; i < blendFiles.count; ++i) {
+            NSURL *file = blendFiles[i];
+            if (![file.path hasPrefix:prefix]) {
+              copied = NO;
+              failure = @"The copied project paths could not be validated.";
+              break;
+            }
+            NSString *relative = [file.path substringFromIndex:prefix.length];
+            [blendFiles replaceObjectAtIndex:i
+                                 withObject:[destination URLByAppendingPathComponent:relative]];
+          }
+        }
+        if (copyProgress.cancelled) {
+          copied = NO;
+        }
+        if (!copied) {
+          [manager removeItemAtURL:stagingProject error:nullptr];
+          if (moved) {
+            [manager removeItemAtURL:project error:nullptr];
+          }
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+          if (generation != _generation) {
+            if (copied) {
+              dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                [[NSFileManager defaultManager] removeItemAtURL:project error:nullptr];
+              });
+            }
+            return;
+          }
+          if (![self hasLivePresenter]) {
+            ++_generation;
+            if (copied) {
+              dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                [[NSFileManager defaultManager] removeItemAtURL:project error:nullptr];
+              });
+            }
+            [self finish];
+            return;
+          }
+          UIAlertController *progress = _progress;
+          _progress = nil;
+          [progress dismissViewControllerAnimated:YES completion:^{
+            if (generation != _generation) {
+              if (copied) {
+                dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                  [[NSFileManager defaultManager] removeItemAtURL:project error:nullptr];
+                });
+              }
+              return;
+            }
+            if (!copied) {
+              [self showError:failure ?: @"The project could not be copied. Check available storage and try again."];
+              return;
+            }
+            if (!folderMode || blendFiles.count == 1) {
+              [self openImportedProject:folderMode ? blendFiles.firstObject : destination
+                              projectRoot:project
+                                 bookmark:linkedBookmark
+                                   digest:linkedDigest
+                             documentPath:linkedMode ? source.path : nil
+                               generation:generation];
+              return;
+            }
+            if (![self hasLivePresenter]) {
+              [self finish];
+              dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                [[NSFileManager defaultManager] removeItemAtURL:project error:nullptr];
+              });
+              return;
+            }
+            UIAlertController *choice = [UIAlertController
+                alertControllerWithTitle:@"Choose Project File"
+                             message:@"The complete folder is copied. Which .blend file should open?"
+                      preferredStyle:UIAlertControllerStyleAlert];
+            _pendingProject = [project retain];
+            [choice setModalInPresentation:YES];
+            NSString *prefix = [destination.path stringByAppendingString:@"/"];
+            for (NSURL *file in blendFiles) {
+              NSString *label = [file.path hasPrefix:prefix] ?
+                                    [file.path substringFromIndex:prefix.length] :
+                                    file.lastPathComponent;
+              [choice addAction:[UIAlertAction actionWithTitle:label
+                                                       style:UIAlertActionStyleDefault
+                                                     handler:^(UIAlertAction *action) {
+                [self openImportedProject:file projectRoot:project bookmark:nil digest:nil
+                            documentPath:nil generation:generation];
+              }]];
+            }
+            [choice addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                                   style:UIAlertActionStyleCancel
+                                                 handler:^(UIAlertAction *action) {
+              ++_generation;
+              [self finish];
+            }]];
+            [_presenter presentViewController:choice animated:YES completion:nil];
+          }];
+          [progress release];
+        });
+      }
+    });
+  }];
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller
+    didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls
+{
+  if (controller != _picker) {
+    return;
+  }
+  NSURL *source = urls.firstObject;
+  [self dismissPicker:^{
+    if (source) {
+      [self importURL:source];
+    }
+    else {
+      [self finish];
+    }
+  }];
+}
+@end
