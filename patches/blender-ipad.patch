   if (region->alignment & RGN_SPLIT_PREV) {
     if (region->prev) {
       remainder = remainder_prev;
       region->prev->winx = BLI_rcti_size_x(&region->prev->winrct) + 1;
       region->prev->winy = BLI_rcti_size_y(&region->prev->winrct) + 1;
