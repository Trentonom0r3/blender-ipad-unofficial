+uiPopupBlockHandle *ui_ipad_registered_popup_resolve(
+    bContext *C, const blender::ui::ipad::ActionOrigin &origin, const uint64_t lifetime)
+{
+  if (!origin.present() || !lifetime || !ui_ipad_action_origin_valid(C, origin))
+    return nullptr;
+  wmWindow *win = CTX_wm_window(C);
+  wmWindowManager *wm = CTX_wm_manager(C);
