+  receipt.window_address = uintptr_t(win);
+  receipt.area_address = uintptr_t(area);
+  receipt.region_address = uintptr_t(region);
+  receipt.event_address = uintptr_t(event);
+  receipt.phase = TouchUndoPhase::PendingInvoke;
+  wm->runtime->touch_undo_recovery = receipt;
+  return true;
+}
+
+bool ED_undo_touch_pop(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || wm->runtime->touch_undo_recovery.phase != TouchUndoPhase::PendingInvoke) {
+    return false;
+  }
+  TouchUndoRecovery receipt = wm->runtime->touch_undo_recovery;
+  wm->runtime->touch_undo_recovery = {};
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !touch_undo_pop_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return false;
+  }
+  WM_jobs_kill_all(wm);
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !touch_undo_pop_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return false;
+  }
+  wm->op_undo_depth++;
+  BKE_callback_exec_id(CTX_data_main(C), &CTX_data_scene(C)->id, BKE_CB_EVT_UNDO_PRE);
+  wm = touch_undo_owner(C, receipt.wm_uid);
+  if (wm) {
+    wm->op_undo_depth--;
+  }
+  wm = touch_undo_context(C, receipt);
+  bool popped = false;
+  if (wm && touch_undo_pop_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    UndoStack *stack = wm->runtime->undo_stack;
+    /* Fresh target after PRE; never use a pointer saved before callbacks. */
+    popped = BKE_undosys_step_load_data_ex(stack, C, stack->step_active->prev, nullptr, true);
+    wm = touch_undo_context(C, receipt);
+    popped = popped && wm && BKE_undosys_touch_seal(wm->runtime->undo_stack, receipt.undo);
+  }
+  wm = touch_undo_context(C, receipt, false);
+  if (wm) {
+    wm->op_undo_depth++;
+    BKE_callback_exec_id(CTX_data_main(C), &CTX_data_scene(C)->id, BKE_CB_EVT_UNDO_POST);
+    wm = touch_undo_owner(C, receipt.wm_uid);
+    if (wm) {
+      wm->op_undo_depth--;
+    }
+  }
+  wm = touch_undo_context(C, receipt);
+  if (!popped || !wm || !BKE_undosys_touch_validate(wm->runtime->undo_stack, receipt.undo)) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment stopped after an Undo callback changed its context");
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return false;
+  }
+  wm->runtime->touch_undo_recovery = receipt;
+  WM_event_add_notifier(C, NC_WINDOW, nullptr);
+  WM_event_add_notifier(C, NC_WM | ND_UNDO, nullptr);
+  return true;
+}
+
+bool ED_undo_touch_seal(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || wm->runtime->touch_undo_recovery.phase != TouchUndoPhase::PendingInvoke) {
+    return false;
+  }
+  TouchUndoRecovery receipt = wm->runtime->touch_undo_recovery;
+  wm->runtime->touch_undo_recovery = {};
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !BKE_undosys_touch_seal(wm->runtime->undo_stack, receipt.undo)) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment stopped because its Undo state changed");
+    return false;
+  }
+  wm->runtime->touch_undo_recovery = receipt;
+  return true;
+}
+
+blender::bke::TouchUndoClaim ED_undo_touch_claim(bContext *C, const wmEvent *event, TouchUndoRecovery &receipt)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  using blender::bke::TouchUndoClaim;
+  if (!wm || wm->runtime->touch_undo_recovery.phase != TouchUndoPhase::PendingInvoke) {
+    return TouchUndoClaim::None;
+  }
+  if (wm->runtime->touch_undo_recovery.event_address != uintptr_t(event)) {
+    return TouchUndoClaim::Rejected;
+  }
+  const TouchUndoRecovery pending = wm->runtime->touch_undo_recovery;
+  wm = touch_undo_context(C, pending);
+  if (!wm || !touch_undo_redo_valid(C, wm->runtime->undo_stack, pending.undo)) {
+    return TouchUndoClaim::Rejected;
+  }
+  receipt = pending;
+  wm->runtime->touch_undo_recovery = {};
+  return TouchUndoClaim::Claimed;
+}
+
+void ED_undo_touch_finish(bContext *C, const TouchUndoRecovery &receipt, const bool cancelled)
+{
+  if (!cancelled || receipt.phase == TouchUndoPhase::Empty) {
+    return;
+  }
+  wmWindowManager *wm = touch_undo_owner(C, receipt.wm_uid);
+  if (wm && wm->runtime->touch_undo_recovery.phase == TouchUndoPhase::Empty) {
+    wm->runtime->touch_undo_recovery = receipt;
+    wm->runtime->touch_undo_recovery.phase = TouchUndoPhase::Ready;
+  }
+}
+
+void ED_undo_touch_finalize_invoke(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (wm && wm->runtime->touch_undo_recovery.phase == TouchUndoPhase::PendingInvoke) {
+    /* Gizmo invoke/poll may fail before the macro acquires the transaction. */
+    wm->runtime->touch_undo_recovery.phase = TouchUndoPhase::Ready;
+  }
+}
+
+bool ED_undo_touch_recover(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || wm->runtime->touch_undo_recovery.phase != TouchUndoPhase::Ready) {
+    return false;
+  }
+  const TouchUndoRecovery receipt = wm->runtime->touch_undo_recovery;
+  wm->runtime->touch_undo_recovery = {}; /* Consume before any callback/decode. */
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !touch_undo_redo_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment recovery stopped after a scene or Undo change");
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return true;
+  }
+
+  /* Native pre semantics, with fresh owner resolution after callbacks. */
+  WM_jobs_kill_all(wm);
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !touch_undo_redo_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment recovery stopped after a scene or Undo change");
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return true;
+  }
+  if ((G.debug & G_DEBUG_IO) && CTX_data_main(C)->lock) {
+    BLO_main_validate_libraries(CTX_data_main(C), nullptr);
+  }
+  wm->op_undo_depth++;
+  BKE_callback_exec_id(CTX_data_main(C), &CTX_data_scene(C)->id, BKE_CB_EVT_REDO_PRE);
+  wm = touch_undo_owner(C, receipt.wm_uid);
+  if (wm) {
+    wm->op_undo_depth--;
+  }
+  wm = touch_undo_context(C, receipt);
+  bool restored = false;
+  uint64_t completed_generation = 0;
+  if (wm && touch_undo_redo_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    restored = BKE_undosys_step_redo(wm->runtime->undo_stack, C);
+    /* Resolve again; decode can rebuild edit owners or the entire Main. */
+    wm = touch_undo_owner(C, receipt.wm_uid);
+    const UndoStack *stack = wm ? wm->runtime->undo_stack : nullptr;
+    restored = restored && stack && stack->ipad_lifetime_id == receipt.undo.stack_id &&
+               stack->step_active &&
+               stack->step_active->ipad_lifetime_id == receipt.undo.accepted_id;
+    completed_generation = stack ? stack->ipad_mutation_generation : 0;
+  }
+
+  /* Pair PRE even on refusal, provided the original owner still exists. */
+  wm = touch_undo_context(C, receipt, false);
+  if (wm && CTX_data_scene(C)) {
+    wm->op_undo_depth++;
+    BKE_callback_exec_id(CTX_data_main(C), &CTX_data_scene(C)->id, BKE_CB_EVT_REDO_POST);
+    wm = touch_undo_owner(C, receipt.wm_uid);
+    if (wm) {
+      wm->op_undo_depth--;
+    }
+  }
+  wm = touch_undo_owner(C, receipt.wm_uid);
+  const UndoStack *completed = wm ? wm->runtime->undo_stack : nullptr;
+  restored = restored && completed && completed->ipad_lifetime_id == receipt.undo.stack_id &&
+             completed->ipad_mutation_generation == completed_generation &&
+             completed->step_active &&
+             completed->step_active->ipad_lifetime_id == receipt.undo.accepted_id;
+  /* No saved context/operator/gizmo pointer is used after either callback. */
+  wm = touch_undo_context(C, receipt, false);
+  if (wm) {
+    WM_event_add_notifier(C, NC_WINDOW, nullptr);
+    WM_event_add_notifier(C, NC_WM | ND_UNDO, nullptr);
+    WM_toolsystem_refresh_active(C);
+    WM_toolsystem_refresh_screen_all(CTX_data_main(C));
+    blender::ed::asset::list::storage_tag_main_data_dirty();
+  }
+  else {
+    /* A callback may have deleted the originating area/region. Do not leave
+     * stale spatial context for the dispatcher which will return immediately. */
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+  }
+  if (!restored) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment could not restore its accepted Undo state");
+  }
+  return true;
+}
+#endif

