+def ipad_component_selection(context):
+    result = []
+    for obj in sorted(context.objects_in_mode, key=lambda item: item.as_pointer()):
+        data = obj.data
+        if context.mode == 'EDIT_MESH':
+            import bmesh
+            mesh = bmesh.from_edit_mesh(data)
+            parts = []
+            for elements in (mesh.verts, mesh.edges, mesh.faces):
+                elements.index_update()
+                parts.append((len(elements), tuple(item.index for item in elements if item.select)))
+            selection = tuple(parts)
+        elif context.mode == 'POSE':
+            # Blender 5.0 stores selection on Bone; newer hosts use PoseBone.
+            selection = tuple((bone.name, getattr(bone, 'select', getattr(bone.bone, 'select', False)))
+                              for bone in obj.pose.bones)
+            selection += (("active", data.bones.active.name if data.bones.active else None),)
+        elif context.mode == 'EDIT_ARMATURE':
+            selection = tuple((bone.name, bone.select, bone.select_head, bone.select_tail)
+                              for bone in data.edit_bones)
+            selection += (("active", data.edit_bones.active.name if data.edit_bones.active else None),)
+        elif context.mode in {'EDIT_CURVE', 'EDIT_SURFACE'}:
+            selection = tuple((tuple(point.select for point in spline.points),
+                tuple((point.select_control_point, point.select_left_handle, point.select_right_handle)
+                      for point in spline.bezier_points)) for spline in data.splines)
+        elif context.mode == 'EDIT_LATTICE':
+            selection = tuple(point.select for point in data.points)
+        elif context.mode == 'EDIT_METABALL':
+            selection = tuple(element.select for element in data.elements)
+        else:
+            def attributes(owner):
+                if owner is None:
+                    return ()
+                return tuple((attr.name, tuple(item.value for item in attr.data))
+                             for attr in owner.attributes
+                             if attr.name.startswith('.selection') and attr.data_type in {'BOOLEAN', 'FLOAT'})
+            if context.mode == 'EDIT_GREASE_PENCIL':
+                selection = tuple((layer.name, frame.frame_number, frame.drawing is not None,
+                                   attributes(frame.drawing))
+                                  for layer in data.layers for frame in layer.frames)
+            else:
+                selection = attributes(data)
+        result.append((obj.as_pointer(), selection))
+    return tuple(result)
+
+
+def ipad_numeric_target(context, slot_index):
+    # Store plain identities, never a retained context or live RNA object. A
+    # changed scene, editor, selection, mode or basis invalidates the dialog.
+    pointer = lambda data: data.as_pointer() if data else 0
+    basis = ipad_transform_orientation(context, slot_index)
+    custom = basis.custom_orientation
+    window_region = context.region if context.region and context.region.type == 'WINDOW' else next(
+        (region for region in context.area.regions if region.type == 'WINDOW'), None)
+    view = window_region.data if window_region else None
+    return (pointer(context.window), pointer(context.area), pointer(context.area.spaces.active),
+            pointer(window_region), pointer(context.scene),
+            pointer(context.view_layer), context.mode, pointer(context.active_object),
+            tuple(sorted(pointer(obj) for obj in context.selected_objects)),
+            tuple(sorted(pointer(obj) for obj in context.objects_in_mode)),
+            basis.type, pointer(custom),
+            tuple(value for row in custom.matrix for value in row) if custom else (),
+            context.tool_settings.transform_pivot_point,
+            tuple(value for row in context.scene.cursor.matrix for value in row),
+            tuple(view.view_rotation) if view else (),
+            context.scene.frame_current, context.scene.frame_subframe,
+            ipad_component_selection(context))
+
+
+class VIEW3D_OT_ipad_transform_numbers(Operator):
+    bl_idname = "view3d.ipad_transform_numbers"
