           CTX_wm_region_popup_set(C, menu->region);
           ui_panel_drag_collapse_handler_add(C, !ui_layout_panel_toggle_open(C, header));
           /* Restore previous popup region. */
           CTX_wm_region_popup_set(C, prev_region_popup);
