 static void float_array_to_string(const float *values,
                                   const int values_len,
                                   char *output,
                                   int output_maxncpy)
 {
   const int values_end = values_len - 1;
   int ofs = 0;
   output[ofs++] = '[';
   for (int i = 0; i < values_len; i++) {
