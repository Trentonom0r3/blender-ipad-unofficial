diff --git a/source/blender/editors/interface/interface_ipad_tool_ring.hh b/source/blender/editors/interface/interface_ipad_tool_ring.hh
new file mode 100644
--- /dev/null
+++ b/source/blender/editors/interface/interface_ipad_tool_ring.hh
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+/* Geometry only, deliberately independent of Blender/UIKit so it can be tested
+ * on a host compiler. The normal eight-direction pie layout does not use this. */
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace blender::ui::ipad {
+struct Rect {
+  float xmin, xmax, ymin, ymax;
+};
+struct ToolRingLayout {
+  std::array<Rect, 9> buttons;
+  bool grid = false;
+  bool needs_scroll = false;
+};
+
+inline ToolRingLayout tool_ring_layout(float unit, Rect viewport, float x, float y)
+{
+  ToolRingLayout result;
+  const float width = 2.8f * unit;
+  const float height = 1.3f * unit;
+  const float gap = 0.25f * unit;
+  const float radius = 4.6f * unit;
+  auto button = [&](int i, float cx, float cy) {
+    result.buttons[i] = {cx - width / 2, cx + width / 2,
+                         cy - height / 2, cy + height / 2};
+  };
+  for (int i = 0; i < 9; ++i) {
+    const float angle = float(i) * 6.283185307179586f / 9.0f;
+    button(i, std::sin(angle) * radius, std::cos(angle) * radius);
+  }
+  /* Center remains open and empty (Settings removed per user review). */
+  auto bounds = [&]() {
+    Rect bounds = result.buttons[0];
+    for (const Rect &rect : result.buttons) {
+      bounds.xmin = std::min(bounds.xmin, rect.xmin);
+      bounds.xmax = std::max(bounds.xmax, rect.xmax);
+      bounds.ymin = std::min(bounds.ymin, rect.ymin);
+      bounds.ymax = std::max(bounds.ymax, rect.ymax);
+    }
+    return bounds;
+  };
+  Rect extent = bounds();
+  const float available_width = viewport.xmax - viewport.xmin - 2 * gap;
+  const float available_height = viewport.ymax - viewport.ymin - 2 * gap;
+  if (extent.xmax - extent.xmin > available_width ||
+      extent.ymax - extent.ymin > available_height)
+  {
+    /* A narrow split editor cannot hold a usable ring. Preserve button size and
+     * access in a compact grid; ordinary popup scrolling handles tiny heights. */
+    result.grid = true;
+    const int columns = std::clamp(int((available_width + gap) / (width + gap)), 1, 3);
+    for (int i = 0; i < 9; ++i) {
+      button(i, (i % columns) * (width + gap), -(i / columns) * (height + gap));
+    }
+    extent = bounds();
+  }
+  const float left = viewport.xmin + gap - extent.xmin;
+  const float right = viewport.xmax - gap - extent.xmax;
+  const float bottom = viewport.ymin + gap - extent.ymin;
+  const float top = viewport.ymax - gap - extent.ymax;
+  result.needs_scroll = bottom > top;
+  x = left <= right ? std::clamp(x, left, right) : left;
+  y = bottom <= top ? std::clamp(y, bottom, top) : top;
+  for (Rect &rect : result.buttons) {
+    rect.xmin += x;
+    rect.xmax += x;
+    rect.ymin += y;
+    rect.ymax += y;
+  }
+  return result;
+}
+}  // namespace blender::ui::ipad
diff --git a/intern/ghost/intern/GHOST_ProjectExportIOS.hh b/intern/ghost/intern/GHOST_ProjectExportIOS.hh
new file mode 100644
--- /dev/null
+++ b/intern/ghost/intern/GHOST_ProjectExportIOS.hh
@@ -0,0 +1,333 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* Included only by GHOST_SystemIOS.mm. The writer runs synchronously: no Blender
+ * context, operator or callback is retained while UIKit owns the picker. */
+@interface GHOST_IOSProjectExporter : NSObject <UIDocumentPickerDelegate,
+                                               UIAdaptivePresentationControllerDelegate>
+{
+  UIViewController *_presenter;
+  UIDocumentPickerViewController *_picker;
+  NSURL *_staging;
+  BOOL _busy;
+  NSString *_exportFilename;
+  NSString *_exportTitle;
+  std::function<bool(const char *, bool)> _compressWriter;
+  std::function<void(const char *)> _on_saved;
+}
+- (BOOL)presentWithCompressPrompt:(NSString *)filename
+                            title:(NSString *)title
+                           writer:(const std::function<bool(const char *, bool)> &)writer
+                          onSaved:(const std::function<void(const char *)> &)onSaved;
+- (BOOL)present:(NSString *)filename
+          title:(NSString *)title
+         writer:(const std::function<bool(const char *)> &)writer;
+@end
+
+@implementation GHOST_IOSProjectExporter
+- (void)finish
+{
+  if (_staging) {
+    /* This URL is always our unique temporary directory, never a provider URL. */
+    [[NSFileManager defaultManager] removeItemAtURL:_staging error:nullptr];
+    [_staging release];
+    _staging = nil;
+  }
+  [_presenter release];
+  _presenter = nil;
+  [_exportFilename release];
+  _exportFilename = nil;
+  [_exportTitle release];
+  _exportTitle = nil;
+  _compressWriter = nullptr;
+  _on_saved = nullptr;
+  _busy = NO;
+}
+
+- (void)startExportWithCompress:(BOOL)compress
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!system || !system->current_active_window_ ||
+      system->current_active_window_->rootWindow.rootViewController != _presenter ||
+      !_presenter.view.window || _presenter.presentedViewController)
+  {
+    [self finish];
+    return;
+  }
+  NSFileManager *manager = [NSFileManager defaultManager];
+  NSURL *root = [NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES];
+  _staging = [[root URLByAppendingPathComponent:
+      [@"BlenderExport-" stringByAppendingString:[NSUUID UUID].UUIDString]
+                                   isDirectory:YES] retain];
+  NSError *error = nil;
+  if (![manager createDirectoryAtURL:_staging withIntermediateDirectories:YES
+                          attributes:nil error:&error]) {
+    NSLog(@"Cannot prepare Blender export: %@", error);
+    [self finish];
+    return;
+  }
+  NSString *name = _exportFilename.lastPathComponent;
+  if (!name.length || [name isEqualToString:@"."] || [name isEqualToString:@".."]) {
+    name = @"Untitled.blend";
+  }
+  if ([name.pathExtension caseInsensitiveCompare:@"blend"] != NSOrderedSame) {
+    name = [name stringByAppendingPathExtension:@"blend"];
+  }
+  NSURL *source = [_staging URLByAppendingPathComponent:name];
+  if (!_compressWriter || !_compressWriter(source.path.UTF8String, compress)) {
+    [self finish];
+    return;
+  }
+  if (!system->current_active_window_ ||
+      system->current_active_window_->rootWindow.rootViewController != _presenter ||
+      !_presenter.view.window || _presenter.presentedViewController)
+  {
+    [self finish];
+    return;
+  }
+  if (![manager fileExistsAtPath:source.path]) {
+    NSLog(@"Blender export error: file %@ does not exist on disk", source.path);
+    [self finish];
+    return;
+  }
+  @try {
+    _picker = [[UIDocumentPickerViewController alloc] initForExportingURLs:@[source] asCopy:YES];
+    _picker.delegate = self;
+    _picker.modalPresentationStyle = UIModalPresentationFormSheet;
+    _picker.title = _exportTitle ?: @"Save to Files";
+    UIViewController *top = _presenter;
+    while (top.presentedViewController && !top.presentedViewController.isBeingDismissed) {
+      top = top.presentedViewController;
+    }
+    [top presentViewController:_picker animated:YES completion:nil];
+    _picker.presentationController.delegate = self;
+  }
+  @catch (NSException *ex) {
+    NSLog(@"Failed to present project export picker: %@", ex);
+    [self finish];
+  }
+}
+
+- (BOOL)presentWithCompressPrompt:(NSString *)filename
+                            title:(NSString *)title
+                           writer:(const std::function<bool(const char *, bool)> &)writer
+                          onSaved:(const std::function<void(const char *)> &)onSaved
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (_busy || !system || !system->current_active_window_) {
+    return NO;
+  }
+  UIViewController *presenter = system->current_active_window_->rootWindow.rootViewController;
+  if (!presenter.view.window || presenter.presentedViewController) {
+    return NO;
+  }
+  _busy = YES;
+  _presenter = [presenter retain];
+  _exportFilename = [filename copy];
+  _exportTitle = [title copy];
+  _compressWriter = writer;
+  _on_saved = onSaved;
+
+  UIAlertController *alert = [UIAlertController alertControllerWithTitle:title
+                                                                 message:@"Compress .blend file?"
+                                                          preferredStyle:UIAlertControllerStyleAlert];
+
+  [alert addAction:[UIAlertAction actionWithTitle:@"Compress (Yes)"
+                                           style:UIAlertActionStyleDefault
+                                         handler:^(UIAlertAction *action) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [self startExportWithCompress:YES];
+    });
+  }]];
+
+  [alert addAction:[UIAlertAction actionWithTitle:@"Don't Compress (No)"
+                                           style:UIAlertActionStyleDefault
+                                         handler:^(UIAlertAction *action) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [self startExportWithCompress:NO];
+    });
+  }]];
+
+  [alert addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                           style:UIAlertActionStyleCancel
+                                         handler:^(UIAlertAction *action) {
+    [self finish];
+  }]];
+
+  [_presenter presentViewController:alert animated:YES completion:nil];
+  return YES;
+}
+
+- (BOOL)present:(NSString *)filename
+          title:(NSString *)title
+         writer:(const std::function<bool(const char *)> &)writer
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (_busy || !system || !system->current_active_window_) {
+    return NO;
+  }
+  UIViewController *presenter = system->current_active_window_->rootWindow.rootViewController;
+  if (!presenter.view.window || presenter.presentedViewController) {
+    return NO;
+  }
+  _busy = YES;
+  _presenter = [presenter retain];
+  NSFileManager *manager = [NSFileManager defaultManager];
+  NSURL *root = [NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES];
+  _staging = [[root URLByAppendingPathComponent:
+      [@"BlenderExport-" stringByAppendingString:[NSUUID UUID].UUIDString]
+                                   isDirectory:YES] retain];
+  NSError *error = nil;
+  if (![manager createDirectoryAtURL:_staging withIntermediateDirectories:YES
+                          attributes:nil error:&error]) {
+    NSLog(@"Cannot prepare Blender export: %@", error);
+    [self finish];
+    return NO;
+  }
+  /* Enforce a clean basename even if caller supplied an absolute path. */
+  NSString *name = filename.lastPathComponent;
+  if (!name.length || [name isEqualToString:@"."] || [name isEqualToString:@".."]) {
+    name = @"ExportedModel";
+  }
+  NSURL *source = [_staging URLByAppendingPathComponent:name];
+  /* Blender must serialize on its main thread. Provider upload/copy happens
+   * later, under the system export picker, not while serializing the scene. */
+  if (!writer(source.path.UTF8String)) {
+    [self finish];
+    return NO;
+  }
+  if (!system->current_active_window_ ||
+      system->current_active_window_->rootWindow.rootViewController != _presenter ||
+      !_presenter.view.window || _presenter.presentedViewController)
+  {
+    [self finish];
+    return NO;
+  }
+  /* Include all generated files in staging directory (e.g. .obj + .mtl). */
+  NSArray<NSURL *> *files = [manager contentsOfDirectoryAtURL:_staging
+                                   includingPropertiesForKeys:nil
+                                                      options:NSDirectoryEnumerationSkipsHiddenFiles
+                                                        error:nil];
+  NSMutableArray<NSURL *> *valid_files = [NSMutableArray array];
+  for (NSURL *file in files) {
+    if ([manager fileExistsAtPath:file.path]) {
+      [valid_files addObject:file];
+    }
+  }
+  if (valid_files.count == 0 && [manager fileExistsAtPath:source.path]) {
+    [valid_files addObject:source];
+  }
+  if (valid_files.count == 0) {
+    NSLog(@"Blender export error: no output files were generated at %@", _staging.path);
+    [self finish];
+    return NO;
+  }
+  @try {
+    _picker = [[UIDocumentPickerViewController alloc] initForExportingURLs:valid_files asCopy:YES];
+    _picker.delegate = self;
+    _picker.modalPresentationStyle = UIModalPresentationFormSheet;
+    _picker.title = title ?: @"Export Model";
+    UIViewController *top = _presenter;
+    while (top.presentedViewController && !top.presentedViewController.isBeingDismissed) {
+      top = top.presentedViewController;
+    }
+    [top presentViewController:_picker animated:YES completion:nil];
+    _picker.presentationController.delegate = self;
+    return YES;
+  }
+  @catch (NSException *ex) {
+    NSLog(@"Failed to present export picker: %@", ex);
+    [self finish];
+    return NO;
+  }
+}
+
+- (void)dismissPicker:(UIDocumentPickerViewController *)controller
+{
+  if (controller != _picker) {
+    return;
+  }
+  UIDocumentPickerViewController *picker = _picker;
+  _picker = nil;
+  picker.delegate = nil;
+  picker.presentationController.delegate = nil;
+  /* Keep the source alive until the picker has completed or cancelled export. */
+  [picker dismissViewControllerAnimated:YES completion:^{ [self finish]; }];
+  [picker release];
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller
+{
+  [self dismissPicker:controller];
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller
+    didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls
+{
+  NSURL *destination = urls.firstObject;
+  if (destination && _on_saved) {
+    _on_saved(destination.path.UTF8String);
+  }
+  [self dismissPicker:controller];
+}
+
+- (void)presentationControllerDidDismiss:(UIPresentationController *)controller
+{
+  if (controller.presentedViewController != _picker) {
+    return;
+  }
+  _picker.delegate = nil;
+  _picker.presentationController.delegate = nil;
+  [_picker release];
+  _picker = nil;
+  [self finish];
+}
+@end
+
+bool GHOST_IOS_export_project(const char *filename,
+                              const std::function<bool(const char *, bool)> &writer,
+                              const std::function<void(const char *)> &on_saved)
+{
+  if (![NSThread isMainThread] || !filename || !writer) {
+    return false;
+  }
+  static GHOST_IOSProjectExporter *exporter = nil;
+  if (!exporter) {
+    exporter = [[GHOST_IOSProjectExporter alloc] init];
+  }
+  return [exporter presentWithCompressPrompt:[NSString stringWithUTF8String:filename]
+                                       title:@"Save a Copy to Files"
+                                      writer:writer
+                                     onSaved:on_saved];
+}
+
+bool GHOST_IOS_save_as_project(const char *filename,
+                               const std::function<bool(const char *, bool)> &writer,
+                               const std::function<void(const char *)> &on_saved)
+{
+  if (![NSThread isMainThread] || !filename || !writer) {
+    return false;
+  }
+  static GHOST_IOSProjectExporter *exporter = nil;
+  if (!exporter) {
+    exporter = [[GHOST_IOSProjectExporter alloc] init];
+  }
+  return [exporter presentWithCompressPrompt:[NSString stringWithUTF8String:filename]
+                                       title:@"Save Project As"
+                                      writer:writer
+                                     onSaved:on_saved];
+}
+
+bool GHOST_IOS_export_file(const char *filename,
+                           const std::function<bool(const char *)> &writer)
+{
+  if (![NSThread isMainThread] || !filename || !writer) {
+    return false;
+  }
+  static GHOST_IOSProjectExporter *exporter = nil;
+  if (!exporter) {
+    exporter = [[GHOST_IOSProjectExporter alloc] init];
+  }
+  return [exporter present:[NSString stringWithUTF8String:filename]
+                     title:@"Export 3D Model"
+                    writer:writer];
+}
