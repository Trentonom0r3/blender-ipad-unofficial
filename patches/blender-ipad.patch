diff --git a/source/blender/editors/screen/screen_ipad_layout_history.cc b/source/blender/editors/screen/screen_ipad_layout_history.cc
new file mode 100644
--- /dev/null
+++ b/source/blender/editors/screen/screen_ipad_layout_history.cc
@@ -0,0 +1,281 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#ifdef WITH_APPLE_CROSSPLATFORM
+
+#include <string>
+
+#include "DNA_screen_types.h"
+#include "DNA_windowmanager_types.h"
+#include "DNA_workspace_types.h"
+
+#include "BLI_listbase.h"
+#include "BLI_utildefines.h"
+
+#include "BKE_context.hh"
+#include "BKE_main.hh"
+#include "BKE_screen.hh"
+#include "BKE_workspace.hh"
+#include "BKE_report.hh"
+
+#include "ED_ipad_panels.hh"
+#include "ED_screen.hh"
+
+#include "RNA_access.hh"
+#include "RNA_define.hh"
+#include "UI_interface.hh"
+#include "UI_interface_layout.hh"
+#include "UI_resources.hh"
+#include "WM_api.hh"
+#include "WM_types.hh"
+
+namespace {
+
+constexpr int screen_ipad_layout_checkpoint = (1 << 2);
+
+bool layout_is_checkpoint(const WorkSpaceLayout *layout)
+{
+  if (!layout) {
+    return false;
+  }
+  const bScreen *screen = BKE_workspace_layout_screen_get(layout);
+  return screen && (screen->flag & screen_ipad_layout_checkpoint) &&
+         screen->state == SCREENNORMAL && !screen->temp &&
+         !BKE_screen_is_fullscreen_area(screen);
+}
+
+WorkSpaceLayout *layout_find_checkpoint(WorkSpace *workspace, const char *screen_id)
+{
+  if (!workspace || !screen_id || !screen_id[0]) {
+    return nullptr;
+  }
+  LISTBASE_FOREACH (WorkSpaceLayout *, layout, &workspace->layouts) {
+    const bScreen *screen = BKE_workspace_layout_screen_get(layout);
+    if (layout_is_checkpoint(layout) && screen && STREQ(screen->id.name, screen_id)) {
+      return layout;
+    }
+  }
+  return nullptr;
+}
+
+std::string layout_unique_name(WorkSpace *workspace, const char *requested_name)
+{
+  const std::string base = requested_name && requested_name[0] ? requested_name : "Saved Layout";
+  std::string candidate = base;
+  int suffix = 2;
+  while (true) {
+    bool used = false;
+    LISTBASE_FOREACH (WorkSpaceLayout *, layout, &workspace->layouts) {
+      if (candidate == BKE_workspace_layout_name_get(layout)) {
+        used = true;
+        break;
+      }
+    }
+    if (!used) {
+      return candidate;
+    }
+    candidate = base + " " + std::to_string(suffix++);
+  }
+}
+
+bool layout_checkpoint_referenced(const Main *bmain,
+                                  const WorkSpace *workspace,
+                                  const WorkSpaceLayout *layout)
+{
+  LISTBASE_FOREACH (WorkSpaceDataRelation *, relation, &workspace->hook_layout_relations) {
+    if (relation->value == layout) {
+      return true;
+    }
+  }
+
+  LISTBASE_FOREACH (wmWindowManager *, wm, &bmain->wm) {
+    LISTBASE_FOREACH (wmWindow *, win, &wm->windows) {
+      const WorkSpaceInstanceHook *hook = win->workspace_hook;
+      if (hook && (hook->act_layout == layout || hook->temp_layout_store == layout)) {
+        return true;
+      }
+    }
+  }
+
+  return BKE_screen_is_used(BKE_workspace_layout_screen_get(layout));
+}
+
+}  // namespace
+
+WorkSpaceLayout *ED_ipad_panels_layout_checkpoint_capture(bContext *C, const char *name)
+{
+  Main *bmain = CTX_data_main(C);
+  WorkSpace *workspace = CTX_wm_workspace(C);
+  wmWindow *win = CTX_wm_window(C);
+  if (!bmain || !workspace || !win || !win->workspace_hook) {
+    return nullptr;
+  }
+
+  WorkSpaceLayout *active = BKE_workspace_active_layout_get(win->workspace_hook);
+  bScreen *screen = active ? BKE_workspace_layout_screen_get(active) : nullptr;
+  if (!screen || screen->state != SCREENNORMAL || screen->temp ||
+      BKE_screen_is_fullscreen_area(screen)) {
+    return nullptr;
+  }
+
+  WorkSpaceLayout *checkpoint = ED_workspace_layout_duplicate(bmain, workspace, active, win);
+  if (!checkpoint) {
+    return nullptr;
+  }
+  bScreen *checkpoint_screen = BKE_workspace_layout_screen_get(checkpoint);
+  checkpoint_screen->flag |= screen_ipad_layout_checkpoint;
+  const std::string checkpoint_name = layout_unique_name(workspace, name);
+  BKE_workspace_layout_name_set(workspace, checkpoint, checkpoint_name.c_str());
+  return checkpoint;
+}
+
+void ED_ipad_panels_layout_history_menu(bContext *C, uiLayout *layout)
+{
+  WorkSpace *workspace = CTX_wm_workspace(C);
+  if (!workspace) {
+    return;
+  }
+
+  bool found = false;
+  LISTBASE_FOREACH (WorkSpaceLayout *, checkpoint, &workspace->layouts) {
+    if (!layout_is_checkpoint(checkpoint)) {
+      continue;
+    }
+    found = true;
+    bScreen *screen = BKE_workspace_layout_screen_get(checkpoint);
+    const std::string name = BKE_workspace_layout_name_get(checkpoint);
+    const std::string restore_label = "Restore " + name;
+    PointerRNA restore = layout->op("SCREEN_OT_ipad_layout_restore",
+                                    restore_label.c_str(),
+                                    ICON_LOOP_BACK,
+                                    blender::wm::OpCallContext::ExecDefault,
+                                    UI_ITEM_NONE);
+    RNA_string_set(&restore, "screen_id", screen->id.name);
+
+    const std::string remove_label = "Remove " + name;
+    PointerRNA remove = layout->op("SCREEN_OT_ipad_layout_remove",
+                                   remove_label.c_str(),
+                                   ICON_X,
+                                   blender::wm::OpCallContext::ExecDefault,
+                                   UI_ITEM_NONE);
+    RNA_string_set(&remove, "screen_id", screen->id.name);
+  }
+
+  if (!found) {
+    layout->label("No saved layouts yet", ICON_INFO);
+  }
+}
+
+static wmOperatorStatus layout_save_exec(bContext *C, wmOperator * /*op*/)
+{
+  WorkSpace *workspace = CTX_wm_workspace(C);
+  if (!workspace) {
+    return OPERATOR_CANCELLED;
+  }
+
+  int number = 1;
+  std::string name;
+  bool name_used;
+  do {
+    name = "Saved Layout " + std::to_string(number++);
+    name_used = false;
+    LISTBASE_FOREACH (WorkSpaceLayout *, layout, &workspace->layouts) {
+      if (name == BKE_workspace_layout_name_get(layout)) {
+        name_used = true;
+        break;
+      }
+    }
+  } while (name_used);
+
+  if (!ED_ipad_panels_layout_checkpoint_capture(C, name.c_str())) {
+    return OPERATOR_CANCELLED;
+  }
+  WM_event_add_notifier(C, NC_SCREEN | NA_EDITED, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+static wmOperatorStatus layout_restore_exec(bContext *C, wmOperator *op)
+{
+  WorkSpace *workspace = CTX_wm_workspace(C);
+  wmWindow *win = CTX_wm_window(C);
+  if (!workspace || !win || !win->workspace_hook) {
+    return OPERATOR_CANCELLED;
+  }
+
+  char screen_id[sizeof(((bScreen *)nullptr)->id.name)] = {};
+  RNA_string_get(op->ptr, "screen_id", screen_id);
+  WorkSpaceLayout *checkpoint = layout_find_checkpoint(workspace, screen_id);
+  WorkSpaceLayout *outgoing = BKE_workspace_active_layout_get(win->workspace_hook);
+  if (!checkpoint || !outgoing || checkpoint == outgoing) {
+    return OPERATOR_CANCELLED;
+  }
+
+  bScreen *outgoing_screen = BKE_workspace_layout_screen_get(outgoing);
+  bScreen *checkpoint_screen = BKE_workspace_layout_screen_get(checkpoint);
+  if (!ED_screen_change(C, checkpoint_screen)) {
+    return OPERATOR_CANCELLED;
+  }
+
+  bScreen *active_screen = CTX_wm_screen(C);
+  if (outgoing_screen && outgoing_screen != active_screen) {
+    outgoing_screen->flag |= screen_ipad_layout_checkpoint;
+    const std::string outgoing_name = layout_unique_name(workspace, "Before Restore");
+    BKE_workspace_layout_name_set(workspace, outgoing, outgoing_name.c_str());
+  }
+  WM_event_add_notifier(C, NC_SCREEN | NA_EDITED, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+static wmOperatorStatus layout_remove_exec(bContext *C, wmOperator *op)
+{
+  Main *bmain = CTX_data_main(C);
+  WorkSpace *workspace = CTX_wm_workspace(C);
+  if (!bmain || !workspace) {
+    return OPERATOR_CANCELLED;
+  }
+
+  char screen_id[sizeof(((bScreen *)nullptr)->id.name)] = {};
+  RNA_string_get(op->ptr, "screen_id", screen_id);
+  WorkSpaceLayout *checkpoint = layout_find_checkpoint(workspace, screen_id);
+  if (!checkpoint) {
+    return OPERATOR_CANCELLED;
+  }
+  if (layout_checkpoint_referenced(bmain, workspace, checkpoint)) {
+    BKE_report(op->reports, RPT_WARNING, "This saved layout is still in use");
+    return OPERATOR_CANCELLED;
+  }
+
+  BKE_workspace_layout_remove(bmain, workspace, checkpoint);
+  WM_event_add_notifier(C, NC_SCREEN | NA_EDITED, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+void SCREEN_OT_ipad_layout_save(wmOperatorType *ot)
+{
+  ot->name = "Save iPad Layout";
+  ot->idname = "SCREEN_OT_ipad_layout_save";
+  ot->description = "Keep a recoverable copy of this editor layout";
+  ot->exec = layout_save_exec;
+  ot->flag = OPTYPE_INTERNAL;
+}
+
+void SCREEN_OT_ipad_layout_restore(wmOperatorType *ot)
+{
+  ot->name = "Restore iPad Layout";
+  ot->idname = "SCREEN_OT_ipad_layout_restore";
+  ot->description = "Restore editor arrangement while keeping the current arrangement recoverable";
+  ot->exec = layout_restore_exec;
+  ot->flag = OPTYPE_INTERNAL;
+  RNA_def_string(ot->srna, "screen_id", nullptr, 0, "Saved Layout", "Checkpoint screen identity");
+}
+
+void SCREEN_OT_ipad_layout_remove(wmOperatorType *ot)
+{
+  ot->name = "Remove iPad Layout";
+  ot->idname = "SCREEN_OT_ipad_layout_remove";
+  ot->description = "Remove an unused saved editor layout";
+  ot->exec = layout_remove_exec;
+  ot->flag = OPTYPE_INTERNAL;
+  RNA_def_string(ot->srna, "screen_id", nullptr, 0, "Saved Layout", "Checkpoint screen identity");
+}
+
+#endif
