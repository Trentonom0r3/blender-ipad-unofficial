diff --git a/source/blender/windowmanager/intern/wm_ipad_portable_write.hh b/source/blender/windowmanager/intern/wm_ipad_portable_write.hh
new file mode 100644
--- /dev/null
+++ b/source/blender/windowmanager/intern/wm_ipad_portable_write.hh
@@ -0,0 +1,104 @@
+/* SPDX-FileCopyrightText: 2026 Blender iPad Contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <limits>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace blender::wm::ipad {
+
+/** Synchronous writer-only replacement. The caller owns a live path buffer. */
+struct PortablePathRedirect {
+  char *path;
+  size_t capacity;
+  std::string replacement;
+};
+
+/**
+ * Validate every replacement before touching any buffer and restore all paths
+ * before the writer's caller runs save callbacks. Never retain this scope across
+ * an asynchronous operation or a change of Main.
+ */
+class PortablePathScope {
+ private:
+  std::vector<PortablePathRedirect> redirects_;
+  std::vector<std::string> originals_;
+  bool applied_ = false;
+
+ public:
+  explicit PortablePathScope(std::vector<PortablePathRedirect> redirects)
+      : redirects_(std::move(redirects))
+  {
+  }
+
+  PortablePathScope(const PortablePathScope &) = delete;
+  PortablePathScope &operator=(const PortablePathScope &) = delete;
+  PortablePathScope(PortablePathScope &&) = delete;
+  PortablePathScope &operator=(PortablePathScope &&) = delete;
+
+  ~PortablePathScope()
+  {
+    restore();
+  }
+
+  bool apply()
+  {
+    if (applied_) {
+      return false;
+    }
+    originals_.clear();
+    originals_.reserve(redirects_.size());
+    for (size_t i = 0; i < redirects_.size(); i++) {
+      const PortablePathRedirect &item = redirects_[i];
+      if (!item.path || item.capacity == 0 || item.replacement.size() >= item.capacity ||
+          item.replacement.find('\0') != std::string::npos)
+      {
+        return false;
+      }
+      const std::uintptr_t begin = reinterpret_cast<std::uintptr_t>(item.path);
+      if (item.capacity > std::numeric_limits<std::uintptr_t>::max() - begin) {
+        return false;
+      }
+      const std::uintptr_t end = begin + item.capacity;
+      for (size_t j = 0; j < i; j++) {
+        const PortablePathRedirect &prior = redirects_[j];
+        const std::uintptr_t prior_begin = reinterpret_cast<std::uintptr_t>(prior.path);
+        const std::uintptr_t prior_end = prior_begin + prior.capacity;
+        if (begin < prior_end && prior_begin < end) {
+          return false;
+        }
+      }
+      const char *terminator = static_cast<const char *>(std::memchr(item.path, '\0', item.capacity));
+      if (!terminator) {
+        return false;
+      }
+      originals_.emplace_back(item.path, size_t(terminator - item.path));
+    }
+    for (const PortablePathRedirect &item : redirects_) {
+      std::memcpy(item.path, item.replacement.c_str(), item.replacement.size() + 1);
+    }
+    applied_ = true;
+    return true;
+  }
+
+  void restore()
+  {
+    if (!applied_) {
+      return;
+    }
+    for (size_t i = 0; i < redirects_.size(); i++) {
+      std::memcpy(redirects_[i].path, originals_[i].c_str(), originals_[i].size() + 1);
+    }
+    applied_ = false;
+  }
+};
+
+}  // namespace blender::wm::ipad
