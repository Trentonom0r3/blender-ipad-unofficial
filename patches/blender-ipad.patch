+static wmOperatorType *ui_ipad_operator_type_live(const uint64_t address)
+{
+  if (!address) return nullptr;
+  for (wmOperatorType *type : WM_operatortypes_registered_get()) {
+    if (uint64_t(reinterpret_cast<uintptr_t>(type)) == address) return type;
+  }
+  return nullptr;
+}
+
+static uiIPadOperatorReceipt ui_ipad_operator_capture(const wmOperatorType *type)
+{
+  uiIPadOperatorReceipt receipt;
+  wmOperatorType *live = ui_ipad_operator_type_live(uint64_t(reinterpret_cast<uintptr_t>(type)));
+  if (!live || !live->ipad_lifetime_id || !live->idname || !live->srna) return receipt;
+  receipt.address = uint64_t(reinterpret_cast<uintptr_t>(live));
+  receipt.lifetime = live->ipad_lifetime_id;
+  receipt.srna_address = uint64_t(reinterpret_cast<uintptr_t>(live->srna));
+  receipt.name = live->idname;
+  return receipt;
+}
+
+static wmOperatorType *ui_ipad_operator_resolve(const uiIPadOperatorReceipt &receipt)
+{
+  if (!receipt.lifetime || receipt.name.empty()) return nullptr;
+  wmOperatorType *live = ui_ipad_operator_type_live(receipt.address);
+  if (!live || live->ipad_lifetime_id != receipt.lifetime || !live->idname ||
+      uint64_t(reinterpret_cast<uintptr_t>(live->srna)) != receipt.srna_address ||
+      receipt.name != live->idname) return nullptr;
+  return live;
+}
