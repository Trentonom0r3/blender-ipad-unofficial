+void ED_ipad_editing_canvas_parts(bContext * /*C*/, ARegion *region, std::vector<rcti> &rects)
+{
+  const rcti &r = region->runtime->ipad_canvas_rect;
+  rcti shelf = region->runtime->ipad_editing_shelf_presented_rect, clipped;
+  BLI_rcti_translate(&shelf, -region->winrct.xmin, -region->winrct.ymin);
+  const bool has_shelf = region->runtime->ipad_editing_shelf_presented &&
+                        BLI_rcti_isect(&r, &shelf, &clipped);
+  for (const Rect &part : policy::editing_canvas_parts(
+           {r.xmin, r.ymin, r.xmax + 1, r.ymax + 1},
+           has_shelf ? Rect{clipped.xmin, clipped.ymin, clipped.xmax + 1, clipped.ymax + 1} : Rect{}))
+  {
+    rcti part_rect = to_rect(part);
+    BLI_rcti_translate(&part_rect, region->winrct.xmin, region->winrct.ymin);
+    rects.push_back(part_rect);
+  }
+}
