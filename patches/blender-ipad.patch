+
+bool UI_ipad_numbers_type_retire(Main *main, wmOperatorType *ot)
+{
+  if (std::find(ui_ipad_numbers_type_guards.begin(), ui_ipad_numbers_type_guards.end(),
+                uintptr_t(ot)) != ui_ipad_numbers_type_guards.end()) return false;
+  if (!main || WM_operatortype_find("VIEW3D_OT_ipad_transform_numbers", true) != ot) return true;
+  const uintptr_t type_address = uintptr_t(ot);
+  StructRNA *self_type = ot->rna_ext.srna, *properties_type = ot->srna;
+  for (;;) {
+    wmWindowManager *owner_wm = nullptr;
+    wmWindow *owner_win = nullptr;
+    uiPopupBlockHandle *owner = nullptr;
+    LISTBASE_FOREACH (wmWindowManager *, wm, &main->wm) {
+      LISTBASE_FOREACH (wmWindow *, win, &wm->windows) {
+        LISTBASE_FOREACH (wmEventHandler *, base, &win->modalhandlers) {
+          /* A DO_FREE handler still owns its pending storage until onfree.
+           * Disposal must include it even though semantic lookup refuses it. */
+          if (base->type != WM_HANDLER_TYPE_UI) continue;
+          auto *handler = reinterpret_cast<wmEventHandler_UI *>(base);
+          if (handler->handle_fn != ui_popup_handler || handler->remove_fn != ui_popup_handler_remove ||
+              !handler->user_data) continue;
+          auto *handle = static_cast<uiPopupBlockHandle *>(handler->user_data);
+          if (handle->ipad_numbers_type == type_address && handle->ipad_numbers_dispose) {
+            owner_wm = wm;owner_win = win;owner = handle;break;
+          }
+        }
+        if (owner) break;
+      }
+      if (owner) break;
+    }
+    if (!owner) {
+      /* Onfree may have detached the UI while native removal still held its
+       * handler frame. Consume its deferred owner before metadata removal. */
+      const auto pending = std::find_if(ui_ipad_numbers_disposals.begin(), ui_ipad_numbers_disposals.end(),
+                                       [&](const uiIPadNumbersDisposal &value) { return value.type == type_address; });
+      if (pending == ui_ipad_numbers_disposals.end()) return true;
+      const uiIPadNumbersDisposal owned = *pending;
+      ui_ipad_numbers_disposals.erase(pending);
+      const uiIPadNumbersTypeGuard type_guard(type_address);
+      owned.dispose(owned.arg);
+      if (G_MAIN != main || WM_operatortype_find("VIEW3D_OT_ipad_transform_numbers", true) != ot)
+        return false;
+      if (ot->rna_ext.srna != self_type || ot->srna != properties_type) return false;
+      continue;
+    }
+    const uiFreeArgFunc dispose = owner->ipad_numbers_dispose;
+    void *arg = owner->ipad_numbers_dispose_arg;
+    ui_ipad_popup_operator_retire(owner);
+    const uiIPadNumbersTypeGuard type_guard(type_address);
+    if (!type_guard.valid()) return false;
+    bContext *C = CTX_create();
+    CTX_data_main_set(C, main);CTX_wm_manager_set(C, owner_wm);CTX_wm_window_set(C, owner_win);
+    /* Native handler removal here does not call Cancel. Onfree button teardown
+     * is non-semantic; detached ownership is consumed once after block cleanup. */
+    UI_popup_handlers_remove(&owner_win->modalhandlers, owner);
+    ui_popup_block_free(C, owner);
+    CTX_free(C);
+    dispose(arg);
+    /* Python finalizers can change Main/registry. Restart from fresh lists;
+     * never retain an iterator or operator metadata across disposal. */
+    if (G_MAIN != main || WM_operatortype_find("VIEW3D_OT_ipad_transform_numbers", true) != ot)
+      return false;
+    if (ot->rna_ext.srna != self_type || ot->srna != properties_type) return false;
+  }
+}
