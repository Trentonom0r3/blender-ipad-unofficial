diff --git a/scripts/startup/bl_ui/space_view3d_ipad.py b/scripts/startup/bl_ui/space_view3d_ipad.py
new file mode 100644
--- /dev/null
+++ b/scripts/startup/bl_ui/space_view3d_ipad.py
@@ -0,0 +1,227 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compact iPad viewport controls built entirely from existing Blender operators."""
+
+import bpy
+from bpy.types import Menu, Operator, Panel
+from bl_ui.space_toolsystem_common import ToolSelectPanelHelper
+
+
+# Clockwise from the top. Add Cube activates the existing interactive tool.
+IPAD_RADIAL_TOOLS = (
+    ("Select", 'builtin.select_box', 'RESTRICT_SELECT_OFF'),
+    ("Cursor", 'builtin.cursor', 'PIVOT_CURSOR'),
+    ("Move", 'builtin.move', 'EMPTY_ARROWS'),
+    ("Rotate", 'builtin.rotate', 'DRIVER_ROTATIONAL_DIFFERENCE'),
+    ("Scale", 'builtin.scale', 'ARROW_LEFTRIGHT'),
+    ("Transform", 'builtin.transform', 'ORIENTATION_GIMBAL'),
+    ("Annotate", 'builtin.annotate', 'GREASEPENCIL'),
+    ("Measure", 'builtin.measure', 'DRIVER_DISTANCE'),
+    ("Add Cube", 'builtin.primitive_cube_add', 'MESH_CUBE'),
+)
+
+
+class WM_OT_ipad_tool_palette(Operator):
+    bl_idname = "wm.ipad_tool_palette"
+    bl_label = "Pencil Tools"
+    bl_description = "Open the radial tool palette for the 3D viewport"
+
+    @classmethod
+    def poll(cls, context):
+        return context.window is not None and any(
+            area.type == 'VIEW_3D' for area in context.window.screen.areas)
+
+    def invoke(self, context, event):
+        views = [area for area in context.window.screen.areas if area.type == 'VIEW_3D']
+        area = next((area for area in views
+                     if area.x <= event.mouse_x < area.x + area.width
+                     and area.y <= event.mouse_y < area.y + area.height), None)
+        if area is None:
+            area = context.area if context.area in views else max(views, key=lambda a: a.width * a.height)
+        region = next((r for r in area.regions if r.type == 'WINDOW'), None)
+        if region is None:
+            return {'CANCELLED'}
+        with context.temp_override(area=area, region=region):
+            bpy.ops.wm.call_menu_pie('INVOKE_DEFAULT', name='VIEW3D_MT_ipad_tools')
+        return {'FINISHED'}
+
+
+class VIEW3D_MT_ipad_tools(Menu):
+    bl_label = "Pencil Tools"
+
+    @classmethod
+    def poll(cls, context):
+        return context.area is not None and context.area.type == 'VIEW_3D'
+
+    def draw(self, context):
+        # Ten ordinary buttons. The iPad popup positions nine around a ring and
+        # Settings at its center; desktop pie directions remain unchanged.
+        layout = self.layout.column()
+        layout.operator_context = 'INVOKE_REGION_WIN'
+        cls = ToolSelectPanelHelper._tool_class_from_space_type('VIEW_3D')
+        available = {tool.idname: tool for tool in cls._tools_flatten_with_dynamic(
+            cls.tools_from_context(context), context=context) if tool is not None}
+        active = ToolSelectPanelHelper.tool_active_from_context(context)
+        active_id = active.idname if active else None
+        for label, name, fallback_icon in IPAD_RADIAL_TOOLS:
+            slot = layout.row()
+            tool = available.get(name)
+            slot.enabled = tool is not None
+            icon_val = 0
+            if tool and getattr(tool, "icon", None):
+                try:
+                    icon_val = ToolSelectPanelHelper._icon_value_from_icon_handle(tool.icon)
+                except Exception:
+                    icon_val = 0
+            if icon_val:
+                slot.operator('wm.tool_set_by_id', text=label, icon_value=icon_val,
+                              depress=active_id == name).name = name
+            else:
+                slot.operator('wm.tool_set_by_id', text=label, icon=fallback_icon,
+                              depress=active_id == name).name = name
+
+
+class VIEW3D_OT_ipad_flythrough_toggle(Operator):
+    bl_idname = "view3d.ipad_flythrough_toggle"
+    bl_label = "Flythrough Mode"
+    bl_description = "Toggle Flythrough navigation: 1-finger look around, 2-finger fly through, 3-finger pan"
+
+    def execute(self, context):
+        wm = context.window_manager
+        current = getattr(wm, "ipad_flythrough_active", False)
+        wm.ipad_flythrough_active = not current
+        if "ipad_flythrough_toggle" in dir(bpy.ops.wm):
+            bpy.ops.wm.ipad_flythrough_toggle()
+        for area in context.window.screen.areas:
+            if area.type == 'VIEW_3D':
+                area.tag_redraw()
+        return {'FINISHED'}
+
+
+class VIEW3D_MT_ipad_tool_settings(Menu):
+    bl_label = "Tool Settings"
+
+    def draw(self, context):
+        layout = self.layout
+        layout.scale_y = 2.2
+        layout.operator_context = 'INVOKE_REGION_WIN'
+        layout.operator('wm.context_toggle', text="Hide Tool Shelf" if context.space_data.show_region_toolbar else "Show Tool Shelf",
+                        icon='MENU_PANEL').data_path = 'space_data.show_region_toolbar'
+
+
+class VIEW3D_PT_ipad_controls(Panel):
+    bl_label = "Workspace Controls"
+    bl_space_type = 'VIEW_3D'
+    bl_region_type = 'HEADER'
+    bl_ui_units_x = 18
+
+    def draw(self, context):
+        layout = self.layout
+        layout.operator_context = 'INVOKE_REGION_WIN'
+        # Capability check also keeps host previews usable without the iOS backend.
+        import bpy
+        # Query the operator registry: bpy.types does not expose native C++ operators.
+        if "import_project_from_files" in dir(bpy.ops.wm):
+            project = layout.column(align=True)
+            project.scale_y = 1.6
+            project.operator('wm.open_mainfile', text="Open Project", icon='FILE_FOLDER')
+            project.operator('wm.save_mainfile', text="Save Project", icon='FILE_TICK')
+            layout.separator()
+
+        portrait = context.window.height > context.window.width
+        columns = 1 if portrait else 2
+
+        navigation = layout.grid_flow(row_major=True, columns=columns,
+                                      even_columns=True, even_rows=True, align=True)
+        navigation.scale_y = 1.8
+        navigation.operator('view3d.view_selected', text="Frame Selection", icon='ZOOM_SELECTED')
+        navigation.operator('view3d.view_all', text="Frame Scene", icon='HOME')
+        camera = navigation.column(align=True)
+        camera.enabled = context.scene.camera is not None
+        camera.operator('view3d.view_camera', text="Camera View", icon='VIEW_CAMERA')
+        navigation.operator('screen.screen_full_area', text="Restore Editors" if context.screen.show_fullscreen else "Expand Canvas", icon='FULLSCREEN_ENTER')
+
+        is_fly = getattr(context.window_manager, "ipad_flythrough_active", False)
+        fly_row = layout.row(align=True)
+        fly_row.scale_y = 1.8
+        fly_row.operator('view3d.ipad_flythrough_toggle',
+                         text="Exit Flythrough Mode" if is_fly else "Enter Flythrough Mode",
+                         icon='CAMERA_STEREO',
+                         depress=is_fly)
+
+        layout.separator()
+        edit = layout.row(align=True)
+        edit.scale_y = 1.8
+        edit.operator('ed.undo', text="Undo", icon='LOOP_BACK')
+        edit.operator('ed.redo', text="Redo", icon='LOOP_FORWARDS')
+
+        layout.separator()
+        chrome = layout.row(align=True)
+        chrome.scale_y = 1.6
+        chrome.prop(context.space_data, 'show_region_toolbar', text="Tools", toggle=True)
+        chrome.prop(context.space_data, 'show_region_ui', text="Sidebar", toggle=True)
+        if hasattr(context.space_data, 'show_region_asset_shelf'):
+            shelf = layout.row()
+            shelf.scale_y = 1.6
+            shelf.prop(context.space_data, 'show_region_asset_shelf', text="Asset Shelf", toggle=True)
+
+        # Quick tools supplement the complete tool shelf and operator search.
+        # Never replace menus or change the user's saved workspace layout here.
+        search = layout.row()
+        search.scale_y = 1.6
+        search.operator('wm.search_menu', text="Search All Commands", icon='VIEWZOOM')
+
+        layout.separator()
+        playback = layout.row(align=True)
+        playback.scale_y = 1.6
+        playback.operator('screen.frame_jump', text="Start").end = False
+        playback.operator('screen.frame_offset', text="-1").delta = -1
+        playback.operator('screen.animation_play', text="Play / Pause", icon='PLAY')
+        playback.operator('screen.frame_offset', text="+1").delta = 1
+        playback.operator('screen.frame_jump', text="End").end = True
+        playback_box = layout.row(align=True)
+        playback_box.scale_y = 1.6
+        playback_box.prop(context.scene, 'frame_current', text="Frame")
+        if context.scene.camera:
+            camera = layout.column(align=True)
+            camera.scale_y = 1.6
+            camera.prop(context.scene.camera.data, 'lens', text="Camera Lens")
+            camera.operator('view3d.camera_to_view', text="Align Camera to View", icon='CON_CAMERASOLVER')
+
+
+def draw_canvas_header(layout):
+    row = layout.row(align=True)
+    row.scale_x = 1.2
+    space = bpy.context.space_data
+
+    # Flythrough Mode toggle
+    wm = bpy.context.window_manager
+    is_fly = getattr(wm, "ipad_flythrough_active", False)
+    fly_btn = row.row(align=True)
+    fly_btn.scale_x = 1.2
+    fly_btn.operator(
+        "view3d.ipad_flythrough_toggle",
+        text="Flythrough [ON]" if is_fly else "Flythrough",
+        icon='CAMERA_STEREO',
+        depress=is_fly,
+    )
+
+
+# This module is installed by the iOS-only overlay. Do not gate registration on
+# binary_path: embedded Python's executable path is not a platform capability.
+classes = (
+    WM_OT_ipad_tool_palette,
+    VIEW3D_MT_ipad_tools,
+    VIEW3D_MT_ipad_tool_settings,
+    VIEW3D_PT_ipad_controls,
+    VIEW3D_OT_ipad_flythrough_toggle,
+)
+
+if not hasattr(bpy.types.WindowManager, "ipad_flythrough_active"):
+    bpy.types.WindowManager.ipad_flythrough_active = bpy.props.BoolProperty(
+        name="Flythrough Active",
+        description="Enable flythrough navigation mode",
+        default=False,
+    )
+
+
+# Native screen presentation now owns startup, workspace switching and panel visibility.
