 {
   /* identifiers */
   ot->name = "Repeat Last";
   ot->description = "Repeat last action";
   ot->idname = "SCREEN_OT_repeat_last";
 
   /* API callbacks. */
   ot->exec = repeat_last_exec;
 
   ot->poll = repeat_history_poll;
 }
 
