+static rcti to_rect(const Rect &rect)
+{
+  return {rect.xmin, std::max(rect.xmin, rect.xmax - 1),
+          rect.ymin, std::max(rect.ymin, rect.ymax - 1)};
+}
+
+static bool contains(const Rect &rect, const int xy[2])
+{
+  return xy[0] >= rect.xmin && xy[0] < rect.xmax && xy[1] >= rect.ymin && xy[1] < rect.ymax;
+}
+
+static const Tab *find_tab(const Model &model, int id)
+{
+  for (const Tab &tab : model.tabs) {
+    if (tab.id == id) {
+      return &tab;
+    }
+  }
+  return nullptr;
+}
+
+static std::string area_label(const ScrArea *area)
+{
+  if (area->spacetype == SPACE_OUTLINER) {
+    const auto *outliner = static_cast<const SpaceOutliner *>(area->spacedata.first);
+    return outliner && outliner->outlinevis == SO_DATA_API ? "Data" : "Scene";
+  }
+  if (area->spacetype == SPACE_PROPERTIES) {
+    return "Inspector";
+  }
+  if (area->spacetype == SPACE_ACTION) {
+    const SpaceAction *saction = static_cast<const SpaceAction *>(area->spacedata.first);
+    return saction && saction->mode == SACTCONT_TIMELINE ? "Timeline" : "Dope Sheet";
+  }
+  if (area->spacetype == SPACE_NODE) {
+    const auto *node = static_cast<const SpaceNode *>(area->spacedata.first);
+    if (node) {
+      if (STREQ(node->tree_idname, "GeometryNodeTree")) {
+        return "Geometry Nodes";
+      }
+      if (STREQ(node->tree_idname, "ShaderNodeTree")) {
+        return "Shader Editor";
+      }
+      if (STREQ(node->tree_idname, "CompositorNodeTree")) {
+        return "Compositor";
+      }
+    }
+  }
+  if (area->spacetype == SPACE_CLIP) {
+    const auto *clip = static_cast<const SpaceClip *>(area->spacedata.first);
+    if (clip) {
+      return clip->view == SC_VIEW_GRAPH ? "Tracking Graph" :
+             clip->view == SC_VIEW_DOPESHEET ? "Tracking Dopesheet" : "Footage";
+    }
+  }
+  if (area->spacetype == SPACE_SEQ) {
+    const auto *sequence = static_cast<const SpaceSeq *>(area->spacedata.first);
+    return sequence && sequence->view == SEQ_VIEW_PREVIEW ? "Preview" : "Sequencer";
+  }
+  return area->type ? area->type->name : "Editor";
+}
+
+static policy::Metrics panel_metrics(const ScrArea *owner, const ScrArea *side_editor = nullptr)
+{
+  policy::Metrics metrics;
+  const float scale = UI_SCALE_FAC;
+  metrics.inset = int(6 * scale);
+  metrics.gap = int(6 * scale);
+  metrics.side_rail_extent = int(44 * scale);
+  metrics.minimum_side_rail_extent = int(28 * scale);
+  metrics.bottom_rail = false;
+  const ARegion *tools = owner ? BKE_area_find_region_type(owner, RGN_TYPE_TOOLS) : nullptr;
+  metrics.tools_width = int((tools && tools->runtime->type ?
+                                tools->runtime->type->prefsizex : 40) * scale);
+  metrics.resize_extent = int(24 * scale);
+  metrics.corner_extent = int(44 * scale);
+  /* Inspector includes its native header, the labeled selector and corner chrome.
+   * Keep useful native content below them without enlarging other side editors. */
+  metrics.minimum_side_height = int((side_editor && side_editor->spacetype == SPACE_PROPERTIES ?
+                                        220 : 120) * scale);
+  metrics.minimum_canvas_width = int(160 * scale);
+  metrics.minimum_canvas_height = int(120 * scale);
+  const bool inspector = side_editor && side_editor->spacetype == SPACE_PROPERTIES;
+  metrics.minimum_side_width = int((inspector ? 280 : 180) * scale);
+  metrics.automatic_side_percent = inspector ? 35 : 45;
+  metrics.minimum_bottom_height = int(140 * scale);
+  metrics.minimum_bottom_width = int(320 * scale);
+  return metrics;
+}
+
+static bool inspector_side(const ScrArea *area)
+{
+  return area && area->spacetype == SPACE_PROPERTIES;
+}
