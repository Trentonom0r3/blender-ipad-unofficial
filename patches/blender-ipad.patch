+#ifdef WITH_APPLE_CROSSPLATFORM
+void UI_ipad_stroke_cue_draw(const bContext *C, ARegion *region,
+                            const uint64_t context[13], const char *status)
+{
+  /* The existing capture API only synchronizes native ViewLayer data; it never
+   * changes the bContext. Keep the draw callback's const context contract. */
+  bContext *context_read = const_cast<bContext *>(C);
+  if (!status || CTX_wm_region(C) != region ||
+      !UI_ipad_context_matches(context_read, context)) return;
+  const char *lines[3] = {status, IFACE_("Lift to apply"), IFACE_("Two-finger drag to cancel")};
+  const uiFontStyle *font = &UI_style_get_dpi()->widget;
+  std::array<float, 3> widths;
+  for (int i = 0; i < 3; ++i) widths[i] = float(UI_fontstyle_string_width(font, lines[i]));
+  const auto geometry = ipad_ring::stroke_cue_layout(UI_UNIT_X, ui_ipad_ring_viewport(context_read), widths);
+  if (!geometry.fits) return;
+  const auto local_rect = [&](const ipad_ring::Rect &r) {
+    return rctf{r.xmin - region->winrct.xmin, r.xmax - region->winrct.xmin,
+                r.ymin - region->winrct.ymin, r.ymax - region->winrct.ymin};
+  };
+  rctf box = local_rect(geometry.bounds);
+  float background[4];
+  UI_GetThemeColor4fv(TH_PANEL_BACK, background);
+  background[3] = 0.96f;
+  GPU_blend(GPU_BLEND_ALPHA);
+  UI_draw_roundbox_corner_set(UI_CNR_ALL);
+  UI_draw_roundbox_4fv(&box, true, 0.6f * UI_UNIT_X, background);
+  uchar color[4];
+  UI_GetThemeColor4ubv(TH_TEXT, color);
+  const uiFontStyleDraw_Params params = {UI_STYLE_TEXT_CENTER, false};
+  for (int i = 0; i < 3; ++i) {
+    const rctf row = local_rect(geometry.lines[i]);
+    const rcti clip = {int(row.xmin), int(row.xmax), int(row.ymin), int(row.ymax)};
+    UI_fontstyle_draw(font, &clip, lines[i], std::strlen(lines[i]), color, &params);
+  }
+  GPU_blend(GPU_BLEND_NONE);
+}
+#endif
