+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "BKE_undo_system.hh"
+
+#ifdef WITH_APPLE_CROSSPLATFORM
+/* Values only: never retain an UndoStep pointer across a native decode. */
+struct UndoTouchReceipt {
+  uint64_t stack_id = 0;
+  uint64_t generation = 0;
+  uint64_t accepted_id = 0;
+  uint64_t baseline_id = 0;
+};
+
+inline bool BKE_undosys_touch_capture(const UndoStack *stack, UndoTouchReceipt &receipt)
+{
+  receipt = {};
+  if (!stack || !stack->ipad_lifetime_id || stack->step_init || stack->group_level ||
+      !stack->step_active || stack->step_active->skip) {
+    return false;
+  }
+  receipt.stack_id = stack->ipad_lifetime_id;
+  receipt.generation = stack->ipad_mutation_generation;
+  receipt.accepted_id = stack->step_active->ipad_lifetime_id;
+  return receipt.accepted_id != 0;
+}
+
+inline bool BKE_undosys_touch_target(const UndoStack *stack, const UndoTouchReceipt &receipt)
+{
+  if (!stack || stack->ipad_lifetime_id != receipt.stack_id || stack->step_init ||
+      stack->group_level || !stack->step_active || stack->step_active->skip ||
+      stack->step_active->ipad_lifetime_id != receipt.baseline_id) {
+    return false;
+  }
+  const UndoStep *target = stack->step_active->next;
+  while (target && target->skip) {
+    target = target->next;
+  }
+  return target && target->ipad_lifetime_id == receipt.accepted_id;
+}
+
+inline bool BKE_undosys_touch_seal(const UndoStack *stack, UndoTouchReceipt &receipt)
+{
+  if (!stack || !stack->step_active) {
+    return false;
+  }
+  receipt.baseline_id = stack->step_active->ipad_lifetime_id;
+  receipt.generation = stack->ipad_mutation_generation;
+  return receipt.baseline_id != receipt.accepted_id && BKE_undosys_touch_target(stack, receipt);
+}
+
+inline bool BKE_undosys_touch_validate(const UndoStack *stack, const UndoTouchReceipt &receipt)
+{
+  return stack && stack->ipad_mutation_generation == receipt.generation &&
+         BKE_undosys_touch_target(stack, receipt);
+}
+#endif
