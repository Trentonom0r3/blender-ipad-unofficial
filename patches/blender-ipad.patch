   /* Prevent rounding errors for UI_SCALE_FAC multiply and divide. */
   if (region->winx > 1) {
     region->sizex = (region->winx + 0.5f) / UI_SCALE_FAC;
   }
   if (region->winy > 1) {
     region->sizey = (region->winy + 0.5f) / UI_SCALE_FAC;
   }
 
