@@ -0,0 +1,870 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** iPad presentation of existing workspace editors. Saved ScrVerts are never modified. */
+#ifdef WITH_APPLE_CROSSPLATFORM
+
+#include <algorithm>
+#include <climits>
+#include <cmath>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "MEM_guardedalloc.h"
+#include "DNA_action_types.h"
+#include "DNA_screen_types.h"
+#include "DNA_space_types.h"
+#include "DNA_userdef_types.h"
+#include "BLI_listbase.h"
+#include "BLI_rect.h"
+#include "BLI_string.h"
+#include "BLI_utildefines.h"
+#include "BLF_api.hh"
+#include "BKE_context.hh"
+#include "BKE_global.hh"
+#include "BKE_screen.hh"
+#include "ED_ipad_panels.hh"
+#include "ED_screen.hh"
+#include "RNA_access.hh"
+#include "RNA_define.hh"
+#include "UI_interface.hh"
+#include "UI_interface_layout.hh"
+#include "UI_resources.hh"
+#include "GPU_state.hh"
+#include "WM_api.hh"
+#include "WM_types.hh"
+#include "wm_event_types.hh"
+
+#include "ipad_workspace_panels.hh"
+
+namespace {
+namespace policy = blender::ed::ipad::panels;
+using policy::Edge;
+using policy::Rect;
+
+constexpr int tools_id = 1000000;
+constexpr int shelf_id = 1000001;
+constexpr int category_first_id = 1000010;
+
+struct Tab {
+  int id;
+  Edge edge;
+  std::string label;
+  ScrArea *area = nullptr;
+  int region_type = 0;
+  std::string category;
+};
+
+struct Model {
+  std::vector<ScrArea *> areas;
+  ScrArea *main = nullptr;
+  std::vector<Tab> tabs;
+  policy::State state;
+  policy::Metrics metrics;
+  policy::Layout layout;
+  Rect bounds;
+};
+
+static rcti to_rect(const Rect &rect)
+{
+  return {rect.xmin, std::max(rect.xmin, rect.xmax - 1),
+          rect.ymin, std::max(rect.ymin, rect.ymax - 1)};
+}
+
+static bool contains(const Rect &rect, const int xy[2])
+{
+  return xy[0] >= rect.xmin && xy[0] < rect.xmax && xy[1] >= rect.ymin && xy[1] < rect.ymax;
+}
+
+static const Tab *find_tab(const Model &model, int id)
+{
+  for (const Tab &tab : model.tabs) {
+    if (tab.id == id) {
+      return &tab;
+    }
+  }
+  return nullptr;
+}
+
+static std::string area_label(const ScrArea *area)
+{
+  if (area->spacetype == SPACE_OUTLINER) {
+    return "Scene";
+  }
+  if (area->spacetype == SPACE_PROPERTIES) {
+    return "Inspector";
+  }
+  if (area->spacetype == SPACE_ACTION) {
+    const SpaceAction *saction = static_cast<const SpaceAction *>(area->spacedata.first);
+    return saction && saction->mode == SACTCONT_TIMELINE ? "Timeline" : "Dope Sheet";
+  }
+  return area->type ? area->type->name : "Editor";
+}
+
+static policy::Metrics panel_metrics()
+{
+  policy::Metrics metrics;
+  const float scale = UI_SCALE_FAC;
+  metrics.inset = int(6 * scale);
+  metrics.gap = int(6 * scale);
+  metrics.side_rail_extent = int(28 * scale);
+  metrics.bottom_rail = false; /* Bottom launchers belong to the native status bar. */
+  metrics.resize_extent = int(24 * scale);
+  metrics.minimum_canvas_width = int(160 * scale);
+  metrics.minimum_canvas_height = int(120 * scale);
+  metrics.minimum_side_width = int(180 * scale);
+  metrics.minimum_bottom_height = int(140 * scale);
+  metrics.minimum_bottom_width = int(320 * scale);
+  return metrics;
+}
+
+static void preferred_sizes(const bScreen *screen, policy::State &state)
+{
+  auto size = [](float value) {
+    return std::isfinite(value) && value > 0 ?
+               int(std::clamp(value, 1.0f, 4000.0f) * UI_SCALE_FAC) : 0;
+  };
+  state.side_width = size(screen->ipad_panel_size[0]);
+  state.bottom_height = size(screen->ipad_panel_size[1]);
+}
+
+static Rect content_bounds(const wmWindow *win, const ScrArea *main)
+{
+  /* Headers and tool headers have already been laid out by Blender. Their count,
+   * alignment and height vary by workspace, mode and user configuration. */
+  const ARegion *region = BKE_area_find_region_type(main, RGN_TYPE_WINDOW);
+  if (region && region->winx > 1 && region->winy > 1) {
+    Rect bounds{region->winrct.xmin, region->winrct.ymin,
+                region->winrct.xmax + 1, region->winrct.ymax + 1};
+    /* An overlapping Sculpt tool header does not reduce WINDOW.winrct. Reserve
+     * its actual edge rectangle too, without querying our panel-aware visible
+     * rectangle (which would feed the previous panel layout back into itself). */
+    LISTBASE_FOREACH (const ARegion *, header, &main->regionbase) {
+      if (!ELEM(header->regiontype, RGN_TYPE_HEADER, RGN_TYPE_TOOL_HEADER, RGN_TYPE_FOOTER) ||
+          (header->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED)) ||
+          header->winx <= 1 || header->winy <= 1)
+      {
+        continue;
+      }
+      const rcti &rect = header->winrct;
+      const int alignment = RGN_ALIGN_ENUM_FROM_MASK(header->alignment);
+      if (rect.xmin < bounds.xmax && rect.xmax >= bounds.xmin) {
+        if (alignment == RGN_ALIGN_TOP && rect.ymax >= bounds.ymax - 2) {
+          bounds.ymax = std::max(bounds.ymin, std::min(bounds.ymax, rect.ymin));
+        }
+        else if (alignment == RGN_ALIGN_BOTTOM && rect.ymin <= bounds.ymin + 1) {
+          bounds.ymin = std::min(bounds.ymax, std::max(bounds.ymin, rect.ymax + 1));
+        }
+      }
+      if (rect.ymin < bounds.ymax && rect.ymax >= bounds.ymin) {
+        if (alignment == RGN_ALIGN_LEFT && rect.xmin <= bounds.xmin + 1) {
+          bounds.xmin = std::min(bounds.xmax, std::max(bounds.xmin, rect.xmax + 1));
+        }
+        else if (alignment == RGN_ALIGN_RIGHT && rect.xmax >= bounds.xmax - 2) {
+          bounds.xmax = std::max(bounds.xmin, std::min(bounds.xmax, rect.xmin));
+        }
+      }
+    }
+    return bounds;
+  }
+  rcti rect;
+  WM_window_screen_rect_calc(win, &rect);
+  return {rect.xmin, rect.ymin, rect.xmax, rect.ymax};
+}
+
+static Model make_model(bContext *C, wmWindow *win)
+{
+  Model model;
+  bScreen *screen = WM_window_get_active_screen(win);
+  std::vector<policy::Area> inputs;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    const int id = int(model.areas.size());
+    model.areas.push_back(area);
+    const bool service = ELEM(area->spacetype, SPACE_OUTLINER, SPACE_PROPERTIES, SPACE_FILE);
+    inputs.push_back({id,
+                      {area->v1->vec.x, area->v1->vec.y,
+                       area->v4->vec.x + 1, area->v2->vec.y + 1},
+                      service ? policy::Role::Service : policy::Role::Content});
+  }
+  const policy::Mapping mapping = policy::classify(inputs, int(2 * UI_SCALE_FAC));
+  if (mapping.primary_id < 0) {
+    return model;
+  }
+  model.main = model.areas[mapping.primary_id];
+  model.bounds = content_bounds(win, model.main);
+
+  ScrArea *previous_area = CTX_wm_area(C);
+  ARegion *previous_region = CTX_wm_region(C);
+  CTX_wm_area_set(C, model.main);
+  ARegion *sidebar = BKE_area_find_region_type(model.main, RGN_TYPE_UI);
+  if (sidebar && !sidebar->runtime->type) {
+    /* File load precedes region type initialization. Preserve a saved category
+     * until Blender can poll its native panels during the first layout. */
+    const std::string category = screen->ipad_panel_active[0] == -1 ?
+                                     screen->ipad_panel_category : "";
+    model.tabs.push_back({category_first_id, Edge::Side,
+                          category.empty() ? "Sidebar" : category,
+                          model.main, RGN_TYPE_UI, category});
+  }
+  if (sidebar && sidebar->runtime->type) {
+    CTX_wm_region_set(C, sidebar);
+    std::vector<std::string> categories;
+    LISTBASE_FOREACH (PanelType *, pt, &sidebar->runtime->type->paneltypes) {
+      if (!pt->category[0] || (pt->poll && !pt->poll(C, pt))) {
+        continue;
+      }
+      if (std::find(categories.begin(), categories.end(), pt->category) == categories.end()) {
+        categories.emplace_back(pt->category);
+        model.tabs.push_back({category_first_id + int(categories.size()), Edge::Side,
+                              pt->category, model.main, RGN_TYPE_UI, pt->category});
+      }
+    }
+    if (categories.empty()) {
+      model.tabs.push_back({category_first_id, Edge::Side, "Sidebar", model.main, RGN_TYPE_UI, ""});
+    }
+  }
+  ARegion *tools = BKE_area_find_region_type(model.main, RGN_TYPE_TOOLS);
+  if (tools && !(tools->flag & RGN_FLAG_POLL_FAILED)) {
+    model.tabs.push_back({tools_id, Edge::Side, "Tools", model.main, RGN_TYPE_TOOLS, ""});
+  }
+  ARegion *shelf = BKE_area_find_region_type(model.main, RGN_TYPE_ASSET_SHELF);
+  if (shelf && !(shelf->flag & RGN_FLAG_POLL_FAILED)) {
+    model.tabs.push_back({shelf_id, Edge::Bottom, "Brushes", model.main, RGN_TYPE_ASSET_SHELF, ""});
+  }
+  CTX_wm_area_set(C, previous_area);
+  CTX_wm_region_set(C, previous_region);
+  for (const policy::Panel &panel : mapping.panels) {
+    ScrArea *area = model.areas[panel.id];
+    model.tabs.push_back({panel.id, panel.edge, area_label(area), area, 0, ""});
+  }
+  for (int axis = 0; axis < 2; axis++) {
+    const Edge edge = axis == 0 ? Edge::Side : Edge::Bottom;
+    for (const Tab &tab : model.tabs) {
+      const int saved = screen->ipad_panel_active[axis];
+      const bool match = tab.region_type == 0 ? saved == tab.id + 1 :
+                         tab.region_type == RGN_TYPE_UI ?
+                             saved == -1 && tab.category == screen->ipad_panel_category :
+                         tab.region_type == RGN_TYPE_TOOLS ? saved == -2 : saved == -3;
+      if (edge == tab.edge && match) {
+        model.state.slot(edge) = {tab.id, bool(screen->ipad_panel_locked[axis])};
+        break;
+      }
+    }
+  }
+  preferred_sizes(screen, model.state);
+  model.metrics = panel_metrics();
+  model.layout = policy::layout(model.bounds, model.state, model.metrics);
+  return model;
+}
+
+static void save_slot(bScreen *screen, const Model &model, Edge edge)
+{
+  const int axis = edge == Edge::Side ? 0 : 1;
+  const policy::Slot &slot = model.state.slot(edge);
+  const Tab *tab = find_tab(model, slot.active_id);
+  screen->ipad_panel_locked[axis] = tab && slot.locked;
+  screen->ipad_panel_active[axis] = !tab ? 0 :
+                                   tab->region_type == 0 ? tab->id + 1 :
+                                   tab->region_type == RGN_TYPE_UI ? -1 :
+                                   tab->region_type == RGN_TYPE_TOOLS ? -2 : -3;
+  if (tab && tab->region_type == RGN_TYPE_UI) {
+    STRNCPY(screen->ipad_panel_category, tab->category.c_str());
+    if (!tab->category.empty()) {
+      UI_panel_category_active_set(BKE_area_find_region_type(tab->area, RGN_TYPE_UI),
+                                   tab->category.c_str());
+    }
+  }
+}
+
+static Rect panel_content(const Model &model, Edge edge)
+{
+  Rect rect = edge == Edge::Side ? model.layout.side_panel : model.layout.bottom_panel;
+  if (edge == Edge::Side) {
+    rect.xmin += model.metrics.resize_extent;
+  }
+  else {
+    rect.ymax -= model.metrics.resize_extent;
+  }
+  return rect;
+}
+
+enum class Action { Tab, Previous, Next, Resize };
+struct Button {
+  Rect rect;
+  std::string label;
+  Action action;
+  Edge edge;
+  int id = -1;
+  bool selected = false;
+};
+
+static std::vector<Button> buttons(const Model &model, const bScreen *screen)
+{
+  std::vector<Button> result;
+  const Rect rail = model.layout.side_rail;
+  std::vector<const Tab *> tabs;
+  for (const Tab &tab : model.tabs) {
+    if (tab.edge == Edge::Side) {
+      tabs.push_back(&tab);
+    }
+  }
+  const policy::RailPage page = policy::rail_page(
+      tabs.size(), rail.height(), std::max(0, screen->ipad_panel_page[0]),
+      int(90 * UI_SCALE_FAC), int(3 * UI_SCALE_FAC));
+  int offset = 0;
+  auto add = [&](const std::string &label, Action action, int id, bool selected) {
+    Rect rect = rail;
+    rect.ymax -= offset;
+    rect.ymin = rect.ymax - page.button_extent;
+    result.push_back({rect, label, action, Edge::Side, id, selected});
+    offset += page.button_extent + page.gap;
+  };
+  if (page.paged) {
+    add("Previous", Action::Previous, int(page.page > 0 ? page.page - 1 : 0), false);
+  }
+  for (size_t i = page.first; i < page.first + page.count; i++) {
+    add(tabs[i]->label, Action::Tab, tabs[i]->id,
+        model.state.side.active_id == tabs[i]->id);
+  }
+  if (page.paged) {
+    add("Next", Action::Next, int(std::min(page.page + 1, page.pages - 1)), false);
+  }
+  for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+    if (model.state.slot(edge).open()) {
+      const Rect resize = edge == Edge::Side ? model.layout.side_resize : model.layout.bottom_resize;
+      result.push_back({resize, "", Action::Resize, edge});
+    }
+  }
+  return result;
+}
+
+static void tag_layout(bContext *C, wmWindow *win, const bool refresh_cursor = true)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  screen->do_refresh = true;
+  screen->do_draw = true;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    ED_area_tag_redraw(area);
+  }
+  LISTBASE_FOREACH (ScrArea *, area, &win->global_areas.areabase) {
+    if (area->spacetype == SPACE_STATUSBAR) {
+      ED_area_tag_redraw(area);
+    }
+  }
+  if (refresh_cursor) {
+    WM_event_add_mousemove(win);
+  }
+  /* Refresh before the next queued input event can use the old hit rectangles. */
+  ED_screen_ensure_updated(C, CTX_wm_manager(C), win);
+}
+
+static void draw_box(const Rect &rect, const char *label, bool selected)
+{
+  if (rect.empty()) {
+    return;
+  }
+  float color[4];
+  UI_GetThemeColor4fv(selected ? TH_SELECT : TH_HEADER, color);
+  color[3] = 1.0f;
+  rctf box = {float(rect.xmin), float(rect.xmax), float(rect.ymin), float(rect.ymax)};
+  UI_draw_roundbox_corner_set(UI_CNR_ALL);
+  UI_draw_roundbox_4fv(&box, true, 6 * UI_SCALE_FAC, color);
+  if (label && label[0]) {
+    const uiStyle *style = UI_style_get_dpi();
+    uchar text_color[4];
+    UI_GetThemeColor4ubv(TH_TEXT, text_color);
+    /* Match the direction and font of Blender's native right sidebar tabs. */
+    const uiFontStyle *font = &style->widget;
+    UI_fontstyle_set(font);
+    const int fontid = font->uifont_id;
+    BLF_enable(fontid, BLF_ROTATION | BLF_CLIPPING);
+    BLF_rotation(fontid, -float(M_PI_2));
+    BLF_clipping(fontid, rect.xmin, rect.ymin + 2, rect.xmax, rect.ymax - 2);
+    const float length = BLF_width(fontid, label, strlen(label));
+    const float padding = std::max(6 * UI_SCALE_FAC, (rect.height() - length) * 0.5f);
+    BLF_position(fontid, (rect.xmin + rect.xmax) * 0.5f - font->points * UI_SCALE_FAC * 0.35f,
+                 rect.ymax - padding, 0.0f);
+    BLF_color4ubv(fontid, text_color);
+    BLF_draw(fontid, label, strlen(label));
+    BLF_disable(fontid, BLF_ROTATION | BLF_CLIPPING);
+  }
+}
+
+struct ResizeData {
+  int axis;
+  int start;
+  float original;
+  float initial_size;
+};
+
+static wmOperatorStatus resize_invoke(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  bScreen *screen = CTX_wm_screen(C);
+  if (!ED_ipad_panels_enabled(screen)) {
+    return OPERATOR_CANCELLED;
+  }
+  const int axis = RNA_int_get(op->ptr, "axis");
+  const Model model = make_model(C, CTX_wm_window(C));
+  const float displayed = axis == 0 ? model.layout.side_panel.width() : model.layout.bottom_panel.height();
+  op->customdata = MEM_new<ResizeData>(__func__, ResizeData{axis, event->xy[axis],
+                                                          screen->ipad_panel_size[axis],
+                                                          displayed / UI_SCALE_FAC});
+  WM_event_add_modal_handler(C, op);
+  return OPERATOR_RUNNING_MODAL;
+}
+
+static void resize_cancel(bContext *C, wmOperator *op)
+{
+  auto *data = static_cast<ResizeData *>(op->customdata);
+  if (data) {
+    if (bScreen *screen = CTX_wm_screen(C)) {
+      screen->ipad_panel_size[data->axis] = data->original;
+    }
+    MEM_delete(data);
+    op->customdata = nullptr;
+    if (CTX_wm_window(C) && CTX_wm_screen(C)) {
+      tag_layout(C, CTX_wm_window(C));
+    }
+  }
+}
+
+static wmOperatorStatus resize_modal(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  auto *data = static_cast<ResizeData *>(op->customdata);
+  if (ELEM(event->type, EVT_ESCKEY, RIGHTMOUSE, WINDEACTIVATE)) {
+    resize_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type == LEFTMOUSE && event->val == KM_RELEASE) {
+    MEM_delete(data);
+    op->customdata = nullptr;
+    return OPERATOR_FINISHED;
+  }
+  if (ELEM(event->type, MOUSEMOVE, INBETWEEN_MOUSEMOVE)) {
+    Model model = make_model(C, CTX_wm_window(C));
+    const float delta = (event->xy[data->axis] - data->start) / UI_SCALE_FAC;
+    const float requested = data->initial_size + (data->axis == 0 ? -delta : delta);
+    policy::resize(model.state, data->axis == 0 ? Edge::Side : Edge::Bottom,
+                    int(requested * UI_SCALE_FAC), model.bounds, model.metrics);
+    CTX_wm_screen(C)->ipad_panel_size[data->axis] =
+        (data->axis == 0 ? model.state.side_width : model.state.bottom_height) / UI_SCALE_FAC;
+    tag_layout(C, CTX_wm_window(C));
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
+}  // namespace
+
+bool ED_ipad_panels_enabled(const bScreen *screen)
+{
+  return screen && !G.background && !screen->temp && screen->state == SCREENNORMAL;
+}
+
+bool ED_ipad_panels_area_visible(const ScrArea *area)
+{
+  return area->runtime.ipad_layer != 4;
+}
+
+int ED_ipad_panels_area_layer(const ScrArea *area)
+{
+  return area->runtime.ipad_layer == 2 ? 1 : area->runtime.ipad_layer == 3 ? 2 : 0;
+}
+
+void ED_ipad_panels_prepare(bContext *C, wmWindow *win)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    area->runtime.ipad_layer = 0;
+    area->runtime.ipad_side_region = 0;
+    area->runtime.ipad_bottom_region = 0;
+    LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+      region->runtime->ipad_floating = false;
+      region->runtime->ipad_canvas = false;
+    }
+  }
+  if (!ED_ipad_panels_enabled(screen)) {
+    return;
+  }
+  Model model = make_model(C, win);
+  if (!model.main) {
+    return;
+  }
+  rcti screen_rect;
+  WM_window_screen_rect_calc(win, &screen_rect);
+  for (ScrArea *area : model.areas) {
+    area->runtime.ipad_layer = 4;
+  }
+  model.main->runtime.ipad_layer = 1;
+  model.main->runtime.ipad_rect = screen_rect;
+  model.main->runtime.ipad_rect.xmax--;
+  model.main->runtime.ipad_rect.ymax--;
+  model.main->runtime.ipad_side_rect = to_rect(panel_content(model, Edge::Side));
+  model.main->runtime.ipad_bottom_rect = to_rect(panel_content(model, Edge::Bottom));
+  for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+    const Tab *tab = find_tab(model, model.state.slot(edge).active_id);
+    if (!tab) {
+      continue;
+    }
+    if (tab->region_type == 0) {
+      tab->area->runtime.ipad_layer = edge == Edge::Side ? 3 : 2;
+      tab->area->runtime.ipad_rect = to_rect(panel_content(model, edge));
+    }
+    else if (edge == Edge::Side) {
+      model.main->runtime.ipad_side_region = tab->region_type;
+    }
+    else {
+      model.main->runtime.ipad_bottom_region = tab->region_type;
+    }
+  }
+}
+
+bool ED_ipad_panels_main_region_layout(const wmWindow *win, ScrArea *main)
+{
+  if (main->runtime.ipad_layer != 1) {
+    return false;
+  }
+  bScreen *screen = WM_window_get_active_screen(win);
+  Model model;
+  model.main = main;
+  model.bounds = content_bounds(win, main);
+  model.metrics = panel_metrics();
+  preferred_sizes(screen, model.state);
+  /* prepare() has already selected the real editor/region instances. Recompute
+   * only their geometry here, after native headers establish the WINDOW rect. */
+  model.state.side.active_id = main->runtime.ipad_side_region ? 0 : -1;
+  model.state.bottom.active_id = main->runtime.ipad_bottom_region ? 0 : -1;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (area->runtime.ipad_layer == 3) {
+      model.state.side.active_id = 0;
+    }
+    else if (area->runtime.ipad_layer == 2) {
+      model.state.bottom.active_id = 0;
+    }
+  }
+  model.layout = policy::layout(model.bounds, model.state, model.metrics);
+  const rcti side = to_rect(panel_content(model, Edge::Side));
+  const rcti bottom = to_rect(panel_content(model, Edge::Bottom));
+  auto assign = [](rcti &target, const rcti &value) {
+    if (target.xmin == value.xmin && target.ymin == value.ymin &&
+        target.xmax == value.xmax && target.ymax == value.ymax)
+    {
+      return false;
+    }
+    target = value;
+    return true;
+  };
+  bool changed = assign(main->runtime.ipad_side_rect, side);
+  changed |= assign(main->runtime.ipad_bottom_rect, bottom);
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (ELEM(area->runtime.ipad_layer, 2, 3)) {
+      const rcti &rect = area->runtime.ipad_layer == 3 ? side : bottom;
+      if (assign(area->runtime.ipad_rect, rect)) {
+        area->flag |= AREA_FLAG_REGION_SIZE_UPDATE;
+        ED_area_tag_redraw(area);
+      }
+    }
+  }
+  if (ARegion *region = BKE_area_find_region_type(main, RGN_TYPE_WINDOW)) {
+    region->runtime->ipad_canvas = true;
+    region->runtime->ipad_canvas_rect = to_rect(model.layout.canvas);
+    BLI_rcti_translate(&region->runtime->ipad_canvas_rect,
+                       -region->winrct.xmin, -region->winrct.ymin);
+    region->runtime->visible_rect = {};
+  }
+  return changed;
+}
+
+bool ED_ipad_panels_region_managed(const ScrArea *area, const ARegion *region)
+{
+  return area->runtime.ipad_layer == 1 &&
+         ELEM(region->regiontype, RGN_TYPE_UI, RGN_TYPE_TOOLS,
+              RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER);
+}
+
+bool ED_ipad_panels_region_rect(ScrArea *area, ARegion *region)
+{
+  if (!ED_ipad_panels_region_managed(area, region)) {
+    region->runtime->ipad_floating = false;
+    return false;
+  }
+  const bool bottom = ELEM(region->regiontype, RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER);
+  const bool open = bottom ? area->runtime.ipad_bottom_region != 0 :
+                            area->runtime.ipad_side_region == region->regiontype;
+  const bool visible = open && !(region->flag & RGN_FLAG_POLL_FAILED);
+  region->runtime->ipad_floating = true;
+  region->overlap = true;
+  region->flag &= ~RGN_FLAG_TOO_SMALL;
+  region->winrct = bottom ? area->runtime.ipad_bottom_rect : area->runtime.ipad_side_rect;
+  if (bottom) {
+    const int header_height = ED_area_headersize();
+    if (region->regiontype == RGN_TYPE_ASSET_SHELF_HEADER) {
+      region->winrct.ymax = region->winrct.ymin + header_height - 1;
+    }
+    else {
+      region->winrct.ymin += header_height;
+    }
+  }
+  if (!visible || region->winrct.xmax <= region->winrct.xmin ||
+      region->winrct.ymax <= region->winrct.ymin)
+  {
+    region->flag |= RGN_FLAG_TOO_SMALL;
+    region->winrct = {0, 0, 0, 0};
+  }
+  region->winx = BLI_rcti_size_x(&region->winrct) + 1;
+  region->winy = BLI_rcti_size_y(&region->winrct) + 1;
+  region->runtime->visible_rect = {};
+  return true;
+}
+
+bool ED_ipad_panels_toggle_region(bContext *C, ARegion *region)
+{
+  if (!region || !CTX_wm_area(C) || !ED_ipad_panels_enabled(CTX_wm_screen(C)) ||
+      !ED_ipad_panels_region_managed(CTX_wm_area(C), region))
+  {
+    return false;
+  }
+  wmWindow *win = CTX_wm_window(C);
+  bScreen *screen = CTX_wm_screen(C);
+  Model model = make_model(C, win);
+  const Edge edge = ELEM(region->regiontype, RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER) ?
+                        Edge::Bottom : Edge::Side;
+  const Tab *active = find_tab(model, model.state.slot(edge).active_id);
+  if (active && active->region_type == region->regiontype) {
+    model.state.tap(edge, active->id);
+  }
+  else {
+    for (const Tab &tab : model.tabs) {
+      if (tab.region_type == region->regiontype) {
+        model.state.tap(edge, tab.id);
+        break;
+      }
+    }
+  }
+  save_slot(screen, model, edge);
+  tag_layout(C, win);
+  return true;
+}
+
+void ED_ipad_panels_draw(bContext *C, wmWindow *win)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!ED_ipad_panels_enabled(screen)) {
+    return;
+  }
+  const Model model = make_model(C, win);
+  GPU_blend(GPU_BLEND_ALPHA);
+  for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+    if (find_tab(model, model.state.slot(edge).active_id)) {
+      const Rect resize = edge == Edge::Side ? model.layout.side_resize : model.layout.bottom_resize;
+      draw_box(resize, "", false);
+      /* A visible grip communicates the larger invisible drag target. */
+      const Rect handle = edge == Edge::Side ? model.layout.side_resize : model.layout.bottom_resize;
+      const float cx = (handle.xmin + handle.xmax) * 0.5f;
+      const float cy = edge == Edge::Side ? (handle.ymin + handle.ymax) * 0.5f :
+                                           handle.ymax - 6 * UI_SCALE_FAC;
+      const float half_w = (edge == Edge::Side ? 2 : 18) * UI_SCALE_FAC;
+      const float half_h = (edge == Edge::Side ? 18 : 2) * UI_SCALE_FAC;
+      rctf grip = {cx - half_w, cx + half_w, cy - half_h, cy + half_h};
+      float color[4];
+      UI_GetThemeColor4fv(TH_TEXT, color);
+      color[3] = 0.45f;
+      UI_draw_roundbox_4fv(&grip, true, 2 * UI_SCALE_FAC, color);
+    }
+  }
+  for (const Button &button : buttons(model, screen)) {
+    if (button.action != Action::Resize) {
+      draw_box(button.rect, button.label.c_str(), button.selected);
+    }
+  }
+  GPU_blend(GPU_BLEND_NONE);
+}
+
+void ED_ipad_panels_statusbar(const bContext *C, uiLayout *layout)
+{
+  bScreen *screen = CTX_wm_screen(C);
+  if (!ED_ipad_panels_enabled(screen)) {
+    return;
+  }
+  const Model model = make_model(const_cast<bContext *>(C), CTX_wm_window(C));
+  uiLayout &row = layout->row(true);
+  for (const Tab &tab : model.tabs) {
+    if (tab.edge != Edge::Bottom) {
+      continue;
+    }
+    PointerRNA props = row.op("SCREEN_OT_ipad_panel_activate", tab.label.c_str(), ICON_NONE,
+                              blender::wm::OpCallContext::ExecDefault,
+                              model.state.bottom.active_id == tab.id ? UI_ITEM_O_DEPRESS : UI_ITEM_NONE);
+    RNA_int_set(&props, "panel", tab.id);
+    RNA_int_set(&props, "axis", 1);
+  }
+  row.separator();
+  row.label("Pin Panels", ICON_PINNED);
+  for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+    uiLayout &pin = row.row(true);
+    pin.active_set(model.state.slot(edge).open());
+    PointerRNA props = pin.op("SCREEN_OT_ipad_panel_pin", edge == Edge::Side ? "Side" : "Bottom",
+                              ICON_NONE, blender::wm::OpCallContext::ExecDefault,
+                              model.state.slot(edge).locked ? UI_ITEM_O_DEPRESS : UI_ITEM_NONE);
+    RNA_int_set(&props, "axis", edge == Edge::Side ? 0 : 1);
+  }
+  layout->separator();
+}
+
+static wmOperatorStatus panel_activate_exec(bContext *C, wmOperator *op)
+{
+  Model model = make_model(C, CTX_wm_window(C));
+  const Edge edge = RNA_int_get(op->ptr, "axis") == 0 ? Edge::Side : Edge::Bottom;
+  const int id = RNA_int_get(op->ptr, "panel");
+  const Tab *tab = find_tab(model, id);
+  if (!tab || tab->edge != edge) {
+    return OPERATOR_CANCELLED;
+  }
+  model.state.tap(edge, id);
+  save_slot(CTX_wm_screen(C), model, edge);
+  tag_layout(C, CTX_wm_window(C));
+  return OPERATOR_FINISHED;
+}
+
+static wmOperatorStatus panel_pin_exec(bContext *C, wmOperator *op)
+{
+  Model model = make_model(C, CTX_wm_window(C));
+  const Edge edge = RNA_int_get(op->ptr, "axis") == 0 ? Edge::Side : Edge::Bottom;
+  if (!model.state.toggle_lock(edge)) {
+    return OPERATOR_CANCELLED;
+  }
+  save_slot(CTX_wm_screen(C), model, edge);
+  tag_layout(C, CTX_wm_window(C));
+  return OPERATOR_FINISHED;
+}
+
+static bool panel_poll(bContext *C)
+{
+  return CTX_wm_window(C) && ED_ipad_panels_enabled(CTX_wm_screen(C));
+}
+
+void SCREEN_OT_ipad_panel_activate(wmOperatorType *ot)
+{
+  ot->name = "Open Workspace Panel";
+  ot->idname = "SCREEN_OT_ipad_panel_activate";
+  ot->description = "Open the existing workspace editor in the floating panel area";
+  ot->exec = panel_activate_exec;
+  ot->poll = panel_poll;
+  ot->flag = OPTYPE_INTERNAL;
+  RNA_def_int(ot->srna, "axis", 1, 0, 1, "Area", "Side or bottom panel", 0, 1);
+  RNA_def_int(ot->srna, "panel", 0, 0, INT_MAX, "Panel", "Workspace editor", 0, INT_MAX);
+}
+
+void SCREEN_OT_ipad_panel_pin(wmOperatorType *ot)
+{
+  ot->name = "Pin Panel Area";
+  ot->idname = "SCREEN_OT_ipad_panel_pin";
+  ot->description = "Keep this area open while working; switching panels replaces its contents";
+  ot->exec = panel_pin_exec;
+  ot->poll = panel_poll;
+  ot->flag = OPTYPE_INTERNAL;
+  RNA_def_int(ot->srna, "axis", 0, 0, 1, "Area", "Side or bottom panel", 0, 1);
+}
+
+bool ED_ipad_panels_handle_event(bContext *C, wmWindow *win, const wmEvent *event)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!ED_ipad_panels_enabled(screen) || !BLI_listbase_is_empty(&screen->regionbase)) {
+    return false;
+  }
+  Model model = make_model(C, win);
+  if (!model.main) {
+    return false;
+  }
+  int &pan_axis = model.main->runtime.ipad_pan_axis;
+  /* GHOST anchors ordinary finger pans at their origin, and emits a cursor event
+   * at every new gesture. Flythrough pans move the origin but have the same begin.
+   * Capture from that first resize hit so moving the handle cannot drop the drag. */
+  if (ELEM(event->type, MOUSEMOVE, INBETWEEN_MOUSEMOVE, LEFTMOUSE, RIGHTMOUSE,
+           WINDEACTIVATE, EVT_ESCKEY))
+  {
+    pan_axis = 0;
+  }
+  const auto controls = buttons(model, screen);
+  if (event->type == MOUSEPAN) {
+    if (!pan_axis) {
+      for (const Button &button : controls) {
+        if (button.action == Action::Resize && contains(button.rect, event->xy)) {
+          pan_axis = button.edge == Edge::Side ? 1 : 2;
+          break;
+        }
+      }
+    }
+    if (pan_axis) {
+      const int axis = pan_axis - 1;
+      const Edge edge = axis == 0 ? Edge::Side : Edge::Bottom;
+      const int current_size = axis == 0 ? model.layout.side_panel.width() :
+                                           model.layout.bottom_panel.height();
+      const int delta = event->xy[axis] - event->prev_xy[axis];
+      policy::resize(model.state, edge, current_size + (axis == 0 ? -delta : delta),
+                      model.bounds, model.metrics);
+      screen->ipad_panel_size[axis] =
+          (axis == 0 ? model.state.side_width : model.state.bottom_height) / UI_SCALE_FAC;
+      /* Do not manufacture a cursor-begin while the same finger gesture is captured. */
+      tag_layout(C, win, false);
+      return true;
+    }
+  }
+  for (const Button &button : controls) {
+    if (!contains(button.rect, event->xy)) {
+      continue;
+    }
+    if (event->type == LEFTMOUSE && event->val == KM_PRESS) {
+      const int axis = button.edge == Edge::Side ? 0 : 1;
+      if (button.action == Action::Resize) {
+        PointerRNA props;
+        WM_operator_properties_create(&props, "SCREEN_OT_ipad_panel_resize");
+        RNA_int_set(&props, "axis", axis);
+        WM_operator_name_call(C, "SCREEN_OT_ipad_panel_resize",
+                              blender::wm::OpCallContext::InvokeDefault, &props, event);
+        WM_operator_properties_free(&props);
+      }
+      else {
+        if (button.action == Action::Tab) {
+          model.state.tap(button.edge, button.id);
+          save_slot(screen, model, button.edge);
+        }
+        else if (button.action == Action::Previous) {
+          screen->ipad_panel_page[axis] = button.id;
+        }
+        else if (button.action == Action::Next) {
+          screen->ipad_panel_page[axis] = button.id;
+        }
+        tag_layout(C, win);
+      }
+    }
+    /* Only pointer events belong to chrome; timers and keyboard shortcuts retain their routing. */
+    return ISMOUSE(event->type) || ISMOUSE_GESTURE(event->type);
+  }
+  if (event->type == LEFTMOUSE && event->val == KM_PRESS &&
+      contains(model.layout.canvas, event->xy))
+  {
+    bool changed = model.state.dismiss(Edge::Side);
+    changed |= model.state.dismiss(Edge::Bottom);
+    if (changed) {
+      save_slot(screen, model, Edge::Side);
+      save_slot(screen, model, Edge::Bottom);
+      tag_layout(C, win);
+      /* Dismissal consumes the tap; it must not also transform/select beneath a panel. */
+      return true;
+    }
+  }
+  return false;
+}
+
+void SCREEN_OT_ipad_panel_resize(wmOperatorType *ot)
+{
+  ot->name = "Resize iPad Panel";
+  ot->idname = "SCREEN_OT_ipad_panel_resize";
+  ot->description = "Resize the floating panel without changing the saved workspace layout";
+  ot->invoke = resize_invoke;
+  ot->modal = resize_modal;
+  ot->cancel = resize_cancel;
+  ot->flag = OPTYPE_INTERNAL | OPTYPE_BLOCKING;
+  RNA_def_int(ot->srna, "axis", 0, 0, 1, "Area", "Side or bottom panel", 0, 1);
+}
