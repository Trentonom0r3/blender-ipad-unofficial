+
+/* Native HUD receipts deliberately do not own operators, RNA or UI pointers.
+ * Cached textures keep their original content owner; compositing cannot make
+ * an old UI tree current merely by observing a newer scene/history. */
+/* Use only copied chrome from existing native prepare/draw paths here. No
+ * panel poll, Python callback or RNA access may run while a HUD/frame is held. */
+bool ED_ipad_hud_exposed_rect(bContext *C, wmWindow *win, ScrArea *area,
+                               const ARegion *canvas, const rcti &hud_rect, rcti &exposed)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || !win || BLI_findindex(&wm->windows, win) == -1) return false;
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!screen || !ED_ipad_panels_enabled(screen) || !area ||
+      BLI_findindex(&screen->areabase, area) == -1 || area->runtime.ipad_layer != 1 ||
+      !canvas || BLI_findindex(&area->regionbase, canvas) == -1 ||
+      canvas->regiontype != RGN_TYPE_WINDOW || !canvas->runtime->visible ||
+      !canvas->runtime->ipad_canvas ||
+      (canvas->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED)))
+    return false;
+  exposed = canvas->runtime->ipad_canvas_rect;
+  BLI_rcti_translate(&exposed, canvas->winrct.xmin, canvas->winrct.ymin);
+  if (hud_rect.ymin < exposed.ymin || hud_rect.ymax > exposed.ymax) return true;
+  int windows = 0;
+  LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+    if (region->regiontype == RGN_TYPE_WINDOW) ++windows;
+  }
+  if (windows != 1 || screen->do_refresh) return true;
+  const auto found = ipad_hud_chrome.find(uintptr_t(win));
+  if (found == ipad_hud_chrome.end()) return true;
+  const IPadHUDChrome &chrome = found->second;
+  if (chrome.screen_address != uintptr_t(screen) || chrome.screen_uid != screen->id.session_uid ||
+      chrome.window_id != uint64_t(win->winid) || chrome.width != WM_window_native_pixel_x(win) ||
+      chrome.height != WM_window_native_pixel_y(win) || chrome.scale != UI_SCALE_FAC) return true;
+  /* A native header/split may settle after prepare. Wait for matching geometry. */
+  const rcti &w = canvas->winrct;
+  const rcti expected{std::clamp(chrome.canvas.xmin, w.xmin, w.xmax),
+                      std::clamp(chrome.canvas.xmax, w.xmin + 1, w.xmax + 1) - 1,
+                      std::clamp(chrome.canvas.ymin, w.ymin, w.ymax),
+                      std::clamp(chrome.canvas.ymax, w.ymin + 1, w.ymax + 1) - 1};
+  if (expected.xmin != exposed.xmin || expected.xmax != exposed.xmax ||
+      expected.ymin != exposed.ymin || expected.ymax != exposed.ymax) return true;
+  const Rect strip{w.xmin, hud_rect.ymin, exposed.xmin, hud_rect.ymax + 1};
+  for (const Rect &blocker : chrome.blockers) {
+    if (!strip.empty() && !blocker.empty() && strip.xmin < blocker.xmax &&
+        strip.xmax > blocker.xmin && strip.ymin < blocker.ymax && strip.ymax > blocker.ymin)
+      return true;
+  }
+  exposed.xmin = w.xmin;
+  return true;
+}
