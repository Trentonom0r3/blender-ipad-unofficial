diff --git a/source/blender/editors/screen/ipad_workspace_panels.hh b/source/blender/editors/screen/ipad_workspace_panels.hh
new file mode 100644
--- /dev/null
+++ b/source/blender/editors/screen/ipad_workspace_panels.hh
@@ -0,0 +1,368 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Runtime-only iPad workspace geometry. No dependency on Blender DNA or editor types. */
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <vector>
+
+namespace blender::ed::ipad::panels {
+
+/* Half-open rectangles, origin at the lower left. Convert inclusive Blender rcti
+ * coordinates at the integration boundary, not by changing saved screen vertices. */
+struct Rect {
+  int xmin = 0, ymin = 0, xmax = 0, ymax = 0;
+  int width() const { return std::max(0, xmax - xmin); }
+  int height() const { return std::max(0, ymax - ymin); }
+  bool empty() const { return width() == 0 || height() == 0; }
+};
+
+enum class Role { Content, Service };
+enum class Edge { Side, Bottom };
+
+struct Area {
+  int id;
+  Rect original;
+  Role role = Role::Content;
+};
+
+struct Panel {
+  int id;
+  Edge edge;
+  Rect original;
+};
+
+struct Mapping {
+  int primary_id = -1;
+  std::vector<Panel> panels;
+};
+
+/* Find the largest editor in the original top content row. Outliner/Properties
+ * are passed as Service; every other editor remains eligible, including node,
+ * image, animation, text and sequence editors. No editor is replaced by VIEW3D. */
+inline Mapping classify(const std::vector<Area> &areas, const int tolerance = 1)
+{
+  Mapping result;
+  const Area *primary = nullptr;
+  int top = 0;
+  bool have_content = false;
+  for (const Area &area : areas) {
+    if (area.id >= 0 && !area.original.empty() && area.role == Role::Content) {
+      top = have_content ? std::max(top, area.original.ymax) : area.original.ymax;
+      have_content = true;
+    }
+  }
+  /* A workspace containing only service editors still needs a usable primary. */
+  if (!have_content) {
+    bool have_area = false;
+    for (const Area &area : areas) {
+      if (area.id >= 0 && !area.original.empty()) {
+        top = have_area ? std::max(top, area.original.ymax) : area.original.ymax;
+        have_area = true;
+      }
+    }
+  }
+  for (const Area &area : areas) {
+    if (area.id < 0 || area.original.empty() ||
+        (have_content && area.role != Role::Content) ||
+        area.original.ymax < top - std::max(0, tolerance)) {
+      continue;
+    }
+    const auto size = static_cast<long long>(area.original.width()) * area.original.height();
+    const auto previous_size = primary ? static_cast<long long>(primary->original.width()) *
+                                            primary->original.height() :
+                                        -1;
+    if (!primary || size > previous_size ||
+        (size == previous_size && (area.original.xmin < primary->original.xmin ||
+                                  (area.original.xmin == primary->original.xmin &&
+                                   area.id < primary->id)))) {
+      primary = &area;
+    }
+  }
+  if (!primary) {
+    return result;
+  }
+  result.primary_id = primary->id;
+  for (const Area &area : areas) {
+    if (area.id < 0 || area.id == primary->id || area.original.empty()) {
+      continue;
+    }
+    const bool overlaps_x = area.original.xmax > primary->original.xmin &&
+                            area.original.xmin < primary->original.xmax;
+    const bool below = area.original.ymax <= primary->original.ymin + std::max(0, tolerance);
+    result.panels.push_back(
+        {area.id, below && (area.role == Role::Content || overlaps_x) ? Edge::Bottom : Edge::Side,
+         area.original});
+  }
+  /* Match spatial reading order rather than storage order: upper side editors
+   * first; bottom editors left-to-right, then upper-to-lower. */
+  std::stable_sort(result.panels.begin(), result.panels.end(), [](const Panel &a, const Panel &b) {
+    if (a.edge != b.edge) {
+      return a.edge == Edge::Side;
+    }
+    if (a.edge == Edge::Bottom && a.original.xmin != b.original.xmin) {
+      return a.original.xmin < b.original.xmin;
+    }
+    if (a.original.ymax != b.original.ymax) {
+      return a.original.ymax > b.original.ymax;
+    }
+    return a.id < b.id;
+  });
+  return result;
+}
+
+struct Slot {
+  int active_id = -1;
+  bool locked = false;
+  bool open() const { return active_id >= 0; }
+};
+
+enum class TapResult { Opened, Switched, Closed, Locked, Invalid };
+
+/* One instance per runtime workspace/screen. Never serialize this into screen
+ * area coordinates. The adapter assigns nonnegative IDs to editor and region tabs. */
+struct State {
+  Slot side;
+  Slot bottom;
+  /* Zero means automatic maximum useful size; positive values remember an
+   * explicit user resize. Passive relayout never replaces this preference. */
+  int side_width = 0;
+  int bottom_height = 0;
+
+  Slot &slot(const Edge edge) { return edge == Edge::Side ? side : bottom; }
+  const Slot &slot(const Edge edge) const { return edge == Edge::Side ? side : bottom; }
+
+  TapResult tap(const Edge edge, const int id)
+  {
+    if (id < 0) {
+      return TapResult::Invalid;
+    }
+    Slot &target = slot(edge);
+    if (target.active_id == id && target.locked) {
+      return TapResult::Locked;
+    }
+    if (target.active_id == id) {
+      target = {};
+      return TapResult::Closed;
+    }
+    const bool was_open = target.open();
+    const bool area_locked = was_open && target.locked;
+    target = {id, area_locked};
+    return was_open ? TapResult::Switched : TapResult::Opened;
+  }
+
+  bool toggle_lock(const Edge edge)
+  {
+    Slot &target = slot(edge);
+    if (!target.open()) {
+      return false;
+    }
+    target.locked = !target.locked;
+    return true;
+  }
+
+  bool dismiss(const Edge edge)
+  {
+    Slot &target = slot(edge);
+    if (!target.open() || target.locked) {
+      return false;
+    }
+    target = {};
+    return true;
+  }
+
+  /* Use when an editor was removed or its placement changed. Include region
+   * tabs in available_tabs so reconciliation preserves an open Item/Tool/View. */
+  void reconcile(const std::vector<Panel> &available_tabs)
+  {
+    for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+      Slot &target = slot(edge);
+      const bool exists = std::any_of(available_tabs.begin(), available_tabs.end(),
+                                      [&](const Panel &panel) {
+                                        return panel.id == target.active_id && panel.edge == edge;
+                                      });
+      if (!exists) {
+        target = {};
+      }
+    }
+  }
+};
+
+struct Metrics {
+  int inset = 8;
+  int gap = 8;
+  int side_rail_extent = 28;
+  int bottom_rail_extent = 0;
+  int resize_extent = 24;
+  int minimum_canvas_width = 160;
+  int minimum_canvas_height = 120;
+  int minimum_side_width = 160;
+  int minimum_bottom_width = 320;
+  int minimum_bottom_height = 120;
+  int automatic_side_percent = 45;
+  int automatic_bottom_percent = 55;
+  bool side_rail = true;
+  /* Bottom launchers normally live in the native status bar outside bounds.
+   * This opt-in remains useful for non-status-bar hosts and geometry tests. */
+  bool bottom_rail = false;
+};
+
+struct Layout {
+  Rect bounds;
+  Rect canvas;
+  Rect side_rail;
+  Rect bottom_rail;
+  Rect side_panel;
+  Rect bottom_panel;
+  Rect side_resize;
+  Rect bottom_resize;
+};
+
+inline int fit_dimension(const int requested, const int minimum, const int maximum)
+{
+  return std::clamp(requested, std::min(std::max(0, minimum), std::max(0, maximum)),
+                    std::max(0, maximum));
+}
+
+/* The caller excludes OS safe areas and mandatory global/header chrome from
+ * bounds. All metrics and bounds use the same units (usually UI-scaled pixels).
+ * The editor may render behind panels; canvas identifies its unobstructed area. */
+inline Layout layout(const Rect bounds, const State &state, const Metrics &metrics = {})
+{
+  Layout result;
+  result.bounds = bounds;
+  if (bounds.empty()) {
+    return result;
+  }
+  const int inset_x = std::min(std::max(0, metrics.inset), bounds.width() / 8);
+  const int inset_y = std::min(std::max(0, metrics.inset), bounds.height() / 8);
+  const Rect interior{bounds.xmin + inset_x, bounds.ymin + inset_y,
+                      bounds.xmax - inset_x, bounds.ymax - inset_y};
+  const int side_rail_width = metrics.side_rail ?
+                                  std::min(std::max(0, metrics.side_rail_extent), interior.width() / 4) :
+                                  0;
+  const int bottom_rail_height = metrics.bottom_rail ?
+                                     std::min(std::max(0, metrics.bottom_rail_extent), interior.height() / 4) :
+                                     0;
+  const int gap_x = std::min(std::max(0, metrics.gap), interior.width() / 16);
+  const int gap_y = std::min(std::max(0, metrics.gap), interior.height() / 16);
+  const int content_right = interior.xmax - side_rail_width - (side_rail_width ? gap_x : 0);
+  const int content_bottom = interior.ymin + bottom_rail_height + (bottom_rail_height ? gap_y : 0);
+  const Rect content{interior.xmin, content_bottom, content_right, interior.ymax};
+  if (side_rail_width) {
+    result.side_rail = {interior.xmax - side_rail_width, content_bottom,
+                        interior.xmax, interior.ymax};
+  }
+  if (bottom_rail_height) {
+    result.bottom_rail = {interior.xmin, interior.ymin,
+                          content_right, interior.ymin + bottom_rail_height};
+  }
+  const int canvas_reserve_x = std::min(std::max(0, metrics.minimum_canvas_width), content.width() / 2);
+  const int canvas_reserve_y = std::min(std::max(0, metrics.minimum_canvas_height), content.height() / 2);
+  const int bottom_reserve_x = state.bottom.open() ?
+                                   std::min(std::max(0, metrics.minimum_bottom_width), content.width() / 2) :
+                                   0;
+  const int width_limit = std::max(0, content.width() -
+                                      std::max(canvas_reserve_x, bottom_reserve_x) - gap_x);
+  const int height_limit = std::max(0, content.height() - canvas_reserve_y - gap_y);
+  const int requested_side = state.side_width > 0 ? state.side_width :
+                             int(static_cast<long long>(content.width()) *
+                                 std::clamp(metrics.automatic_side_percent, 1, 90) / 100);
+  const int requested_bottom = state.bottom_height > 0 ? state.bottom_height :
+                               int(static_cast<long long>(content.height()) *
+                                   std::clamp(metrics.automatic_bottom_percent, 1, 90) / 100);
+  const int side_width = state.side.open() ?
+                             fit_dimension(requested_side, metrics.minimum_side_width, width_limit) :
+                             0;
+  const int bottom_height = state.bottom.open() ?
+                                fit_dimension(requested_bottom, metrics.minimum_bottom_height, height_limit) :
+                                0;
+  const int canvas_right = content.xmax - side_width - (side_width ? gap_x : 0);
+  const int canvas_bottom = content.ymin + bottom_height + (bottom_height ? gap_y : 0);
+  result.canvas = {content.xmin, canvas_bottom, canvas_right, content.ymax};
+  if (side_width) {
+    result.side_panel = {content.xmax - side_width, content.ymin, content.xmax, content.ymax};
+    result.side_resize = {result.side_panel.xmin, result.side_panel.ymin,
+                          result.side_panel.xmin + std::min(std::max(0, metrics.resize_extent), side_width),
+                          result.side_panel.ymax};
+  }
+  if (bottom_height) {
+    result.bottom_panel = {content.xmin, content.ymin, canvas_right, content.ymin + bottom_height};
+    result.bottom_resize = {result.bottom_panel.xmin,
+                            result.bottom_panel.ymax - std::min(std::max(0, metrics.resize_extent), bottom_height),
+                            result.bottom_panel.xmax, result.bottom_panel.ymax};
+  }
+  return result;
+}
+
+/* Record the actual clamped result of a user drag. Passive layout/rotation never
+ * mutates preferred dimensions, so returning to a large window restores them.
+ * This operation is independent of which tab is active or locked. */
+inline void resize(State &state, const Edge edge, const int requested,
+                   const Rect bounds, const Metrics &metrics = {})
+{
+  if (bounds.empty()) {
+    return;
+  }
+  State probe = state;
+  if (edge == Edge::Side) {
+    probe.side.active_id = 0;
+    /* Zero is an automatic-layout sentinel, never the result of a drag. */
+    probe.side_width = std::max(1, requested);
+    state.side_width = layout(bounds, probe, metrics).side_panel.width();
+  }
+  else {
+    probe.bottom.active_id = 0;
+    probe.bottom_height = std::max(1, requested);
+    state.bottom_height = layout(bounds, probe, metrics).bottom_panel.height();
+  }
+}
+
+struct RailPage {
+  std::size_t first = 0;
+  std::size_t count = 0;
+  std::size_t page = 0;
+  std::size_t pages = 0;
+  int button_extent = 0;
+  int gap = 0;
+  bool paged = false;
+  bool previous = false;
+  bool next = false;
+};
+
+/* Overflow never collapses the rail. Reserve previous/next buttons only when
+ * needed. On extremely short windows, shrink all three targets equally rather
+ * than making a selected tab or a paging control unreachable. */
+inline RailPage rail_page(const std::size_t total, const int extent,
+                          const std::size_t requested_page = 0,
+                          const int desired_button = 44, const int desired_gap = 6)
+{
+  RailPage result;
+  if (total == 0 || extent <= 0) {
+    return result;
+  }
+  result.button_extent = std::min(std::max(1, desired_button), extent);
+  result.gap = std::min(std::max(0, desired_gap), extent / 8);
+  const auto capacity = static_cast<std::size_t>(
+      std::max(1, (extent + result.gap) / (result.button_extent + result.gap)));
+  if (total <= capacity) {
+    result.count = total;
+    result.pages = 1;
+    return result;
+  }
+  result.paged = true;
+  result.gap = std::min(result.gap, extent / 8);
+  result.button_extent = std::min(result.button_extent, std::max(1, (extent - 2 * result.gap) / 3));
+  const int body_extent = std::max(0, extent - 2 * (result.button_extent + result.gap));
+  const auto body_capacity = static_cast<std::size_t>(
+      std::max(1, (body_extent + result.gap) / (result.button_extent + result.gap)));
+  result.pages = 1 + (total - 1) / body_capacity;
+  result.page = std::min(requested_page, result.pages - 1);
+  result.first = result.page * body_capacity;
+  result.count = std::min(body_capacity, total - result.first);
+  result.previous = result.page > 0;
+  result.next = result.page + 1 < result.pages;
+  return result;
+}
+
+}  // namespace blender::ed::ipad::panels
