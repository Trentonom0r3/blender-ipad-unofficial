+bool ui_ipad_ring_roll_input(bContext * /*C*/, uiBlock * /*block*/, const wmEvent * /*event*/)
+{
+  /* Consume old queued roll packets without reading a popup or changing its
+   * page/contact/buttons. Only admitted Begin/Motion/End tip contacts browse. */
+  return true;
+}
