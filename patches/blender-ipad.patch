-  if (!(event->flag & WM_EVENT_MULTITOUCH_TWO_FINGERS)) {
+  /* iOS: a real MIDDLEMOUSE press (external mouse) starts the modal grab-pan,
+   * driven by CURSOR_MOVE events — this pins the grabbed point exactly (depth and
+   * zoom correct), unlike the zoom-amplified one-shot TRACKPADPAN path. Two-finger
+   * trackpad pans (MOUSEPAN) still use the one-shot path; other non-two-finger
+   * events (e.g. touch) are ignored. */
+  if (event->type != MIDDLEMOUSE && !(event->flag & WM_EVENT_MULTITOUCH_TWO_FINGERS)) {
