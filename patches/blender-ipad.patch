+
+bool GHOST_IOS_import_file(const char *filter_glob,
+                           const std::function<bool(const char *)> &on_picked,
+                           const std::function<void()> &on_cancelled)
+{
+  if (![NSThread isMainThread] || !on_picked) {
+    return false;
+  }
+  static GHOST_IOSFileImporter *importer = nil;
+  if (!importer) {
+    importer = [[GHOST_IOSFileImporter alloc] init];
+  }
+  NSString *glob = filter_glob ? [NSString stringWithUTF8String:filter_glob] : @"";
+  return [importer presentWithFilter:glob libraryCopy:NO onPicked:on_picked
+                             onCancelled:on_cancelled];
+}
+
+
+bool GHOST_IOS_pick_blend_library(const std::function<bool(const char *)> &on_picked,
+                                  const std::function<void()> &on_cancelled)
+{
+  if (![NSThread isMainThread] || !on_picked) {
+    return false;
+  }
+  static GHOST_IOSFileImporter *library_importer = nil;
+  if (!library_importer) {
+    library_importer = [[GHOST_IOSFileImporter alloc] init];
+  }
+  return [library_importer presentWithFilter:@"*.blend" libraryCopy:YES
+                                  onPicked:on_picked onCancelled:on_cancelled];
+}
+
+void GHOST_IOS_discard_blend_library(const char *local_path)
+{
+  if (!local_path) {
+    return;
+  }
+  NSFileManager *manager = [NSFileManager defaultManager];
+  NSURL *documents = [manager URLsForDirectory:NSDocumentDirectory inDomains:NSUserDomainMask].firstObject;
+  NSURL *root = [[documents URLByAppendingPathComponent:@"Libraries" isDirectory:YES]
+      URLByStandardizingPath];
+  NSString *selectedPath = [[NSURL fileURLWithPath:[NSString stringWithUTF8String:local_path]]
+      URLByStandardizingPath].path;
+  NSString *rootPrefix = [root.path stringByAppendingString:@"/"];
+  if (![selectedPath hasPrefix:rootPrefix]) {
+    return;
+  }
+  NSString *relative = [selectedPath substringFromIndex:rootPrefix.length];
+  NSString *folderName = relative.pathComponents.firstObject;
+  if (![folderName hasPrefix:@"BlenderLibrary-"]) {
+    return;
+  }
+  NSString *identifier = [folderName substringFromIndex:@"BlenderLibrary-".length];
+  NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:identifier];
+  const BOOL ours = uuid && [[uuid UUIDString] isEqualToString:identifier];
+  [uuid release];
+  if (!ours) {
+    return;
+  }
+  /* A folder selection can place the chosen .blend several levels below the
+   * copy root. Discard only that app-owned import, never its parent Library. */
+  NSURL *importDir = [root URLByAppendingPathComponent:folderName isDirectory:YES];
+  [manager removeItemAtURL:importDir error:nil];
+}
+
+static bool g_ipad_flythrough_mode = false;
+
+void GHOST_IOS_set_flythrough_mode(bool enable)
+{
+  g_ipad_flythrough_mode = enable;
+}
+
+bool GHOST_IOS_get_flythrough_mode()
+{
+  return g_ipad_flythrough_mode;
+}
