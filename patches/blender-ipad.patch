    * it is always assumed to be click style */
   if (event->type == LEFTMOUSE || ELEM(event->val, KM_RELEASE, KM_CLICK)) {
     pie->pie_block->pie_data.flags |= UI_PIE_CLICK_STYLE;
     pie->pie_block->pie_data.event_type = EVENT_NONE;
