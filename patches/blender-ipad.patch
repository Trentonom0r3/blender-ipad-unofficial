 struct BevelData {
   float initial_length[NUM_VALUE_KINDS];
   float scale[NUM_VALUE_KINDS];
   NumInput num_input[NUM_VALUE_KINDS];
   /** The current value when shift is pressed. Negative when shift not active. */
   float shift_value[NUM_VALUE_KINDS];
   float max_obj_scale;
   bool is_modal;

   Vector<BevelObjectStore> ob_store;

   /* modal only */
   int launch_event;
   float mcenter[2];
   void *draw_handle_pixel;
   short value_mode; /* Which value does mouse movement and numeric input affect? */
   float segments;   /* Segments as float so smooth mouse pan works in small increments */

   CurveProfile *custom_profile;

   bool use_automerge;
   double automerge_threshold;
+#ifdef WITH_APPLE_CROSSPLATFORM
+  TouchBevelCapture touch;
+#endif
 };
+
+#ifdef WITH_APPLE_CROSSPLATFORM
+/* Native backups keep their BMesh address during preview. Resolve owners from
+ * the current Main before touching data; saved object/region pointers are only
+ * identity values, including during WM teardown with no original viewport. */
+static Mesh *touch_bevel_mesh(bContext *C, const BevelData *data,
+                              const BevelObjectStore &store)
+{
+  Main *bmain = C ? CTX_data_main(C) : nullptr;
+  if (!bmain || uintptr_t(bmain) != data->touch.main_address) {
+    return nullptr;
+  }
+  LISTBASE_FOREACH (Mesh *, mesh, &bmain->meshes) {
+    if (mesh->id.session_uid != store.mesh_uid) {
+      continue;
+    }
+    BMEditMesh *em = mesh->runtime->edit_mesh.get();
+    if (em && em == store.edit_identity && em->bm && em->bm == store.bm_identity &&
+        em->bm->shapenr == store.shapenr &&
+        (mesh->key ? mesh->key->id.session_uid : 0) == store.key_uid)
+    {
+      return mesh;
+    }
+    return nullptr;
+  }
+  return nullptr;
+}
+
+static Object *touch_bevel_owner(bContext *C, const BevelData *data,
+                                const BevelObjectStore &store)
+{
+  Main *bmain = C ? CTX_data_main(C) : nullptr;
+  if (!bmain || uintptr_t(bmain) != data->touch.main_address) {
+    return nullptr;
+  }
+  LISTBASE_FOREACH (Object *, object, &bmain->objects) {
+    if (object->id.session_uid != store.object_uid || object->type != OB_MESH || !object->data) {
+      continue;
+    }
+    Mesh *mesh = static_cast<Mesh *>(object->data);
+    BMEditMesh *em = mesh->runtime->edit_mesh.get();
+    if (mesh->id.session_uid == store.mesh_uid && em && em == store.edit_identity &&
+        em->bm && em->bm == store.bm_identity && em->bm->shapenr == store.shapenr &&
+        (mesh->key ? mesh->key->id.session_uid : 0) == store.key_uid)
+    {
+      return object;
+    }
+    return nullptr;
+  }
+  return nullptr;
+}
+
+static ARegion *touch_bevel_region(bContext *C, const BevelData *data, ScrArea **r_area)
+{
+  *r_area = nullptr;
+  Main *bmain = C ? CTX_data_main(C) : nullptr;
+  if (!bmain || uintptr_t(bmain) != data->touch.main_address) {
+    return nullptr;
+  }
+  LISTBASE_FOREACH (bScreen *, screen, &bmain->screens) {
+    if (screen->id.session_uid != data->touch.screen_uid) {
+      continue;
+    }
+    LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+      if (area != data->touch.area_identity || area->spacetype != SPACE_VIEW3D) {
+        continue;
+      }
+      LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+        if (region == data->touch.region_identity && region->regiontype == RGN_TYPE_WINDOW &&
+            region->runtime->type == data->touch.draw_type)
+        {
+          *r_area = area;
+          return region;
+        }
+      }
+    }
+  }
+  return nullptr;
+}
+
+static bool touch_bevel_context_valid(bContext *C, const BevelData *data)
+{
+  ScrArea *area;
+  ARegion *region = touch_bevel_region(C, data, &area);
+  Scene *scene = CTX_data_scene(C);
+  const bScreen *screen = CTX_wm_screen(C);
+  if (!region || CTX_wm_region(C) != region || CTX_wm_area(C) != area || !scene || !screen ||
+      screen->id.session_uid != data->touch.screen_uid ||
+      scene->id.session_uid != data->touch.scene_uid || !ED_operator_editmesh(C))
+  {
+    return false;
+  }
+  const bToolRef *tool = WM_toolsystem_ref_from_context(C);
+  if (!tool || !STREQ(tool->idname, "builtin.bevel") || !CTX_data_view_layer(C)) {
+    return false;
+  }
+  for (const BevelObjectStore &store : data->ob_store) {
+    Object *object = touch_bevel_owner(C, data, store);
+    if (!object || !BKE_view_layer_base_find(CTX_data_view_layer(C), object)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+static bool touch_bevel_selection_unlocked(bContext *C, wmOperator *op)
+{
+  bool selected = false;
+  const Vector<Object *> objects = BKE_view_layer_array_from_objects_in_edit_mode_unique_data(
+      CTX_data_scene(C), CTX_data_view_layer(C), CTX_wm_view3d(C));
+  for (Object *object : objects) {
+    BMEditMesh *em = BKE_editmesh_from_object(object);
+    if (!em || !em->bm) {
+      return false;
+    }
+    if (em->bm->totvertsel == 0) {
+      continue;
+    }
+    selected = true;
+    if (blender::ed::object::shape_key_report_if_locked(object, op->reports)) {
+      return false;
+    }
+  }
+  return selected;
+}
+
+static void touch_bevel_acquire(bContext *C, BevelData *data)
+{
+  data->touch.active = true;
+  data->touch.main_address = uintptr_t(CTX_data_main(C));
+  data->touch.scene_uid = CTX_data_scene(C)->id.session_uid;
+  data->touch.screen_uid = CTX_wm_screen(C)->id.session_uid;
+  data->touch.area_identity = CTX_wm_area(C);
+  data->touch.region_identity = CTX_wm_region(C);
+  data->touch.draw_type = CTX_wm_region(C)->runtime->type;
+  data->custom_profile = BKE_curveprofile_copy(data->custom_profile);
+  for (BevelObjectStore &store : data->ob_store) {
+    Mesh *mesh = static_cast<Mesh *>(store.ob->data);
+    BMEditMesh *em = BKE_editmesh_from_object(store.ob);
+    store.object_uid = store.ob->id.session_uid;
+    store.mesh_uid = mesh->id.session_uid;
+    store.key_uid = mesh->key ? mesh->key->id.session_uid : 0;
+    store.edit_identity = em;
+    store.bm_identity = em->bm;
+    store.shapenr = em->bm->shapenr;
+  }
+}
+
+static void touch_bevel_detach_draw(BevelData *data)
+{
+  /* Region types outlive editor instances. Resolve the registered type instead
+   * of dereferencing a saved region, also tolerating shutdown of the registry. */
+  const SpaceType *space = BKE_spacetype_from_id(SPACE_VIEW3D);
+  ARegionType *type = space ? BKE_regiontype_from_id(space, RGN_TYPE_WINDOW) : nullptr;
+  if (type && type == data->touch.draw_type && data->draw_handle_pixel) {
+    ED_region_draw_cb_exit(type, data->draw_handle_pixel);
+  }
+  data->draw_handle_pixel = nullptr;
+}
+
+static void touch_bevel_finish(bContext *C, wmOperator *op, const bool cancelled)
+{
+  auto *data = static_cast<BevelData *>(op->customdata);
+  ScrArea *area;
+  ARegion *region = touch_bevel_region(C, data, &area);
+  bool complete = true;
+  for (BevelObjectStore &store : data->ob_store) {
+    Mesh *mesh = touch_bevel_mesh(C, data, store);
+    if (mesh) {
+      BMEditMesh *em = mesh->runtime->edit_mesh.get();
+      if (cancelled) {
+        EDBM_redo_state_restore_and_free(&store.mesh_backup, em, true);
+        EDBMUpdate_Params params{};
+        params.calc_normals = true;
+        params.is_destructive = true;
+        EDBM_update(mesh, &params);
+      }
+      if ((em->selectmode & SCE_SELECT_FACE) == 0) {
+        EDBM_selectmode_flush(em);
+      }
+    }
+    else {
+      complete = false;
+    }
+    EDBM_redo_state_free(&store.mesh_backup);
+  }
+  if (cancelled && !complete) {
+    BKE_report(op->reports, RPT_WARNING,
+               "The mesh changed during Bevel; some preview geometry could not be restored");
+  }
+  touch_bevel_detach_draw(data);
+  BKE_curveprofile_free(data->custom_profile);
+  if (area) {
+    ED_area_status_text(area, nullptr);
+    ED_region_tag_redraw(region);
+  }
+  /* An invalid originating viewport cannot remain in the caller's context. */
+  const bScreen *screen = C ? CTX_wm_screen(C) : nullptr;
+  if (C && (!region || CTX_wm_area(C) != area || CTX_wm_region(C) != region ||
+            !screen || screen->id.session_uid != data->touch.screen_uid)) {
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+  }
+  G.moving = 0;
+  MEM_delete(data);
+  op->customdata = nullptr;
+}
+
+void EDBM_touch_bevel_discard(wmOperator *op)
+{
+  if (!op->customdata || !op->type || !STREQ(op->type->idname, "MESH_OT_bevel")) {
+    return;
+  }
+  auto *data = static_cast<BevelData *>(op->customdata);
+  if (!data->touch.active) {
+    return;
+  }
+  /* Context-free destruction releases owned storage; it never restores into
+   * old Object/Mesh pointers or accesses an already removed viewport. */
+  touch_bevel_detach_draw(data);
+  for (BevelObjectStore &store : data->ob_store) {
+    EDBM_redo_state_free(&store.mesh_backup);
+  }
+  BKE_curveprofile_free(data->custom_profile);
+  G.moving = 0;
+  MEM_delete(data);
+  op->customdata = nullptr;
+}
