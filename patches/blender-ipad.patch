+# Tool properties constrain drags; numeric values belong only to a transient dialog.
+IPAD_TRANSFORM_TOOLS = {
+    'builtin.move': ('MOVE', 'transform.translate', 1),
+    'builtin.rotate': ('ROTATE', 'transform.rotate', 2),
+    'builtin.scale': ('SCALE', 'transform.resize', 3),
+}
+IPAD_TRANSFORM_ACTIONS = {
+    'TRANSLATE': ('MOVE', 'transform.translate'),
+    'ROTATE': ('ROTATE', 'transform.rotate'),
+    'SCALE': ('SCALE', 'transform.resize'),
+}
+IPAD_TRANSFORM_AXES = (
+    ('FREE', "Free", (False, False, False)),
+    ('X', "X", (True, False, False)), ('Y', "Y", (False, True, False)),
+    ('Z', "Z", (False, False, True)), ('XY', "XY", (True, True, False)),
+    ('XZ', "XZ", (True, False, True)), ('YZ', "YZ", (False, True, True)),
+)
