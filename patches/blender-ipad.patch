+        return false;
+      if (ot->rna_ext.srna != self_type || ot->srna != properties_type) return false;
+      continue;
+    }
+    const uiFreeArgFunc dispose = owner->ipad_numbers_dispose;
+    void *arg = owner->ipad_numbers_dispose_arg;
