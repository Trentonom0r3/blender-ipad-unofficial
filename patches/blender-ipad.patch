+uiBut *ui_ipad_parent_button_resolve(bContext *C, const uiBlock *block, const void *argument)
+{
+  if (!block->ipad_action_origin.present()) return const_cast<uiBut *>(static_cast<const uiBut *>(argument));
+  const auto &lease = block->ipad_parent_button;
+  if (!lease.origin.present() || lease.button_address != uint64_t(uintptr_t(argument))) return nullptr;
+  uiBut *parent = ui_ipad_button_lease_resolve(C, lease);
