   }
   else if (ELEM(but->type, ButType::Text, ButType::SearchMenu)) {
     /* string */
     if (UI_but_is_utf8(but)) {
       BLI_strncpy_utf8(str, but->poin, str_maxncpy);
     }
     else {
       BLI_strncpy(str, but->poin, str_maxncpy);
