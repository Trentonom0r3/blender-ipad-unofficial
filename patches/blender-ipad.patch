+/* Measured noninteractive text inside an already proved presented footprint.
+ * No new target, center content or desired-layout input reservation. */
+inline RingBrowseCue ring_browse_cue_layout(const Rect &bounds,
+    const std::vector<Rect> &buttons, int inventory, int visible,
+    float width, float height, float padding)
+{
+  if (inventory <= visible || visible < 1 || buttons.size() != size_t(visible) ||
+      !std::isfinite(width) || !std::isfinite(height) || !std::isfinite(padding) ||
+      width <= 0 || height <= 0 || padding < 0) return {};
+  const std::array<Rect, 4> candidates{{
+      {bounds.xmin + padding, bounds.xmin + padding + width,
+       bounds.ymin + padding, bounds.ymin + padding + height},
+      {bounds.xmax - padding - width, bounds.xmax - padding,
+       bounds.ymax - padding - height, bounds.ymax - padding},
+      {bounds.xmax - padding - width, bounds.xmax - padding,
+       bounds.ymin + padding, bounds.ymin + padding + height},
+      {bounds.xmin + padding, bounds.xmin + padding + width,
+       bounds.ymax - padding - height, bounds.ymax - padding}}};
+  for (const Rect &candidate : candidates) {
+    if (candidate.xmin < bounds.xmin || candidate.xmax > bounds.xmax ||
+        candidate.ymin < bounds.ymin || candidate.ymax > bounds.ymax) continue;
+    bool free = true;
+    for (const Rect &button : buttons) {
+      if (candidate.xmin < button.xmax + padding && button.xmin - padding < candidate.xmax &&
+          candidate.ymin < button.ymax + padding && button.ymin - padding < candidate.ymax) {
+        free = false; break;
+      }
+    }
+    if (free) return {candidate, true};
+  }
+  return {};
+}
