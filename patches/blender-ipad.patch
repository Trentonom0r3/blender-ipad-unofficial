+def ipad_more_tool_inventory(context):
+    """Remaining native tools; retain every variant not directly on Base."""
+    return tuple(tool for tool in ipad_native_tool_inventory(context)
+                 if tool.idname not in IPAD_BASE_TOOL_IDS)
