+    /* Temporary native popup regions belong to the screen, not an area. */
+    if (!region) {
+      LISTBASE_FOREACH (ARegion *, live, &screen->regionbase) {
+        if (uintptr_t(live) == region_value) { region = live; break; }
+      }
+    }
+  }
+  CTX_wm_area_set(C, area);
+  CTX_wm_region_set(C, region);
+}
+
+static bool ui_ipad_ring_data_valid(bContext *C, const uiIPadRingData &data)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmWindow *window = CTX_wm_window(C);
+  if (!wm || !window || uintptr_t(window) != data.context.window ||
+      BLI_findindex(&wm->windows, window) == -1 ||
+      uintptr_t(CTX_data_main(C)) != data.context.main)
+  {
+    return false;
+  }
+  bScreen *screen = WM_window_get_active_screen(window);
+  ScrArea *area = CTX_wm_area(C);
+  ARegion *region = CTX_wm_region(C);
+  if (!screen || uintptr_t(screen) != data.context.screen || !area ||
+      uintptr_t(area) != data.context.area || BLI_findindex(&screen->areabase, area) == -1 ||
+      !region || uintptr_t(region) != data.context.region ||
+      BLI_findindex(&area->regionbase, region) == -1 || region->regiontype != RGN_TYPE_WINDOW ||
+      !region->runtime->visible || area->spacetype != SPACE_VIEW3D)
+  {
+    return false;
+  }
+  MenuType *mt = WM_menutype_find(data.menu.c_str(), false);
+  /* Native popup refresh preserves the previous top edge. If view geometry or
+   * DPI changed, close before that stabilization can undo our bounded layout. */
+  const auto receipt = ipad_ring::context_values(data.context);
+  const bool owners_valid = UI_ipad_context_matches(C, receipt.data());
+  if (!owners_valid || ui_ipad_ring_tool_identity(C) != data.tool_identity) return false;
+#ifdef WITH_APPLE_CROSSPLATFORM
+  if (!WM_event_ipad_mode_safe(C) ||
+      WM_window_native_pixel_size(window)[1] != data.window_height) return false;
+#endif
+  return ipad_ring::ring_context_matches(data.context, ui_ipad_ring_identity(C)) &&
+         data.unit == UI_UNIT_X &&
+         ipad_ring::ring_viewport_matches(data.window_rect, ui_ipad_ring_window_rect(C)) &&
+         ipad_ring::ring_viewport_matches(data.viewport, ui_ipad_ring_viewport(C)) &&
+         mt && WM_menutype_poll(C, mt);
+}
+
+bool ui_ipad_ring_context_valid(bContext *C, const uiBlock *block)
+{
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS)) {
+    return true;
+  }
+  const uiPopupBlockHandle *handle = block->handle;
+  if (!handle || !handle->can_refresh) {
+    return false;
+  }
+  const auto *data = static_cast<const uiIPadRingData *>(handle->popup_create_vars.arg);
+  return data && ui_ipad_ring_data_valid(C, *data);
+}
+
+std::string ui_ipad_ring_tool_identity(const bContext *C)
+{
+  const bToolRef *tool = WM_toolsystem_ref_from_context(C);
+  return tool ? std::string(tool->idname) : std::string();
+}
+
+bool ui_ipad_ring_action_capture(
+    bContext *C, const uiBlock *block, uint64_t values[13], std::string &tool, uint64_t &lifetime)
+{
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS) ||
+      ui_ipad_ring_waits_for_draw(block) || !ui_ipad_ring_context_valid(C, block)) return false;
+  auto *data = static_cast<uiIPadRingData *>(block->handle->popup_create_vars.arg);
+  const auto receipt = ipad_ring::context_values(data->context);
+  std::copy(receipt.begin(), receipt.end(), values);
+  if (!UI_ipad_context_matches(C, values)) return false;
+  /* Copy the native tool ID only after validating live owners. Deferred actions
+   * keep this string and scalar context, never a bToolRef, RNA or popup pointer. */
+  tool = data->tool_identity;
+  lifetime = data->lifetime;
+  if (!lifetime) return false;
+  data->input_suspended = true;
+  return true;
+}
+
+std::string ui_ipad_ring_selection_target(bContext *C, const uiBut *but)
+{
+  if (!but->optype || !STREQ(but->optype->idname, "VIEW3D_OT_ipad_selection_tool") ||
+      !but->opptr) return {};
+  PropertyRNA *prop = RNA_struct_find_property(but->opptr, "tool");
+  const char *identifier = nullptr;
+  if (!prop || RNA_property_type(prop) != PROP_ENUM ||
+      RNA_property_array_length(but->opptr, prop) != 0 ||
+      !RNA_property_enum_identifier(C, but->opptr, prop,
+          RNA_property_enum_get(but->opptr, prop), &identifier) || !identifier) return {};
+  const std::string target(identifier);
+  return target == "builtin.select_box" || target == "builtin.select_lasso" ? target : std::string();
+}
+
+bool ui_ipad_ring_waits_for_draw(const uiBlock *block)
+{
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS)) return false;
+  const uiPopupBlockHandle *handle = block->handle;
+  if (!handle || !handle->can_refresh ||
+      handle->popup_create_vars.handle_create_func != ui_ipad_ring_create) return true;
+  const auto *data = static_cast<const uiIPadRingData *>(handle->popup_create_vars.arg);
+  return !data || data->input_suspended || block->ipad_ring_lifetime != data->lifetime ||
+         block->ipad_ring_generation != data->presented_generation;
+}
+
+void ui_ipad_ring_draw_completed(const uiBlock *block, const int drawn_buttons)
+{
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS)) return;
+  const uiPopupBlockHandle *handle = block->handle;
+  if (!handle || !handle->can_refresh ||
+      handle->popup_create_vars.handle_create_func != ui_ipad_ring_create) return;
+  auto *data = static_cast<uiIPadRingData *>(handle->popup_create_vars.arg);
+  if (!data || block->ipad_ring_lifetime != data->lifetime ||
+      block->ipad_ring_generation != data->generation || block->buttons.is_empty() ||
+      drawn_buttons != data->visible_count || data->visible_count < 1) return;
+  if (ipad_ring::ring_uses_pages(ipad_ring::ring_kind(data->menu.c_str()))) return;
+  /* No draw-context owner lookup: popup drawing may have no area/WINDOW in C.
+   * The native handler validates those live owners before any button lookup. */
+  data->presented_generation = data->generation;
+  data->input_suspended = false;
+}
+
+static void ui_ipad_ring_inventory_capture(const uiBlock *block, uiIPadRingData &data);
+
+void ui_ipad_ring_draw_presented(const uiBlock *block, const ARegion *region,
+                                const rcti &local_bounds,
+                                const std::vector<uiIPadRingDrawItem> &drawn)
+{
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS)) return;
+  const uiPopupBlockHandle *handle = block->handle;
+  if (!handle || !handle->can_refresh ||
+      handle->popup_create_vars.handle_create_func != ui_ipad_ring_create) return;
+  auto *data = static_cast<uiIPadRingData *>(handle->popup_create_vars.arg);
+  if (!data || !ipad_ring::ring_uses_pages(ipad_ring::ring_kind(data->menu.c_str())) ||
+      block->ipad_ring_lifetime != data->lifetime ||
+      block->ipad_ring_generation != data->generation) return;
+  data->input_suspended = true;
+  if (data->generation <= data->refused_generation) return;
+  const auto refuse = [&]() {
+    data->refused_generation = data->generation;
+    ED_region_tag_refresh_ui(handle->region);
+    data->browse.presented_generation = 0;
+    data->browse.continuity_first = 0;
+    data->browse.inventory_key.clear();
+    data->browse.presented.clear();
+    data->browse.contact_valid = false;
+    data->browse.contact = false;
+    data->contact_serial = 0;
+    data->browse.roll_seeded = false;
+    data->roll_serial = 0;
+    data->roll_generation = 0;
+#ifdef WITH_APPLE_CROSSPLATFORM
+    ghost::ios::retire_pencil_ring(data->ghost_window, data->lifetime);
+#endif
+  };
+  if (int(drawn.size()) != data->visible_count || data->visible_count < 1) {
+    refuse(); return;
+  }
+  for (const auto &button : block->buttons) {
+    if (!(button->flag & UI_HIDDEN) && !button->ipad_ring_label_fit) {
+      refuse();
+      block->handle->menuretval = UI_RETURN_CANCEL;
+      return;
+    }
+  }
+  const float dx = float(region->winrct.xmin), dy = float(region->winrct.ymin);
+  const ipad_ring::Rect bounds{local_bounds.xmin + dx, local_bounds.xmax + dx,
+                               local_bounds.ymin + dy, local_bounds.ymax + dy};
+  /* Refuse partially clipped targets. These are the actual pixel rectangles
+   * after native popup clipping, translation and projection, not desired layout. */
+  if (bounds.xmin < data->viewport.xmin || bounds.xmax > data->viewport.xmax ||
+      bounds.ymin < data->viewport.ymin || bounds.ymax > data->viewport.ymax) { refuse(); return; }
+  /* Native end/poll and old active-button migration have now completed.
+   * Snapshot the final actual buttons, never the creator's provisional ones. */
+  ui_ipad_ring_inventory_capture(block, *data);
+  std::vector<ipad_ring::RingPresentedItem> items;
+  for (const auto &item : drawn) {
+    if (item.index < 0 || item.index >= data->inventory_count ||
+        item.rect.xmin < 0 || item.rect.ymin < 0 ||
+        item.rect.xmax > BLI_rcti_size_x(&region->winrct) + 1 ||
+        item.rect.ymax > BLI_rcti_size_y(&region->winrct) + 1) { refuse(); return; }
+    items.push_back({{item.rect.xmin + dx, item.rect.xmax + dx,
+                      item.rect.ymin + dy, item.rect.ymax + dy},
+                     data->menu + ":" + std::to_string(item.index),
+                     item.index < int(data->refresh_taps.size()) && data->refresh_taps[item.index]});
+  }
+  const float cx = (bounds.xmin + bounds.xmax) * 0.5f;
+  const float cy = (bounds.ymin + bounds.ymax) * 0.5f;
+  auto candidate = data->browse;
+  if (!candidate.publish(data->lifetime, data->generation, std::move(items),
+                            data->inventory_count, bounds, cx, cy, data->unit,
+                            data->inventory_key, data->navigation_rebuild)) { refuse(); return; }
+#ifdef WITH_APPLE_CROSSPLATFORM
+  const ghost::ios::NavigationRect capture{int(bounds.xmin),
+      data->window_height - int(bounds.ymax), int(bounds.xmax) - 1,
+      data->window_height - int(bounds.ymin) - 1};
+  if (!ghost::ios::publish_pencil_ring(data->ghost_window,
+                                      {data->lifetime, data->generation, capture, !ui_ipad_ring_child_open(block)})) { refuse(); return; }
+#endif
+  data->browse = std::move(candidate);
+  data->presented_generation = data->generation;
+  data->input_suspended = false;
+}
+
+void ui_ipad_ring_capture_suspend(const uiBlock *block)
+{
+#ifdef WITH_APPLE_CROSSPLATFORM
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS) || !block->handle ||
+      block->handle->popup_create_vars.handle_create_func != ui_ipad_ring_create) return;
+  auto *data = static_cast<uiIPadRingData *>(block->handle->popup_create_vars.arg);
+  if (data) {
+    data->browse.contact = false; data->browse.contact_valid = false;
+    data->browse.rotating = false; data->browse.roll_seeded = false;
+    data->contact_serial = 0; data->roll_serial = 0;
+    ghost::ios::pencil_ring_contact_enabled(data->ghost_window, data->lifetime, false);
+  }
+#else
+  (void)block;
+#endif
+}
