 int UI_blocklist_min_y_get(ListBase *lb)
 {
   int min = 0;
 
   LISTBASE_FOREACH (uiBlock *, block, lb) {
     if (block == lb->first || block->rect.ymin < min) {
       min = block->rect.ymin;
     }
   }
 
   return min;
 }
 
