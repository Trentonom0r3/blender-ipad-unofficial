+/* Clamp every category using the full Tools footprint so category switches
+ * keep their origin. Base itself presents/captures only its smaller footprint. */
+inline RingPageLayout ring_page_layout(float unit, Rect viewport, float x, float y,
+                                       int total, float phase, bool touch = false,
+                                       bool compact_base = false)
+{
+  RingPageLayout result;
+  if (!std::isfinite(unit) || unit <= 0 || total < 1 || total > 4096 ||
+      !std::isfinite(x) || !std::isfinite(y) || !std::isfinite(phase) ||
+      !std::isfinite(viewport.xmin) || !std::isfinite(viewport.xmax) ||
+      !std::isfinite(viewport.ymin) || !std::isfinite(viewport.ymax)) return result;
+  const float width = 4.7f * unit;
+  const float height = (touch ? 2.2f : 1.7f) * unit;
+  if (compact_base && total > 9) return result;
+  float radius = 7.6f * unit;
+  const float gap = .25f * unit;
+  float extent_x = 2 * radius + width, extent_y = 2 * radius + height;
+  const float available_x = viewport.xmax - viewport.xmin - 2 * gap;
+  const float available_y = viewport.ymax - viewport.ymin - 2 * gap;
+  int columns = 3;
+  if (extent_x > available_x || extent_y > available_y) {
+    result.grid = true;
+    if (available_x < width || available_y < height) return result;
+    columns = std::clamp(int((available_x + gap) / (width + gap)), 1, 3);
+    extent_x = columns * width + (columns - 1) * gap;
+    const int rows = (9 + columns - 1) / columns;
+    extent_y = rows * height + (rows - 1) * gap;
+  }
+  if (extent_x > available_x || extent_y > available_y) return result;
+  result.center_x = x = std::clamp(x, viewport.xmin + gap + extent_x / 2,
+                                  viewport.xmax - gap - extent_x / 2);
+  result.center_y = y = std::clamp(y, viewport.ymin + gap + extent_y / 2,
+                                  viewport.ymax - gap - extent_y / 2);
+  if (compact_base && total <= 6 && !result.grid) {
+    radius = 4.9f * unit;
+    extent_x = 2 * radius + width;
+    extent_y = 2 * radius + height;
+  }
+  result.footprint = {x - extent_x / 2, x + extent_x / 2,
+                      y - extent_y / 2, y + extent_y / 2};
+  const int visible = std::min(total, 9);
+  const int angular_slots = visible;
+  phase = total > 9 ? std::remainder(phase, float(total)) : 0;
+  const int first = int(std::floor(phase));
+  const float fraction = phase - std::floor(phase);
+  for (int i = 0; i < visible; ++i) {
+    float cx, cy;
+    if (result.grid) {
+      cx = result.footprint.xmin + width / 2 + (i % columns) * (width + gap);
+      cy = result.footprint.ymax - height / 2 - (i / columns) * (height + gap);
+    }
+    else {
+      const float angle = (float(i) - fraction) * 6.283185307179586f / angular_slots;
+      cx = x + std::sin(angle) * radius;
+      cy = y + std::cos(angle) * radius;
+    }
+    result.buttons.push_back({cx - width / 2, cx + width / 2, cy - height / 2, cy + height / 2});
+    result.indices.push_back(((first + i) % total + total) % total);
+  }
+  result.fits = true;
+  return result;
+}
