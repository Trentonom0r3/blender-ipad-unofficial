+    bl_label = "Drag Constraint"
+    bl_description = "Constrain the next native tool drag to an axis or plane"
+
+    axis: bpy.props.EnumProperty(items=tuple((name, label, "") for name, label, _ in IPAD_TRANSFORM_AXES))
+
+    @classmethod
+    def poll(cls, context):
+        state = ipad_transform_state(context)
+        return ipad_transform_context(context) and state is not None and state[2] is not None
+
+    def execute(self, context):
+        state = ipad_transform_state(context)
+        if state is None or state[2] is None or (state[1] == 'ROTATE' and self.axis in {'XY', 'XZ', 'YZ'}):
+            return {'CANCELLED'}
+        active, _, operator, _ = state
+        active.operator_properties(operator).constraint_axis = next(
+            axes for name, _, axes in IPAD_TRANSFORM_AXES if name == self.axis)
+        context.area.tag_redraw()
+        return {'FINISHED'}
