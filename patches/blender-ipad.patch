     }
   }
 
   return desc;
 }
 
 static int rna_ui_get_enum_icon(bContext *C,
                                 PointerRNA *ptr,
                                 const char *propname,
                                 const char *identifier)
 {
   PropertyRNA *prop = nullptr;
   const EnumPropertyItem *items = nullptr;
   bool free;
   int icon = ICON_NONE;
 
   prop = RNA_struct_find_property(ptr, propname);
