+def draw_editing_shelf(layout, context, width_units=None):
+    """Shared by the shipped native WINDOW block and the host layout preview."""
+    width = layout.ui_units_x if width_units is None else width_units
+    wide, minimal = width >= 28, width < 15.4
+    column = layout.column(align=True)
+    column.operator_context = 'INVOKE_REGION_WIN'
+    active = ToolSelectPanelHelper.tool_active_from_context(context)
+    state = ipad_transform_state(context)
+    tool, selection_mode, shape = ipad_selection_state(context)
+    active_id = active.idname if active else None
+    selection = active_id in {'builtin.select_box', 'builtin.select_lasso'}
+    operation, operator, slot = state[1:] if state else (None, None, 1)
+    props = state[0].operator_properties(operator) if operator else None
+    constraint = next((text for _, text, axes in IPAD_TRANSFORM_AXES
+                       if props and tuple(props.constraint_axis) == axes), "Custom")
+    action = dict((value, text) for text, value in IPAD_SELECTION_MODES).get(selection_mode, "Custom")
+    if selection:
+        title = f"Select · {shape} · {action}"
+        panel = 'VIEW3D_PT_ipad_selection'
+    elif state:
+        title = f"{operation.title()} · {constraint}" if operation else "Transform"
+        if active_id == 'builtin.transform':
+            title = "Transform · " + title if operator else "Transform · choose action"
+        if operator:
+            title += f" · {ipad_transform_orientation(context, slot).type.title()}"
+            if props.use_accurate:
+                title += " · Fine"
+            if context.tool_settings.use_snap:
+                title += " · Snap"
+        panel = 'VIEW3D_PT_ipad_transform'
+    else:
+        title = (active_id or "No active tool").removeprefix('builtin.').replace('_', ' ').title()
+        panel = ('VIEW3D_PT_ipad_bevel' if ipad_bevel_state(context) else
+                 None)
+    mode_name = {"OBJECT": "Object", "EDIT_MESH": "Mesh", "POSE": "Pose"}.get(
+        context.mode, context.mode.removeprefix('EDIT_').replace('_', ' ').title())
+    if not ipad_editing_shelf_expanded(context):
+        draw_compact_editing_shelf(column, context, width, mode_name, title, state, active_id)
+        return
+    top = column.row(align=True)
+    modes = top.column(align=True)
+    modes.scale_y = 2.2
+    ipad_mode_button(modes, context)
+    top.label(text=title)
+    # Equal cells protect icon-only Undo/Redo/axis targets from native row shrink.
+    tools = column.grid_flow(row_major=True, columns=3 if minimal else 8 if wide else 4,
+                             even_columns=True, even_rows=True, align=True)
+    tools.scale_y = 2.2
+    if minimal:
+        tools.popover(panel='VIEW3D_PT_ipad_editing_tools', text="Tools", icon='TOOL_SETTINGS')
+    else:
+        ipad_editing_tool_buttons(tools, context, compact=not wide)
+    tools.operator('ed.undo', text="", icon='LOOP_BACK')
+    tools.operator('ed.redo', text="", icon='LOOP_FORWARDS')
+    more_text = "More" if selection or state or ipad_bevel_state(context) else "Selection"
+    if panel:
+        tools.popover(panel=panel, text=more_text, icon='PREFERENCES')
+    else:
+        tools.operator('wm.search_menu', text='Search' if wide else '', icon='VIEWZOOM')
+    tools.operator('view3d.ipad_shelf_toggle', text='Collapse').expanded = False
+
+    count = (3 if minimal else (8 if wide and context.mode == 'EDIT_MESH' else 5)) if selection else (7 if wide and props else 4 if props else 1)
+    controls = column.grid_flow(row_major=True, columns=count,
+                                even_columns=True, even_rows=True, align=True)
+    controls.scale_y = 2.2
+    if selection:
+        if not minimal:
+            for text, name, _, _ in IPAD_SELECTION_TOOLS:
+                choice = controls.operator('view3d.ipad_selection_tool', text=text,
+                                           depress=tool == name)
+                choice.tool = name
+                choice.mode = selection_mode if selection_mode in {'SET', 'ADD', 'SUB'} else 'SET'
+        for text, value in IPAD_SELECTION_MODES:
+            choice = controls.operator('view3d.ipad_selection_tool', text=text,
+                                       depress=selection_mode == value)
+            choice.tool, choice.mode = tool, value
+        if context.mode == 'EDIT_MESH' and not minimal:
+            elements = controls if wide else column.grid_flow(row_major=True, columns=3, even_columns=True, even_rows=True, align=True)
+            if not wide:
+                elements.scale_y = 2.2
+            for index, (value, icon) in enumerate((
+                    ('VERT', 'VERTEXSEL'), ('EDGE', 'EDGESEL'), ('FACE', 'FACESEL'))):
+                elements.operator('mesh.select_mode', text="", icon=icon,
+                                  depress=context.tool_settings.mesh_select_mode[index]).type = value
+    elif props:
+        for name, text, axes in IPAD_TRANSFORM_AXES[:4]:
+            controls.operator('view3d.ipad_transform_axis', text=text,
+                              depress=tuple(props.constraint_axis) == axes).axis = name
+        if not minimal:
+            precise = controls if wide else column.grid_flow(row_major=True, columns=3, even_columns=True, even_rows=True, align=True)
+            if not wide:
+                precise.scale_y = 2.2
+            precise.prop(props, 'use_accurate', text="Fine", toggle=True)
+            precise.prop(context.tool_settings, 'use_snap', text="Snap", toggle=True)
+            numbers = precise.operator('view3d.ipad_transform_numbers', text="Numbers")
+            numbers.operation, numbers.slot_index = operation, slot
+            numbers.axis = next((axis for index, axis in enumerate('XYZ')
+                                 if props.constraint_axis[index] and sum(props.constraint_axis) == 1), 'Z')
+    elif panel:
+        controls.popover(panel=panel, text="Bevel Options" if ipad_bevel_state(context) else "Choose transform action",
+                         icon='TOOL_SETTINGS')
+    direct = bool(props or ipad_bevel_state(context) or
+                  (active_id == 'builtin.extrude_region' and context.mode == 'EDIT_MESH'))
+    column.label(text="Tap or drag · two fingers to orbit" if selection else
+                 "Drag selection · lift to finish" if direct else "Tool active · two fingers to orbit")
+
+
+class VIEW3D_HT_ipad_editing_shelf(Header):
+    bl_space_type = 'VIEW_3D'
