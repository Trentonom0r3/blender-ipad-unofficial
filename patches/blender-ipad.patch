+/* Native arithmetic has no Python/global namespace or UI callbacks. Keep the
+ * copied unit settings independent of the enclosing button/event/list frame. */
+static bool ui_ipad_numbers_eval_native(const char *str,
+                                        const UnitSettings *unit,
+                                        const int unit_type,
+                                        double *r_value)
+{
+  if (!str || strlen(str) >= 256) return false;
+  if (!str[0]) { *r_value = 0.0; return true; }
+  char converted[8192];
+  const char *expression = str;
+  double scale = 1.0;
+  bool explicit_unit = false;
+  if (unit) {
+    scale = BKE_unit_value_scale(*unit, unit_type, 1.0);
+    if (!std::isfinite(scale) || scale == 0.0) return false;
+    explicit_unit = BKE_unit_string_contains_unit(str, unit_type);
+    if (explicit_unit) {
+      STRNCPY_UTF8(converted, str);
+      BKE_unit_replace_string(converted, sizeof(converted), str, scale, unit->system, unit_type);
+      expression = converted;
+    }
+  }
+  ExprPyLike_Parsed *parsed = BLI_expr_pylike_parse(expression, nullptr, 0);
+  double value = 0.0;
+  const bool success = BLI_expr_pylike_is_valid(parsed) &&
+      BLI_expr_pylike_eval(parsed, nullptr, 0, &value) == EXPR_PYLIKE_SUCCESS;
+  BLI_expr_pylike_free(parsed);
+  if (!success) return false;
+  if (unit && !explicit_unit) value = BKE_unit_apply_preferred_unit(*unit, unit_type, value) / scale;
+  if (!std::isfinite(value)) return false;
+  *r_value = value;
+  return true;
+}
+
 bool ui_but_string_eval_number(bContext *C, const uiBut *but, const char *str, double *r_value)
 {
+  if (!ui_ipad_numbers_but_rebind(const_cast<uiBut *>(but))) return false;
+  if (but->block->ipad_action_origin.present()) {
+    UnitSettings unit{};
+    const bool uses_unit = ui_but_is_unit(but);
+    if (uses_unit) {
+      Scene *scene = CTX_data_scene(C);
+      if (!ui_ipad_rna_main_member(C, reinterpret_cast<ID *>(scene)) ||
+          !but->block->unit) return false;
+      /* UI_block_begin owns a UnitSettings copy so that a later Scene free
+       * cannot invalidate displayed units. Keep the native presented copy. */
+      unit = *but->block->unit;
+    }
+    const bool success = ui_ipad_numbers_eval_native(str, uses_unit ? &unit : nullptr,
+        RNA_SUBTYPE_UNIT_VALUE(UI_but_unit_type_get(but)), r_value);
+    if (!success) BKE_report(CTX_wm_reports(C), RPT_ERROR,
+        "Use a number, arithmetic or units; Python and drivers are unavailable in Transform by Numbers");
+    return success;
+  }
   if (str[0] == '\0') {
     *r_value = 0.0;
     return true;
   }
 
   PropertySubType subtype = PROP_NONE;
   if (but->rnaprop) {
     subtype = RNA_property_subtype(but->rnaprop);
   }
 
   if (ui_but_is_float(but)) {
     if (ui_but_is_unit(but)) {
       return ui_number_from_string_units_with_but(C, str, but, r_value);
     }
     if (subtype == PROP_FACTOR) {
       return ui_number_from_string_factor(C, str, r_value);
     }
     if (subtype == PROP_PERCENTAGE) {
       return ui_number_from_string_percentage(C, str, r_value);
     }
     return ui_number_from_string(C, str, r_value);
   }
   return ui_number_from_string(C, str, r_value);
 }
 
