+bool ui_ipad_numbers_popup_valid(bContext *C, uiPopupBlockHandle *handle)
+{
+  if (!handle->ipad_numbers) return true;
+  if (ui_ipad_registered_popup_resolve(C, handle->ipad_action_origin,
+                                       handle->ipad_popup_lifetime) != handle) return false;
+  /* Lookup the registration before reading the pending operator's type or
+   * property metadata. It is owned by this live UI handler, not WM history. */
+  wmOperatorType *ot = WM_operatortype_find("VIEW3D_OT_ipad_transform_numbers", true);
+  if (!ot || ui_ipad_rna_address(ot) != handle->ipad_numbers_type) return false;
+  wmOperator *op = handle->popup_op;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || !ui_ipad_rna_main_member(C, &wm->id) || !op ||
+      ui_ipad_rna_address(op) != handle->ipad_numbers_operator || op->type != ot ||
+      !op->ptr || ui_ipad_rna_address(op->ptr) != handle->ipad_numbers_ptr ||
+      !op->properties || ui_ipad_rna_address(op->properties) != handle->ipad_numbers_properties)
+    return false;
+  return op->ptr->owner_id == &wm->id && op->ptr->type == ot->srna &&
+         op->ptr->data == op->properties && op->properties->type == IDP_GROUP;
+}
