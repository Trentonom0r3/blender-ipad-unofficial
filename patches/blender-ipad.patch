+static bool ui_ipad_hud_field_world(bContext *C, uiBut *but, ARegion *hud,
+                                     uiIPadHUDField &field)
+{
+  const uintptr_t previous_area = uintptr_t(CTX_wm_area(C)), previous_region = uintptr_t(CTX_wm_region(C));
+  wmWindowManager *wm = CTX_wm_manager(C); wmWindow *win = CTX_wm_window(C);
+  if (!wm || !win || BLI_findindex(&wm->windows, win) == -1) return false;
+  bScreen *screen = WM_window_get_active_screen(win);
+  ScrArea *area = nullptr;
+  LISTBASE_FOREACH (ScrArea *, candidate, &screen->areabase) {
+    if (BLI_findindex(&candidate->regionbase, hud) != -1) { area = candidate; break; }
+  }
+  if (!area || hud->regiontype != RGN_TYPE_HUD || !hud->runtime->visible ||
+      (hud->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED))) return false;
+  CTX_wm_area_set(C, area);
+  ARegion *canvas = UI_ipad_corner_hud_window(C, area, hud);
+  if (!canvas) { ui_ipad_action_context_restore(C, previous_area, previous_region); return false; }
+  CTX_wm_region_set(C, canvas);
+  const bool captured = UI_ipad_context_capture(C, field.context.data()) && WM_event_ipad_mode_safe(C);
+  if (captured) {
+    field.tool = ui_ipad_ring_tool_identity(C);
+    const auto pixels = WM_window_native_pixel_size(win);
+    field.width = pixels[0]; field.height = pixels[1]; field.scale = UI_SCALE_FAC;
+    const UndoStack *undo = wm->runtime ? wm->runtime->undo_stack : nullptr;
+    field.undo_address = uint64_t(uintptr_t(undo));
+    field.undo_lifetime = undo ? undo->ipad_lifetime_id : 0;
+    field.undo_mutation = undo ? undo->ipad_mutation_generation : 0;
+    field.button = but->ipad_ui_lifetime; field.hud_address = uint64_t(uintptr_t(hud));
+    field.hud_lifetime = hud->runtime->ipad_hud_content_lifetime;
+    if (but->block->name == "OPERATOR_PT_redo") {
+      wmOperator *outer = WM_operator_last_redo(C);
+      if (!outer || BLI_findindex(&wm->runtime->operators, outer) == -1 ||
+          !(field.outer_type = ui_ipad_operator_capture(outer->type)).lifetime)
+      {
+        ui_ipad_action_context_restore(C, previous_area, previous_region);
+        return false;
+      }
+      field.outer_address = uint64_t(uintptr_t(outer));
+      field.outer_lifetime = WM_operator_touch_lifetime_id(outer);
+      if (!field.outer_lifetime) {
+        ui_ipad_action_context_restore(C, previous_area, previous_region);
+        return false;
+      }
+    }
+  }
+  ui_ipad_action_context_restore(C, previous_area, previous_region);
+  return captured;
+}
