+ * its copied callback only after a provider Save has actually started. */
+static wmGenericCallback *ipad_close_callback_handoff = nullptr;
+static uint64_t ipad_next_close_ticket = 0;
+struct IpadReadyCloseAction {
+  wmGenericCallback *callback = nullptr;
+  Main *main = nullptr;
+  wmWindow *window = nullptr;
+  uint64_t modification_generation = 0;
+  uint64_t ticket = 0;
+};
+static IpadReadyCloseAction ipad_ready_close_action;
+
+struct IpadFilesSaveData {
+  bool save_copy;
+  bool provider_update;
+  bool reported_pending_save;
+  uint64_t modification_generation;
+  Main *main_at_stage;
+  wmGenericCallback *post_close_callback;
+};
+
+static void wm_save_to_files_data_free(wmOperator *op)
+{
+  if (auto *data = static_cast<IpadFilesSaveData *>(op->customdata)) {
+    if (data->post_close_callback) {
+      GHOST_IOS_recent_project_cancel();
+      WM_generic_callback_free(data->post_close_callback);
+    }
+    MEM_freeN(data);
+    op->customdata = nullptr;
+  }
+}
+
+static void wm_save_to_files_cancel(bContext * /*C*/, wmOperator *op)
+{
+  GHOST_IOS_project_export_cancel();
+  wm_save_to_files_data_free(op);
+}
+
+static wmOperatorStatus wm_save_to_files_modal(bContext *C,
+                                               wmOperator *op,
+                                               const wmEvent *event)
+{
+  IpadFilesSaveData *data = static_cast<IpadFilesSaveData *>(op->customdata);
+  if (!data) {
+    GHOST_IOS_project_export_cancel();
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type == EVT_ESCKEY && event->val == KM_PRESS) {
+    if (data->provider_update) {
+      if (!data->reported_pending_save) {
+        BKE_report(op->reports, RPT_INFO, "Saving to Files; wait for the result");
+        data->reported_pending_save = true;
+      }
+      return OPERATOR_RUNNING_MODAL;
+    }
+    wm_save_to_files_data_free(op);
+    GHOST_IOS_project_export_cancel();
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type != IPAD_PROJECT_EXPORT) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  char path[FILE_MAX];
+  const GHOST_IOSProjectExportAction action = GHOST_IOS_project_export_take_action(
+      path, sizeof(path));
+  if (action == GHOST_IOSProjectExportAction_Compress ||
+      action == GHOST_IOSProjectExportAction_NoCompress)
+  {
+    char staging_path[FILE_MAX];
+    if (!GHOST_IOS_project_export_staging_path(staging_path, sizeof(staging_path))) {
+      BKE_report(op->reports, RPT_ERROR, "Could not prepare a temporary project for Files");
+      wm_save_to_files_data_free(op);
+      GHOST_IOS_project_export_cancel();
+      return OPERATOR_CANCELLED;
+    }
+    int flags = G.fileflags;
+    SET_FLAG_FROM_TEST(flags, action == GHOST_IOSProjectExportAction_Compress, G_FILE_COMPRESS);
+    const eBLO_WritePathRemap remap = data->save_copy ? BLO_WRITE_PATH_REMAP_ABSOLUTE :
+                                                       BLO_WRITE_PATH_REMAP_RELATIVE;
+    /* Keep Main's filepath and dirty state intact while Files owns the destination choice. */
+    if (!wm_file_write(C, staging_path, flags, remap, true, op->reports)) {
+      wm_save_to_files_data_free(op);
+      GHOST_IOS_project_export_cancel();
+      return OPERATOR_CANCELLED;
+    }
+    data->modification_generation = ipad_file_modified_generation;
+    data->main_at_stage = CTX_data_main(C);
+    if (!GHOST_IOS_project_export_present_picker()) {
+      BKE_report(op->reports, RPT_ERROR, "Could not present the Files save sheet");
+      wm_save_to_files_data_free(op);
+      GHOST_IOS_project_export_cancel();
+      return OPERATOR_CANCELLED;
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (action == GHOST_IOSProjectExportAction_Saved) {
+    if (!data->save_copy) {
+      Main *bmain = CTX_data_main(C);
+      const bool same_main = bmain && bmain == data->main_at_stage;
+      const bool snapshot_current = same_main &&
+                                    data->modification_generation == ipad_file_modified_generation;
+      if (same_main && !data->provider_update) {
+        STRNCPY(bmain->filepath, path);
+      }
+      if (snapshot_current) {
+        bmain->has_forward_compatibility_issues = false;
+        bmain->colorspace.is_missing_opencolorio_config = false;
+        /* Set the saved flag now. A later edit can clear it before notifiers
+         * are drained; a delayed ND_FILESAVE would incorrectly set it again. */
+        if (wmWindowManager *wm = CTX_wm_manager(C)) {
+          wm->file_saved = 1;
+          WM_event_add_notifier(C, NC_WM | ND_DATACHANGED, nullptr);
+        }
+      }
+      else if (same_main) {
+        /* The provider wrote the staged snapshot, but later edits must retain
+         * Blender's unsaved marker and autosave schedule. */
+        WM_file_tag_modified();
+      }
+      if (wmWindowManager *wm = CTX_wm_manager(C)) {
+        if (snapshot_current) {
+          wm_autosave_timer_end(wm);
+          wm_autosave_timer_begin(wm);
+          wm->autosave_scheduled = false;
+        }
+        BKE_reportf(&wm->runtime->reports, RPT_INFO,
+                    !same_main ? "Saved prior project \"%s\"; current project unchanged" :
+                    !snapshot_current ? "Saved snapshot \"%s\"; newer edits remain unsaved" :
+                    data->provider_update ? "Saved \"%s\"" : "Saved as \"%s\"",
+                    BLI_path_basename(path));
+      }
+    }
+    else {
+      BKE_reportf(op->reports, RPT_INFO, "Saved copy as \"%s\"", BLI_path_basename(path));
+      const Main *current = CTX_data_main(C);
+      if (current && current == data->main_at_stage &&
+          !BLI_listbase_is_empty(&current->libraries))
+      {
+        BKE_report(op->reports,
+                   RPT_WARNING,
+                   "This .blend copy may need separate linked library files when shared");
+      }
+    }
+    if (data->post_close_callback) {
+      Main *current = CTX_data_main(C);
+      if (current && current == data->main_at_stage) {
+        const uint64_t ticket = ++ipad_next_close_ticket;
+        if (GHOST_IOS_project_export_queue_close_resume(ticket)) {
+          if (ipad_ready_close_action.callback) {
+            WM_generic_callback_free(ipad_ready_close_action.callback);
+          }
+          ipad_ready_close_action = {data->post_close_callback,
+                                     current,
+                                     CTX_wm_window(C),
+                                     ipad_file_modified_generation,
+                                     ticket};
+          data->post_close_callback = nullptr;
+        }
+      }
+    }
+    wm_save_to_files_data_free(op);
+    GHOST_IOS_project_export_finish();
+    return OPERATOR_FINISHED;
+  }
+  if (action == GHOST_IOSProjectExportAction_Conflict) {
+    BKE_report(op->reports, RPT_ERROR,
+               "Files project differs or cannot be checked. Use Save As to keep edits, then reopen the original");
+    wm_save_to_files_data_free(op);
+    GHOST_IOS_project_export_finish();
+    return OPERATOR_CANCELLED;
+  }
+  if (action == GHOST_IOSProjectExportAction_MirrorFailed) {
+    BKE_report(op->reports, RPT_ERROR,
+               "Files project saved, but its local working file could not be refreshed; retry Save or use Save As");
+    wm_save_to_files_data_free(op);
+    GHOST_IOS_project_export_finish();
+    return OPERATOR_CANCELLED;
+  }
+  if (action == GHOST_IOSProjectExportAction_Failed) {
+    BKE_report(op->reports, RPT_ERROR,
+               data->provider_update ? "Could not write the Files project; the project remains unsaved" :
+                                       "Files created the project but Blender could not retain access; reopen it from Files");
+    wm_save_to_files_data_free(op);
+    GHOST_IOS_project_export_finish();
+    return OPERATOR_CANCELLED;
+  }
+  if (action == GHOST_IOSProjectExportAction_Cancelled) {
+    wm_save_to_files_data_free(op);
+    GHOST_IOS_project_export_finish();
+    return OPERATOR_CANCELLED;
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
+
+static wmOperatorStatus wm_save_to_files_invoke(bContext *C,
+                                                 wmOperator *op,
+                                                 const bool save_copy)
+{
+  Main *bmain = CTX_data_main(C);
+  const char *path = BKE_main_blendfile_path(bmain);
+  const char *filename = path[0] ? BLI_path_basename(path) : "Untitled.blend";
+  op->customdata = MEM_callocN<IpadFilesSaveData>("iPad Files save data");
+  static_cast<IpadFilesSaveData *>(op->customdata)->save_copy = save_copy;
+  if (!GHOST_IOS_begin_project_export(filename, save_copy)) {
+    BKE_report(op->reports, RPT_ERROR, "Could not open Files sheet. Close other dialogs and try again");
+    wm_save_to_files_data_free(op);
+    return OPERATOR_CANCELLED;
+  }
+  WM_event_add_modal_handler(C, op);
+  return OPERATOR_RUNNING_MODAL;
+}
+
+static wmOperatorStatus wm_save_provider_invoke(bContext *C, wmOperator *op)
+{
+  const char *current = BKE_main_blendfile_path(CTX_data_main(C));
+  op->customdata = MEM_callocN<IpadFilesSaveData>("iPad Files provider save data");
+  auto *data = static_cast<IpadFilesSaveData *>(op->customdata);
+  data->provider_update = true;
+  if (!GHOST_IOS_begin_project_update(current)) {
+    BKE_report(op->reports, RPT_ERROR, "Could not begin a coordinated Files save");
+    wm_save_to_files_data_free(op);
+    return OPERATOR_CANCELLED;
+  }
+  char staging_path[FILE_MAX];
+  if (!GHOST_IOS_project_export_staging_path(staging_path, sizeof(staging_path)) ||
+      !wm_file_write(C, staging_path, G.fileflags, BLO_WRITE_PATH_REMAP_NONE, true, op->reports) ||
+      !GHOST_IOS_project_export_publish_update())
+  {
+    BKE_report(op->reports, RPT_ERROR, "Could not stage the project for Files");
+    wm_save_to_files_data_free(op);
+    GHOST_IOS_project_export_cancel();
+    return OPERATOR_CANCELLED;
+  }
+  data->modification_generation = ipad_file_modified_generation;
+  data->main_at_stage = CTX_data_main(C);
+  data->post_close_callback = ipad_close_callback_handoff;
+  ipad_close_callback_handoff = nullptr;
+  WM_event_add_modal_handler(C, op);
+  return OPERATOR_RUNNING_MODAL;
+}
+
+void wm_ipad_close_after_save_resume(bContext *C, wmWindow *window, uint64_t ticket)
+{
+  if (!ticket || ticket != ipad_ready_close_action.ticket ||
+      !ipad_ready_close_action.callback)
+  {
+    return;
+  }
+  IpadReadyCloseAction pending = ipad_ready_close_action;
+  ipad_ready_close_action = {};
+  if (window != pending.window || CTX_data_main(C) != pending.main) {
+    WM_generic_callback_free(pending.callback);
+    return;
+  }
+  if (ipad_file_modified_generation != pending.modification_generation ||
+      wm_file_or_session_data_has_unsaved_changes(CTX_data_main(C), CTX_wm_manager(C)))
+  {
+    /* Edits made during the asynchronous write need a fresh explicit choice. */
+    wm_close_file_dialog(C, pending.callback);
+    return;
+  }
+  pending.callback->exec(C, pending.callback->user_data);
+  WM_generic_callback_free(pending.callback);
+}
