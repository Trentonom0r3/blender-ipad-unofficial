 UndoStep *BKE_undosys_step_same_type_next(UndoStep *us)
 {
   if (us) {
     const UndoType *ut = us->type;
     while ((us = us->next)) {
       if (us->type == ut) {
         return us;
       }
     }
   }
   return us;
 }
 
