+
+/* Native HUD receipts deliberately do not own operators, RNA or UI pointers.
+ * Cached textures keep their original content owner; compositing cannot make
+ * an old UI tree current merely by observing a newer scene/history. */
+namespace {
+struct IPadHUDOwner {
+  std::array<uint64_t, 13> context{};
+  std::array<char, 64> tool{};
+  uint64_t hud_address = 0, hud_lifetime = 0, buffer_address = 0;
+  uint64_t redo_address = 0, redo_lifetime = 0, redo_type_address = 0, redo_type_lifetime = 0;
+  uint64_t undo_address = 0, undo_lifetime = 0, undo_mutation = 0;
+  int window_width = 0, window_height = 0;
+  float ui_scale = 0.0f;
+  rcti region_rect{};
+  bool valid = false;
+};
+struct IPadHUDContent {
+  IPadHUDOwner layout_before, layout_after, texture;
+  bool layout_ready = false;
+};
+struct IPadHUDPresentation {
+  IPadHUDOwner owner;
+  std::vector<rcti> rects;
+  uint64_t generation = 0;
+};
+struct IPadHUDFrame {
+  uint64_t window_id = 0;
+  bool pending = false;
+  std::vector<IPadHUDPresentation> presented, drawing;
+};
+static std::unordered_map<uint64_t, IPadHUDContent> ipad_hud_contents;
+static std::unordered_map<uintptr_t, IPadHUDFrame> ipad_hud_frames;
+static uint64_t ipad_hud_next_identity = 1;
+
+static uint64_t ipad_hud_new_identity()
+{
+  if (ipad_hud_next_identity == std::numeric_limits<uint64_t>::max()) return 0;
+  return ipad_hud_next_identity++;
+}
+static bool ipad_hud_rect_equal(const rcti &a, const rcti &b)
+{
+  return a.xmin == b.xmin && a.ymin == b.ymin && a.xmax == b.xmax && a.ymax == b.ymax;
+}
+static bool ipad_hud_owner_equal(const IPadHUDOwner &a, const IPadHUDOwner &b,
+                                 const bool geometry)
+{
+  return a.redo_address == b.redo_address && a.redo_lifetime == b.redo_lifetime &&
+         a.redo_type_address == b.redo_type_address && a.redo_type_lifetime == b.redo_type_lifetime &&
+         a.valid && b.valid && a.context == b.context && a.tool == b.tool &&
+         a.hud_address == b.hud_address && a.hud_lifetime == b.hud_lifetime &&
+         a.undo_address == b.undo_address && a.undo_lifetime == b.undo_lifetime &&
+         a.undo_mutation == b.undo_mutation && a.window_width == b.window_width &&
+         a.window_height == b.window_height && a.ui_scale == b.ui_scale &&
+         (!geometry || (a.buffer_address == b.buffer_address &&
+                        ipad_hud_rect_equal(a.region_rect, b.region_rect)));
+}
+static bool ipad_hud_window_live(bContext *C, const wmWindow *win)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  return wm && win && BLI_findindex(&wm->windows, win) != -1;
+}
+static bool ipad_hud_owner_capture(bContext *C, wmWindow *win, ScrArea *area,
+                                    ARegion *hud, IPadHUDOwner &owner)
+{
+  owner = {};
+  if (!ipad_hud_window_live(C, win)) return false;
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!screen || !ED_ipad_panels_enabled(screen) || !area ||
+      BLI_findindex(&screen->areabase, area) == -1 || !hud ||
+      BLI_findindex(&area->regionbase, hud) == -1 || hud->regiontype != RGN_TYPE_HUD ||
+      !hud->runtime->ipad_hud_content_lifetime || area->spacetype != SPACE_VIEW3D ||
+      !ED_ipad_panels_area_visible(area) || !hud->runtime->visible ||
+      (hud->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER | RGN_FLAG_TOO_SMALL |
+                    RGN_FLAG_POLL_FAILED))) return false;
+  /* This function resolves only fresh list members. Never cast an old receipt
+   * address back into a region. The corner lifecycle owns quad-view selection. */
+  /* CTX_wm_area_set clears the region even when restoring the same area.
+   * Restore parent before child on every exit, including refused captures. */
+  ScrArea *previous_area = CTX_wm_area(C);
+  ARegion *previous_region = CTX_wm_region(C);
+  CTX_wm_area_set(C, area);
+  ARegion *window = UI_ipad_corner_hud_window(C, area, hud);
+  if (!window || BLI_findindex(&area->regionbase, window) == -1 ||
+      window->regiontype != RGN_TYPE_WINDOW || !window->runtime->visible) {
+    CTX_wm_area_set(C, previous_area);
+    CTX_wm_region_set(C, previous_region);
+    return false;
+  }
+  CTX_wm_region_set(C, window);
+  const bool captured = UI_ipad_context_capture(C, owner.context.data()) &&
+                        owner.context[1] == uint64_t(uintptr_t(win));
+  if (captured) {
+    const bToolRef *tool = WM_toolsystem_ref_from_context(C);
+    BLI_strncpy(owner.tool.data(), tool ? tool->idname : "", owner.tool.size());
+    const wmWindowManager *wm = CTX_wm_manager(C);
+    const UndoStack *undo = wm->runtime ? wm->runtime->undo_stack : nullptr;
+    if (undo) {
+      owner.undo_address = uint64_t(uintptr_t(undo));
+      owner.undo_lifetime = undo->ipad_lifetime_id;
+      owner.undo_mutation = undo->ipad_mutation_generation;
+    }
+    if (wmOperator *redo = WM_operator_last_redo(C)) {
+      if (BLI_findindex(&wm->runtime->operators, redo) == -1) {
+        CTX_wm_area_set(C, previous_area); CTX_wm_region_set(C, previous_region); return false;
+      }
+      wmOperatorType *registered_type = nullptr;
+      for (wmOperatorType *type : WM_operatortypes_registered_get()) {
+        if (type == redo->type) { registered_type = type; break; }
+      }
+      if (!registered_type || !registered_type->ipad_lifetime_id) {
+        CTX_wm_area_set(C, previous_area); CTX_wm_region_set(C, previous_region); return false;
+      }
+      owner.redo_address = uint64_t(uintptr_t(redo));
+      owner.redo_lifetime = WM_operator_touch_lifetime_id(redo);
+      owner.redo_type_address = uint64_t(uintptr_t(registered_type));
+      owner.redo_type_lifetime = registered_type->ipad_lifetime_id;
+      if (!owner.redo_lifetime) {
+        CTX_wm_area_set(C, previous_area); CTX_wm_region_set(C, previous_region); return false;
+      }
+    }
+    owner.hud_address = uint64_t(uintptr_t(hud));
+    owner.hud_lifetime = hud->runtime->ipad_hud_content_lifetime;
+    owner.buffer_address = uint64_t(uintptr_t(hud->runtime->draw_buffer));
+    owner.region_rect = hud->winrct;
+    owner.window_width = WM_window_native_pixel_x(win);
+    owner.window_height = WM_window_native_pixel_y(win);
+    owner.ui_scale = UI_SCALE_FAC;
+    owner.valid = true;
+  }
+  CTX_wm_area_set(C, previous_area);
+  CTX_wm_region_set(C, previous_region);
+  return captured;
+}
+static bool ipad_hud_rects_equal(const std::vector<rcti> &a, const std::vector<rcti> &b)
+{
+  if (a.size() != b.size()) return false;
+  for (size_t i = 0; i < a.size(); ++i) {
+    if (!ipad_hud_rect_equal(a[i], b[i])) return false;
+  }
+  return true;
+}
+static void ipad_hud_cache_prune(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm) return;
+  std::unordered_set<uintptr_t> windows;
+  std::unordered_set<uint64_t> content;
+  LISTBASE_FOREACH (wmWindow *, win, &wm->windows) {
+    windows.insert(uintptr_t(win));
+    bScreen *screen = WM_window_get_active_screen(win);
+    if (!screen) continue;
+    LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+      LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+        if (region->runtime->ipad_hud_content_lifetime)
+          content.insert(region->runtime->ipad_hud_content_lifetime);
+      }
+    }
+  }
+  for (auto it = ipad_hud_frames.begin(); it != ipad_hud_frames.end();) {
+    if (!windows.count(it->first)) it = ipad_hud_frames.erase(it); else ++it;
+  }
+  for (auto it = ipad_hud_contents.begin(); it != ipad_hud_contents.end();) {
+    if (!content.count(it->first)) it = ipad_hud_contents.erase(it); else ++it;
+  }
+}
+}  // namespace
+
+void ED_ipad_hud_layout_begin(bContext *C, wmWindow *win, ScrArea *area, ARegion *hud)
+{
+  if (hud->regiontype != RGN_TYPE_HUD) return;
+  if (!hud->runtime->ipad_hud_content_lifetime)
+    hud->runtime->ipad_hud_content_lifetime = ipad_hud_new_identity();
+  if (!hud->runtime->ipad_hud_content_lifetime) return;
+  auto &content = ipad_hud_contents[hud->runtime->ipad_hud_content_lifetime];
+  content.layout_ready = false;
+  ipad_hud_owner_capture(C, win, area, hud, content.layout_before);
+}
+void ED_ipad_hud_layout_end(bContext *C, wmWindow *win, ScrArea *area, ARegion *hud)
+{
+  if (hud->regiontype != RGN_TYPE_HUD || !hud->runtime->ipad_hud_content_lifetime) return;
+  auto &content = ipad_hud_contents[hud->runtime->ipad_hud_content_lifetime];
+  ipad_hud_owner_capture(C, win, area, hud, content.layout_after);
+  /* Native layout may resize the region, but may not change its semantic owner. */
+  content.layout_ready = ipad_hud_owner_equal(content.layout_before, content.layout_after, false);
+}
+void ED_ipad_hud_draw_end(bContext *C, wmWindow *win, ScrArea *area, ARegion *hud)
+{
+  if (hud->regiontype != RGN_TYPE_HUD || !hud->runtime->ipad_hud_content_lifetime) return;
+  auto &content = ipad_hud_contents[hud->runtime->ipad_hud_content_lifetime];
+  IPadHUDOwner current;
+  ipad_hud_owner_capture(C, win, area, hud, current);
+  content.texture = content.layout_ready &&
+      ipad_hud_owner_equal(content.layout_after, current, false) ? current : IPadHUDOwner{};
+}
+void ED_ipad_hud_compositor_begin(bContext *C, wmWindow *win)
+{
+  if (!ipad_hud_window_live(C, win)) return;
+  ipad_hud_cache_prune(C);
+  auto &frame = ipad_hud_frames[uintptr_t(win)];
+  frame.window_id = uint64_t(win->winid);
+  frame.drawing.clear();
+  frame.pending = true;
+}
+void ED_ipad_hud_compositor_record(bContext *C, wmWindow *win, ScrArea *area,
+                                   ARegion *hud, const rcti &exclusive_rect)
+{
+  if (hud->regiontype != RGN_TYPE_HUD || !ipad_hud_window_live(C, win)) return;
+  auto frame_it = ipad_hud_frames.find(uintptr_t(win));
+  if (frame_it == ipad_hud_frames.end() || !frame_it->second.pending ||
+      frame_it->second.window_id != uint64_t(win->winid)) return;
+  if (exclusive_rect.xmax <= exclusive_rect.xmin || exclusive_rect.ymax <= exclusive_rect.ymin)
+    return;
+  IPadHUDPresentation presentation;
+  const auto content_it = ipad_hud_contents.find(hud->runtime->ipad_hud_content_lifetime);
+  if (content_it != ipad_hud_contents.end()) presentation.owner = content_it->second.texture;
+  /* Even an unadmitted cached texture reserves its visible footprint. A fresh
+   * UI redraw is required before it can invoke native fields. */
+  if (!presentation.owner.valid) ED_region_tag_redraw(hud);
+  rcti drawn = exclusive_rect;
+  --drawn.xmax; --drawn.ymax;
+  LISTBASE_FOREACH (ARegion *, canvas, &area->regionbase) {
+    if (canvas->regiontype != RGN_TYPE_WINDOW || !canvas->runtime->visible ||
+        !canvas->runtime->ipad_canvas) continue;
+    rcti exposed = canvas->runtime->ipad_canvas_rect;
+    BLI_rcti_translate(&exposed, canvas->winrct.xmin, canvas->winrct.ymin);
+    rcti clipped;
+    /* These native canvas bounds exclude Inspector/Tools/bottom editors,
+     * rails, headers and seams. Do not promote a covered HUD above them. */
+    if (BLI_rcti_isect(&drawn, &exposed, &clipped)) presentation.rects.push_back(clipped);
+  }
+  if (!presentation.rects.empty()) frame_it->second.drawing.push_back(std::move(presentation));
+}
+void ED_ipad_hud_compositor_end(bContext *C, wmWindow *win,
+                                std::vector<IPadHUDPresentedRect> &rects)
+{
+  if (!ipad_hud_window_live(C, win)) return;
+  auto frame_it = ipad_hud_frames.find(uintptr_t(win));
+  if (frame_it == ipad_hud_frames.end()) return;
+  auto &frame = frame_it->second;
+  if (frame.pending && frame.window_id == uint64_t(win->winid)) {
+    for (auto &next : frame.drawing) {
+      for (const auto &previous : frame.presented) {
+        if (ipad_hud_owner_equal(next.owner, previous.owner, true) &&
+            ipad_hud_rects_equal(next.rects, previous.rects)) {
+          next.generation = previous.generation; break;
+        }
+      }
+      if (!next.generation) next.generation = ipad_hud_new_identity();
+      /* Exhaustion still shields visible UI with a permanently refused token.
+       * Never turn a failed receipt into exposed canvas/point selection. */
+      if (!next.generation) next.generation = std::numeric_limits<uint64_t>::max();
+    }
+    frame.presented = std::move(frame.drawing);
+    frame.pending = false;
+  }
+  for (const auto &presentation : frame.presented) {
+    if (!presentation.generation) continue;
+    for (const rcti &r : presentation.rects)
+      rects.push_back({r.xmin, r.ymin, r.xmax, r.ymax, presentation.generation});
+  }
+}
+bool ED_ipad_hud_input_admit(bContext *C, wmWindow *win, const uint64_t generation)
+{
+  if (!generation || generation == std::numeric_limits<uint64_t>::max() ||
+      !ipad_hud_window_live(C, win)) return false;
+  const auto frame_it = ipad_hud_frames.find(uintptr_t(win));
+  if (frame_it == ipad_hud_frames.end() ||
+      frame_it->second.window_id != uint64_t(win->winid)) return false;
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!screen || !ED_ipad_panels_enabled(screen)) return false;
+  for (const auto &presentation : frame_it->second.presented) {
+    if (presentation.generation != generation || !presentation.owner.valid) continue;
+    /* Start from current native lists; saved numeric addresses are comparisons. */
+    LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+      if (uint64_t(uintptr_t(area)) != presentation.owner.context[3]) continue;
+      LISTBASE_FOREACH (ARegion *, hud, &area->regionbase) {
+        if (uint64_t(uintptr_t(hud)) != presentation.owner.hud_address ||
+            hud->runtime->ipad_hud_content_lifetime != presentation.owner.hud_lifetime) continue;
+        IPadHUDOwner current;
+        if (!ipad_hud_owner_capture(C, win, area, hud, current) ||
+            !ipad_hud_owner_equal(presentation.owner, current, true)) return false;
+        /* Pending canvas/overlay changes may leave the old pixels visible.
+         * Keep reserving them, but never dispatch into changed field geometry. */
+        for (const rcti &r : presentation.rects) {
+          bool fits = false;
+          LISTBASE_FOREACH (ARegion *, canvas, &area->regionbase) {
+            if (canvas->regiontype != RGN_TYPE_WINDOW || !canvas->runtime->visible ||
+                !canvas->runtime->ipad_canvas) continue;
+            rcti exposed = canvas->runtime->ipad_canvas_rect, clipped;
+            BLI_rcti_translate(&exposed, canvas->winrct.xmin, canvas->winrct.ymin);
+            if (BLI_rcti_isect(&exposed, &r, &clipped) && ipad_hud_rect_equal(r, clipped))
+              fits = true;
+          }
+          if (!fits) return false;
+        }
+        return true;
+      }
+      return false;
+    }
+    return false;
+  }
+  return false;
+}
+
+namespace {
+/* Retirement deliberately ignores Scene/tool/history changes: those are why
+ * this UI is stale. WM/window/screen/region membership and runtime identity
+ * must still describe the original native owner before any teardown. */
+static ARegion *ipad_hud_retire_region(bContext *C, const IPadHUDOwner &owner,
+                                       ScrArea *&r_area)
+{
+  r_area = nullptr;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || uint64_t(uintptr_t(CTX_data_main(C))) != owner.context[0] ||
+      wm->id.session_uid != owner.context[12]) return nullptr;
+  LISTBASE_FOREACH (wmWindow *, win, &wm->windows) {
+    if (uint64_t(uintptr_t(win)) != owner.context[1] ||
+        uint64_t(win->winid) != owner.context[11]) continue;
+    if (CTX_wm_window(C) != win) return nullptr;
+    bScreen *screen = WM_window_get_active_screen(win);
+    if (!screen || uint64_t(uintptr_t(screen)) != owner.context[2] ||
+        screen->id.session_uid != owner.context[5]) return nullptr;
+    LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+      if (uint64_t(uintptr_t(area)) != owner.context[3]) continue;
+      LISTBASE_FOREACH (ARegion *, hud, &area->regionbase) {
+        if (uint64_t(uintptr_t(hud)) == owner.hud_address &&
+            hud->regiontype == RGN_TYPE_HUD &&
+            hud->runtime->ipad_hud_content_lifetime == owner.hud_lifetime) {
+          r_area = area; return hud;
+        }
+      }
+      return nullptr;
+    }
+    return nullptr;
+  }
+  return nullptr;
+}
+static void ipad_hud_retire_context_restore(bContext *C, const uintptr_t area_address,
+                                            const uintptr_t region_address)
+{
+  /* No old native owner is read after an onfree/custom-interaction callback. */
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmWindow *win = CTX_wm_window(C);
+  ScrArea *restored_area = nullptr;
+  ARegion *restored_region = nullptr;
+  if (wm && win && BLI_findindex(&wm->windows, win) != -1) {
+    bScreen *screen = WM_window_get_active_screen(win);
+    if (screen) {
+      LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+        if (uintptr_t(area) != area_address) continue;
+        restored_area = area;
+        LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+          if (uintptr_t(region) == region_address) { restored_region = region; break; }
+        }
+        break;
+      }
+    }
+  }
+  CTX_wm_area_set(C, restored_area);
+  CTX_wm_region_set(C, restored_region);
+}
+}  // namespace
+
+void ED_ipad_hud_input_retire(bContext *C, wmWindow *win, const uint64_t generation)
+{
+  if (!generation || !ipad_hud_window_live(C, win)) return;
+  IPadHUDOwner owner;
+  /* Copy all receipt state before callbacks can erase/reallocate the registry.
+   * Repeated stale packets cannot dispose a newer owner or repeat a callback. */
+  {
+    const auto frame_it = ipad_hud_frames.find(uintptr_t(win));
+    if (frame_it == ipad_hud_frames.end() ||
+        frame_it->second.window_id != uint64_t(win->winid)) return;
+    for (const auto &presentation : frame_it->second.presented) {
+      if (presentation.generation == generation && presentation.owner.valid) {
+        owner = presentation.owner; break;
+      }
+    }
+  }
+  if (!owner.valid) return;
+  const uintptr_t previous_area = uintptr_t(CTX_wm_area(C));
+  const uintptr_t previous_region = uintptr_t(CTX_wm_region(C));
+  for (const char *name : {"VIEW3D_PT_ipad_corner_transform", "VIEW3D_PT_ipad_corner_selection",
+                           "VIEW3D_PT_ipad_corner_view", "OPERATOR_PT_redo"}) {
+    ScrArea *area;
+    ARegion *hud = ipad_hud_retire_region(C, owner, area);
+    if (!hud) break;
+    CTX_wm_area_set(C, area);
+    CTX_wm_region_set(C, hud);
+    /* Native block-free uses onfree activation exit. It skips value/Cancel
+     * restoration, deferred application and another Undo/Redo. */
+    UI_block_discard_named_rebuild(C, hud, name);
+    ipad_hud_retire_context_restore(C, previous_area, previous_region);
+    ScrArea *fresh_area;
+    ARegion *fresh_hud = ipad_hud_retire_region(C, owner, fresh_area);
+    if (!fresh_hud) return;
+    ED_region_tag_redraw(fresh_hud);
+  }
+}
+
+void ED_ipad_hud_forget_window(const wmWindow *win)
+{
+  ipad_hud_frames.erase(uintptr_t(win));
+}
+
+void ED_ipad_editing_canvas_parts(bContext * /*C*/, ARegion *region, std::vector<rcti> &rects)
+{
+  const rcti &r = region->runtime->ipad_canvas_rect;
+  rcti shelf = region->runtime->ipad_editing_shelf_presented_rect, clipped;
+  BLI_rcti_translate(&shelf, -region->winrct.xmin, -region->winrct.ymin);
+  const bool has_shelf = region->runtime->ipad_editing_shelf_presented &&
+                        BLI_rcti_isect(&r, &shelf, &clipped);
+  for (const Rect &part : policy::editing_canvas_parts(
+           {r.xmin, r.ymin, r.xmax + 1, r.ymax + 1},
+           has_shelf ? Rect{clipped.xmin, clipped.ymin, clipped.xmax + 1, clipped.ymax + 1} : Rect{}))
+  {
+    rcti part_rect = to_rect(part);
+    BLI_rcti_translate(&part_rect, region->winrct.xmin, region->winrct.ymin);
+    rects.push_back(part_rect);
+  }
+}
+
+static void editing_shelf_visible_set(bContext *C, ARegion *region, const bool visible)
+{
+  if (region->runtime->ipad_editing_shelf_visible == visible) {
+    return;
+  }
+  region->runtime->ipad_editing_shelf_visible = visible;
+  /* Tiny splits and rejected layouts retain the previous header controls.
+   * Redraw only on visibility changes, so this does not create a redraw loop. */
+  if (ScrArea *area = CTX_wm_area(C)) {
+    LISTBASE_FOREACH (ARegion *, header, &area->regionbase) {
+      if (header->regiontype == RGN_TYPE_HEADER) {
+        ED_region_tag_redraw(header);
+      }
+    }
+  }
+}
+
+void ED_ipad_editing_shelf_invalidate(bContext *C, ARegion *region)
+{
+  UI_block_discard_named_rebuild(C, region, "VIEW3D_HT_ipad_editing_shelf");
+  editing_shelf_visible_set(C, region, false);
+  /* Keep the last visible footprint protected until an actual redraw. */
+  ED_region_tag_redraw(region);
+}
+
+void ED_ipad_editing_shelf_draw(bContext *C, ARegion *region)
+{
+  rcti rect;
+  if (!ED_ipad_editing_shelf_rect(C, region, rect)) {
+    UI_block_discard_named_rebuild(C, region, "VIEW3D_HT_ipad_editing_shelf");
+    region->runtime->ipad_editing_shelf_presented = false;
+    editing_shelf_visible_set(C, region, false);
+    return;
+  }
+  /* The caller has established region pixel space. UI_block_begin captures that
+   * same projection for native input; never build this block under the 3D matrix. */
+  HeaderType *ht = static_cast<HeaderType *>(BLI_findstring(
+      &region->runtime->type->headertypes, "VIEW3D_HT_ipad_editing_shelf", offsetof(HeaderType, idname)));
+  uiBlock *block = UI_block_begin(C, region, ht->idname, blender::ui::EmbossType::Emboss);
+  const int pad = int(8 * UI_SCALE_FAC);
+  const int width = BLI_rcti_size_x(&rect) + 1 - 2 * pad;
+  uiLayout &layout = blender::ui::block_layout(block, blender::ui::LayoutDirection::Vertical,
+                                              blender::ui::LayoutType::Panel,
+                                              rect.xmin + pad, rect.ymax - pad, width, 1, 0,
+                                              UI_style_get_dpi());
+  layout.ui_units_x_set(float(width) / UI_UNIT_X);
+  Header header = {};
+  header.type = ht;
+  header.layout = &layout;
+  ht->draw(C, &header);
+  const blender::int2 end = blender::ui::block_layout_resolve(block);
+  /* Explicit bounds never clip native buttons. Reject an overflowing rebuild
+   * and its predecessor rather than leave invisible or unprotected hit targets. */
+  const rcti content{rect.xmin + pad, rect.xmax - pad,
+                     rect.ymin + pad, rect.ymax - pad};
+  /* Vertical layout resolve returns its starting x, not the rightmost button.
+   * Inspect resolved native button rectangles before accepting the footprint. */
+  uint64_t context[13];
+  if (!UI_ipad_context_capture(C, context) || end.y < rect.ymin + pad ||
+      !UI_block_buttons_fit_rect(block, content)) {
+    UI_block_discard_rebuild(C, region, block);
+    region->runtime->ipad_editing_shelf_presented = false;
+    editing_shelf_visible_set(C, region, false);
+    return;
+  }
+  UI_block_bounds_set_explicit(block, rect.xmin, rect.ymin, rect.xmax, rect.ymax);
+  UI_block_end(C, block);
+  float color[4];
+  UI_GetThemeColor4fv(TH_BACK, color);
+  color[3] = 0.96f;
+  const rctf background{float(rect.xmin), float(rect.xmax), float(rect.ymin), float(rect.ymax)};
+  GPU_blend(GPU_BLEND_ALPHA);
+  UI_draw_roundbox_corner_set(UI_CNR_ALL);
+  UI_draw_roundbox_4fv(&background, true, 12 * UI_SCALE_FAC, color);
+  GPU_blend(GPU_BLEND_NONE);
+  UI_block_draw(C, block);
+  region->runtime->ipad_editing_shelf_presented_rect = rect;
+  BLI_rcti_translate(&region->runtime->ipad_editing_shelf_presented_rect,
+                    region->winrct.xmin, region->winrct.ymin);
+  std::copy(context, context + 13, region->runtime->ipad_editing_shelf_context);
+  region->runtime->ipad_editing_shelf_window_rect = region->winrct;
+  region->runtime->ipad_editing_shelf_expanded = editing_shelf_expanded(C);
+  region->runtime->ipad_editing_shelf_scale = UI_SCALE_FAC;
+  region->runtime->ipad_editing_shelf_presented = true;
+  editing_shelf_visible_set(C, region, true);
+}
+
+void ED_ipad_panels_draw(bContext *C, wmWindow *win)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!ED_ipad_panels_enabled(screen)) {
+    return;
+  }
+  const Model model = make_model(C, win);
+  if (model.default_sculpt_shelf) {
+    /* A workspace's mode/poll may settle after initial area preparation. Request
+     * the next layout pass; do not mutate GPU region buffers during compositing. */
+    screen->do_refresh = true;
+    WM_event_add_mousemove(win);
+  }
+  GPU_blend(GPU_BLEND_ALPHA);
+  for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+    if (find_tab(model, model.state.slot(edge).active_id)) {
+      const Rect resize = edge == Edge::Side ? model.layout.side_resize : model.layout.bottom_resize;
+      draw_box(resize, "", false);
+      /* A visible grip communicates the larger invisible drag target. */
+      const Rect handle = edge == Edge::Side ? model.layout.side_resize : model.layout.bottom_resize;
+      const float cx = (handle.xmin + handle.xmax) * 0.5f;
+      const float cy = edge == Edge::Side ? (handle.ymin + handle.ymax) * 0.5f :
+                                           handle.ymax - 6 * UI_SCALE_FAC;
+      const float half_w = (edge == Edge::Side ? 2 : 18) * UI_SCALE_FAC;
+      const float half_h = (edge == Edge::Side ? 18 : 2) * UI_SCALE_FAC;
+      rctf grip = {cx - half_w, cx + half_w, cy - half_h, cy + half_h};
+      float color[4];
+      UI_GetThemeColor4fv(TH_TEXT, color);
+      color[3] = 0.45f;
+      UI_draw_roundbox_4fv(&grip, true, 2 * UI_SCALE_FAC, color);
+    }
+  }
+  for (const Button &button : buttons(model, screen)) {
+    if (button.native) {
+      continue; /* Native gizmo draws it; shared press/release capture owns taps. */
+    }
+    if (button.action == Action::Seam) {
+      draw_box(button.rect, "", false, win->eventstate && contains(button.rect, win->eventstate->xy));
+      const bool vertical = button.edge == Edge::Side;
+      const float cx = (button.rect.xmin + button.rect.xmax) * 0.5f;
+      const float cy = (button.rect.ymin + button.rect.ymax) * 0.5f;
+      const float dx = (vertical ? 2 : 12) * UI_SCALE_FAC;
+      const float dy = (vertical ? 12 : 2) * UI_SCALE_FAC;
+      rctf grip{cx - dx, cx + dx, cy - dy, cy + dy};
+      float color[4];
+      UI_GetThemeColor4fv(TH_TEXT, color);
+      UI_draw_roundbox_4fv(&grip, true, 2 * UI_SCALE_FAC, color);
+    }
+    else if (button.action == Action::Resize && button.id == 1) {
+      draw_box(button.rect, "", false, win->eventstate && contains(button.rect, win->eventstate->xy));
+      const Rect &r = button.rect;
+      const float cx = (r.xmin + r.xmax) * 0.5f, cy = (r.ymin + r.ymax) * 0.5f;
+      float color[4]; UI_GetThemeColor4fv(TH_TEXT, color);
+      /* Three offset dots form a diagonal grip without adding wrapper labels. */
+      for (int i = -1; i <= 1; ++i) {
+        const float offset = i * 6 * UI_SCALE_FAC;
+        const float radius = std::min({2 * UI_SCALE_FAC, r.width() / 8.0f, r.height() / 8.0f});
+        const float x = std::clamp(cx + offset, float(r.xmin) + radius, float(r.xmax) - radius);
+        const float y = std::clamp(cy + offset, float(r.ymin) + radius, float(r.ymax) - radius);
+        rctf dot{x-radius, x+radius, y-radius, y+radius};
+        UI_draw_roundbox_4fv(&dot, true, radius, color);
+      }
+    }
+    else if (button.action == Action::Lock) {
+      float color[4];
+      UI_GetThemeColor4fv(button.selected ? TH_TAB_ACTIVE : TH_TAB_INACTIVE, color);
+      const Rect &r = button.rect;
+      rctf circle = {float(r.xmin), float(r.xmax), float(r.ymin), float(r.ymax)};
+      UI_draw_roundbox_corner_set(UI_CNR_ALL);
+      UI_draw_roundbox_4fv(&circle, true, r.width() * 0.5f, color);
+      const float icon_size = 16 * UI_SCALE_FAC;
+      UI_icon_draw((r.xmin + r.xmax - icon_size) * 0.5f,
+                    (r.ymin + r.ymax - icon_size) * 0.5f,
+                    button.selected ? ICON_PINNED : ICON_UNPINNED);
+    }
+    else if (button.action != Action::Resize) {
+      draw_box(button.rect, button.label.c_str(), button.selected,
+               win->eventstate && contains(button.rect, win->eventstate->xy));
+    }
+  }
+  GPU_blend(GPU_BLEND_NONE);
+}
