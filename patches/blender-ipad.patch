+static uiBlock *ui_ipad_ring_create(bContext *C, uiPopupBlockHandle *handle, void *arg)
+{
+  /* Root provenance is populated by this creator, after the generic refresh
+   * admission. Refuse exhausted native popup identity before Python/RNA draw. */
+  if (!handle->ipad_popup_lifetime) {
+    handle->menuretval = UI_RETURN_CANCEL;
+    return UI_block_begin(C, handle->region, "ipad_cancelled_root", blender::ui::EmbossType::Emboss);
+  }
+  auto &data = *static_cast<uiIPadRingData *>(arg);
+  const bool navigation_rebuild = data.browse.desired_generation > data.generation;
+  data.navigation_rebuild = navigation_rebuild;
+  data.input_suspended = true;
+  if (data.generation == UINT64_MAX) handle->menuretval = UI_RETURN_CANCEL;
+  else ++data.generation;
+  if (ipad_ring::ring_uses_pages(ipad_ring::ring_kind(data.menu.c_str()))) {
+    data.generation = std::max(data.generation, data.browse.desired_generation);
+    data.browse.desired_generation = data.generation;
+    /* Native refresh retains the old block for button-state migration. Cancel
+     * its active/semi-modal states, but leave the block owned by that refresh. */
+    if (navigation_rebuild)
+    LISTBASE_FOREACH (uiBlock *, previous, &handle->region->runtime->uiblocks) {
+      if (previous->ipad_ring_lifetime != data.lifetime) continue;
+      for (const auto &button : previous->buttons) {
+        if (button->semi_modal_state && button->semi_modal_state != button->active)
+          ui_but_semi_modal_state_free(C, button.get());
+        if (button->active) ui_but_active_free(C, button.get());
+      }
+    }
+  }
+  uiBlock *block = UI_block_begin(C, handle->region, "iPadToolRing", blender::ui::EmbossType::Emboss);
+  static_assert(sizeof(bToolRef::idname) == ipad_ring::ActionOrigin::tool_capacity);
+  block->ipad_action_origin = ipad_ring::ActionOrigin::capture(
+      ipad_ring::context_values(data.context), data.tool_identity, data.lifetime);
+  handle->ipad_action_origin = block->ipad_action_origin;
+  block->ipad_ring_lifetime = data.lifetime;
+  block->ipad_ring_generation = data.generation;
+  UI_block_flag_enable(block, UI_BLOCK_LOOP);
+  UI_block_theme_style_set(block, UI_BLOCK_THEME_STYLE_POPUP);
+  block->pie_data.flags |= UI_PIE_IPAD_TOOLS;
+  const auto kind = ipad_ring::ring_kind(data.menu.c_str());
+  block->ipad_ring_full_labels = ipad_ring::ring_uses_pages(kind);
+  if (kind == ipad_ring::RingKind::Mode) {
+    block->pie_data.flags |= UI_PIE_IPAD_MODE;
+  }
+  else if (kind != ipad_ring::RingKind::Tools) {
+    block->pie_data.flags |= UI_PIE_IPAD_CONTEXT;
+    if (kind == ipad_ring::RingKind::Selection || kind == ipad_ring::RingKind::SelectOptions) {
+      block->pie_data.flags |= UI_PIE_IPAD_SELECTION;
+    }
+  }
+  uiLayout &layout = blender::ui::block_layout(block, blender::ui::LayoutDirection::Vertical,
+      blender::ui::LayoutType::Menu, 0, 0, int(4.4f * UI_UNIT_X), 0, 0, UI_style_get_dpi());
+  if (ui_ipad_ring_data_valid(C, data)) {
+    UI_menutype_draw(C, WM_menutype_find(data.menu.c_str(), false), &layout);
+  }
+  blender::ui::block_layout_resolve(block);
+  const auto viewport = ui_ipad_ring_data_valid(C, data) ? ui_ipad_ring_viewport(C) :
+      ipad_ring::Rect{0, 1, 0, 1};
+  data.visible_count = int(block->buttons.size());
+  data.inventory_count = data.visible_count;
+  if (ipad_ring::ring_uses_pages(kind)) {
+    if (data.reopen_phase_pending) {
+      const bool tools_match = kind == ipad_ring::RingKind::Inventory &&
+          !data.reopen_tool_inventory.empty() &&
+          data.reopen_tool_inventory == ui_ipad_ring_native_inventory(block);
+      const bool workspaces_match = kind == ipad_ring::RingKind::Workspaces &&
+          data.reopen_workspace_inventory ==
+              ui_ipad_ring_workspace_inventory(CTX_data_main(C));
+      if (!tools_match && !workspaces_match) data.phase = data.browse.phase = 0;
+      data.reopen_phase_pending = false;
+      data.reopen_tool_inventory.clear();
+      data.reopen_workspace_inventory.clear();
+    }
+    const auto geometry = ipad_ring::ring_page_layout(UI_UNIT_X, viewport,
+        float(data.anchor[0]), float(data.anchor[1]), int(block->buttons.size()), data.phase,
+        data.touch_tools, kind == ipad_ring::RingKind::Base);
+    if (!geometry.fits) {
+      handle->menuretval = UI_RETURN_CANCEL;
+      for (const std::unique_ptr<uiBut> &but : block->buttons) but->flag |= UI_HIDDEN | UI_BUT_DISABLED;
+      UI_block_bounds_set_normal(block, 0);
+      return block;
+    }
+    data.visible_count = int(geometry.indices.size());
+    /* The active tool's native popover retains the tool ring's selected cue.
+     * Compare against a fresh registered panel before using a saved identity. */
+    PanelType *next_drag_panel = kind == ipad_ring::RingKind::Inventory ?
+        WM_paneltype_find("VIEW3D_PT_ipad_transform", true) : nullptr;
+
+    /* All category links carry the same origin even while off-page. Changing
+     * their properties only when visible would break continuity at each page. */
+    wmOperatorType *menu_type = WM_operatortype_find("WM_OT_call_menu_pie", true);
+    for (const auto &button : block->buttons) {
+      uiBut *but = button.get();
+      if (menu_type && but->optype == menu_type && but->opptr &&
+          but->opptr->type == menu_type->srna) {
+        char target[BKE_ST_MAXNAME]; RNA_string_get(but->opptr, "name", target);
+        if (UI_ipad_ring_menu(target)) {
+          RNA_boolean_set(but->opptr, "ipad_anchor_override", true);
+          RNA_boolean_set(but->opptr, "ipad_touch_targets", data.touch_tools);
+          RNA_int_set(but->opptr, "ipad_anchor_x", int(geometry.center_x));
+          RNA_int_set(but->opptr, "ipad_anchor_y", int(geometry.center_y));
+        }
+      }
+    }
+    for (const std::unique_ptr<uiBut> &but : block->buttons) but->flag |= UI_HIDDEN;
+    for (int i = 0; i < data.visible_count; ++i) {
+      uiBut *but = block->buttons[geometry.indices[i]].get();
+      const auto &rect = geometry.buttons[i];
+      but->flag &= ~UI_HIDDEN;
+      if (next_drag_panel && UI_but_paneltype_get(but) == next_drag_panel &&
+          (data.tool_identity == "builtin.move" || data.tool_identity == "builtin.rotate" ||
+           data.tool_identity == "builtin.scale" || data.tool_identity == "builtin.transform"))
+        but->flag |= UI_SELECT_DRAW;
+
+      BLI_rctf_init(&but->rect, rect.xmin, rect.xmax, rect.ymin, rect.ymax);
+      but->pie_dir = UI_RADIAL_NONE;
+      but->emboss = blender::ui::EmbossType::Emboss;
+      but->alignnr = 0;
+      but->drawflag &= ~(UI_BUT_ALIGN_TOP | UI_BUT_ALIGN_DOWN | UI_BUT_ALIGN_LEFT | UI_BUT_ALIGN_RIGHT);
+      if (but->optype && STREQ(but->optype->idname, "OBJECT_OT_mode_set") && but->opptr) {
+        const Object *object = CTX_data_active_object(C);
+        but->flag &= ~(UI_SELECT_DRAW | UI_BUT_UNDO);
+        if (object && RNA_enum_get(but->opptr, "mode") == int(object->mode)) but->flag |= UI_SELECT_DRAW;
+      }
+
+    }
+    UI_block_bounds_set_explicit(block, int(std::floor(geometry.footprint.xmin)),
+        int(std::floor(geometry.footprint.ymin)), int(std::ceil(geometry.footprint.xmax)),
+        int(std::ceil(geometry.footprint.ymax)));
+    return block;
+  }
+  if (kind == ipad_ring::RingKind::Mode) {
+    bool valid = !block->buttons.is_empty();
+    float label_width = 0;
+    for (const std::unique_ptr<uiBut> &but : block->buttons) {
+      valid &= but->optype && STREQ(but->optype->idname, "OBJECT_OT_mode_set") && but->opptr;
+      label_width = std::max(label_width, float(UI_fontstyle_string_width(
+          &UI_style_get_dpi()->widget, but->str.c_str())));
+    }
+    const auto geometry = ipad_ring::mode_menu_layout(UI_UNIT_X, viewport,
+        float(data.anchor[0]), float(data.anchor[1]), int(block->buttons.size()), label_width);
+    if (!valid || !geometry.fits) {
+      handle->menuretval = UI_RETURN_CANCEL;
+      for (const std::unique_ptr<uiBut> &but : block->buttons) but->flag |= UI_HIDDEN | UI_BUT_DISABLED;
+      BKE_report(CTX_wm_reports(C), RPT_INFO, "Expand this viewport to show modes");
+      UI_block_bounds_set_normal(block, 0);
+      return block;
+    }
+    const int observed = int(CTX_data_active_object(C)->mode);
+    for (int i = 0; i < int(block->buttons.size()); ++i) {
+      uiBut *but = block->buttons[i].get();
+      const auto &rect = geometry.buttons[i];
+      BLI_rctf_init(&but->rect, rect.xmin, rect.xmax, rect.ymin, rect.ymax);
+      but->pie_dir = UI_RADIAL_NONE;
+      but->emboss = blender::ui::EmbossType::Emboss;
+      but->alignnr = 0;
+      but->flag &= ~(UI_SELECT_DRAW | UI_BUT_UNDO);
+      if (RNA_enum_get(but->opptr, "mode") == observed) but->flag |= UI_SELECT_DRAW;
+      but->drawflag &= ~(UI_BUT_ALIGN_TOP | UI_BUT_ALIGN_DOWN | UI_BUT_ALIGN_LEFT | UI_BUT_ALIGN_RIGHT);
+    }
+    UI_block_bounds_set_normal(block, 0);
+    return block;
+  }
+  const auto geometry = ipad_ring::tool_ring_layout(UI_UNIT_X, viewport,
+      float(data.anchor[0]), float(data.anchor[1]),
+      kind != ipad_ring::RingKind::Tools || data.touch_tools);
+  if (block->buttons.size() != geometry.buttons.size() || !geometry.fits) {
+    /* No unexpected or overflowing button can receive input in Release either.
+     * Return a valid block; ordinary popup finalization/teardown owns its free. */
+    handle->menuretval = UI_RETURN_CANCEL;
+    for (const std::unique_ptr<uiBut> &but : block->buttons) {
+      but->flag |= UI_HIDDEN | UI_BUT_DISABLED;
+    }
+    UI_block_bounds_set_normal(block, 0);
+    return block;
+  }
+  for (int i = 0; i < int(block->buttons.size()); ++i) {
+    uiBut *but = block->buttons[i].get();
+    const auto &rect = geometry.buttons[i];
+    BLI_rctf_init(&but->rect, rect.xmin, rect.xmax, rect.ymin, rect.ymax);
+    but->pie_dir = UI_RADIAL_NONE;
+    but->emboss = blender::ui::EmbossType::Emboss;
+    but->alignnr = 0;
+    but->drawflag &= ~(UI_BUT_ALIGN_TOP | UI_BUT_ALIGN_DOWN | UI_BUT_ALIGN_LEFT | UI_BUT_ALIGN_RIGHT);
+    if (but->optype && STREQ(but->optype->idname, "WM_OT_call_menu_pie") && but->opptr) {
+      char target[BKE_ST_MAXNAME];
+      RNA_string_get(but->opptr, "name", target);
+      if (ipad_ring::ring_kind(target) != ipad_ring::RingKind::None) {
+        /* Deferred native callbacks own a copy of these values after popup free. */
+        RNA_boolean_set(but->opptr, "ipad_anchor_override", true);
+        RNA_boolean_set(but->opptr, "ipad_touch_targets", data.touch_tools);
+        RNA_int_set(but->opptr, "ipad_anchor_x", data.anchor[0]);
+        RNA_int_set(but->opptr, "ipad_anchor_y", data.anchor[1]);
+      }
+    }
+  }
+  UI_block_bounds_set_normal(block, 0);
+  return block;
+}
