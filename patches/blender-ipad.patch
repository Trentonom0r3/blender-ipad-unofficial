+        handle->ipad_action_origin.context != origin.context ||
+        std::memcmp(handle->ipad_action_origin.tool, origin.tool, sizeof(origin.tool)) != 0 ||
+        !ui_ipad_action_origin_valid(C, handle->ipad_action_origin)) continue;
+    return handle;
+  }
