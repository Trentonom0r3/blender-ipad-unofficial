+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <tuple>
+#include <vector>
+
+/* Value-only binding provenance. uiBut and uiAfterFunc own these containers;
+ * uiPopupBlockHandle must remain trivially copyable for native memcpy refresh.
+ * Numeric addresses are comparison keys, never sources for dereferencing. */
+enum class uiIPadRNAOwner : uint8_t {
+  None, Scene, Object, ObjectData, Screen, WindowManager, Brush,
+  ToolOperator, ToolGizmo, PopupOperator, PopupProperties,
+};
+
+/* Detached UI callbacks own the name; numeric addresses are comparison keys.
+ * Resolve each dispatch from the live registry, never through saved metadata. */
+struct uiIPadOperatorReceipt {
+  uint64_t address = 0, lifetime = 0, srna_address = 0;
+  std::string name;
+};
+
+struct uiIPadRNAPathStep {
+  std::string name;
+  int index = -1;
+  uint64_t data_address = 0, type_address = 0;
+  uint64_t backend_address = 0;
+  int backend_type = 0, backend_subtype = 0, backend_length = -1;
+  bool operator==(const uiIPadRNAPathStep &other) const
+  {
+    return std::tie(name, index, data_address, type_address, backend_address,
+                    backend_type, backend_subtype, backend_length) ==
+           std::tie(other.name, other.index, other.data_address, other.type_address,
+                    other.backend_address, other.backend_type, other.backend_subtype,
+                    other.backend_length);
+  }
+};
+
+struct uiIPadRNAReceipt {
+  uiIPadRNAOwner owner = uiIPadRNAOwner::None;
+  uint64_t owner_address = 0, data_address = 0, type_address = 0, property_address = 0;
+  uint64_t root_type_address = 0;
+  unsigned int owner_uid = 0;
+  uint16_t owner_id_type = 0;
+  uint64_t undo_address = 0, undo_lifetime = 0, undo_mutation = 0;
+  uint64_t tool_address = 0, tool_root_address = 0, tool_group_address = 0;
+  uint64_t subgroup_address = 0, popup_lifetime = 0, popup_operator_address = 0;
+  int tool_space = 0, tool_mode = 0;
+  std::string tool_id, subgroup, property_id, path;
+  std::vector<uiIPadRNAPathStep> steps;
+  std::array<int, 3> dimensions{};
+  int dimension_count = 0, array_length = 0, index = 0;
+  bool array = false, valid = false;
+  bool operator==(const uiIPadRNAReceipt &other) const
+  {
+    return std::tie(owner, owner_address, data_address, type_address, property_address,
+                    root_type_address, owner_uid, owner_id_type, undo_address, undo_lifetime,
+                    undo_mutation, tool_address, tool_root_address, tool_group_address,
+                    subgroup_address, popup_lifetime, popup_operator_address, tool_space,
+                    tool_mode, tool_id, subgroup, property_id, path, steps, dimensions,
+                    dimension_count, array_length, index, array, valid) ==
+           std::tie(other.owner, other.owner_address, other.data_address, other.type_address,
+                    other.property_address, other.root_type_address, other.owner_uid,
+                    other.owner_id_type, other.undo_address, other.undo_lifetime,
+                    other.undo_mutation, other.tool_address, other.tool_root_address,
+                    other.tool_group_address, other.subgroup_address, other.popup_lifetime,
+                    other.popup_operator_address, other.tool_space, other.tool_mode,
+                    other.tool_id, other.subgroup, other.property_id, other.path, other.steps,
+                    other.dimensions, other.dimension_count, other.array_length, other.index,
+                    other.array, other.valid);
+  }
+};
diff --git a/source/blender/editors/interface/interface_ipad_tool_ring.hh b/source/blender/editors/interface/interface_ipad_tool_ring.hh
new file mode 100644
index 0000000..fed15ca
--- /dev/null
+++ b/source/blender/editors/interface/interface_ipad_tool_ring.hh
@@ -0,0 +1,454 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+/* Geometry only, deliberately independent of Blender/UIKit so it can be tested
+ * on a host compiler. The normal eight-direction pie layout does not use this. */
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <string_view>
+#include <type_traits>
+#include <vector>
+
+namespace blender::ui::ipad {
+/* Native popup handles are memcpy-copied on refresh. This origin is only
+ * value provenance, not proof that an arbitrary cached RNA tree is still live.
+ * Capture while the originating native ring context is owned; resolve live
+ * RNA/property ownership separately before any read, write or callback. */
+struct ActionOrigin {
+  static constexpr size_t tool_capacity = 64;
+  std::array<uint64_t, 13> context{};
+  uint64_t lifetime = 0;
+  bool corner = false;
+  char tool[tool_capacity]{};
+  bool present() const { return lifetime != 0; }
+  static ActionOrigin capture(const std::array<uint64_t, 13> &values,
+                              std::string_view tool_id, uint64_t ring_lifetime)
+  {
+    ActionOrigin result;
+    if (!ring_lifetime || tool_id.size() >= tool_capacity ||
+        tool_id.find('\0') != std::string_view::npos) return result;
+    for (int i = 0; i < 5; ++i) if (!values[i]) return result;
+    result.context = values; result.lifetime = ring_lifetime;
+    std::copy(tool_id.begin(), tool_id.end(), result.tool);
+    return result;
+  }
+  bool matches(const std::array<uint64_t, 13> &live, std::string_view live_tool) const
+  {
+    return present() && context == live && live_tool == std::string_view(tool);
+  }
+};
+static_assert(std::is_trivially_copyable_v<ActionOrigin>);
+static_assert(std::is_standard_layout_v<ActionOrigin>);
+
+struct Rect {
+  float xmin, xmax, ymin, ymax;
+};
