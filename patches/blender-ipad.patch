+bool ED_ipad_panels_handle_event(bContext *C, wmWindow *win, const wmEvent *event)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  /* Popup modal handlers already run first in wm_event_system. A tooltip in
+   * screen->regionbase must not disable every panel tab. */
+  if (!ED_ipad_panels_enabled(screen)) {
+    return false;
+  }
+  Model model = make_model(C, win);
+  if (!model.main) {
+    return false;
+  }
+  int &pan_axis = model.main->runtime.ipad_pan_axis;
+  if (ELEM(event->type, MOUSEMOVE, INBETWEEN_MOUSEMOVE)) {
+    /* Rail hover is compositor chrome, not a native region UI block. */
+    screen->do_draw = true;
+  }
+  /* GHOST anchors ordinary finger pans at their origin, and emits a cursor event
+   * at every new gesture. Flythrough pans move the origin but have the same begin.
+   * Capture from that first resize hit so moving the handle cannot drop the drag. */
+  if (ELEM(event->type, MOUSEMOVE, INBETWEEN_MOUSEMOVE, LEFTMOUSE, RIGHTMOUSE,
+           WINDEACTIVATE, EVT_ESCKEY))
+  {
+    pan_axis = 0;
+  }
+  const auto controls = buttons(model, screen);
+  auto &runtime = model.main->runtime;
+  if (event->flag & WM_EVENT_IS_POINTER_CANCEL) {
+    runtime.ipad_tab_action = 0;
+    pan_axis = 0;
+    screen->do_draw = true;
+    return true;
+  }
+  if (runtime.ipad_tab_action) {
+    if (ELEM(event->type, EVT_ESCKEY, RIGHTMOUSE, WINDEACTIVATE)) {
+      runtime.ipad_tab_action = 0;
+      screen->do_draw = true;
+      return event->type != WINDEACTIVATE;
+    }
+    if (event->type == LEFTMOUSE && event->val == KM_RELEASE) {
+      const int action = runtime.ipad_tab_action;
+      const int id = runtime.ipad_tab_id;
+      runtime.ipad_tab_action = 0;
+      screen->do_draw = true;
+      for (const Button &button : controls) {
+        if (int(button.action) + 1 == action && button.id == id && int(button.edge) == runtime.ipad_tab_edge &&
+            contains(button.rect, event->xy))
+        {
+          activate_button(C, win, model, button);
+          break;
+        }
+      }
+      /* Own the full sequence, including release outside the rail. */
+      return true;
+    }
+    if (ISMOUSE(event->type) || ISMOUSE_GESTURE(event->type)) {
+      screen->do_draw = true;
+      return true;
+    }
+  }
+  if (event->type == MOUSEPAN) {
+    if (!pan_axis) {
+      for (const Button &button : controls) {
+        if (button.action == Action::Resize && contains(button.rect, event->xy)) {
+          pan_axis = (button.edge == Edge::Side ? 1 : 2) + (button.id == 1 ? 2 : 0);
+          break;
+        }
+      }
+    }
+    if (pan_axis) {
+      const int axis = (pan_axis - 1) % 2;
+      const Edge edge = axis == 0 ? Edge::Side : Edge::Bottom;
+      const int current_size = axis == 0 ? model.layout.side_panel.width() :
+                                           model.layout.bottom_panel.height();
+      const int delta = event->xy[axis] - event->prev_xy[axis];
+      const int requested = current_size + (axis == 0 ? -delta : delta);
+      if (pan_axis > 2) {
+        const int current_extent = axis == 0 ? model.layout.side_panel.height() : model.layout.bottom_panel.width();
+        const int delta_other = event->xy[1-axis] - event->prev_xy[1-axis];
+        const int extent = current_extent + (axis == 0 ? -delta_other : delta_other);
+        policy::resize_2d(model.state, edge, axis == 0 ? requested : extent,
+                           axis == 0 ? extent : requested, model.bounds, model.metrics);
+        screen->ipad_panel_extent[axis] =
+            (axis == 0 ? model.state.side_height : model.state.bottom_width) / UI_SCALE_FAC;
+      }
+      else {
+        policy::resize(model.state, edge, requested, model.bounds, model.metrics);
+      }
+      saved_panel_size(screen, axis, axis == 0 && active_inspector_side(model)) =
+          (axis == 0 ? model.state.side_width : model.state.bottom_height) / UI_SCALE_FAC;
+      /* Do not manufacture a cursor-begin while the same finger gesture is captured. */
+      tag_layout(C, win, false);
+      return true;
+    }
+  }
+  for (const Button &button : controls) {
+    if (!contains(button.rect, event->xy)) {
+      continue;
+    }
+    if (event->type == LEFTMOUSE && event->val == KM_PRESS) {
+      const int axis = button.edge == Edge::Side ? 0 : 1;
+      if (button.action == Action::Seam) {
+        PointerRNA props;
+        WM_operator_properties_create(&props, "SCREEN_OT_ipad_working_resize");
+        RNA_int_set(&props, "seam", button.id);
+        WM_operator_name_call(C, "SCREEN_OT_ipad_working_resize",
+                              blender::wm::OpCallContext::InvokeDefault, &props, event);
+        WM_operator_properties_free(&props);
+      }
+      else if (button.action == Action::Resize) {
+        PointerRNA props;
+        WM_operator_properties_create(&props, "SCREEN_OT_ipad_panel_resize");
+        RNA_int_set(&props, "axis", axis + (button.id == 1 ? 2 : 0));
+        WM_operator_name_call(C, "SCREEN_OT_ipad_panel_resize",
+                              blender::wm::OpCallContext::InvokeDefault, &props, event);
+        WM_operator_properties_free(&props);
+      }
+      else {
+        runtime.ipad_tab_action = int(button.action) + 1;
+        runtime.ipad_tab_id = button.id;
+        runtime.ipad_tab_edge = int(button.edge);
+        screen->do_draw = true;
+      }
+    }
+    /* Only pointer events belong to chrome; timers and keyboard shortcuts retain their routing. */
+    return ISMOUSE(event->type) || ISMOUSE_GESTURE(event->type);
+  }
+  /* Let the originating WINDOW's native UI handle its shelf. Its padding
+   * guard runs after button handlers, before gizmos/tool keymaps. */
+  if (ED_ipad_editing_shelf_hit(C, event->xy)) {
+    return false;
+  }
+  bool navigation_hit = false;
+  for (const policy::Area &working : model.working) {
+    const ScrArea *area = model.areas[working.id];
+    if (area->spacetype != SPACE_VIEW3D) {
+      continue;
+    }
+    const auto *v3d = static_cast<const View3D *>(area->spacedata.first);
+    const bool visible = v3d && !(v3d->gizmo_flag & (V3D_GIZMO_HIDE | V3D_GIZMO_HIDE_NAVIGATE)) &&
+                         ((U.uiflag & USER_SHOW_GIZMO_NAVIGATE) ||
+                          U.mini_axis_type == USER_MINI_AXIS_TYPE_GIZMO);
+    navigation_hit |= visible && BLI_rcti_isect_pt_v(&area->runtime.ipad_navigation_rect, event->xy);
+  }
+  /* A deliberately chosen editing tool owns its first direct stroke. Keep
+   * the canvas geometry and open panels stable until that drag has finished. */
+  if (event->type == LEFTMOUSE && event->val == KM_PRESS &&
+      !(event->flag & WM_EVENT_IS_DIRECT_TOOL) &&
+      contains(model.layout.canvas, event->xy) && !navigation_hit)
+  {
+    bool changed = model.state.dismiss(Edge::Side);
+    changed |= model.state.dismiss(Edge::Bottom);
+    changed |= model.state.dismiss(Edge::Tools);
+    if (changed) {
+      save_slot(screen, model, Edge::Side);
+      save_slot(screen, model, Edge::Bottom);
+      save_slot(screen, model, Edge::Tools);
+      tag_layout(C, win);
+      /* Dismissal consumes the tap; it must not also transform/select beneath a panel. */
+      return true;
+    }
+  }
+  /* Defer switching the panel host until ordinary canvas input; changing
+   * native sidebar/Tools geometry in the middle of a direct stroke is unsafe. */
+  if (event->type == LEFTMOUSE && event->val == KM_PRESS &&
+      !(event->flag & WM_EVENT_IS_DIRECT_TOOL) &&
+      contains(model.layout.canvas, event->xy) && !navigation_hit) {
+    for (const policy::Area &working : model.working) {
+      ScrArea *area = model.areas[working.id];
+      if (area != model.main && BLI_rcti_isect_pt_v(&area->runtime.ipad_rect, event->xy)) {
+        screen->ipad_panel_owner = working.id + 1;
+        tag_layout(C, win);
+        break;
+      }
+    }
+  }
+  return false;
+}
+
+void SCREEN_OT_ipad_working_resize(wmOperatorType *ot)
+{
+  ot->name = "Resize Working Editors";
+  ot->idname = "SCREEN_OT_ipad_working_resize";
+  ot->description = "Drag a working-editor seam while preserving connected native editors";
+  ot->invoke = seam_invoke;
+  ot->modal = seam_modal;
+  ot->cancel = seam_cancel;
+  ot->poll = panel_poll;
+  ot->flag = OPTYPE_INTERNAL;
+  RNA_def_int(ot->srna, "seam", 0, 0, INT_MAX, "Seam", "Working editor seam", 0, INT_MAX);
+}
+
+void SCREEN_OT_ipad_launcher_arrange(wmOperatorType *ot)
+{
+  ot->name = "Arrange Launchers";
+  ot->idname = "SCREEN_OT_ipad_launcher_arrange";
+  ot->description = "Arrange native editor and category launchers on their rails";
+  ot->exec = launcher_arrange_exec;
+  ot->poll = panel_poll;
+  ot->flag = OPTYPE_INTERNAL;
+}
+
+void SCREEN_OT_ipad_launcher_move(wmOperatorType *ot)
+{
+  ot->name = "Move Launcher";
+  ot->idname = "SCREEN_OT_ipad_launcher_move";
+  ot->description = "Move this launcher earlier or later without changing its editor";
+  ot->exec = launcher_move_exec;
+  ot->poll = panel_poll;
+  ot->flag = OPTYPE_INTERNAL;
+  RNA_def_string(ot->srna, "target", nullptr, 0, "Target", "Runtime editor or native category identity");
+  RNA_def_string(ot->srna, "signature", nullptr, 0, "Layout", "Originating screen and editor identities");
+  RNA_def_int(ot->srna, "direction", 1, -1, 1, "Direction", "Earlier or later", -1, 1);
+}
+
+void SCREEN_OT_ipad_panel_resize(wmOperatorType *ot)
+{
+  ot->name = "Resize iPad Panel";
+  ot->idname = "SCREEN_OT_ipad_panel_resize";
+  ot->description = "Resize the floating panel without changing the saved workspace layout";
+  ot->invoke = resize_invoke;
+  ot->modal = resize_modal;
+  ot->cancel = resize_cancel;
+  ot->flag = OPTYPE_INTERNAL | OPTYPE_BLOCKING;
+  RNA_def_int(ot->srna, "axis", 0, 0, 3, "Area", "Side or bottom strip, or diagonal corner", 0, 3);
+}
