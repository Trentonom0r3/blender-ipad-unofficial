+bool UI_ipad_corner_block_ready(const uiBlock *block)
+{
+  const bool named = block->name == "VIEW3D_PT_ipad_corner_transform" ||
+      block->name == "VIEW3D_PT_ipad_corner_selection" || block->name == "VIEW3D_PT_ipad_corner_view";
+  return !named || (block->active && block->ipad_action_origin.present() &&
+                   block->ipad_action_origin.corner && block->ipad_corner_block_lifetime);
+}
+
+static uint64_t ui_ipad_corner_next_lifetime = 1;
+static uint64_t ui_ipad_corner_lifetime_allocate()
+{
+  return ui_ipad_corner_next_lifetime != UINT64_MAX ? ui_ipad_corner_next_lifetime++ : 0;
+}
+
+static bool ui_ipad_corner_history_matches(bContext *C, const uiBlock *block)
+{
+  return block->ipad_corner_block_lifetime &&
+         ui_ipad_rna_history_matches(C, block->ipad_corner_history);
+}
+
+static void ui_ipad_corner_block_begin(const bContext *context, ARegion *region, uiBlock *block)
+{
+#ifdef WITH_APPLE_CROSSPLATFORM
+  if (!region || region->regiontype != RGN_TYPE_HUD ||
+      !(block->name == "VIEW3D_PT_ipad_corner_transform" ||
+        block->name == "VIEW3D_PT_ipad_corner_selection" ||
+        block->name == "VIEW3D_PT_ipad_corner_view")) return;
+  bContext *C = const_cast<bContext *>(context);
+  /* These static panel roots are independent of the native OPERATOR_PT_redo.
+   * Constructor proof precedes Python header/body and first RNA reads. */
+  const uintptr_t previous_area = uintptr_t(CTX_wm_area(C));
+  const uintptr_t previous_region = uintptr_t(CTX_wm_region(C));
+  ARegion *canvas = UI_ipad_corner_canvas(C);
+  if (!canvas) { block->active = false; return; }
+  CTX_wm_region_set(C, canvas);
+  std::array<uint64_t, 13> values{};
+  const uint64_t fresh_lifetime = ui_ipad_corner_lifetime_allocate();
+  const bool captured = fresh_lifetime && UI_ipad_context_capture(C, values.data());
+  if (captured) {
+    auto origin = blender::ui::ipad::ActionOrigin::capture(
+        values, ui_ipad_ring_tool_identity(C), fresh_lifetime);
+    origin.corner = true;
+    uiBlock *old = block->oldblock;
+    if (old && old->ipad_action_origin.corner &&
+        old->ipad_action_origin.context == origin.context &&
+        std::memcmp(old->ipad_action_origin.tool, origin.tool, sizeof(origin.tool)) == 0 &&
+        ui_ipad_corner_history_matches(C, old)) origin.lifetime = old->ipad_action_origin.lifetime;
+    block->ipad_action_origin = origin;
+    block->ipad_corner_block_lifetime = fresh_lifetime;
+    block->ipad_corner_region_address = uint64_t(uintptr_t(region));
+    ui_ipad_rna_history_capture(C, block->ipad_corner_history);
+  }
+  else block->active = false;
+  ui_ipad_action_context_restore(C, previous_area, previous_region);
+#else
+  UNUSED_VARS(context, region, block);
+#endif
+}
