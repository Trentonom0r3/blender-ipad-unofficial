+{
+  wmOperatorType *type = WM_operatortype_find("VIEW3D_OT_ipad_native_tool", true);
+  if (!type || !type->srna || !type->ipad_lifetime_id) return {};
+  for (const auto &owned : block->buttons) {
+    const uiBut *button = owned.get();
+    if (button->optype != type || !button->opptr || button->opptr->type != type->srna ||
+        !button->opptr->data) continue;
+    const IDProperty *group = static_cast<const IDProperty *>(button->opptr->data);
+    if (group->type != IDP_GROUP) continue;
+    const IDProperty *property = IDP_GetPropertyFromGroup(group, "inventory");
+    if (!property || property->type != IDP_STRING || property->len < 1 ||
+        property->len > 65536 || property->len > property->totallen ||
+        !property->data.pointer) continue;
+    const char *text = static_cast<const char *>(property->data.pointer);
+    const char *end = static_cast<const char *>(memchr(text, '\0', size_t(property->len)));
+    if (end) return std::string(text, size_t(end - text));
+  }
+  return {};
