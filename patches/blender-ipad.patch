+bool EDBM_touch_undo_context_matches(bContext *C, const UndoStep *step)
+{
+  if (!step || !step->type || step->type->step_decode != mesh_undosys_step_decode) {
+    return false;
+  }
+  const auto *mesh_step = reinterpret_cast<const MeshUndoStep *>(step);
+  if (!mesh_step->elems || !mesh_step->elems_len || !mesh_step->elems[0].data.mesh) {
+    return false;
+  }
+  Main *main = CTX_data_main(C);
+  Scene *scene = CTX_data_scene(C);
+  Object *object = CTX_data_edit_object(C);
+  if (!main || !scene || !object || !object->data) {
+    return false;
+  }
+  /* Encoded refs have null/old ptr values. Use the native name/library resolver. */
+  const UndoRefID_Scene &scene_ref = mesh_step->scene_ref;
+  ID *resolved_scene = BKE_libblock_find_name_and_library_filepath(
+      main, GS(scene_ref.name), scene_ref.name + 2,
+      scene_ref.library_filepath_abs[0] ? scene_ref.library_filepath_abs : nullptr);
+  if (resolved_scene != &scene->id) {
+    return false;
+  }
+  ViewLayer *view_layer = CTX_data_view_layer(C);
+  BKE_view_layer_synced_ensure(scene, view_layer);
+  for (uint i = 0; i < mesh_step->elems_len; i++) {
+    const MeshUndoStep_Elem &elem = mesh_step->elems[i];
+    const UndoRefID_Object &reference = elem.obedit_ref;
+    ID *resolved = BKE_libblock_find_name_and_library_filepath(
+        main, GS(reference.name), reference.name + 2,
+        reference.library_filepath_abs[0] ? reference.library_filepath_abs : nullptr);
+    if (!resolved) {
+      return false;
+    }
+    Object *owner = reinterpret_cast<Object *>(resolved);
+    if (owner->type != OB_MESH || !owner->data || !elem.data.mesh ||
+        (i == 0 && owner != object) || !BKE_view_layer_base_find(view_layer, owner) ||
+        elem.data.mesh->id.session_uid != static_cast<ID *>(owner->data)->session_uid) {
+      return false;
+    }
+  }
+  return true;
+}
+#endif
