+struct NativeSeamControl {
+  policy::WorkingSeam seam;
+  bool fallback = false;
+  policy::WorkingAdjacency adjacency{};
+  ScrEdge *edge = nullptr;
+};
+
+/* Bind local fallback adjacency to an actual face edge, never merely a nearby
+ * collinear edge. The captured pointer is resolved again in the live snapshot. */
+static std::vector<policy::Area> working_controls(
+    bScreen *screen, const std::vector<policy::Area> &working, const Rect bounds,
+    std::vector<NativeSeamControl> &controls)
+{
+  std::vector<policy::WorkingSeam> partitions;
+  std::vector<policy::WorkingFallback> nodes;
+  auto displayed = policy::working_layout(working, bounds, int(4 * UI_SCALE_FAC),
+                                           &partitions, &nodes);
+  for (const auto &seam : partitions) { controls.push_back({seam, false, {}, nullptr}); }
+  std::vector<ScrArea *> areas;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) { areas.push_back(area); }
+  for (const auto &adj : policy::working_adjacencies(working, displayed, nodes)) {
+    if (adj.before_id < 0 || adj.after_id < 0 || adj.before_id >= int(areas.size()) ||
+        adj.after_id >= int(areas.size())) { continue; }
+    const ScrArea *before = areas[adj.before_id], *after = areas[adj.after_id];
+    ScrVert *a = adj.vertical ? before->v4 : before->v2;
+    ScrVert *b = before->v3;
+    ScrVert *c = after->v1;
+    ScrVert *d = adj.vertical ? after->v2 : after->v4;
+    ScrEdge *bound = nullptr;
+    LISTBASE_FOREACH (ScrEdge *, edge, &screen->edgebase) {
+      auto joins = [&](ScrVert *v, ScrVert *w) {
+        return (edge->v1 == v && edge->v2 == w) || (edge->v1 == w && edge->v2 == v);
+      };
+      if (!joins(a,b) && !joins(c,d)) { continue; }
+      const int x = adj.vertical ? edge->v1->vec.x : edge->v1->vec.y;
+      const int y = adj.vertical ? edge->v2->vec.x : edge->v2->vec.y;
+      const int u = adj.vertical ? edge->v1->vec.y : edge->v1->vec.x;
+      const int v = adj.vertical ? edge->v2->vec.y : edge->v2->vec.x;
+      if (x == adj.coordinate && y == x &&
+          std::min(std::max(u,v), adj.saved_max) > std::max(std::min(u,v), adj.saved_min)) {
+        bound = edge;
+        break;
+      }
+    }
+    if (!bound) { continue; }
+    Rect native_bounds = adj.node.saved_bounds;
+    --native_bounds.xmax;
+    --native_bounds.ymax;
+    controls.push_back({{adj.vertical, adj.coordinate, native_bounds, adj.node.display_bounds,
+                          adj.line, {}, {}}, true, adj, bound});
+  }
+  return displayed;
+}
