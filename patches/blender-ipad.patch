                                           const bool can_refresh)
 {
   wmWindow *window = CTX_wm_window(C);
   uiBut *activebut = UI_context_active_but_get(C);

   /* disable tooltips from buttons below */
   if (activebut) {
     UI_but_tooltip_timer_remove(C, activebut);
   }
   /* standard cursor by default */
   WM_cursor_set(window, WM_CURSOR_DEFAULT);

   /* create handle */
   uiPopupBlockHandle *handle = MEM_new<uiPopupBlockHandle>(__func__);
+
+  /* Explicit parent or admitted creator scope only. An unrelated popup in the
+   * same window does not inherit whichever ring happens to be open. Numbers
+   * reaches this scope after the root has closed, with no parent button. */
+  handle->ipad_action_origin = but ? but->block->ipad_action_origin :
+                                     ui_ipad_action_origin_current();
+  if (but) handle->ipad_parent_button = ui_ipad_button_lease_capture(but);
+  /* Root ring ownership is populated by its first creator. Allocate before
