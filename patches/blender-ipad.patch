 #include "ED_view3d.hh"
 
 #include "mesh_intern.hh" /* own include */
 
 using blender::Vector;
 
+#ifdef WITH_APPLE_CROSSPLATFORM
+/* The macro owns these independent native BMesh copies, never a saved context.
+ * Identity values are compared only after resolving a live Mesh from Main. */
+struct TouchExtrudeMesh {
+  uint32_t mesh_uid;
+  uint32_t key_uid;
+  const BMEditMesh *edit_identity;
+  const BMesh *bm_identity;
+  int shapenr;
+  BMBackup backup{};
+};
+
+struct TouchExtrudeTransaction {
+  Vector<TouchExtrudeMesh> meshes;
+};
+
+void EDBM_touch_extrude_discard(void *transaction)
+{
+  auto *data = static_cast<TouchExtrudeTransaction *>(transaction);
+  if (!data) {
+    return;
+  }
+  for (TouchExtrudeMesh &snapshot : data->meshes) {
+    EDBM_redo_state_free(&snapshot.backup);
+  }
+  MEM_delete(data);
+}
+
+void *EDBM_touch_extrude_begin(bContext *C, ReportList *reports)
+{
+  const bToolRef *tool = WM_toolsystem_ref_from_context(C);
+  if (!ED_operator_editmesh(C) || !tool || !STREQ(tool->idname, "builtin.extrude_region")) {
+    return nullptr;
+  }
+  auto *data = MEM_new<TouchExtrudeTransaction>(__func__);
+  const Vector<Object *> objects = BKE_view_layer_array_from_objects_in_edit_mode_unique_data(
+      CTX_data_scene(C), CTX_data_view_layer(C), CTX_wm_view3d(C));
+  /* Validate every participating owner before copying or changing any geometry. */
+  for (Object *object : objects) {
+    Mesh *mesh = static_cast<Mesh *>(object->data);
+    BMEditMesh *em = BKE_editmesh_from_object(object);
+    if (!em || !em->bm) {
+      EDBM_touch_extrude_discard(data);
+      return nullptr;
+    }
+    if (em->bm->totvertsel == 0) {
+      continue;
+    }
+    if (blender::ed::object::shape_key_report_if_locked(object, reports)) {
+      EDBM_touch_extrude_discard(data);
+      return nullptr;
+    }
+    data->meshes.append({mesh->id.session_uid,
+                         mesh->key ? mesh->key->id.session_uid : 0,
+                         em, em->bm, em->bm->shapenr, {}});
+  }
+  if (data->meshes.is_empty()) {
+    EDBM_touch_extrude_discard(data);
+    return nullptr;
+  }
+  /* No event/callback yields between validation and acquisition of all copies. */
+  for (TouchExtrudeMesh &snapshot : data->meshes) {
+    snapshot.backup = EDBM_redo_state_store(const_cast<BMEditMesh *>(snapshot.edit_identity));
+  }
+  return data;
+}
+
+bool EDBM_touch_extrude_finish(bContext *C, void *transaction, const bool cancelled)
+{
+  auto *data = static_cast<TouchExtrudeTransaction *>(transaction);
+  if (!data) {
+    return true; /* A rejected snapshot did not make any provisional edit. */
+  }
+  bool complete = !cancelled || (C && CTX_data_main(C));
+  if (cancelled && complete) {
+    Main *bmain = CTX_data_main(C);
+    for (TouchExtrudeMesh &snapshot : data->meshes) {
+      Mesh *owner = nullptr;
+      LISTBASE_FOREACH (Mesh *, mesh, &bmain->meshes) {
+        if (mesh->id.session_uid == snapshot.mesh_uid) {
+          owner = mesh;
+          break;
+        }
+      }
+      BMEditMesh *em = owner ? owner->runtime->edit_mesh.get() : nullptr;
+      /* A changed owner/key/edit representation is not our rollback target. */
+      if (!em || em != snapshot.edit_identity || em->bm != snapshot.bm_identity ||
+          em->bm->shapenr != snapshot.shapenr ||
+          (owner->key ? owner->key->id.session_uid : 0) != snapshot.key_uid)
+      {
+        complete = false;
+        continue;
+      }
+      EDBM_redo_state_restore_and_free(&snapshot.backup, em, false);
+      EDBMUpdate_Params params{};
+      params.calc_looptris = true;
+      params.calc_normals = true;
+      params.is_destructive = true;
+      EDBM_update(owner, &params);
+    }
+  }
+  EDBM_touch_extrude_discard(data);
+  return complete;
+}
+#endif
