+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <cstddef>
+#include <functional>
+
+/* Present a native picker for an independent local .blend copy. Main thread only.
+ * Returns whether presentation began, not whether a project has been opened. */
+bool GHOST_IOS_import_project();
+
+/* Prompt user with simple alert ("Compress .blend file?"), then serialize copy
+ * synchronously via writer, and present the native export picker.
+ * The writer must leave working-document identity and unsaved state unchanged. */
+bool GHOST_IOS_export_project(const char *filename,
+                              const std::function<bool(const char *staging_path, bool compress)> &writer,
+                              const std::function<void(const char *dest_path)> &on_saved = nullptr);
+
+/* Prompt user with simple alert ("Compress .blend file?"), then serialize project
+ * synchronously via writer, and present the native export picker.
+ * When a destination is chosen in Files, on_saved is called with the destination path. */
+bool GHOST_IOS_save_as_project(const char *filename,
+                               const std::function<bool(const char *staging_path, bool compress)> &writer,
+                               const std::function<void(const char *dest_path)> &on_saved);
+
+/* Prepare a destination path for saving a project inside Documents/Projects.
+ * Creates the containing directory if needed.
+ * Returns true if the path was written to out_path, false on error. */
+bool GHOST_IOS_get_project_save_path(const char *filename, char *out_path, size_t max_len);
+
+/* Present native picker to export a generated file from a temporary staging path.
+ * The writer creates the file(s) synchronously in staging_dir before presentation. */
+bool GHOST_IOS_export_file(const char *filename,
+                           const std::function<bool(const char *staging_path)> &writer);
+
+/* Present native picker to choose an external file for import.
+ * When a file is chosen, it is coordinated/copied into a sandbox location
+ * and callback is invoked on the main thread with the local path. */
+bool GHOST_IOS_import_file(const char *filter_glob,
+                           const std::function<void(const char *local_path)> &on_picked,
+                           const std::function<void()> &on_cancelled);
+
+/* Flythrough navigation state toggle for iPad touch controls. */
+void GHOST_IOS_set_flythrough_mode(bool enable);
+bool GHOST_IOS_get_flythrough_mode();
diff --git a/intern/ghost/intern/GHOST_ProjectImportIOS.hh b/intern/ghost/intern/GHOST_ProjectImportIOS.hh
new file mode 100644
--- /dev/null
+++ b/intern/ghost/intern/GHOST_ProjectImportIOS.hh
@@ -0,0 +1,502 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* Included only by GHOST_SystemIOS.mm. This service imports an independent
+ * project copy. It does not claim to own or save the provider's original file. */
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+@interface GHOST_IOSProjectImporter : NSObject <UIDocumentPickerDelegate,
+                                               UIAdaptivePresentationControllerDelegate>
+{
+  UIViewController *_presenter;
+  UIDocumentPickerViewController *_picker;
+  UIAlertController *_progress;
+  NSUInteger _generation;
+  BOOL _busy;
+}
+- (BOOL)present;
+@end
+
+@implementation GHOST_IOSProjectImporter
+
+- (BOOL)hasLivePresenter
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!system || !system->current_active_window_) {
+    return NO;
+  }
+  return system->current_active_window_->rootWindow.rootViewController == _presenter &&
+         _presenter.view.window != nil;
+}
+
+- (void)finish
+{
+  _busy = NO;
+  [_presenter release];
+  _presenter = nil;
+}
+
+- (void)showError:(NSString *)message
+{
+  if ([self hasLivePresenter]) {
+    UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"Project Import"
+                                                                  message:message
+                                                           preferredStyle:UIAlertControllerStyleAlert];
+    [alert addAction:[UIAlertAction actionWithTitle:@"OK"
+                                             style:UIAlertActionStyleCancel
+                                           handler:nil]];
+    [_presenter presentViewController:alert animated:YES completion:nil];
+  }
+  else {
+    NSLog(@"Project import: %@", message);
+  }
+  [self finish];
+}
+
+- (void)dismissPicker:(void (^)(void))completion
+{
+  UIDocumentPickerViewController *picker = _picker;
+  _picker = nil;
+  picker.delegate = nil;
+  picker.presentationController.delegate = nil;
+  [picker dismissViewControllerAnimated:YES completion:completion];
+  [picker release];
+}
+
+- (BOOL)present
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (_busy || !system || !system->current_active_window_) {
+    return NO;
+  }
+  UIViewController *presenter = system->current_active_window_->rootWindow.rootViewController;
+  if (!presenter.view.window || presenter.presentedViewController) {
+    return NO;
+  }
+  _presenter = [presenter retain];
+  _busy = YES;
+  ++_generation;
+  UTType *blend = [UTType typeWithFilenameExtension:@"blend" conformingToType:UTTypeData];
+  _picker = [[UIDocumentPickerViewController alloc] initForOpeningContentTypes:@[blend ?: UTTypeData]
+                                                                     asCopy:YES];
+  _picker.allowsMultipleSelection = NO;
+  _picker.delegate = self;
+  _picker.modalPresentationStyle = UIModalPresentationFormSheet;
+  _picker.title = @"Open a Blender Project";
+  [_presenter presentViewController:_picker animated:YES completion:nil];
+  _picker.presentationController.delegate = self;
+  return YES;
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller
+{
+  if (controller != _picker) {
+    return;
+  }
+  ++_generation;
+  [self dismissPicker:^{ [self finish]; }];
+}
+
+- (void)presentationControllerDidDismiss:(UIPresentationController *)controller
+{
+  if (controller.presentedViewController != _picker) {
+    return;
+  }
+  ++_generation;
+  _picker.delegate = nil;
+  _picker.presentationController.delegate = nil;
+  [_picker release];
+  _picker = nil;
+  [self finish];
+}
+
+- (void)importURL:(NSURL *)source
+{
+  if (![self hasLivePresenter]) {
+    [self finish];
+    return;
+  }
+  if (!source.isFileURL || [source.pathExtension caseInsensitiveCompare:@"blend"] != NSOrderedSame) {
+    [self showError:@"Choose a Blender (.blend) project."];
+    return;
+  }
+  const NSUInteger generation = _generation;
+  _progress = [[UIAlertController alertControllerWithTitle:@"Opening Project"
+                                                  message:@"Preparing project in Blender's Projects folder."
+                                           preferredStyle:UIAlertControllerStyleAlert] retain];
+  [_progress addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                               style:UIAlertActionStyleCancel
+                                             handler:^(UIAlertAction *action) {
+    /* File-provider work may finish later. Its generation cannot open a project
+     * or dismiss UI belonging to a newer request. */
+    ++_generation;
+    [_progress release];
+    _progress = nil;
+    [self finish];
+  }]];
+  [_presenter presentViewController:_progress animated:YES completion:^{
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+      @autoreleasepool {
+        NSFileManager *manager = [NSFileManager defaultManager];
+        NSURL *documents = [[manager URLsForDirectory:NSDocumentDirectory
+                                            inDomains:NSUserDomainMask] firstObject];
+        /* Never overwrite an existing import, even for equal filenames. Keep the
+         * original filename inside its own visible project directory. */
+        NSString *folder = [NSString stringWithFormat:@"%@ - %@",
+                            source.lastPathComponent.stringByDeletingPathExtension,
+                            [NSUUID UUID].UUIDString];
+        NSURL *project = [[documents URLByAppendingPathComponent:@"Projects" isDirectory:YES]
+                          URLByAppendingPathComponent:folder isDirectory:YES];
+        NSURL *destination = [project URLByAppendingPathComponent:source.lastPathComponent];
+        __block NSError *copy_error = nil;
+        NSError *coordination_error = nil;
+        __block BOOL copied = NO;
+        const BOOL scoped = [source startAccessingSecurityScopedResource];
+        NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+        [coordinator coordinateReadingItemAtURL:source options:0 error:&coordination_error
+                                     byAccessor:^(NSURL *read_url) {
+          NSNumber *regular = nil;
+          if (![read_url getResourceValue:&regular forKey:NSURLIsRegularFileKey error:&copy_error] ||
+              !regular.boolValue) {
+            return;
+          }
+          if ([manager createDirectoryAtURL:project withIntermediateDirectories:YES
+                                 attributes:nil error:&copy_error]) {
+            /* The actual copy is inside the coordinator's accessor. Blender
+             * subsequently reads our local copy, outside the provider lease. */
+            copied = [manager copyItemAtURL:read_url toURL:destination error:&copy_error];
+          }
+        }];
+        [coordinator release];
+        if (scoped) {
+          [source stopAccessingSecurityScopedResource];
+        }
+        NSString *failure = (coordination_error ?: copy_error).localizedDescription;
+        if (!copied) {
+          [manager removeItemAtURL:project error:nullptr];
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+          if (generation != _generation) {
+            if (copied) {
+              dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                [[NSFileManager defaultManager] removeItemAtURL:project error:nullptr];
+              });
+            }
+            return;
+          }
+          UIAlertController *progress = _progress;
+          _progress = nil;
+          [progress dismissViewControllerAnimated:YES completion:^{
+            if (generation != _generation) {
+              return;
+            }
+            if (!copied) {
+              [self showError:failure ?: @"The project could not be copied. Check available storage and try again."];
+              return;
+            }
+            GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+            if (![self hasLivePresenter] || !system->handleOpenDocumentRequest(destination.path)) {
+              [self showError:@"The project could not be opened. Check that the file is a valid Blender project."];
+              return;
+            }
+            /* Normal GHOST open event retains Blender's unsaved-changes dialog
+             * and script policy. No operator/context pointer survives UIKit. */
+            [self finish];
+          }];
+          [progress release];
+        });
+      }
+    });
+  }];
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller
+    didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls
+{
+  if (controller != _picker) {
+    return;
+  }
+  NSURL *source = urls.firstObject;
+  [self dismissPicker:^{
+    if (source) {
+      [self importURL:source];
+    }
+    else {
+      [self finish];
+    }
+  }];
+}
+@end
+
+bool GHOST_IOS_import_project()
+{
+  /* Application-lifetime delegate; UIKit delegates are non-owning. */
+  static GHOST_IOSProjectImporter *importer = nil;
+  if (![NSThread isMainThread]) {
+    return false;
+  }
+  if (!importer) {
+    importer = [[GHOST_IOSProjectImporter alloc] init];
+  }
+  return [importer present];
+}
+
+bool GHOST_IOS_get_project_save_path(const char *filename, char *out_path, size_t max_len)
+{
+  if (!out_path || max_len == 0) {
+    return false;
+  }
+  @autoreleasepool {
+    NSFileManager *manager = [NSFileManager defaultManager];
+    NSURL *documents = [[manager URLsForDirectory:NSDocumentDirectory
+                                        inDomains:NSUserDomainMask] firstObject];
+    if (!documents) {
+      return false;
+    }
+    NSString *rawName = (filename && filename[0]) ? [NSString stringWithUTF8String:filename] :
+                                                    @"Untitled.blend";
+    NSString *cleanName = rawName.lastPathComponent;
+    if (cleanName.length == 0 || [cleanName isEqualToString:@"."] || [cleanName isEqualToString:@".."]) {
+      cleanName = @"Untitled.blend";
+    }
+    if ([cleanName.pathExtension caseInsensitiveCompare:@"blend"] != NSOrderedSame) {
+      cleanName = [cleanName stringByAppendingPathExtension:@"blend"];
+    }
+    NSString *baseName = cleanName.stringByDeletingPathExtension;
+    if (baseName.length == 0) {
+      baseName = @"Untitled";
+      cleanName = @"Untitled.blend";
+    }
+    NSString *folder = [NSString stringWithFormat:@"%@ - %@", baseName, [NSUUID UUID].UUIDString];
+    NSURL *projectsDir = [documents URLByAppendingPathComponent:@"Projects" isDirectory:YES];
+    NSURL *projectFolder = [projectsDir URLByAppendingPathComponent:folder isDirectory:YES];
+    NSError *error = nil;
+    if (![manager createDirectoryAtURL:projectFolder withIntermediateDirectories:YES
+                            attributes:nil error:&error]) {
+      NSLog(@"Failed to create project directory at %@: %@", projectFolder.path, error);
+      return false;
+    }
+    NSURL *destURL = [projectFolder URLByAppendingPathComponent:cleanName];
+    const char *cpath = destURL.path.UTF8String;
+    if (!cpath || strlen(cpath) >= max_len) {
+      return false;
+    }
+    strncpy(out_path, cpath, max_len - 1);
+    out_path[max_len - 1] = '\0';
+    return true;
+  }
+}
+
+@interface GHOST_IOSFileImporter : NSObject <UIDocumentPickerDelegate,
+                                            UIAdaptivePresentationControllerDelegate>
+{
+  UIViewController *_presenter;
+  UIDocumentPickerViewController *_picker;
+  NSUInteger _generation;
+  BOOL _busy;
+  std::function<void(const char *)> _on_picked;
+  std::function<void()> _on_cancelled;
+}
+- (BOOL)presentWithFilter:(NSString *)filterGlob
+                 onPicked:(const std::function<void(const char *)> &)onPicked
+              onCancelled:(const std::function<void()> &)onCancelled;
+@end
+
+@implementation GHOST_IOSFileImporter
+- (BOOL)hasLivePresenter
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!system || !system->current_active_window_) {
+    return NO;
+  }
+  return system->current_active_window_->rootWindow.rootViewController == _presenter &&
+         _presenter.view.window != nil;
+}
+
+- (void)finish
+{
+  _busy = NO;
+  [_presenter release];
+  _presenter = nil;
+  _on_picked = nullptr;
+  _on_cancelled = nullptr;
+}
+
+- (void)dismissPicker:(void (^)(void))completion
+{
+  UIDocumentPickerViewController *picker = _picker;
+  _picker = nil;
+  picker.delegate = nil;
+  picker.presentationController.delegate = nil;
+  [picker dismissViewControllerAnimated:YES completion:completion];
+  [picker release];
+}
+
+- (BOOL)presentWithFilter:(NSString *)filterGlob
+                 onPicked:(const std::function<void(const char *)> &)onPicked
+              onCancelled:(const std::function<void()> &)onCancelled
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (_busy || !system || !system->current_active_window_) {
+    return NO;
+  }
+  UIViewController *presenter = system->current_active_window_->rootWindow.rootViewController;
+  if (!presenter.view.window || presenter.presentedViewController) {
+    return NO;
+  }
+  _presenter = [presenter retain];
+  _busy = YES;
+  ++_generation;
+  _on_picked = onPicked;
+  _on_cancelled = onCancelled;
+
+  NSMutableArray<UTType *> *types = [NSMutableArray array];
+  if (filterGlob.length) {
+    NSArray<NSString *> *patterns = [filterGlob componentsSeparatedByCharactersInSet:
+        [NSCharacterSet characterSetWithCharactersInString:@";:, "]];
+    for (NSString *pat in patterns) {
+      NSString *clean = [pat stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+      if ([clean hasPrefix:@"*."]) {
+        clean = [clean substringFromIndex:2];
+      }
+      else if ([clean hasPrefix:@"."]) {
+        clean = [clean substringFromIndex:1];
+      }
+      if (clean.length) {
+        UTType *t = [UTType typeWithFilenameExtension:clean conformingToType:UTTypeData];
+        if (t && ![types containsObject:t]) {
+          [types addObject:t];
+        }
+      }
+    }
+  }
+  if (!types.count) {
+    [types addObject:UTTypeData];
+  }
+
+  _picker = [[UIDocumentPickerViewController alloc] initForOpeningContentTypes:types asCopy:YES];
+  _picker.allowsMultipleSelection = NO;
+  _picker.delegate = self;
+  _picker.modalPresentationStyle = UIModalPresentationFormSheet;
+  _picker.title = @"Import 3D Model";
+  [_presenter presentViewController:_picker animated:YES completion:nil];
+  _picker.presentationController.delegate = self;
+  return YES;
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller
+{
+  if (controller != _picker) {
+    return;
+  }
+  ++_generation;
+  auto onCancelled = _on_cancelled;
+  [self dismissPicker:^{
+    if (onCancelled) {
+      onCancelled();
+    }
+    [self finish];
+  }];
+}
+
+- (void)presentationControllerDidDismiss:(UIPresentationController *)controller
+{
+  if (controller.presentedViewController != _picker) {
+    return;
+  }
+  ++_generation;
+  _picker.delegate = nil;
+  _picker.presentationController.delegate = nil;
+  [_picker release];
+  _picker = nil;
+  if (_on_cancelled) {
+    _on_cancelled();
+  }
+  [self finish];
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller
+    didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls
+{
+  if (controller != _picker) {
+    return;
+  }
+  NSURL *source = urls.firstObject;
+  const NSUInteger generation = _generation;
+  auto onPicked = _on_picked;
+  auto onCancelled = _on_cancelled;
+
+  [self dismissPicker:^{
+    if (!source) {
+      if (onCancelled) {
+        onCancelled();
+      }
+      [self finish];
+      return;
+    }
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+      @autoreleasepool {
+        NSFileManager *manager = [NSFileManager defaultManager];
+        NSURL *root = [NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES];
+        NSString *folder = [NSString stringWithFormat:@"BlenderImport-%@", [NSUUID UUID].UUIDString];
+        NSURL *importDir = [root URLByAppendingPathComponent:folder isDirectory:YES];
+        NSURL *destination = [importDir URLByAppendingPathComponent:source.lastPathComponent];
+        NSError *coordError = nil;
+        __block NSError *copyError = nil;
+        __block BOOL copied = NO;
+        const BOOL scoped = [source startAccessingSecurityScopedResource];
+        NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+        [coordinator coordinateReadingItemAtURL:source options:0 error:&coordError
+                                     byAccessor:^(NSURL *read_url) {
+          if ([manager createDirectoryAtURL:importDir withIntermediateDirectories:YES
+                                 attributes:nil error:&copyError]) {
+            copied = [manager copyItemAtURL:read_url toURL:destination error:&copyError];
+          }
+        }];
+        [coordinator release];
+        if (scoped) {
+          [source stopAccessingSecurityScopedResource];
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+          if (generation != _generation) {
+            return;
+          }
+          if (copied && onPicked) {
+            onPicked(destination.path.UTF8String);
+          }
+          else if (onCancelled) {
+            onCancelled();
+          }
+          [self finish];
+        });
+      }
+    });
+  }];
+}
+@end
+
+bool GHOST_IOS_import_file(const char *filter_glob,
+                           const std::function<void(const char *)> &on_picked,
+                           const std::function<void()> &on_cancelled)
+{
+  if (![NSThread isMainThread] || !on_picked) {
+    return false;
+  }
+  static GHOST_IOSFileImporter *importer = nil;
+  if (!importer) {
+    importer = [[GHOST_IOSFileImporter alloc] init];
+  }
+  NSString *glob = filter_glob ? [NSString stringWithUTF8String:filter_glob] : @"";
+  return [importer presentWithFilter:glob onPicked:on_picked onCancelled:on_cancelled];
+}
+
+static bool g_ipad_flythrough_mode = false;
+
+void GHOST_IOS_set_flythrough_mode(bool enable)
+{
+  g_ipad_flythrough_mode = enable;
+}
+
+bool GHOST_IOS_get_flythrough_mode()
+{
+  return g_ipad_flythrough_mode;
+}
