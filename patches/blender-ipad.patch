 {
   if ((block->flag & UI_BLOCK_NUMSELECT) && event->val == KM_PRESS) {
     for (const std::unique_ptr<uiBut> &but : block->buttons) {
       if (but->pie_dir == dir && !ELEM(but->type, ButType::Sepr, ButType::SeprLine)) {
         return but.get();
       }
     }
   }

   return nullptr;
