+/* Bind menu commands to their originating working editor, including when the
+ * menu itself runs in the top bar or a popup region. */
+static ScrArea *working_source(const Model &model, const int source)
+{
+  if (source < 0) {
+    return model.main;
+  }
+  for (const policy::Area &working : model.working) {
+    if (working.id == source) {
+      return model.areas[source];
+    }
+  }
+  return nullptr;
+}
