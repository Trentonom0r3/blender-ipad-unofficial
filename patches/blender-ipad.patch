+    if (handler->handle_fn != ui_popup_handler || handler->remove_fn != ui_popup_handler_remove ||
+        !handler->user_data) continue;
+    /* A matching registered native handler owns this fresh handle. Never start
+     * from after.popup_op or a saved handle address: Cancel may have freed it. */
+    auto *handle = static_cast<uiPopupBlockHandle *>(handler->user_data);
+    if (handle->ipad_operator_retired || handle->ipad_popup_lifetime != lifetime ||
+        (handle->menuretval & (UI_RETURN_CANCEL | UI_RETURN_OK | UI_RETURN_OUT | UI_RETURN_OUT_PARENT | UI_RETURN_POPUP_OK)) || !handle->region ||
