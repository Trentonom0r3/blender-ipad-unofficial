+    region->runtime->type = art;
+  }
+  /* Native copy/read drops temporary regiondata. Recover the sentinel storage
+   * independently of creating the region; never overwrite a valid Redo origin. */
+  const bool initialized = region->regiondata == nullptr;
+  if (initialized) {
