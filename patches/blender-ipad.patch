+#ifdef WITH_APPLE_CROSSPLATFORM
+void WM_toolsystem_ref_properties_for_transform(const bContext *C,
+                                                bToolRef *tref,
+                                                PointerRNA *ptr,
+                                                const wmOperatorType *ot,
+                                                const bool use_orientation)
+{
+  /* Only deliberate transform-tool calls use the tool's native orientation slot.
+   * Leave shortcuts, other tools and explicit gizmo bases untouched. */
+  if (!tref || tref->space_type != SPACE_VIEW3D ||
+      !(STREQ(ot->idname, "TRANSFORM_OT_translate") ||
+        STREQ(ot->idname, "TRANSFORM_OT_rotate") ||
+        STREQ(ot->idname, "TRANSFORM_OT_resize")))
+  {
+    return;
+  }
+  const char *mode = CTX_data_mode_string(C);
+  if (!mode || !(STREQ(mode, "OBJECT") || STREQ(mode, "POSE") || STRPREFIX(mode, "EDIT_"))) {
+    return;
+  }
+  int slot = -1;
+  if (STREQ(tref->idname, "builtin.move") && STREQ(ot->idname, "TRANSFORM_OT_translate")) {
+    slot = SCE_ORIENT_TRANSLATE;
+  }
+  else if (STREQ(tref->idname, "builtin.rotate") && STREQ(ot->idname, "TRANSFORM_OT_rotate")) {
+    slot = SCE_ORIENT_ROTATE;
+  }
+  else if (STREQ(tref->idname, "builtin.scale") && STREQ(ot->idname, "TRANSFORM_OT_resize")) {
+    slot = SCE_ORIENT_SCALE;
+  }
+  else if (STREQ(tref->idname, "builtin.transform")) {
+    slot = SCE_ORIENT_TRANSLATE;
+  }
+  if (slot < 0) {
+    return;
+  }
