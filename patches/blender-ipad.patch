+@interface GHOST_IOSFileImporter : NSObject <UIDocumentPickerDelegate,
+                                            UIAdaptivePresentationControllerDelegate>
+{
+  UIViewController *_presenter;
+  UIDocumentPickerViewController *_picker;
+  UIAlertController *_progress;
+  UIAlertController *_libraryChoice;
+  NSProgress *_copyProgress;
+  NSURL *_pendingLibraryDir;
+  NSUInteger _generation;
+  BOOL _busy;
+  BOOL _libraryCopy;
+  std::function<bool(const char *)> _on_picked;
+  std::function<void()> _on_cancelled;
+}
+- (void)continueLibraryChoice:(NSURL *)file importDir:(NSURL *)importDir generation:(NSUInteger)generation remaining:(int)remaining;
+- (BOOL)presentWithFilter:(NSString *)filterGlob
+              libraryCopy:(BOOL)libraryCopy
+                 onPicked:(const std::function<bool(const char *)> &)onPicked
+              onCancelled:(const std::function<void()> &)onCancelled;
+@end
+
+@implementation GHOST_IOSFileImporter
+- (BOOL)hasLivePresenter
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!system || !system->current_active_window_) {
+    return NO;
+  }
+  return system->current_active_window_->rootWindow.rootViewController == _presenter &&
+         _presenter.view.window != nil;
+}
+
+- (void)finish
+{
+  _busy = NO;
+  if (_copyProgress) {
+    [_copyProgress cancel];
+    [_copyProgress release];
+    _copyProgress = nil;
+  }
+  if (_progress) {
+    [_progress dismissViewControllerAnimated:NO completion:nil];
+    [_progress release];
+    _progress = nil;
+  }
+  if (_libraryChoice) {
+    UIAlertController *choice = _libraryChoice;
+    _libraryChoice = nil;
+    choice.presentationController.delegate = nil;
+    [choice dismissViewControllerAnimated:NO completion:nil];
+    [choice release];
+  }
+  NSURL *pending = _pendingLibraryDir;
+  _pendingLibraryDir = nil;
+  if (pending) {
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+      [[NSFileManager defaultManager] removeItemAtURL:pending error:nil];
+      [pending release];
+    });
+  }
+  [_presenter release];
+  _presenter = nil;
+  _on_picked = nullptr;
+  _on_cancelled = nullptr;
+}
+
+- (void)continueLibraryChoice:(NSURL *)file importDir:(NSURL *)importDir generation:(NSUInteger)generation remaining:(int)remaining
+{
+  if (generation != _generation || !_busy) {
+    return;
+  }
+  if (![self hasLivePresenter]) {
+    if (_on_cancelled) {
+      _on_cancelled();
+    }
+    [self finish];
+    return;
+  }
+  if (_presenter.presentedViewController) {
+    if (remaining <= 0) {
+      if (_on_cancelled) {
+        _on_cancelled();
+      }
+      [self finish];
+      return;
+    }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC),
+                   dispatch_get_main_queue(), ^{
+      [self continueLibraryChoice:file importDir:importDir generation:generation remaining:remaining - 1];
+    });
+    return;
+  }
+  NSError *publishError = nil;
+  if (!_pendingLibraryDir || ![[NSFileManager defaultManager]
+      moveItemAtURL:_pendingLibraryDir toURL:importDir error:&publishError]) {
+    UIViewController *presenter = [_presenter retain];
+    if (_on_cancelled) {
+      _on_cancelled();
+    }
+    [self finish];
+    if (presenter.view.window && !presenter.presentedViewController) {
+      UIAlertController *alert = [UIAlertController
+          alertControllerWithTitle:@"Library Not Copied"
+                       message:publishError.localizedDescription ?:
+                           @"The library folder could not be published. Check available storage and try again."
+                preferredStyle:UIAlertControllerStyleAlert];
+      [alert addAction:[UIAlertAction actionWithTitle:@"OK"
+                                               style:UIAlertActionStyleCancel handler:nil]];
+      [presenter presentViewController:alert animated:YES completion:nil];
+    }
+    [presenter release];
+    return;
+  }
+  [_pendingLibraryDir release];
+  _pendingLibraryDir = [importDir retain];
+  const bool accepted = _on_picked && _on_picked(file.path.UTF8String);
+  if (accepted) {
+    [_pendingLibraryDir release];
+    _pendingLibraryDir = nil;
+  }
+  else if (_on_cancelled) {
+    _on_cancelled();
+  }
+  [self finish];
+}
+
+- (void)dismissPicker:(void (^)(void))completion
+{
+  UIDocumentPickerViewController *picker = _picker;
+  _picker = nil;
+  picker.delegate = nil;
+  picker.presentationController.delegate = nil;
+  [picker dismissViewControllerAnimated:YES completion:completion];
+  [picker release];
+}
+
+- (BOOL)presentWithFilter:(NSString *)filterGlob
+              libraryCopy:(BOOL)libraryCopy
+                 onPicked:(const std::function<bool(const char *)> &)onPicked
+              onCancelled:(const std::function<void()> &)onCancelled
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (_busy && ![self hasLivePresenter]) {
+    ++_generation;
+    [self finish];
+  }
+  if (_busy || !system || !system->current_active_window_) {
+    return NO;
+  }
+  UIViewController *presenter = system->current_active_window_->rootWindow.rootViewController;
+  if (!presenter.view.window || presenter.presentedViewController) {
+    return NO;
+  }
+  _presenter = [presenter retain];
+  _busy = YES;
+  _libraryCopy = libraryCopy;
+  ++_generation;
+  _on_picked = onPicked;
+  _on_cancelled = onCancelled;
+
+  NSMutableArray<UTType *> *types = [NSMutableArray array];
+  if (filterGlob.length) {
+    NSArray<NSString *> *patterns = [filterGlob componentsSeparatedByCharactersInSet:
+        [NSCharacterSet characterSetWithCharactersInString:@";:, "]];
+    for (NSString *pat in patterns) {
+      NSString *clean = [pat stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+      if ([clean hasPrefix:@"*."]) {
+        clean = [clean substringFromIndex:2];
+      }
+      else if ([clean hasPrefix:@"."]) {
+        clean = [clean substringFromIndex:1];
+      }
+      if (clean.length) {
+        UTType *t = [UTType typeWithFilenameExtension:clean conformingToType:UTTypeData];
+        if (t && ![types containsObject:t]) {
+          [types addObject:t];
+        }
+      }
+    }
+  }
+  if (!types.count) {
+    [types addObject:UTTypeData];
+  }
+  if (libraryCopy) {
+    /* Files can also provide a complete asset folder. Keep the existing
+     * single-.blend choice available in this same picker. */
+    [types addObject:UTTypeFolder];
+  }
+
+  _picker = [[UIDocumentPickerViewController alloc] initForOpeningContentTypes:types asCopy:YES];
+  _picker.allowsMultipleSelection = NO;
+  _picker.delegate = self;
+  _picker.modalPresentationStyle = UIModalPresentationFormSheet;
+  _picker.title = libraryCopy ? @"Choose Library File or Folder" : @"Import 3D Model";
+  [_presenter presentViewController:_picker animated:YES completion:nil];
+  _picker.presentationController.delegate = self;
+  return YES;
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller
+{
+  if (controller != _picker) {
+    return;
+  }
+  ++_generation;
+  auto onCancelled = _on_cancelled;
+  [self dismissPicker:^{
+    if (onCancelled) {
+      onCancelled();
+    }
+    [self finish];
+  }];
+}
+
+- (void)presentationControllerDidDismiss:(UIPresentationController *)controller
+{
+  if (_libraryChoice && controller.presentedViewController == _libraryChoice) {
+    ++_generation;
+    auto onCancelled = _on_cancelled;
+    UIAlertController *choice = _libraryChoice;
+    _libraryChoice = nil;
+    [choice release];
+    if (onCancelled) {
+      onCancelled();
+    }
+    [self finish];
+    return;
+  }
+  if (!_picker || controller.presentedViewController != _picker) {
+    return;
+  }
+  ++_generation;
+  _picker.delegate = nil;
+  _picker.presentationController.delegate = nil;
+  [_picker release];
+  _picker = nil;
+  if (_on_cancelled) {
+    _on_cancelled();
+  }
+  [self finish];
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller
+    didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls
+{
+  if (controller != _picker) {
+    return;
+  }
+  NSURL *source = urls.firstObject;
+  const NSUInteger generation = _generation;
+  auto onPicked = _on_picked;
+  auto onCancelled = _on_cancelled;
+  const BOOL libraryCopy = _libraryCopy;
+  NSNumber *isDirectory = nil;
+  const BOOL scopedForType = libraryCopy && source &&
+      [source startAccessingSecurityScopedResource];
+  const BOOL folderCopy = libraryCopy && source &&
+      [source getResourceValue:&isDirectory forKey:NSURLIsDirectoryKey error:nil] &&
+      isDirectory.boolValue;
+  if (scopedForType) {
+    [source stopAccessingSecurityScopedResource];
+  }
+
+  [self dismissPicker:^{
+    if (!source || (libraryCopy && !folderCopy &&
+                    [source.pathExtension caseInsensitiveCompare:@"blend"] != NSOrderedSame)) {
+      if (onCancelled) {
+        onCancelled();
+      }
+      [self finish];
+      return;
+    }
+    if (![self hasLivePresenter] || _presenter.presentedViewController) {
+      if (onCancelled) {
+        onCancelled();
+      }
+      [self finish];
+      return;
+    }
+    _copyProgress = [[NSProgress progressWithTotalUnitCount:1] retain];
+    _progress = [[UIAlertController alertControllerWithTitle:
+        (folderCopy ? @"Preparing Library Folder" :
+         libraryCopy ? @"Preparing Blender Library" : @"Preparing 3D Model")
+                                                 message:folderCopy ? @"Copying the folder and its relative assets. You can cancel." :
+                                                                     @"Copying the selected file. You can cancel."
+                                          preferredStyle:UIAlertControllerStyleAlert] retain];
+    [_progress setModalInPresentation:YES];
+    [_progress addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                                 style:UIAlertActionStyleCancel
+                                               handler:^(UIAlertAction *action) {
+      ++_generation;
+      [_copyProgress cancel];
+      /* UIKit dismisses a Cancel action itself; release our ownership first. */
+      UIAlertController *progress = _progress;
+      _progress = nil;
+      [progress release];
+      if (onCancelled) {
+        onCancelled();
+      }
+      [self finish];
+    }]];
+    [_presenter presentViewController:_progress animated:YES completion:^{
+      if (!_busy || generation != _generation || !_copyProgress) {
+        return;
+      }
+      NSProgress *copyProgress = [_copyProgress retain];
+      dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+      @autoreleasepool {
+        NSFileManager *manager = [NSFileManager defaultManager];
+        NSURL *root = libraryCopy ?
+            [[[manager URLsForDirectory:NSDocumentDirectory inDomains:NSUserDomainMask] firstObject]
+                URLByAppendingPathComponent:@"Libraries" isDirectory:YES] :
+            [NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES];
+        NSString *identifier = [NSUUID UUID].UUIDString;
+        NSString *folder = [NSString stringWithFormat:@"%@-%@",
+            (libraryCopy ? @"BlenderLibrary" : @"BlenderImport"), identifier];
+        NSURL *importDir = [root URLByAppendingPathComponent:folder isDirectory:YES];
+        /* Keep an unfinished library invisible in Files until its read succeeds. */
+        NSURL *stagingDir = libraryCopy ?
+            [root URLByAppendingPathComponent:
+                [@".BlenderLibraryImport-" stringByAppendingString:identifier] isDirectory:YES] :
+            importDir;
+        NSURL *destination = [importDir URLByAppendingPathComponent:source.lastPathComponent];
+        NSURL *stagingDestination = [stagingDir URLByAppendingPathComponent:source.lastPathComponent];
+        NSError *coordError = nil;
+        __block NSError *copyError = nil;
+        __block BOOL copied = NO;
+        const BOOL scoped = [source startAccessingSecurityScopedResource];
+        NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+        if (!copyProgress.cancelled) {
+          if (folderCopy) {
+            if ([manager createDirectoryAtURL:stagingDir withIntermediateDirectories:YES
+                                   attributes:nil error:&copyError]) {
+              copied = [GHOST_IOSProjectImporter copyItemAtURL:source
+                  toURL:stagingDestination manager:manager progress:copyProgress error:&copyError];
+            }
+          }
+          else {
+            [coordinator coordinateReadingItemAtURL:source options:0 error:&coordError
+                                         byAccessor:^(NSURL *read_url) {
+              if (copyProgress.cancelled) {
+                return;
+              }
+              if ([manager createDirectoryAtURL:stagingDir withIntermediateDirectories:YES
+                                     attributes:nil error:&copyError]) {
+                copied = [manager copyItemAtURL:read_url toURL:stagingDestination error:&copyError];
+              }
+            }];
+          }
+        }
+        [coordinator release];
+        NSURL *selectedLibrary = destination;
+        NSMutableArray<NSURL *> *availableLibraries = [NSMutableArray array];
+        if (copied && folderCopy && !copyProgress.cancelled) {
+          NSMutableArray<NSURL *> *blendFiles = [NSMutableArray array];
+          __block BOOL enumerationFailed = NO;
+          NSDirectoryEnumerator<NSURL *> *contents = [manager
+              enumeratorAtURL:stagingDestination
+              includingPropertiesForKeys:@[NSURLIsRegularFileKey, NSURLIsSymbolicLinkKey]
+              options:NSDirectoryEnumerationSkipsHiddenFiles |
+                      NSDirectoryEnumerationSkipsPackageDescendants
+              errorHandler:^BOOL(NSURL *url, NSError *error) {
+                copyError = error;
+                enumerationFailed = YES;
+                return NO;
+              }];
+          for (NSURL *item in contents) {
+            if (copyProgress.cancelled) {
+              copied = NO;
+              break;
+            }
+            if ([item.pathExtension caseInsensitiveCompare:@"blend"] != NSOrderedSame) {
+              continue;
+            }
+            NSNumber *regular = nil, *symbolicLink = nil;
+            if (![item getResourceValue:&regular forKey:NSURLIsRegularFileKey error:&copyError] ||
+                ![item getResourceValue:&symbolicLink forKey:NSURLIsSymbolicLinkKey error:&copyError]) {
+              enumerationFailed = YES;
+              break;
+            }
+            if (regular.boolValue && !symbolicLink.boolValue) {
+              [blendFiles addObject:item];
+            }
+          }
+          if (enumerationFailed || !blendFiles.count) {
+            copied = NO;
+            if (!enumerationFailed) {
+              copyError = [NSError errorWithDomain:NSCocoaErrorDomain
+                                              code:NSFileReadUnknownError
+                                          userInfo:@{NSLocalizedDescriptionKey:
+                                              @"This folder has no .blend file."}];
+            }
+          }
+          else if (copied && !copyProgress.cancelled) {
+            [blendFiles sortUsingComparator:^NSComparisonResult(NSURL *a, NSURL *b) {
+              return [a.path localizedStandardCompare:b.path];
+            }];
+            NSString *prefix = [stagingDestination.path stringByAppendingString:@"/"];
+            for (NSURL *file in blendFiles) {
+              if (![file.path hasPrefix:prefix]) {
+                copied = NO;
+                break;
+              }
+              [availableLibraries addObject:[destination URLByAppendingPathComponent:
+                  [file.path substringFromIndex:prefix.length]]];
+            }
+            if (copied) {
+              selectedLibrary = availableLibraries.firstObject;
+            }
+          }
+        }
+        if (copied && libraryCopy && !copyProgress.cancelled &&
+            !(folderCopy && availableLibraries.count > 1)) {
+          copied = [manager moveItemAtURL:stagingDir toURL:importDir error:&copyError];
+        }
+        if (scoped) {
+          [source stopAccessingSecurityScopedResource];
+        }
+        NSString *copyFailure = [copyError.localizedDescription copy];
+        dispatch_async(dispatch_get_main_queue(), ^{
+          if (generation != _generation || copyProgress.cancelled || ![self hasLivePresenter]) {
+            dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+              NSFileManager *cleanupManager = [NSFileManager defaultManager];
+              if (libraryCopy) {
+                [cleanupManager removeItemAtURL:stagingDir error:nil];
+              }
+              [cleanupManager removeItemAtURL:importDir error:nil];
+            });
+            if (generation == _generation) {
+              if (onCancelled) {
+                onCancelled();
+              }
+              [self finish];
+            }
+            [copyProgress release];
+            return;
+          }
+          UIAlertController *progress = _progress;
+          _progress = nil;
+          if (copied && folderCopy && availableLibraries.count > 1) {
+            /* Leave the complete copy hidden until a library is chosen. Startup
+             * cleanup removes it if the app exits at this native choice. */
+            _pendingLibraryDir = [stagingDir retain];
+            UIAlertController *choice = [[UIAlertController
+                alertControllerWithTitle:@"Choose Library File"
+                             message:@"The complete folder was copied. Which .blend should Link or Append use?"
+                      preferredStyle:UIAlertControllerStyleAlert] retain];
+            _libraryChoice = choice;
+            [choice setModalInPresentation:YES];
+            NSString *prefix = [destination.path stringByAppendingString:@"/"];
+            for (NSURL *file in availableLibraries) {
+              NSString *label = [file.path hasPrefix:prefix] ?
+                  [file.path substringFromIndex:prefix.length] : file.lastPathComponent;
+              [choice addAction:[UIAlertAction actionWithTitle:label
+                                                       style:UIAlertActionStyleDefault
+                                                     handler:^(UIAlertAction *action) {
+                if (generation != _generation || !_busy) {
+                  return;
+                }
+                if (![self hasLivePresenter]) {
+                  if (onCancelled) {
+                    onCancelled();
+                  }
+                  [self finish];
+                  return;
+                }
+                UIAlertController *shown = _libraryChoice;
+                _libraryChoice = nil;
+                shown.presentationController.delegate = nil;
+                [shown release];
+                [self continueLibraryChoice:file importDir:importDir generation:generation remaining:20];
+              }]];
+            }
+            [choice addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                                   style:UIAlertActionStyleCancel
+                                                 handler:^(UIAlertAction *action) {
+              if (generation != _generation || !_busy) {
+                return;
+              }
+              ++_generation;
+              UIAlertController *shown = _libraryChoice;
+              _libraryChoice = nil;
+              shown.presentationController.delegate = nil;
+              [shown release];
+              if (onCancelled) {
+                onCancelled();
+              }
+              [self finish];
+            }]];
+            [progress dismissViewControllerAnimated:YES completion:^{
+              if (generation != _generation || !_busy) {
+                return;
+              }
+              if (![self hasLivePresenter] || _presenter.presentedViewController) {
+                if (onCancelled) {
+                  onCancelled();
+                }
+                [self finish];
+                return;
+              }
+              [_presenter presentViewController:choice animated:YES completion:nil];
+              choice.presentationController.delegate = self;
+            }];
+            [progress release];
+            [copyProgress release];
+            return;
+          }
+          [progress dismissViewControllerAnimated:NO completion:nil];
+          [progress release];
+          const bool accepted = copied && onPicked && onPicked(selectedLibrary.path.UTF8String);
+          if (!accepted) {
+            dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+              NSFileManager *cleanupManager = [NSFileManager defaultManager];
+              if (libraryCopy) {
+                [cleanupManager removeItemAtURL:stagingDir error:nil];
+              }
+              [cleanupManager removeItemAtURL:importDir error:nil];
+            });
+            if (onCancelled) {
+              onCancelled();
+            }
+          }
+          /* A failed coordinated copy otherwise looks like a cancelled picker. */
+          UIViewController *errorPresenter = !copied && [self hasLivePresenter] ?
+              [_presenter retain] : nil;
+          [self finish];
+          if (errorPresenter) {
+            dispatch_async(dispatch_get_main_queue(), ^{
+              if (errorPresenter.view.window && !errorPresenter.presentedViewController) {
+                UIAlertController *alert = [UIAlertController
+                    alertControllerWithTitle:libraryCopy ? @"Library Not Copied" : @"Model Not Copied"
+                                 message:copyFailure ?: @"The selected item could not be copied. Check Files access and available storage, then try again."
+                          preferredStyle:UIAlertControllerStyleAlert];
+                [alert addAction:[UIAlertAction actionWithTitle:@"OK"
+                                                         style:UIAlertActionStyleCancel
+                                                       handler:nil]];
+                [errorPresenter presentViewController:alert animated:YES completion:nil];
+              }
+              [errorPresenter release];
+            });
+          }
+          [copyProgress release];
+        });
+        [copyFailure release];
+      }
+    });
+    }];
+  }];
+}
