+static wmOperatorStatus working_split_exec(bContext *C, wmOperator *op)
+{
+  wmWindow *win = CTX_wm_window(C);
+  Model model = make_model(C, win);
+  ScrArea *source = working_source(model, RNA_int_get(op->ptr, "source"));
+  if (!source) {
+    return OPERATOR_CANCELLED;
+  }
+  if (!ED_ipad_panels_layout_checkpoint_capture(C, "Before Split")) {
+    BKE_report(op->reports, RPT_WARNING, "Could not preserve the current layout");
+    return OPERATOR_CANCELLED;
+  }
+  ScrArea *created = area_split(win, CTX_wm_screen(C), source,
+                                 RNA_boolean_get(op->ptr, "vertical") ? SCREEN_AXIS_V : SCREEN_AXIS_H,
+                                 0.5f, true);
+  if (!created) {
+    BKE_report(op->reports, RPT_WARNING, "This editor is too small for another split");
+    return OPERATOR_CANCELLED;
+  }
+  source->ipad_keep_working = created->ipad_keep_working = 1;
+  tag_layout(C, win);
+  WM_event_add_notifier(C, NC_SCREEN | NA_EDITED, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+static wmOperatorStatus working_swap_exec(bContext *C, wmOperator *op)
+{
+  wmWindow *win = CTX_wm_window(C);
+  Model model = make_model(C, win);
+  ScrArea *source = working_source(model, RNA_int_get(op->ptr, "source"));
+  if (!source) {
+    return OPERATOR_CANCELLED;
+  }
+  const int target = RNA_int_get(op->ptr, "target");
+  for (const policy::Area &working : model.working) {
+    if (working.id == target && model.areas[target] != source) {
+      if (!ED_ipad_panels_layout_checkpoint_capture(C, "Before Swap")) {
+        BKE_report(op->reports, RPT_WARNING, "Could not preserve the current layout");
+        return OPERATOR_CANCELLED;
+      }
+      ED_area_swapspace(C, source, model.areas[target]);
+      tag_layout(C, win);
+      WM_event_add_notifier(C, NC_SCREEN | NA_EDITED, nullptr);
+      return OPERATOR_FINISHED;
+    }
+  }
+  return OPERATOR_CANCELLED;
+}
+
+static wmOperatorStatus working_join_exec(bContext *C, wmOperator *op)
+{
+  wmWindow *win = CTX_wm_window(C);
+  bScreen *screen = CTX_wm_screen(C);
+  Model model = make_model(C, win);
+  ScrArea *source = working_source(model, RNA_int_get(op->ptr, "source"));
+  ScrArea *target = nullptr;
+  const int target_id = RNA_int_get(op->ptr, "target");
+  for (const policy::Area &working : model.working) {
+    if (working.id == target_id) {
+      target = model.areas[working.id];
+      break;
+    }
+  }
+  if (!source || !target || source == target ||
+      !working_areas_are_full_edge_neighbors(source, target))
+  {
+    return OPERATOR_CANCELLED;
+  }
+  if (!ED_ipad_panels_layout_checkpoint_capture(C, "Before Join")) {
+    BKE_report(op->reports, RPT_WARNING, "Could not preserve the current layout");
+    return OPERATOR_CANCELLED;
+  }
+  if (!screen_area_join(C, op->reports, screen, source, target)) {
+    return OPERATOR_CANCELLED;
+  }
+  if (CTX_wm_area(C) == target) {
+    CTX_wm_area_set(C, nullptr);
+    CTX_wm_region_set(C, nullptr);
+  }
+  working_area_indices_remap_after_join(screen, model, target);
+  tag_layout(C, win);
+  WM_event_add_notifier(C, NC_SCREEN | NA_EDITED, nullptr);
+  return OPERATOR_FINISHED;
+}
