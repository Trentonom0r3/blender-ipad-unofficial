diff --git a/source/blender/editors/interface/interface_ipad_ring_browse.hh b/source/blender/editors/interface/interface_ipad_ring_browse.hh
new file mode 100644
index 0000000..ef9a89b
--- /dev/null
+++ b/source/blender/editors/interface/interface_ipad_ring_browse.hh
@@ -0,0 +1,222 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+/* Owned ring navigation uses only values copied from the last presented native
+ * layout. The caller owns native button teardown and redraw, never this model. */
+#include "interface_ipad_tool_ring.hh"
+#include <string>
+#include <utility>
+
+namespace blender::ui::ipad {
+constexpr int ring_visible_limit = 9;
+constexpr float ring_tau = 6.283185307179586f;
+inline float ring_angle_delta(float current, float previous)
+{
+  if (!std::isfinite(current) || !std::isfinite(previous)) return 0;
+  return std::remainder(current - previous, ring_tau);
+}
+struct RingPresentedItem {
+  Rect bounds{};
+  std::string identity;
+  bool refresh_tap_safe = false;
+};
+enum class RingInputResult { Pass, Shield, Tap, Close, Rebuild };
+struct RingInputOutcome {
+  RingInputResult result = RingInputResult::Shield;
+  std::string identity;
+};
+struct RingBrowseState {
+  uint64_t lifetime = 0, desired_generation = 1, presented_generation = 0;
+  /* Earliest contiguous generation with identical actual presented values.
+   * This admits delayed UIKit Begin, never arbitrary old generations. */
+  uint64_t continuity_first = 0;
+  std::string inventory_key;
+  std::vector<RingPresentedItem> presented;
+  Rect footprint{};
+  float center_x = 0, center_y = 0, unit = 20, phase = 0;
+  int inventory_count = 0;
+  bool contact = false, rotating = false, contact_valid = false;
+  bool roll_seeded = false;
+  float previous_angle = 0, accumulated_angle = 0, press_radius = 0;
+  float roll_previous = 0, roll_accumulated = 0;
+  uint64_t press_generation = 0;
+  std::string press_identity;
+
+  bool ready() const { return lifetime && presented_generation == desired_generation; }
+  void open(uint64_t id) { *this = RingBrowseState{}; lifetime = id; }
+  void retire() { lifetime = 0; presented.clear(); contact_valid = false; roll_seeded = false; }
+  bool publish(uint64_t id, uint64_t generation, std::vector<RingPresentedItem> items,
+               int total, Rect bounds, float cx, float cy, float pixel_unit,
+               std::string key = {}, bool navigation_rebuild = false)
+  {
+    if (!id || id != lifetime || generation != desired_generation || total < 1 ||
+        total > 4096 || items.empty() || items.size() > ring_visible_limit ||
+        int(items.size()) != std::min(total, ring_visible_limit) ||
+        !std::isfinite(bounds.xmin) || !std::isfinite(bounds.xmax) ||
+        !std::isfinite(bounds.ymin) || !std::isfinite(bounds.ymax) ||
+        bounds.xmin >= bounds.xmax || bounds.ymin >= bounds.ymax ||
+        !std::isfinite(cx) || !std::isfinite(cy) || !std::isfinite(pixel_unit) || pixel_unit <= 0)
+      return false;
+    for (const auto &item : items) {
+      if (item.identity.empty() || !std::isfinite(item.bounds.xmin) ||
+          !std::isfinite(item.bounds.xmax) || !std::isfinite(item.bounds.ymin) ||
+          !std::isfinite(item.bounds.ymax) || item.bounds.xmin >= item.bounds.xmax ||
+          item.bounds.ymin >= item.bounds.ymax || item.bounds.xmin < bounds.xmin ||
+          item.bounds.xmax > bounds.xmax || item.bounds.ymin < bounds.ymin ||
+          item.bounds.ymax > bounds.ymax) return false;
+    }
+    for (size_t i = 0; i < items.size(); ++i)
+      for (size_t j = i + 1; j < items.size(); ++j) {
+        const Rect &a = items[i].bounds, &b = items[j].bounds;
+        if (items[i].identity == items[j].identity ||
+            (a.xmin < b.xmax && b.xmin < a.xmax && a.ymin < b.ymax && b.ymin < a.ymax))
+          return false;
+      }
+    const bool same_frame = !key.empty() && key == inventory_key &&
+        total == inventory_count && ring_viewport_matches(bounds, footprint) &&
+        cx == center_x && cy == center_y && pixel_unit == unit;
+    bool same_items = same_frame && items.size() == presented.size();
+    if (same_items) for (size_t i = 0; i < items.size(); ++i) {
+      same_items &= items[i].identity == presented[i].identity &&
+                    ring_viewport_matches(items[i].bounds, presented[i].bounds) &&
+                    items[i].refresh_tap_safe == presented[i].refresh_tap_safe;
+    }
+    if (!same_items) continuity_first = generation;
+    if (contact && generation != press_generation) {
+      if (!same_items && !(rotating && navigation_rebuild && same_frame)) contact_valid = false;
+      /* Only pure operator buttons with copied argument values may preserve
+       * an explicit tap across an identical presentation. Opaque callbacks
+       * retain strict original-generation admission. */
+      if (contact_valid && !rotating && same_items) {
+        const auto *pressed = hit_identity(press_identity);
+        if (pressed && pressed->refresh_tap_safe) press_generation = generation;
+      }
+    }
+    inventory_key = std::move(key);
+    presented = std::move(items);
+    inventory_count = total;
+    footprint = bounds;
+    center_x = cx; center_y = cy; unit = pixel_unit;
+    presented_generation = generation;
+    return true;
+  }
+  bool can_begin(uint64_t generation) const
+  {
+    return ready() && generation && generation >= continuity_first &&
+           generation <= presented_generation;
+  }
+  const RingPresentedItem *hit_identity(const std::string &identity) const
+  {
+    for (const auto &item : presented) if (item.identity == identity) return &item;
+    return nullptr;
+  }
+  static bool contains(const Rect &r, float x, float y)
+  {
+    return x >= r.xmin && x < r.xmax && y >= r.ymin && y < r.ymax;
+  }
+  const RingPresentedItem *hit(float x, float y) const
+  {
+    for (const auto &item : presented) if (contains(item.bounds, x, y)) return &item;
+    return nullptr;
+  }
+  int first_item() const
+  {
+    if (!inventory_count) return 0;
+    const int value = int(std::floor(phase)) % inventory_count;
+    return value < 0 ? value + inventory_count : value;
+  }
+  RingInputOutcome press(uint64_t id, float x, float y, uint64_t generation = 0)
+  {
+    if (!id || id != lifetime || contact || !ready() || !std::isfinite(x) || !std::isfinite(y))
+      return {};
+    generation = generation ? generation : presented_generation;
+    if (!can_begin(generation)) return {};
+    contact = contact_valid = true; rotating = false; roll_seeded = false;
+    accumulated_angle = 0;
+    previous_angle = std::atan2(x - center_x, y - center_y);
+    press_radius = std::hypot(x - center_x, y - center_y);
+    const auto *item = hit(x, y);
+    press_generation = generation;
+    if (item && item->refresh_tap_safe) press_generation = presented_generation;
+    press_identity = item ? item->identity : std::string{};
+    return {RingInputResult::Shield, {}};
+  }
+  RingInputOutcome motion(uint64_t id, float x, float y)
+  {
+    if (!id || id != lifetime || !contact || !contact_valid ||
+        !std::isfinite(x) || !std::isfinite(y)) return {};
+    /* A new root may be awaiting actual draw/publication. Until its values
+     * are proved, pre-threshold input cannot start browsing the new page. */
+    if (!rotating && !ready()) return {};
+    const float radius = std::hypot(x - center_x, y - center_y);
+    if (radius < 2 * unit) { contact_valid = false; return {}; }
+    const float angle = std::atan2(x - center_x, y - center_y);
+    const float delta = ring_angle_delta(angle, previous_angle);
+    previous_angle = angle;
+    accumulated_angle += delta;
+    if (!rotating && inventory_count > ring_visible_limit && press_radius >= 2 * unit &&
+        std::abs(accumulated_angle) >= 0.12f) {
+      rotating = true;
+      phase -= accumulated_angle * ring_visible_limit / ring_tau;
+    }
+    else if (rotating) phase -= delta * ring_visible_limit / ring_tau;
+    else return {};
+    // Bound long-running rotation without changing the visible tool order.
+    phase = std::remainder(phase, float(inventory_count));
+    ++desired_generation;
+    return {RingInputResult::Rebuild, {}};
+  }
+  RingInputOutcome release(uint64_t id, float x, float y, bool cancelled)
+  {
+    if (!id || id != lifetime || !contact) return {};
+    contact = false; roll_seeded = false;
+    if (cancelled || !contact_valid) {
+      contact_valid = false;
+      if (rotating) { rotating = false; phase = std::round(phase); ++desired_generation; return {RingInputResult::Rebuild,{}}; }
+      return {};
+    }
+    contact_valid = false;
+    if (rotating) {
+      rotating = false; phase = std::round(phase); ++desired_generation;
+      return {RingInputResult::Rebuild, {}};
+    }
+    if (!ready() || press_generation != presented_generation) return {};
+    if (press_identity.empty()) return {RingInputResult::Close, {}};
+    const auto *item = hit(x, y);
+    if (item && item->identity == press_identity) return {RingInputResult::Tap, press_identity};
+    return {};
+  }
+  RingInputOutcome home(uint64_t id)
+  {
+    if (!id || id != lifetime) return {};
+    contact = false; contact_valid = false; rotating = false; phase = 0;
+    roll_seeded = false; ++desired_generation;
+    return {RingInputResult::Rebuild, {}};
+  }
+  RingInputOutcome roll(uint64_t id, float angle, bool hovering, bool reacquired = false)
+  {
+    if (!id || id != lifetime || !hovering || !std::isfinite(angle)) {
+      roll_seeded = false; return {};
+    }
+    if (contact || !ready() || inventory_count <= ring_visible_limit) {
+      roll_seeded = false; return {};
+    }
+    if (!roll_seeded || reacquired) {
+      roll_seeded = true; roll_previous = angle; roll_accumulated = 0; return {};
+    }
+    const float delta = ring_angle_delta(angle, roll_previous);
+    roll_previous = angle;
+    /* Discontinuous grip changes are a fresh baseline, never a multi-page
+     * jump. Continuous device comfort/gain still needs Pencil Pro acceptance. */
+    if (std::abs(delta) > 0.65f) { roll_accumulated = 0; return {}; }
+    roll_accumulated += delta;
+    if (std::abs(roll_accumulated) < 0.15f) return {};
+    // Provisional gain: roughly 17 degrees of deliberate twist per snapped choice.
+    const int steps = int(std::round(roll_accumulated * 2.4f * ring_visible_limit / ring_tau));
+    if (!steps) return {};
+    phase = std::remainder(std::round(phase) - steps, float(inventory_count));
+    roll_accumulated = 0; ++desired_generation;
+    return {RingInputResult::Rebuild, {}};
+  }
+};
+}  // namespace blender::ui::ipad
