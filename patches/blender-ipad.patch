+static wmWindow *ui_ipad_ring_reopen_window(bContext *C,
+                                           const uiIPadRingReopenRequest &request)
+{
+  Main *main = CTX_data_main(C);
+  if (!main || uintptr_t(main) != request.context[0]) return nullptr;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || BLI_findindex(&main->wm, wm) == -1 ||
+      wm->id.session_uid != request.context[12]) return nullptr;
+  LISTBASE_FOREACH (wmWindow *, window, &wm->windows) {
+    if (uintptr_t(window) == request.context[1] && uint64_t(window->winid) == request.context[11])
+      return window;
+  }
+  return nullptr;
+}
+
+bool UI_ipad_ring_reopen_capture(bContext *C, const uiBlock *block,
+                                  uiIPadRingReopenRequest &request)
+{
+  request = {};
+  if (!block || !(block->pie_data.flags & UI_PIE_IPAD_TOOLS) ||
+      ui_ipad_ring_waits_for_draw(block) || !ui_ipad_ring_context_valid(C, block) ||
+      ui_ipad_ring_child_open(block)) return false;
+  const auto *data = static_cast<const uiIPadRingData *>(block->handle->popup_create_vars.arg);
+  if (!data || !data->lifetime || !UI_ipad_ring_menu(data->menu.c_str())) return false;
+  const auto context = ipad_ring::context_values(data->context);
+  std::copy(context.begin(), context.end(), request.context);
+  request.menu = data->menu;
+  request.phase = data->phase;
+  request.anchor[0] = int(data->browse.center_x);
+  request.anchor[1] = int(data->browse.center_y);
+  if (!ipad_ring::ring_uses_pages(ipad_ring::ring_kind(data->menu.c_str()))) {
+    request.anchor[0] = data->anchor[0]; request.anchor[1] = data->anchor[1];
+  }
+  request.touch_targets = data->touch_tools;
+  request.tool_inventory = ui_ipad_ring_native_inventory(block);
+  request.workspace_inventory = ui_ipad_ring_workspace_inventory(CTX_data_main(C));
+  return request.present() && std::isfinite(request.phase);
+}
+
+bool UI_ipad_ring_reopen_workspace_target(bContext *C, uiIPadRingReopenRequest &request,
+                                           const char *name)
+{
+  if (!request.present() || !name || !name[0] || !ui_ipad_ring_reopen_window(C, request))
+    return false;
+  LISTBASE_FOREACH (WorkSpace *, workspace, &CTX_data_main(C)->workspaces) {
+    if (STREQ(workspace->id.name + 2, name)) {
+      request.requested_workspace_uid = workspace->id.session_uid;
+      request.requested_workspace_name = name;
+      return request.requested_workspace_uid != 0;
+    }
+  }
+  return false;
+}
+
+void UI_ipad_ring_reopen_queue(bContext *C, const uiIPadRingReopenRequest &source,
+                                const wmOperatorStatus status)
+{
+  if (!source.present() || !std::isfinite(source.phase) ||
+      !(status & (OPERATOR_FINISHED | OPERATOR_CANCELLED)) ||
+      (status & (OPERATOR_RUNNING_MODAL | OPERATOR_INTERFACE))) return;
+  wmWindow *window = ui_ipad_ring_reopen_window(C, source);
+  if (!window) return;
+  Main *main = CTX_data_main(C);
+  Scene *scene = WM_window_get_active_scene(window);
+  bScreen *screen = WM_window_get_active_screen(window);
+  if (!scene || BLI_findindex(&main->scenes, scene) == -1 ||
+      !screen || BLI_findindex(&main->screens, screen) == -1) return;
+  uiIPadRingPendingReopen pending{source, scene->id.session_uid, screen->id.session_uid};
+  if (status & OPERATOR_CANCELLED) {
+    pending.request.requested_workspace_uid = 0;
+    pending.request.requested_workspace_name.clear();
+  }
+  /* One user intent per native window. No operator, popup, ID or RNA is kept. */
+  ui_ipad_ring_pending_reopens.erase(std::remove_if(
+      ui_ipad_ring_pending_reopens.begin(), ui_ipad_ring_pending_reopens.end(),
+      [&](const uiIPadRingPendingReopen &old) {
+        return old.request.context[0] == source.context[0] &&
+               old.request.context[1] == source.context[1] &&
+               old.request.context[11] == source.context[11] &&
+               old.request.context[12] == source.context[12];
+      }), ui_ipad_ring_pending_reopens.end());
+  ui_ipad_ring_pending_reopens.push_back(std::move(pending));
+}
+
+bool UI_ipad_ring_reopen_cancel_pending(bContext *C, const wmEvent *event)
+{
+  if (!event || !(event->type == WINDEACTIVATE ||
+      ((event->type == PENCIL_TOOL_PALETTE || event->type == EVT_ESCKEY ||
+        event->type == LEFTMOUSE || event->type == RIGHTMOUSE) && event->val == KM_PRESS)))
+    return false;
+  wmWindow *window = CTX_wm_window(C);
+  const size_t before = ui_ipad_ring_pending_reopens.size();
+  ui_ipad_ring_pending_reopens.erase(std::remove_if(
+      ui_ipad_ring_pending_reopens.begin(), ui_ipad_ring_pending_reopens.end(),
+      [&](const uiIPadRingPendingReopen &pending) {
+        return window && ui_ipad_ring_reopen_window(C, pending.request) == window;
+      }), ui_ipad_ring_pending_reopens.end());
+  /* Deactivation is always passed by native WM; retire intent without blocking it. */
+  return before != ui_ipad_ring_pending_reopens.size() && event->type != WINDEACTIVATE;
+}
+
+static bool ui_ipad_ring_reopen_has_popup(const bScreen *screen)
+{
+  LISTBASE_FOREACH (const ARegion *, region, &screen->regionbase) {
+    LISTBASE_FOREACH (const uiBlock *, block, &region->runtime->uiblocks) {
+      if (block->handle) return true;
+    }
+  }
+  return false;
+}
+
+static bool ui_ipad_ring_reopen_canvas(wmWindow *window, const uiIPadRingReopenRequest &request,
+                                        const bool workspace_changed,
+                                        ScrArea **area_result, ARegion **region_result)
+{
+  *area_result = nullptr; *region_result = nullptr;
+  bScreen *screen = WM_window_get_active_screen(window);
+  int64_t best = -1;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (area->spacetype != SPACE_VIEW3D) continue;
+    LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+      if (region->regiontype != RGN_TYPE_WINDOW || !region->runtime->visible || !region->regiondata)
+        continue;
+      if (!workspace_changed) {
+        if (uintptr_t(area) == request.context[3] && uintptr_t(region) == request.context[4]) {
+          *area_result = area; *region_result = region; return true;
+        }
+        continue;
+      }
+      const int64_t width = int64_t(region->winrct.xmax) - region->winrct.xmin;
+      const int64_t height = int64_t(region->winrct.ymax) - region->winrct.ymin;
+      if (width <= 0 || height <= 0) continue;
+      const int64_t score = width * height;
+      const bool contains = request.anchor[0] >= region->winrct.xmin &&
+          request.anchor[0] < region->winrct.xmax && request.anchor[1] >= region->winrct.ymin &&
+          request.anchor[1] < region->winrct.ymax;
+      if (contains) { *area_result = area; *region_result = region; return true; }
+      if (score > best) { best = score; *area_result = area; *region_result = region; }
+    }
+  }
+  return *region_result != nullptr;
+}
+
+void UI_ipad_ring_reopen_flush(bContext *C, const bool after_notifiers)
+{
+  /* Detach requests before Python/native menu creators can re-enter UI. */
+  std::vector<uiIPadRingPendingReopen> requests;
+  requests.swap(ui_ipad_ring_pending_reopens);
+  for (uiIPadRingPendingReopen &pending : requests) {
+    const uiIPadRingReopenRequest &request = pending.request;
+    wmWindow *window = ui_ipad_ring_reopen_window(C, request);
+    if (!window) continue;
+    if (request.requested_workspace_uid && !after_notifiers) {
+      ui_ipad_ring_pending_reopens.push_back(std::move(pending)); continue;
+    }
+    Main *main = CTX_data_main(C);
+    wmWindowManager *wm = CTX_wm_manager(C);
+    Scene *scene = WM_window_get_active_scene(window);
+    bScreen *screen = WM_window_get_active_screen(window);
+    if (!scene || BLI_findindex(&main->scenes, scene) == -1 ||
+        !screen || BLI_findindex(&main->screens, screen) == -1 ||
+        !window->eventstate || ui_ipad_ring_reopen_has_popup(screen)) continue;
+    const bool workspace_changed = request.requested_workspace_uid != 0;
+    if (workspace_changed) {
+      WorkSpace *target = nullptr;
+      LISTBASE_FOREACH (WorkSpace *, workspace, &main->workspaces) {
+        if (workspace->id.session_uid == request.requested_workspace_uid &&
+            request.requested_workspace_name == workspace->id.name + 2) { target = workspace; break; }
+      }
+      if (!target || WM_window_get_active_workspace(window) != target) continue;
+    }
+    else if (scene->id.session_uid != pending.scene_uid || screen->id.session_uid != pending.screen_uid)
+      continue;
+    ScrArea *area; ARegion *region;
+    if (!ui_ipad_ring_reopen_canvas(window, request, workspace_changed, &area, &region)) continue;
+    wmWindow *previous_window = CTX_wm_window(C);
+    const uintptr_t previous_area = uintptr_t(CTX_wm_area(C));
+    const uintptr_t previous_region = uintptr_t(CTX_wm_region(C));
+    const uintptr_t previous_popup = uintptr_t(CTX_wm_region_popup(C));
+    const bool previous_live = previous_window && BLI_findindex(&wm->windows, previous_window) != -1;
+    const int previous_window_id = previous_live ? previous_window->winid : 0;
+    const uintptr_t previous_window_value = previous_live ? uintptr_t(previous_window) : 0;
+    CTX_wm_window_set(C, window); CTX_wm_area_set(C, area); CTX_wm_region_set(C, region);
+    CTX_wm_region_popup_set(C, nullptr);
+    uint64_t fresh[13];
+    if (UI_ipad_context_capture(C, fresh)
+#ifdef WITH_APPLE_CROSSPLATFORM
+        && WM_event_ipad_mode_safe(C)
+#endif
+    ) {
+      wmEvent event{};
+      event.xy[0] = request.anchor[0]; event.xy[1] = request.anchor[1];
+      ui_ipad_ring_invoke(C, request.menu.c_str(), &event, request.touch_targets, &request);
+    }
+    /* Creation can execute Python. Restore only owners rediscovered in current lists. */
+    if (CTX_data_main(C) != main || CTX_wm_manager(C) != wm ||
+        BLI_findindex(&main->wm, wm) == -1 || wm->id.session_uid != request.context[12]) return;
+    wmWindow *restore_window = nullptr;
+    LISTBASE_FOREACH (wmWindow *, live, &wm->windows) {
+      if (uintptr_t(live) == previous_window_value && live->winid == previous_window_id) {
+        restore_window = live; break;
+      }
+    }
+    CTX_wm_window_set(C, restore_window);
+    ui_ipad_action_context_restore(C, previous_area, previous_region);
+    bScreen *restore_screen = restore_window ? WM_window_get_active_screen(restore_window) : nullptr;
+    ARegion *restore_popup = nullptr;
+    if (restore_screen) LISTBASE_FOREACH (ARegion *, live, &restore_screen->regionbase) {
+      if (uintptr_t(live) == previous_popup) { restore_popup = live; break; }
+    }
+    CTX_wm_region_popup_set(C, restore_popup);
+  }
+}
+
+bool UI_ipad_ring_menu(const char *idname)
+{
+  return ipad_ring::ring_kind(idname) != ipad_ring::RingKind::None;
+}
+
+wmOperatorStatus UI_pie_menu_invoke(bContext *C, const char *idname, const wmEvent *event,
+                                    const bool ipad_touch_targets)
 {
   uiPieMenu *pie;
   uiLayout *layout;
   MenuType *mt = WM_menutype_find(idname, true);

   if (mt == nullptr) {
     printf("%s: named menu \"%s\" not found\n", __func__, idname);
     return OPERATOR_CANCELLED;
   }

   if (WM_menutype_poll(C, mt) == false) {
     /* cancel but allow event to pass through, just like operators do */
     return (OPERATOR_CANCELLED | OPERATOR_PASS_THROUGH);
   }

+  if (UI_ipad_ring_menu(idname)) {
+    return ui_ipad_ring_invoke(C, idname, event, ipad_touch_targets);
+  }
   pie = UI_pie_menu_begin(C, CTX_IFACE_(mt->translation_context, mt->label), ICON_NONE, event);
   layout = UI_pie_menu_layout(pie);

   UI_menutype_draw(C, mt, layout);

   UI_pie_menu_end(C, pie);

   return OPERATOR_INTERFACE;
 }

 /** \} */

 /* -------------------------------------------------------------------- */
 /** \name Pie Menu Levels
  *
  * Pie menus can't contain more than 8 items (yet).
  * When using ##uiLayout::operator_enum, a "More" button is created that calls
  * a new pie menu if the enum has too many items. We call this a new "level".
  * Indirect recursion is used, so that a theoretically unlimited number of items is supported.
  *
  * This is a implementation specifically for operator enums,
  * needed since the object mode pie now has more than 8 items.
  * Ideally we'd have some way of handling this for all kinds of pie items, but that's tricky.
  *
  * - Julian (Feb 2016)
  * \{ */

 struct PieMenuLevelData {
   char title[UI_MAX_NAME_STR]; /* parent pie title, copied for level */
   int icon;                    /* parent pie icon, copied for level */
   int totitem;                 /* total count of *remaining* items */

   /* needed for calling #uiLayout::operator_enum_items again for new level */
   wmOperatorType *ot;
   blender::StringRefNull propname;
   IDProperty *properties;
   blender::wm::OpCallContext context;
   eUI_Item_Flag flag;
 };

