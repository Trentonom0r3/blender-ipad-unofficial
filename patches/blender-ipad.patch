+bool ui_ipad_action_origin_valid(bContext *C, const ipad_ring::ActionOrigin &origin)
+{
+  if (!origin.present()) return true; /* Unrelated native/hardware popups. */
+  if (origin.corner) {
+    Main *main = CTX_data_main(C);
+    wmWindowManager *wm = CTX_wm_manager(C);
+    wmWindow *window = CTX_wm_window(C);
+    if (!main || uintptr_t(main) != origin.context[0] || !wm ||
+        BLI_findindex(&main->wm, wm) == -1 || wm->id.session_uid != origin.context[12] ||
+        !window || BLI_findindex(&wm->windows, window) == -1 ||
+        uintptr_t(window) != origin.context[1] || uint64_t(window->winid) != origin.context[11])
+      return false;
+    bScreen *screen = WM_window_get_active_screen(window);
+    if (!screen || uintptr_t(screen) != origin.context[2] ||
+        screen->id.session_uid != origin.context[5]) return false;
+    ScrArea *area = nullptr;
+    LISTBASE_FOREACH (ScrArea *, live, &screen->areabase) {
+      if (uintptr_t(live) == origin.context[3] && live == CTX_wm_area(C)) { area = live; break; }
+    }
+    if (!area) return false;
+    ARegion *hud = nullptr, *canvas = nullptr;
+    LISTBASE_FOREACH (ARegion *, live, &area->regionbase) {
+      if (live == CTX_wm_region(C) && live->regiontype == RGN_TYPE_HUD) hud = live;
+      if (uintptr_t(live) == origin.context[4] && live->regiontype == RGN_TYPE_WINDOW) canvas = live;
+    }
+    if (hud) {
+      if (!canvas) return false;
+      /* Only the stamped corner's own live HUD borrows its originating WINDOW
+       * for the existing strict proof. No general popup/context rebind bypass. */
+      CTX_wm_region_set(C, canvas);
+      const bool valid = UI_ipad_context_matches(C, origin.context.data()) &&
+                         ui_ipad_ring_tool_identity(C) == origin.tool;
+      CTX_wm_region_set(C, hud);
+      return valid;
+    }
+  }
+  if (!UI_ipad_context_matches(C, origin.context.data()) ||
+      ui_ipad_ring_tool_identity(C) != origin.tool) return false;
+  /* Provenance is also checked during an admitted native operator creator,
+   * where op_undo_depth is intentionally nonzero. Input admission retains its
+   * separate native modal/recovery checks; creation is not a second action. */
+  return true;
+}
+
+bool ui_ipad_action_origin_rebind(bContext *C, const ipad_ring::ActionOrigin &origin)
+{
+  if (!origin.present()) return true;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmWindow *window = CTX_wm_window(C);
+  const auto &v = origin.context;
+  /* Compare values and native list membership before installing saved owners.
+   * A retired area/region is never read through its old pointer. */
+  if (uintptr_t(CTX_data_main(C)) != v[0] || !wm || wm->id.session_uid != v[12] ||
+      !window || uintptr_t(window) != v[1] || BLI_findindex(&wm->windows, window) == -1 ||
+      uint64_t(window->winid) != v[11]) return false;
+  bScreen *screen = WM_window_get_active_screen(window);
+  if (!screen || uintptr_t(screen) != v[2] || screen->id.session_uid != v[5]) return false;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (uintptr_t(area) != v[3]) continue;
+    LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+      if (uintptr_t(region) != v[4]) continue;
+      ScrArea *previous_area = CTX_wm_area(C);
+      ARegion *previous_region = CTX_wm_region(C);
+      CTX_wm_area_set(C, area);
+      CTX_wm_region_set(C, region);
+      if (ui_ipad_action_origin_valid(C, origin)) return true;
+      CTX_wm_area_set(C, previous_area);
+      CTX_wm_region_set(C, previous_region);
+      return false;
+    }
+    return false;
+  }
+  return false;
+}
