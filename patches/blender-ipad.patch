+static uiIPadRNAPathStep ui_ipad_rna_backend_step(const IDProperty *prop, int index)
+{
+  uiIPadRNAPathStep step;
+  step.name = prop->name;step.index = index;
+  step.backend_address = ui_ipad_rna_address(prop);
+  step.backend_type = prop->type;step.backend_subtype = prop->subtype;
+  step.backend_length = (prop->type == IDP_ARRAY || prop->type == IDP_IDPARRAY) ? prop->len : -1;
+  return step;
+}
+
+static bool ui_ipad_rna_group_path(const IDProperty *group, const void *needle,
+                                  std::vector<uiIPadRNAPathStep> &steps, int &remaining)
+{
+  if (--remaining < 0 || !group || group->type != IDP_GROUP || steps.size() >= 16) return false;
+  if (group == needle) return true;
+  LISTBASE_FOREACH (const IDProperty *, child, &group->data.group) {
+    if (--remaining < 0) return false;
+    if (child->type == IDP_GROUP) {
+      steps.push_back(ui_ipad_rna_backend_step(child, -1));
+      if (ui_ipad_rna_group_path(child, needle, steps, remaining)) return true;
+      steps.pop_back();
+    }
+    else if (child->type == IDP_IDPARRAY && child->len >= 0 && child->len <= 1024) {
+      const IDProperty *items = IDP_IDPArray(child);
+      if (!items && child->len) continue;
+      for (int i = 0; i < child->len; ++i) {
+        steps.push_back(ui_ipad_rna_backend_step(child, i));
+        if (ui_ipad_rna_group_path(&items[i], needle, steps, remaining)) return true;
+        steps.pop_back();
+        if (remaining < 0) return false;
+      }
+    }
+  }
+  return false;
+}
+
+static bool ui_ipad_rna_backend_preflight(const PointerRNA &root,
+                                         const uiIPadRNAReceipt &receipt)
+{
+  auto *group = static_cast<const IDProperty *>(root.data);
+  for (size_t i = 0; i + 1 < receipt.steps.size(); ++i) {
+    const auto &step = receipt.steps[i];
+    if (!group || group->type != IDP_GROUP) return false;
+    const IDProperty *node = IDP_GetPropertyFromGroup(group, step.name.c_str());
+    if (!node || ui_ipad_rna_address(node) != step.backend_address ||
+        node->type != step.backend_type || node->subtype != step.backend_subtype ||
+        (node->type != IDP_GROUP && node->len != step.backend_length)) return false;
+    if (step.index == -1 && node->type == IDP_GROUP) group = node;
+    else if (node->type == IDP_IDPARRAY && step.index >= 0 && step.index < node->len &&
+             IDP_IDPArray(node)) group = &IDP_IDPArray(node)[step.index];
+    else return false;
+  }
+  return group && group->type == IDP_GROUP;
+}
+
+static bool ui_ipad_rna_runtime_leaf(PointerRNA &ptr, PropertyRNA *field,
+                                    const uiIPadRNAPathStep &step)
+{
+  auto *group = static_cast<IDProperty *>(ptr.data);
+  if (!group || group->type != IDP_GROUP) return false;
+  IDProperty *node = IDP_GetPropertyFromGroup(group, step.name.c_str());
+  const PropertyType type = RNA_property_type(field);
+  if (type != PROP_BOOLEAN && type != PROP_INT && type != PROP_ENUM &&
+      type != PROP_FLOAT && type != PROP_STRING) return false;
+  if (!node) return step.backend_address == 0;
+  if (step.backend_address && (ui_ipad_rna_address(node) != step.backend_address ||
+      node->type != step.backend_type || node->subtype != step.backend_subtype ||
+      (step.backend_length >= 0 && node->len != step.backend_length))) return false;
+  /* Mirror the pinned verifier's compatibility before any RNA value access
+   * can delete incompatible storage. Missing scalar defaults remain valid. */
+  if (RNA_property_array_check(field)) {
+    if (node->type != IDP_ARRAY) return false;
+    /* getlength may run a callback. Snapshot scalars first; the caller proves
+     * the fresh tree again before following any old RNA/backend payload. */
+    const int length = node->len, subtype = node->subtype;
+    if (length != RNA_property_array_length(&ptr, field)) return false;
+    return ((subtype == IDP_FLOAT || subtype == IDP_DOUBLE) && type == PROP_FLOAT) ||
+           (subtype == IDP_BOOLEAN && type == PROP_BOOLEAN) ||
+           (subtype == IDP_INT && (type == PROP_BOOLEAN || type == PROP_INT || type == PROP_ENUM));
+  }
+  return (node->type == IDP_INT && (type == PROP_BOOLEAN || type == PROP_INT || type == PROP_ENUM)) ||
+         (node->type == IDP_BOOLEAN && type == PROP_BOOLEAN) ||
+         ((node->type == IDP_FLOAT || node->type == IDP_DOUBLE) && type == PROP_FLOAT) ||
+         (node->type == IDP_STRING && type == PROP_STRING);
+}
+
+/* Static native paths only. User custom properties and string-key collection
+ * traversal require distinct backend receipts; they are not silently followed.
+ * The property index remains separate from the path and its array shape. */
+static bool ui_ipad_rna_static_path(std::string_view path,
+                                   std::vector<uiIPadRNAPathStep> &steps)
+{
+  steps.clear();
+  if (path.empty() || path.size() > 1024 || path.find('\0') != std::string_view::npos) return false;
+  size_t offset = 0;
+  const auto name_char = [](char c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+           (c >= '0' && c <= '9') || c == '_';
+  };
+  while (offset < path.size()) {
+    if (steps.size() == 16) return false;
+    const size_t begin = offset;
+    while (offset < path.size() && name_char(path[offset])) ++offset;
+    if (offset == begin || offset - begin >= 128 ||
+        (path[begin] >= '0' && path[begin] <= '9')) return false;
+    uiIPadRNAPathStep step;
+    step.name = path.substr(begin, offset - begin);
+    if (offset < path.size() && path[offset] == '[') {
+      ++offset;const size_t index_begin = offset;uint64_t index = 0;
+      while (offset < path.size() && path[offset] >= '0' && path[offset] <= '9') {
+        index = index * 10 + uint64_t(path[offset++] - '0');
+        if (index > uint64_t(INT_MAX)) return false;
+      }
+      if (offset == index_begin || offset >= path.size() || path[offset++] != ']') return false;
+      step.index = int(index);
+    }
+    steps.push_back(std::move(step));
+    if (offset == path.size()) break;
+    if (path[offset++] != '.' || offset == path.size()) return false;
+  }
+  return !steps.empty() && steps.back().index == -1;
+}
+
+static bool ui_ipad_rna_static_walk(bContext *C,
+                                   const blender::ui::ipad::ActionOrigin &origin,
+                                   const uiIPadRNAReceipt &receipt,
+                                   PointerRNA &ptr, PropertyRNA *&prop,
+                                   std::vector<uiIPadRNAPathStep> *captured_steps = nullptr)
+{
+  if (receipt.steps.empty() || receipt.steps.size() > 16 ||
+      !ui_ipad_rna_id_matches(C, origin, receipt)) return false;
+  ID *id = ui_ipad_rna_id_root(C, receipt.owner);
+  const bool tool = ui_ipad_rna_is_tool(receipt.owner);
+  const bool pending = receipt.owner == uiIPadRNAOwner::PopupProperties;
+  const bool backend = tool || pending;
+  PointerRNA root;
+  const auto backend_root = [&]() {
+    return tool ? ui_ipad_rna_tool_root(C, receipt, root) :
+                  ui_ipad_rna_pending_root(C, origin, receipt, root);
+  };
+  if (backend) {
+    if (!backend_root() ||
+        !ui_ipad_rna_backend_preflight(root, receipt)) return false;
+  }
+  else root = RNA_id_pointer_create(id);
+  PointerRNA fresh = root;
+  for (size_t i = 0; i < receipt.steps.size(); ++i) {
+    const auto &step = receipt.steps[i];
+    if (!ui_ipad_rna_id_matches(C, origin, receipt)) return false;
+    if (backend && (!backend_root() || !ui_ipad_rna_backend_preflight(root, receipt))) return false;
+    /* Replaced nested storage/type is refused before its metadata lookup. */
+    if (!captured_steps && (ui_ipad_rna_address(fresh.data) != step.data_address ||
+                           ui_ipad_rna_address(fresh.type) != step.type_address)) return false;
+    if (captured_steps) {
+      uiIPadRNAPathStep captured = step;
+      captured.data_address = ui_ipad_rna_address(fresh.data);
+      captured.type_address = ui_ipad_rna_address(fresh.type);
+      captured_steps->push_back(std::move(captured));
+    }
+    PropertyRNA *field = RNA_struct_find_property(&fresh, step.name.c_str());
+    if (!ui_ipad_rna_id_matches(C, origin, receipt) || !field) return false;
+    if (backend && (!backend_root() ||
+                 !ui_ipad_rna_backend_preflight(root, receipt))) return false;
+    /* RNA_property_pointer_get can ensure missing IDProperty storage. Reject
+     * runtime fields before access; this static route remains find-only. */
+    const bool runtime = (RNA_property_flag(field) & PROP_IDPROPERTY) != 0;
+    if (runtime != backend) return false;
+    if (i + 1 == receipt.steps.size()) {
+      if (step.index != -1) return false;
+      if (backend && (!ui_ipad_rna_runtime_leaf(fresh, field, step) ||
+                   !ui_ipad_rna_id_matches(C, origin, receipt) ||
+                   !backend_root() ||
+                   !ui_ipad_rna_backend_preflight(root, receipt))) return false;
+      ptr = std::move(fresh);prop = field;return true;
+    }
+    PointerRNA next;
+    const PropertyType type = RNA_property_type(field);
+    if (type == PROP_POINTER && step.index == -1) next = RNA_property_pointer_get(&fresh, field);
+    else if (type == PROP_COLLECTION && step.index >= 0) {
+      if (!RNA_property_collection_lookup_int(&fresh, field, step.index, &next)) return false;
+    }
+    else return false;
+    if (!ui_ipad_rna_id_matches(C, origin, receipt) || !next.data) return false;
+    if (backend) {
+      if (!backend_root() ||
+          !ui_ipad_rna_backend_preflight(root, receipt)) return false;
+      auto *group = static_cast<const IDProperty *>(fresh.data);
+      const IDProperty *node = IDP_GetPropertyFromGroup(group, step.name.c_str());
+      const void *expected = step.index == -1 ? node :
+          node && node->type == IDP_IDPARRAY && step.index < node->len && IDP_IDPArray(node) ?
+            &IDP_IDPArray(node)[step.index] : nullptr;
+      if (!expected || next.data != expected) return false;
+    }
+    fresh = std::move(next);
+  }
+  return false;
+}
+
+static bool ui_ipad_rna_shape(bContext *C, const blender::ui::ipad::ActionOrigin &origin,
+                             const uiIPadRNAReceipt &receipt,
+                             PointerRNA &ptr, PropertyRNA *prop, int index,
+                             uiIPadRNAReceipt &shape)
+{
+  static_assert(RNA_MAX_ARRAY_DIMENSION == 3);
+  shape.array = RNA_property_array_check(prop);
+  shape.index = shape.array ? index : 0;
+  shape.dimensions = {};
+  const auto reacquire = [&]() {
+    PointerRNA current;PropertyRNA *field = nullptr;
+    if (!ui_ipad_rna_static_walk(C, origin, receipt, current, field) ||
+        current.data != ptr.data || current.type != ptr.type || field != prop ||
+        !RNA_struct_contains_property(&current, prop)) return false;
+    ptr = std::move(current);return true;
+  };
+  shape.dimension_count = RNA_property_array_dimension(&ptr, prop, shape.dimensions.data());
+  if (!reacquire()) return false;
+  shape.array_length = shape.array ? RNA_property_array_length(&ptr, prop) : 0;
+  if (!reacquire()) return false;
+  return shape.dimension_count >= 0 && shape.dimension_count <= 3 && shape.array_length >= 0 &&
+         (!shape.array || index == -1 || (index >= 0 && index < shape.array_length));
+}
+
+static bool ui_ipad_rna_finish_capture(bContext *C, const blender::ui::ipad::ActionOrigin &origin,
+                                      const PointerRNA &ptr, PropertyRNA *prop, int index,
+                                      uiIPadRNAReceipt &receipt)
+{
+  PointerRNA fresh;PropertyRNA *field = nullptr;
+  std::vector<uiIPadRNAPathStep> captured_steps;
+  if (!ui_ipad_rna_static_walk(C, origin, receipt, fresh, field, &captured_steps) ||
+      fresh.data != ptr.data || fresh.type != ptr.type || field != prop ||
+      !RNA_struct_contains_property(&fresh, prop)) return false;
+  receipt.steps = std::move(captured_steps);
+  const char *identifier = RNA_property_identifier(field);
+  if (!identifier || strlen(identifier) >= 128) return false;
+  receipt.property_id = identifier;
+  receipt.data_address = ui_ipad_rna_address(fresh.data);
+  receipt.type_address = ui_ipad_rna_address(fresh.type);
+  receipt.property_address = ui_ipad_rna_address(field);
+  if (!ui_ipad_rna_shape(C, origin, receipt, fresh, field, index, receipt) ||
+      !ui_ipad_rna_id_matches(C, origin, receipt)) return false;
+  receipt.valid = true;return true;
+}
+
+static bool ui_ipad_rna_tool_capture(bContext *C, const blender::ui::ipad::ActionOrigin &origin,
+                                    const PointerRNA &ptr, PropertyRNA *prop, int index,
+                                    uiIPadRNAReceipt &receipt)
+{
+  WorkSpace *workspace = CTX_wm_workspace(C);
+  bToolRef *tool = WM_toolsystem_ref_from_context(C);
+  if (!ui_ipad_rna_main_member(C, reinterpret_cast<ID *>(workspace)) ||
+      !tool || !tool->properties || tool->properties->type != IDP_GROUP) return false;
+  IDProperty *group = IDP_GetPropertyFromGroup(tool->properties, tool->idname);
+  if (!group || group->type != IDP_GROUP) return false;
+  LISTBASE_FOREACH (const IDProperty *, subgroup, &group->data.group) {
+    if (subgroup->type != IDP_GROUP) continue;
+    int remaining = 1024;
+    uiIPadRNAReceipt candidate;
+    if (!ui_ipad_rna_group_path(subgroup, ptr.data, candidate.steps, remaining)) continue;
+    wmOperatorType *ot = WM_operatortype_find(subgroup->name, true);
+    wmGizmoGroupType *gt = ot ? nullptr : WM_gizmogrouptype_find(subgroup->name, true);
+    StructRNA *type = ot ? ot->srna : gt ? gt->srna : nullptr;
+    if (!type) continue;
+    candidate.owner = ot ? uiIPadRNAOwner::ToolOperator : uiIPadRNAOwner::ToolGizmo;
+    candidate.owner_address = ui_ipad_rna_address(workspace);
+    candidate.owner_uid = workspace->id.session_uid;candidate.owner_id_type = GS(workspace->id.name);
+    candidate.tool_address = ui_ipad_rna_address(tool);candidate.tool_space = tool->space_type;
+    candidate.tool_mode = tool->mode;candidate.tool_id = tool->idname;
+    candidate.tool_root_address = ui_ipad_rna_address(tool->properties);
+    candidate.tool_group_address = ui_ipad_rna_address(group);
+    candidate.subgroup_address = ui_ipad_rna_address(subgroup);
+    candidate.subgroup = subgroup->name;candidate.root_type_address = ui_ipad_rna_address(type);
+    ui_ipad_rna_history_capture(C, candidate);
+    if (!ui_ipad_rna_id_matches(C, origin, candidate)) return false;
+    /* The raw group path first proves the constructor's data belongs to this
+     * live tree. Only then read its newly supplied native property identifier. */
+    const char *identifier = RNA_property_identifier(prop);
+    if (!identifier || !*identifier || strlen(identifier) >= 128) return false;
+    auto *binding_group = static_cast<const IDProperty *>(ptr.data);
+    if (binding_group->type != IDP_GROUP) return false;
+    const IDProperty *leaf = IDP_GetPropertyFromGroup(binding_group, identifier);
+    uiIPadRNAPathStep step;
+    if (leaf) step = ui_ipad_rna_backend_step(leaf, -1);
+    else step.name = identifier;
+    candidate.steps.push_back(std::move(step));
+    if (candidate.steps.size() > 16 ||
+        !ui_ipad_rna_finish_capture(C, origin, ptr, prop, index, candidate)) return false;
+    receipt = std::move(candidate);return true;
+  }
+  return false;
+}
+
+bool ui_ipad_rna_capture(bContext *C, const blender::ui::ipad::ActionOrigin &origin,
+                         const PointerRNA &ptr, PropertyRNA *prop, int index,
+                         uiIPadRNAReceipt &receipt)
+{
+  receipt = {};
+  if (!origin.present()) return true;
+  if (!ui_ipad_action_origin_valid(C, origin) || !ptr.data || !prop) return false;
+  if (!ptr.owner_id) return ui_ipad_rna_tool_capture(C, origin, ptr, prop, index, receipt);
+  for (uiIPadRNAOwner kind : {uiIPadRNAOwner::Scene, uiIPadRNAOwner::Object,
+                            uiIPadRNAOwner::ObjectData, uiIPadRNAOwner::Screen,
+                            uiIPadRNAOwner::WindowManager, uiIPadRNAOwner::Brush}) {
+    ID *fresh = ui_ipad_rna_id_root(C, kind);
+    if (fresh && fresh == ptr.owner_id && ui_ipad_rna_main_member(C, fresh)) {
+      receipt.owner = kind;receipt.owner_address = ui_ipad_rna_address(fresh);
+      receipt.owner_uid = fresh->session_uid;receipt.owner_id_type = GS(fresh->name);break;
+    }
+  }
+  if (receipt.owner == uiIPadRNAOwner::None) return false;
+  ui_ipad_rna_history_capture(C, receipt);
+  /* This path is captured once, from a newly constructed live native binding.
+   * Later validation never derives a path from cached PointerRNA/PropertyRNA. */
+  const auto path = RNA_path_from_ID_to_property(&ptr, prop);
+  if (!ui_ipad_rna_id_matches(C, origin, receipt) || !path ||
+      !ui_ipad_rna_static_path(*path, receipt.steps)) return false;
+  receipt.path = *path;
+  return ui_ipad_rna_finish_capture(C, origin, ptr, prop, index, receipt);
+}
+
+static bool ui_ipad_rna_constructor_match(bContext *C,
+    const blender::ui::ipad::ActionOrigin &origin, const PointerRNA &incoming,
+    PropertyRNA *incoming_property, const char *name, int index,
+    uiIPadRNAReceipt &receipt, PointerRNA &fresh, PropertyRNA *&field)
+{
+  if (receipt.steps.empty() || (name && receipt.steps.back().name != name)) return false;
+  std::vector<uiIPadRNAPathStep> steps;
+  if (!ui_ipad_rna_static_walk(C, origin, receipt, fresh, field, &steps) ||
+      fresh.owner_id != incoming.owner_id || fresh.data != incoming.data ||
+      fresh.type != incoming.type || (incoming_property && incoming_property != field)) return false;
+  /* Only fresh fixed-name metadata is followed. Incoming pointers were numeric
+   * comparison keys; their identifiers/ancestors have never been inspected. */
+  receipt.steps = std::move(steps);
+  return ui_ipad_rna_finish_capture(C, origin, fresh, field, index, receipt);
+}
+
+static bool ui_ipad_rna_constructor_capture(uiBlock *block, const PointerRNA &incoming,
+    PropertyRNA *incoming_property, const char *name, int index,
+    uiIPadRNAReceipt &receipt, PointerRNA &fresh, PropertyRNA *&field)
+{
+  receipt = {};
+  const auto &origin = block->ipad_action_origin;
+  bContext *C = static_cast<bContext *>(block->evil_C);
+  if (!origin.present() || !ui_ipad_action_origin_valid(C, origin) || !incoming.data ||
+      (!name && !incoming_property)) return false;
+  const auto match = [&](uiIPadRNAReceipt candidate, const std::string &path) {
+    if (!ui_ipad_rna_static_path(path, candidate.steps) ||
+        !ui_ipad_rna_constructor_match(C, origin, incoming, incoming_property, name, index,
+                                        candidate, fresh, field)) return false;
+    candidate.path = path;receipt = std::move(candidate);return true;
+  };
+  Scene *scene = CTX_data_scene(C);
+  if (scene && incoming.owner_id == reinterpret_cast<ID *>(scene) &&
+      ui_ipad_rna_main_member(C, reinterpret_cast<ID *>(scene))) {
+    uiIPadRNAReceipt base;
+    base.owner = uiIPadRNAOwner::Scene;base.owner_address = ui_ipad_rna_address(scene);
+    base.owner_uid = scene->id.session_uid;base.owner_id_type = GS(scene->id.name);
+    ui_ipad_rna_history_capture(C, base);
+    /* The literal paths belong to this fresh Scene. No global field-name
+     * permission is applied to unrelated ToolSettings/property trees. */
+    if (incoming.type == &RNA_ToolSettings && incoming.data == scene->toolsettings) {
+      for (const char *leaf : {"transform_pivot_point", "use_snap", "snap_target",
+          "snap_elements_base", "snap_elements_individual", "use_snap_grid_absolute",
+          "use_snap_peel_object", "use_snap_to_same_target", "snap_face_nearest_steps",
+          "use_snap_align_rotation", "use_snap_backface_culling", "use_snap_self",
+          "use_snap_edit", "use_snap_nonedit", "use_snap_selectable", "use_snap_translate",
+          "use_snap_rotate", "use_snap_scale", "snap_angle_increment_3d",
+          "snap_angle_increment_3d_precision"}) {
+        if (match(base, std::string("tool_settings.") + leaf)) return true;
+        if (!ui_ipad_rna_id_matches(C, origin, base)) return false;
+      }
+    }
+    if (incoming.type == &RNA_TransformOrientationSlot) {
+      for (int slot = 0; slot < 4; ++slot) {
+        if (match(base, "transform_orientation_slots[" + std::to_string(slot) + "].type"))
+          return true;
+        if (!ui_ipad_rna_id_matches(C, origin, base)) return false;
+      }
+    }
+  }
+  if (!incoming.owner_id) {
+    WorkSpace *workspace = CTX_wm_workspace(C);
+    if (!ui_ipad_rna_main_member(C, reinterpret_cast<ID *>(workspace))) return false;
+    bToolRef *tool = WM_toolsystem_ref_from_context(C);
+    if (!tool || !tool->properties || tool->properties->type != IDP_GROUP) return false;
+    IDProperty *group = IDP_GetPropertyFromGroup(tool->properties, tool->idname);
+    if (!group || group->type != IDP_GROUP) return false;
+    for (const char *subgroup_name : {"TRANSFORM_OT_translate", "TRANSFORM_OT_rotate",
+          "TRANSFORM_OT_resize", "VIEW3D_GGT_xform_gizmo"}) {
+      IDProperty *subgroup = IDP_GetPropertyFromGroup(group, subgroup_name);
+      if (!subgroup || subgroup->type != IDP_GROUP || incoming.data != subgroup) continue;
+      const bool gizmo = STREQ(subgroup_name, "VIEW3D_GGT_xform_gizmo");
+      wmOperatorType *ot = gizmo ? nullptr : WM_operatortype_find(subgroup_name, true);
+      wmGizmoGroupType *gt = gizmo ? WM_gizmogrouptype_find(subgroup_name, true) : nullptr;
+      StructRNA *schema = ot ? ot->srna : gt ? gt->srna : nullptr;
+      if (!schema || incoming.type != schema) return false;
+      uiIPadRNAReceipt base;
+      base.owner = gizmo ? uiIPadRNAOwner::ToolGizmo : uiIPadRNAOwner::ToolOperator;
+      base.owner_address = ui_ipad_rna_address(workspace);
+      base.owner_uid = workspace->id.session_uid;base.owner_id_type = GS(workspace->id.name);
+      base.tool_address = ui_ipad_rna_address(tool);base.tool_space = tool->space_type;
+      base.tool_mode = tool->mode;base.tool_id = tool->idname;
+      base.tool_root_address = ui_ipad_rna_address(tool->properties);
+      base.tool_group_address = ui_ipad_rna_address(group);
+      base.subgroup_address = ui_ipad_rna_address(subgroup);
+      base.subgroup = subgroup_name;base.root_type_address = ui_ipad_rna_address(schema);
+      ui_ipad_rna_history_capture(C, base);
+      const char *leaf_name = gizmo ? "drag_action" : "use_accurate";
+      IDProperty *leaf = IDP_GetPropertyFromGroup(subgroup, leaf_name);
+      uiIPadRNAPathStep step = leaf ? ui_ipad_rna_backend_step(leaf, -1) : uiIPadRNAPathStep{};
+      step.name = leaf_name;base.steps.push_back(std::move(step));
+      if (ui_ipad_rna_constructor_match(C, origin, incoming, incoming_property, name, index,
+                                         base, fresh, field)) {
+        receipt = std::move(base);return true;
+      }
+      return false;
+    }
+  }
+  const auto &scope = ui_ipad_numbers_constructor;
+  if (scope.op && incoming.owner_id &&
+      ui_ipad_rna_address(incoming.owner_id) == scope.binding.owner_address) {
+    for (const char *leaf_name : {"offset", "factors", "axis", "angle"}) {
+      uiIPadRNAReceipt base = scope.binding;
+      PointerRNA root;
+      if (!ui_ipad_rna_constructor_root(C, origin, base, root)) return false;
+      IDProperty *leaf = IDP_GetPropertyFromGroup(static_cast<IDProperty *>(root.data), leaf_name);
+      uiIPadRNAPathStep step = leaf ? ui_ipad_rna_backend_step(leaf, -1) : uiIPadRNAPathStep{};
+      step.name = leaf_name;base.steps.push_back(std::move(step));
+      if (!ui_ipad_rna_constructor_match(C, origin, incoming, incoming_property, name, index,
+                                          base, fresh, field)) continue;
+      const bool vector = STREQ(leaf_name, "offset") || STREQ(leaf_name, "factors");
+      if (base.array != vector || (vector && base.array_length != 3) ||
+          RNA_property_type(field) != (STREQ(leaf_name, "axis") ? PROP_ENUM : PROP_FLOAT))
+        return false;
+      receipt = std::move(base);return true;
+    }
+  }
+  return false;
+}
+
+bool UI_ipad_rna_prepare(uiBlock *block, PointerRNA *ptr, PropertyRNA **prop, const char *name)
+{
+  if (!block->ipad_action_origin.present()) {
+    if (ptr && prop && name) *prop = RNA_struct_find_property(ptr, name);
+    return true;
+  }
+  if (!ptr || !prop) return false;
+  uiIPadRNAReceipt receipt;PointerRNA fresh;PropertyRNA *field = nullptr;
+  if (!ui_ipad_rna_constructor_capture(block, *ptr, *prop, name, RNA_NO_INDEX,
+                                        receipt, fresh, field)) return false;
+  *ptr = std::move(fresh);*prop = field;return true;
+}
+
+bool ui_ipad_rna_resolve(bContext *C, const blender::ui::ipad::ActionOrigin &origin,
+                         const uiIPadRNAReceipt &receipt, PointerRNA &ptr, PropertyRNA *&prop)
+{
+  if (!origin.present()) return true;
+  if (!receipt.valid || !ui_ipad_rna_id_matches(C, origin, receipt)) return false;
+  PointerRNA fresh;PropertyRNA *field = nullptr;
+  if (!ui_ipad_rna_static_walk(C, origin, receipt, fresh, field) ||
+      ui_ipad_rna_address(fresh.data) != receipt.data_address ||
+      ui_ipad_rna_address(fresh.type) != receipt.type_address ||
+      ui_ipad_rna_address(field) != receipt.property_address ||
+      !RNA_struct_contains_property(&fresh, reinterpret_cast<PropertyRNA *>(uintptr_t(receipt.property_address))) ||
+      receipt.property_id != RNA_property_identifier(field)) return false;
+  uiIPadRNAReceipt shape;
+  if (!ui_ipad_rna_shape(C, origin, receipt, fresh, field, receipt.index, shape) ||
+      !ui_ipad_rna_id_matches(C, origin, receipt) || shape.array != receipt.array ||
+      shape.dimension_count != receipt.dimension_count || shape.dimensions != receipt.dimensions ||
+      shape.array_length != receipt.array_length || shape.index != receipt.index) return false;
+  /* PointerRNA owns an ancestor Vector. Replace the entire resolved value,
+   * rather than retaining a retired ancestor chain with fresh data/type. */
+  ptr = std::move(fresh);prop = field;return true;
+}
+
+bool ui_ipad_but_rna_rebind(bContext *C, uiBut *but)
+{
+  const auto &origin = but->block->ipad_action_origin;
+  if (!ui_ipad_action_origin_valid(C, origin)) return false;
+  if (!origin.present() || !but->rnaprop) return true;
+  return ui_ipad_rna_resolve(C, origin, but->ipad_rna_receipt, but->rnapoin, but->rnaprop);
+}
+
+bool ui_ipad_numbers_bind(bContext *C, uiPopupBlockHandle *handle)
+{
+  if (!handle->ipad_action_origin.present()) return true;
+  wmOperatorType *ot = WM_operatortype_find("VIEW3D_OT_ipad_transform_numbers", true);
+  if (!ot || !handle->popup_op || handle->popup_op->type != ot) return true;
+  /* Initial constructors already ran. This seam is intentionally limited to
+   * the static Numbers class with IDProperty fields and no get/set/check/cancel
+   * override. Bind after handler registration and before the first draw. */
+  handle->ipad_numbers = true;
+  handle->ipad_numbers_operator = ui_ipad_rna_address(handle->popup_op);
+  handle->ipad_numbers_type = ui_ipad_rna_address(ot);
+  handle->ipad_numbers_ptr = ui_ipad_rna_address(handle->popup_op->ptr);
+  handle->ipad_numbers_properties = ui_ipad_rna_address(handle->popup_op->properties);
+  if (!ui_ipad_numbers_popup_valid(C, handle)) return false;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  uiBlock *block = static_cast<uiBlock *>(handle->region->runtime->uiblocks.first);
+  for (const std::unique_ptr<uiBut> &but : block->buttons) {
+    if (!but->rnaprop) continue;
+    if (but->rnapoin.owner_id != &wm->id || but->rnapoin.type != ot->srna ||
+        but->rnapoin.data != handle->popup_op->properties) return false;
+    const char *identifier = RNA_property_identifier(but->rnaprop);
+    if (!identifier || !ELEM(std::string_view(identifier), "offset", "factors", "angle", "axis"))
+      return false;
+    uiIPadRNAReceipt receipt;
+    receipt.owner = uiIPadRNAOwner::PopupProperties;
+    receipt.owner_address = ui_ipad_rna_address(wm);
+    receipt.owner_uid = wm->id.session_uid;receipt.owner_id_type = GS(wm->id.name);
+    receipt.popup_lifetime = handle->ipad_popup_lifetime;
+    receipt.popup_operator_address = handle->ipad_numbers_operator;
+    receipt.subgroup_address = handle->ipad_numbers_properties;
+    receipt.root_type_address = ui_ipad_rna_address(ot->srna);
+    ui_ipad_rna_history_capture(C, receipt);
+    IDProperty *leaf = IDP_GetPropertyFromGroup(handle->popup_op->properties, identifier);
+    uiIPadRNAPathStep step = leaf ? ui_ipad_rna_backend_step(leaf, -1) : uiIPadRNAPathStep{};
+    step.name = identifier;receipt.steps.push_back(std::move(step));
+    if (!ui_ipad_rna_finish_capture(C, handle->ipad_action_origin, but->rnapoin,
+                                   but->rnaprop, but->rnaindex, receipt)) return false;
+    but->ipad_rna_receipt = std::move(receipt);
+  }
+  return true;
+}
+
+/* All admitted owned properties share fresh binding and self-call admission. */
+bool ui_ipad_numbers_but_rebind(uiBut *but)
+{
+  bContext *C = static_cast<bContext *>(but->block->evil_C);
+  if (but->ipad_callback_retired || !ui_ipad_hud_button_owner_allowed(C, but) ||
+      !ui_ipad_but_self_callback_allowed(C, but)) return false;
+  return ui_ipad_but_rna_rebind(C, but);
+}
+
+/* An immediate callback executes inside BUT/ROW and event frames which still
+ * own their button/data. A post-callback lease cannot protect those callers.
+ * Admit only the pinned UI-preserving Snap normalization, before any write or
+ * Cancel restoration. Its native get/set touch only ToolSettings.snap_mode. */
+static bool ui_ipad_but_snap_callback_allowed(bContext *C, uiBut *but)
+{
+  const uiIPadRNAReceipt &receipt = but->ipad_rna_receipt;
+  if (!ui_ipad_snap_callback_matches(but) || !receipt.valid ||
+      receipt.owner != uiIPadRNAOwner::Scene || receipt.steps.size() != 2 ||
+      receipt.steps[0].name != "tool_settings" || receipt.steps[0].index != -1 ||
+      receipt.steps[1].index != -1 ||
+      !(receipt.property_id == "snap_elements_base" ||
+        receipt.property_id == "snap_elements_individual") ||
+      receipt.steps[1].name != receipt.property_id ||
+      !ui_ipad_but_rna_rebind(C, but)) return false;
+  Scene *scene = CTX_data_scene(C);
+  return scene && but->rnapoin.owner_id == &scene->id &&
+         but->rnapoin.type == &RNA_ToolSettings && but->rnapoin.data == scene->toolsettings;
+}
+
+bool ui_ipad_but_self_callback_allowed(bContext *C, uiBut *but)
+{
+  const auto &origin = but->block->ipad_action_origin;
+  if (!origin.present()) return true;
+  if (!ui_ipad_action_origin_valid(C, origin)) return false;
+  if (but->ipad_callback_retired ||
+      (but->block->ipad_corner_block_lifetime && !ui_ipad_corner_history_matches(C, but->block))) return false;
+  if (!but->func || (but->func_arg1 != but && but->func_arg2 != but)) return true;
+  return ui_ipad_but_snap_callback_allowed(C, but);
+}
+
+bool ui_ipad_but_direct_property_allowed(bContext *C, uiBut *but)
+{
+  if (!but->block->ipad_action_origin.present()) return true;
+  if (but->ipad_callback_retired) return false;
+  /* Property operators write before calling active_but_prop_handle. Refuse
+   * unknown direct functions before exposing their writable PointerRNA. */
+  return !but->block->handle_func && ui_ipad_but_rna_rebind(C, but) &&
+         (!but->func || ui_ipad_but_snap_callback_allowed(C, but));
+}
+
+static bool ui_ipad_but_migration_matches(const uiBut *but, const uiBut *oldbut)
+{
+  const auto &a = but->block->ipad_action_origin;
+  const auto &b = oldbut->block->ipad_action_origin;
+  if (!a.present() && !b.present()) return true;
+  if (a.lifetime != b.lifetime || a.context != b.context ||
+      std::memcmp(a.tool, b.tool, sizeof(a.tool)) != 0 ||
+      but->identity_cmp_func || oldbut->identity_cmp_func ||
+      but->ipad_callback_retired || oldbut->ipad_callback_retired ||
+      !(but->ipad_rna_receipt == oldbut->ipad_rna_receipt) ||
+      but->ipad_snap_callback != oldbut->ipad_snap_callback ||
+      (but->ipad_snap_callback &&
+       (but->ipad_snap_callback_value != oldbut->ipad_snap_callback_value ||
+        !ui_ipad_snap_callback_matches(but) || !ui_ipad_snap_callback_matches(oldbut))))
+    return false;
+  /* Never let native custom identity matching migrate an unknown self call. */
+  for (const uiBut *candidate : {but, oldbut}) {
+    if (candidate->func && (candidate->func_arg1 == candidate ||
+                            candidate->func_arg2 == candidate) &&
+        !ui_ipad_snap_callback_matches(candidate)) return false;
+  }
+  return true;
+}

 static bool ui_but_is_unit_radians_ex(const UnitSettings *unit, const int unit_type)
 {
