   }
 
   View2D *v2d = &region->v2d;
   BLI_rctf_resize(&v2d->cur,
                   float(BLI_rcti_size_x(&v2d->mask)) / (value / 100.0f),
                   float(BLI_rcti_size_y(&v2d->mask)) / (value / 100.0f));
   ED_region_tag_redraw(region);
 }
 
