+   * Respect explicit keymap overrides and never tag ordinary shortcuts. */
+  PointerRNA tool_ptr;
+  const bool fine_canvas = WM_toolsystem_ref_properties_get_from_operator(tref, ot, &tool_ptr) &&
+                           RNA_struct_property_is_set(&tool_ptr, "use_accurate") &&
+                           RNA_boolean_get(&tool_ptr, "use_accurate") &&
+                           RNA_boolean_get(ptr, "use_accurate");
+  RNA_boolean_set(ptr, "ipad_tool_precision", fine_canvas);
