 static bool parse_float_array(char *text, float *values, int values_len_expected)
 {
   /* can parse max 4 floats for now */
   BLI_assert(0 <= values_len_expected && values_len_expected <= 4);
 
   float v[5];
   const int values_len_actual = sscanf(
       text, "[%f, %f, %f, %f, %f]", &v[0], &v[1], &v[2], &v[3], &v[4]);
 
   if (values_len_actual == values_len_expected) {
     memcpy(values, v, sizeof(float) * values_len_expected);
     return true;
   }
   return false;
 }
 
+static bool ui_ipad_numbers_parse_array(const char *text, float *values, const int count)
+{
+  const auto skip_space = [](const char *p) {
+    while (*p && std::isspace(static_cast<unsigned char>(*p))) ++p;
+    return p;
+  };
+  const char *cursor = skip_space(text);
+  if (count < 1 || count > 4 || *cursor++ != '[') return false;
+  for (int index = 0; index < count; ++index) {
+    cursor = skip_space(cursor);
+    char *end = nullptr;
+    const double value = std::strtod(cursor, &end);
+    if (end == cursor || !std::isfinite(value)) return false;
+    values[index] = float(value);
+    if (!std::isfinite(values[index])) return false;
+    cursor = skip_space(end);
+    if (*cursor++ != (index + 1 == count ? ']' : ',')) return false;
+  }
+  return *skip_space(cursor) == '\0';
+}
