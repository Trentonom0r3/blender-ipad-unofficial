     if (ISMOUSE_BUTTON(event->type) && WM_event_drag_test(event, event->prev_press_xy)) {
       /* Pass. */
     }
     else {
       if ((event_time_ms - event_prev_press_time_ms) < uint64_t(U.dbl_click_time)) {
         return true;
       }
     }
   }
 
   return false;
 }
 
