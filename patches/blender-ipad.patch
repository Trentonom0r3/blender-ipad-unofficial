+bool UI_ipad_hud_event_admit(bContext *C, wmWindow *win, const wmEvent *event)
+{
+#ifdef WITH_APPLE_CROSSPLATFORM
+  if (!event->ipad_hud_generation) return true;
+  if (!event->ipad_hud_serial || event->ipad_hud_serial == UINT64_MAX) return false;
+  /* Physical contact serials never wrap/restart within the GHOST process.
+   * Even an unchanged presentation cannot turn an old terminal into the
+   * release of a newer field. Store no borrowed window/context owner. */
+
+  const uintptr_t window = uintptr_t(win);
+  const auto previous = ui_ipad_hud_contacts.find(window);
+  const uint64_t serial = previous == ui_ipad_hud_contacts.end() ? 0 : previous->second.serial;
+  if (previous != ui_ipad_hud_contacts.end() && event->ipad_hud_serial <= previous->second.ended_serial)
+    return false;
+  if (event->ipad_hud_serial < serial) return false;
+  if (event->ipad_hud_serial > serial && event->type != MOUSEMOVE &&
+      !(event->type == LEFTMOUSE && event->val == KM_PRESS)) return false;
+  /* A known physical release ends that contact before any proof or onfree
+   * disposal. This denies future input, without granting value restoration.
+   * The current first release still needs its full field/presentation proof. */
+  if (previous != ui_ipad_hud_contacts.end() && event->ipad_hud_serial == serial &&
+      event->type == LEFTMOUSE && event->val == KM_RELEASE)
+    previous->second.ended_serial = serial;
+  auto remember_contact = [&]() {
+    if (ui_ipad_hud_contacts.size() >= 64) {
+      wmWindowManager *wm = CTX_wm_manager(C);
+      for (auto it = ui_ipad_hud_contacts.begin(); it != ui_ipad_hud_contacts.end();) {
+        bool live = false;
+        if (wm) LISTBASE_FOREACH (wmWindow *, candidate, &wm->windows) {
+          live |= uintptr_t(candidate) == it->first;
+        }
+        if (!live) it = ui_ipad_hud_contacts.erase(it); else ++it;
+      }
+    }
+    if (ui_ipad_hud_contacts.size() >= 64 && !ui_ipad_hud_contacts.count(window)) return false;
+    uiIPadHUDContactState &state = ui_ipad_hud_contacts[window];
+    state.serial = event->ipad_hud_serial;
+    if (event->type == LEFTMOUSE && event->val == KM_RELEASE)
+      state.ended_serial = event->ipad_hud_serial;
+    return true;
+  };
+  for (const auto &entry : ui_ipad_hud_fields) {
+    const uiIPadHUDField receipt = entry.second;
+    if (receipt.generation != event->ipad_hud_generation || receipt.serial != event->ipad_hud_serial)
+      continue;
+    if (receipt.physical_terminal) return false;
+    if (ui_ipad_hud_field_proof(C, receipt)) return remember_contact();
+    ui_ipad_hud_field_retire(C, receipt); return false;
+  }
+  return ED_ipad_hud_input_admit(C, win, event->ipad_hud_generation) && remember_contact();
+#else
+  UNUSED_VARS(C, win, event); return true;
+#endif
+}
