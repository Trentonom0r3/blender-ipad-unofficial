+static bool panel_poll(bContext *C)
+{
+  return CTX_wm_window(C) && ED_ipad_panels_enabled(CTX_wm_screen(C));
+}
+
+/* Bind menu commands to their originating working editor, including when the
+ * menu itself runs in the top bar or a popup region. */
+static ScrArea *working_source(const Model &model, const int source)
+{
+  if (source < 0) {
+    return model.main;
+  }
+  for (const policy::Area &working : model.working) {
+    if (working.id == source) {
+      return model.areas[source];
+    }
+  }
+  return nullptr;
+}
+
+static wmOperatorStatus launcher_arrange_exec(bContext *C, wmOperator * /*op*/)
+{
+  const Model model = make_model(C, CTX_wm_window(C));
+  bScreen *screen = CTX_wm_screen(C);
+  const std::string signature = launcher_signature(screen, model);
+  uiPopupMenu *popup = UI_popup_menu_begin(C, "Arrange Launchers", ICON_NONE);
+  uiLayout *layout = UI_popup_menu_layout(popup);
+  for (const bool left : {true, false}) {
+    layout->label(left ? "Left Rail" : "Right Rail", ICON_NONE);
+    std::vector<const Tab *> rail;
+    for (const Tab &tab : model.tabs) { if ((tab.edge != Edge::Side) == left) { rail.push_back(&tab); } }
+    for (size_t i = 0; i < rail.size(); ++i) {
+      const Tab &tab = *rail[i];
+      uiLayout *row = &layout->row(true);
+      row->scale_y_set(2.2f);
+      const std::string label = tab.label + (tab.region_type == 0 ? " (" + std::to_string(tab.id + 1) + ")" : "");
+      row->label(label.c_str(), ICON_NONE);
+      for (const int direction : {-1, 1}) {
+        uiLayout *action = &row->row(true);
+        action->enabled_set(direction < 0 ? i > 0 : i + 1 < rail.size());
+        PointerRNA props = action->op("SCREEN_OT_ipad_launcher_move", direction < 0 ? "Earlier" : "Later",
+                                      direction < 0 ? ICON_TRIA_UP : ICON_TRIA_DOWN,
+                                      blender::wm::OpCallContext::ExecDefault, UI_ITEM_NONE);
+        RNA_string_set(&props, "target", launcher_key(tab).c_str());
+        RNA_string_set(&props, "signature", signature.c_str());
+        RNA_int_set(&props, "direction", direction);
+      }
+    }
+    layout->separator();
+  }
+  UI_popup_menu_end(C, popup);
+  return OPERATOR_FINISHED;
+}
+
+static wmOperatorStatus launcher_move_exec(bContext *C, wmOperator *op)
+{
+  const Model model = make_model(C, CTX_wm_window(C));
+  auto property = [&](const char *name) {
+    std::vector<char> value(size_t(RNA_string_length(op->ptr, name)) + 1);
+    RNA_string_get(op->ptr, name, value.data());
+    return std::string(value.data());
+  };
+  if (!move_launcher(CTX_wm_screen(C), model, property("target"), property("signature"),
+                     RNA_int_get(op->ptr, "direction"))) { return OPERATOR_CANCELLED; }
+  tag_layout(C, CTX_wm_window(C));
+  return launcher_arrange_exec(C, nullptr);
+}
+
+static bool working_areas_are_full_edge_neighbors(ScrArea *source, ScrArea *target)
+{
+  const eScreenDir direction = area_getorientation(source, target);
+  if (direction == SCREEN_DIR_NONE) {
+    return false;
+  }
+  int offset1, offset2;
+  area_getoffsets(source, target, direction, &offset1, &offset2);
+  return offset1 == 0 && offset2 == 0;
+}
+
+static int working_area_index_after_join(const Model &before, const bScreen *screen, const int saved)
+{
+  if (saved <= 0) {
+    return saved;
+  }
+  const int old_index = saved - 1;
+  if (old_index >= int(before.areas.size())) {
+    return 0;
+  }
+  const int new_index = BLI_findindex(&screen->areabase, before.areas[old_index]);
+  return new_index < 0 ? 0 : new_index + 1;
+}
+
+static void working_area_indices_remap_after_join(
+    bScreen *screen, const Model &before, const ScrArea * /*removed*/)
+{
+  for (int axis = 0; axis < 2; axis++) {
+    screen->ipad_panel_active[axis] = working_area_index_after_join(
+        before, screen, screen->ipad_panel_active[axis]);
+  }
+  screen->ipad_panel_owner = working_area_index_after_join(
+      before, screen, screen->ipad_panel_owner);
+}
+
+void ED_ipad_panels_working_menu(bContext *C, uiLayout *layout)
+{
+  layout->op("SCREEN_OT_ipad_layout_save", "Save Layout", ICON_DUPLICATE,
+             blender::wm::OpCallContext::ExecDefault, UI_ITEM_NONE);
+  layout->separator();
+  ED_ipad_panels_layout_history_menu(C, layout);
+  layout->separator();
+  layout->op("SCREEN_OT_ipad_launcher_arrange", "Arrange Launchers", ICON_SORTSIZE,
+               blender::wm::OpCallContext::ExecDefault, UI_ITEM_NONE);
+  layout->separator();
+  Model model = make_model(C, CTX_wm_window(C));
+  ScrArea *source = CTX_wm_area(C);
+  if (!source || source->runtime.ipad_layer != 1) {
+    source = model.main;
+  }
+  int source_id = -1;
+  for (const policy::Area &working : model.working) {
+    if (model.areas[working.id] == source) {
+      source_id = working.id;
+      break;
+    }
+  }
+  if (source_id < 0) {
+    return;
+  }
+  for (const bool vertical : {true, false}) {
+    PointerRNA props = layout->op("SCREEN_OT_ipad_working_split",
+                                 vertical ? "Split Vertically" : "Split Horizontally",
+                                 vertical ? ICON_SPLIT_VERTICAL : ICON_SPLIT_HORIZONTAL,
+                                 blender::wm::OpCallContext::ExecDefault, UI_ITEM_NONE);
+    RNA_boolean_set(&props, "vertical", vertical);
+    RNA_int_set(&props, "source", source_id);
+  }
+  bool has_full_edge_join = false;
+  for (const policy::Area &working : model.working) {
+    ScrArea *target = model.areas[working.id];
+    if (target == source || !working_areas_are_full_edge_neighbors(source, target)) {
+      continue;
+    }
+    if (!has_full_edge_join) {
+      layout->separator();
+      has_full_edge_join = true;
+    }
+    const std::string label = "Keep this editor; close " + area_label(target) + " (" +
+                              std::to_string(working.id + 1) + ")";
+    PointerRNA props = layout->op("SCREEN_OT_ipad_working_join", label.c_str(), ICON_AREA_JOIN,
+                                 blender::wm::OpCallContext::ExecDefault, UI_ITEM_NONE);
+    RNA_int_set(&props, "source", source_id);
+    RNA_int_set(&props, "target", working.id);
+  }
+  if (model.working.size() > 1) {
+    layout->separator();
+    for (const policy::Area &working : model.working) {
+      const ScrArea *area = model.areas[working.id];
+      if (area == source) {
+        continue;
+      }
+      const std::string label = "Swap with " + area_label(area) + " (" +
+                                std::to_string(working.id + 1) + ")";
+      PointerRNA props = layout->op("SCREEN_OT_ipad_working_swap", label.c_str(), ICON_AREA_SWAP,
+                                   blender::wm::OpCallContext::ExecDefault, UI_ITEM_NONE);
+      RNA_int_set(&props, "source", source_id);
+      RNA_int_set(&props, "target", working.id);
+    }
+  }
+}
