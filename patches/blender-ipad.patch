+namespace {
+/* Retirement deliberately ignores Scene/tool/history changes: those are why
+ * this UI is stale. WM/window/screen/region membership and runtime identity
+ * must still describe the original native owner before any teardown. */
+static ARegion *ipad_hud_retire_region(bContext *C, const IPadHUDOwner &owner,
+                                       ScrArea *&r_area)
+{
+  r_area = nullptr;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || uint64_t(uintptr_t(CTX_data_main(C))) != owner.context[0] ||
+      wm->id.session_uid != owner.context[12]) return nullptr;
+  LISTBASE_FOREACH (wmWindow *, win, &wm->windows) {
+    if (uint64_t(uintptr_t(win)) != owner.context[1] ||
+        uint64_t(win->winid) != owner.context[11]) continue;
+    if (CTX_wm_window(C) != win) return nullptr;
+    bScreen *screen = WM_window_get_active_screen(win);
+    if (!screen || uint64_t(uintptr_t(screen)) != owner.context[2] ||
+        screen->id.session_uid != owner.context[5]) return nullptr;
+    LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+      if (uint64_t(uintptr_t(area)) != owner.context[3]) continue;
+      LISTBASE_FOREACH (ARegion *, hud, &area->regionbase) {
+        if (uint64_t(uintptr_t(hud)) == owner.hud_address &&
+            hud->regiontype == RGN_TYPE_HUD &&
+            hud->runtime->ipad_hud_content_lifetime == owner.hud_lifetime) {
+          r_area = area; return hud;
+        }
+      }
+      return nullptr;
+    }
+    return nullptr;
+  }
+  return nullptr;
+}
+static void ipad_hud_retire_context_restore(bContext *C, const uintptr_t area_address,
+                                            const uintptr_t region_address)
+{
+  /* No old native owner is read after an onfree/custom-interaction callback. */
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmWindow *win = CTX_wm_window(C);
+  ScrArea *restored_area = nullptr;
+  ARegion *restored_region = nullptr;
+  if (wm && win && BLI_findindex(&wm->windows, win) != -1) {
+    bScreen *screen = WM_window_get_active_screen(win);
+    if (screen) {
+      LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+        if (uintptr_t(area) != area_address) continue;
+        restored_area = area;
+        LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+          if (uintptr_t(region) == region_address) { restored_region = region; break; }
+        }
+        break;
+      }
+    }
+  }
+  CTX_wm_area_set(C, restored_area);
+  CTX_wm_region_set(C, restored_region);
+}
+}  // namespace
+
+void ED_ipad_hud_input_retire(bContext *C, wmWindow *win, const uint64_t generation)
+{
+  if (!generation || !ipad_hud_window_live(C, win)) return;
+  IPadHUDOwner owner;
+  /* Copy all receipt state before callbacks can erase/reallocate the registry.
+   * Repeated stale packets cannot dispose a newer owner or repeat a callback. */
+  {
+    const auto frame_it = ipad_hud_frames.find(uintptr_t(win));
+    if (frame_it == ipad_hud_frames.end() ||
+        frame_it->second.window_id != uint64_t(win->winid)) return;
+    for (const auto &presentation : frame_it->second.presented) {
+      if (presentation.generation == generation && presentation.owner.valid) {
+        owner = presentation.owner; break;
+      }
+    }
+  }
+  if (!owner.valid) return;
+  const uintptr_t previous_area = uintptr_t(CTX_wm_area(C));
+  const uintptr_t previous_region = uintptr_t(CTX_wm_region(C));
+  for (const char *name : {"VIEW3D_PT_ipad_corner_transform", "VIEW3D_PT_ipad_corner_selection",
+                           "VIEW3D_PT_ipad_corner_view", "OPERATOR_PT_redo"}) {
+    ScrArea *area;
+    ARegion *hud = ipad_hud_retire_region(C, owner, area);
+    if (!hud) break;
+    CTX_wm_area_set(C, area);
+    CTX_wm_region_set(C, hud);
+    /* Native block-free uses onfree activation exit. It skips value/Cancel
+     * restoration, deferred application and another Undo/Redo. */
+    UI_block_discard_named_rebuild(C, hud, name);
+    ipad_hud_retire_context_restore(C, previous_area, previous_region);
+    ScrArea *fresh_area;
+    ARegion *fresh_hud = ipad_hud_retire_region(C, owner, fresh_area);
+    if (!fresh_hud) return;
+    ED_region_tag_redraw(fresh_hud);
+  }
+}
