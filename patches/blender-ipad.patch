+    angle: bpy.props.FloatProperty(name="Angle", default=0, subtype='ANGLE', unit='ROTATION',
+                                  options={'SKIP_SAVE'})
+    axis: bpy.props.EnumProperty(name="Axis", items=(('X', "X", ""), ('Y', "Y", ""), ('Z', "Z", "")),
+                                default='Z', options={'SKIP_SAVE'})
+
+    @classmethod
+    def poll(cls, context):
+        return ipad_transform_context(context)
+
+    def invoke(self, context, event):
+        if not self.poll(context):
+            return {'CANCELLED'}
+        self._target = ipad_numeric_target(context, self.slot_index)
+        return context.window_manager.invoke_props_dialog(self, width=360)
+
+    def draw(self, context):
+        layout = self.layout
+        layout.scale_y = 2.2
+        basis = ipad_transform_orientation(context, self.slot_index)
+        layout.label(text=f"{self.operation.title()} · {basis.type.title()} axes")
+        if self.operation == 'MOVE':
+            layout.prop(self, 'offset', text="Offset")
+        elif self.operation == 'SCALE':
+            layout.prop(self, 'factors', text="Factors")
+        else:
+            layout.prop(self, 'axis', expand=True)
+            layout.prop(self, 'angle')
+        layout.label(text="OK applies once · Undo reverses the edit")
+
+    def execute(self, context):
+        if not self.poll(context):
+            return {'CANCELLED'}
+        if hasattr(self, '_target') and self._target != ipad_numeric_target(context, self.slot_index):
+            self.report({'WARNING'}, "Selection or transform settings changed; reopen Numbers")
+            return {'CANCELLED'}
+        basis = ipad_transform_orientation(context, self.slot_index)
+        kwargs = {'orient_type': basis.type}
+        if self.operation == 'MOVE':
+            if not any(self.offset):
+                return {'CANCELLED'}
+            return bpy.ops.transform.translate('EXEC_REGION_WIN', value=tuple(self.offset), **kwargs)
+        if self.operation == 'SCALE':
+            if tuple(self.factors) == (1, 1, 1):
+                return {'CANCELLED'}
+            return bpy.ops.transform.resize('EXEC_REGION_WIN', value=tuple(self.factors), **kwargs)
+        if self.angle == 0:
+            return {'CANCELLED'}
+        return bpy.ops.transform.rotate('EXEC_REGION_WIN', value=self.angle,
+            orient_axis=self.axis, constraint_axis=tuple(axis == self.axis for axis in 'XYZ'), **kwargs)
+
