+def ipad_transform_context(context):
+    return (context.area is not None and context.area.type == 'VIEW_3D'
+            and context.window is not None
+            and context.mode in IPAD_SELECT_ALL
+            and not getattr(context.window_manager, "ipad_flythrough_active", False))
