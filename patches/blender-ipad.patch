+    case uiIPadRNAOwner::WindowManager: return reinterpret_cast<ID *>(CTX_wm_manager(C));
+    case uiIPadRNAOwner::PopupProperties: return reinterpret_cast<ID *>(CTX_wm_manager(C));
+    case uiIPadRNAOwner::Brush: {
+      Paint *paint = BKE_paint_get_active_from_context(C);
+      return paint ? reinterpret_cast<ID *>(BKE_paint_brush(paint)) : nullptr;
