+namespace {
+struct IPadHUDOwner {
+  std::array<uint64_t, 13> context{};
+  std::array<char, 64> tool{};
+  uint64_t hud_address = 0, hud_lifetime = 0, buffer_address = 0;
+  uint64_t redo_address = 0, redo_lifetime = 0, redo_type_address = 0, redo_type_lifetime = 0;
+  uint64_t undo_address = 0, undo_lifetime = 0, undo_mutation = 0;
+  int window_width = 0, window_height = 0;
+  float ui_scale = 0.0f;
+  rcti region_rect{};
+  bool valid = false;
+};
+struct IPadHUDContent {
+  IPadHUDOwner layout_before, layout_after, texture;
+  bool layout_ready = false;
+};
+struct IPadHUDPresentation {
+  IPadHUDOwner owner;
+  std::vector<rcti> rects;
+  uint64_t generation = 0;
+};
+struct IPadHUDFrame {
+  uint64_t window_id = 0;
+  bool pending = false;
+  std::vector<IPadHUDPresentation> presented, drawing;
+};
+static std::unordered_map<uint64_t, IPadHUDContent> ipad_hud_contents;
+static std::unordered_map<uintptr_t, IPadHUDFrame> ipad_hud_frames;
+static uint64_t ipad_hud_next_identity = 1;
+
+static uint64_t ipad_hud_new_identity()
+{
+  if (ipad_hud_next_identity == std::numeric_limits<uint64_t>::max()) return 0;
+  return ipad_hud_next_identity++;
+}
+static bool ipad_hud_rect_equal(const rcti &a, const rcti &b)
+{
+  return a.xmin == b.xmin && a.ymin == b.ymin && a.xmax == b.xmax && a.ymax == b.ymax;
+}
+static bool ipad_hud_owner_equal(const IPadHUDOwner &a, const IPadHUDOwner &b,
+                                 const bool geometry)
+{
+  return a.redo_address == b.redo_address && a.redo_lifetime == b.redo_lifetime &&
+         a.redo_type_address == b.redo_type_address && a.redo_type_lifetime == b.redo_type_lifetime &&
+         a.valid && b.valid && a.context == b.context && a.tool == b.tool &&
+         a.hud_address == b.hud_address && a.hud_lifetime == b.hud_lifetime &&
+         a.undo_address == b.undo_address && a.undo_lifetime == b.undo_lifetime &&
+         a.undo_mutation == b.undo_mutation && a.window_width == b.window_width &&
+         a.window_height == b.window_height && a.ui_scale == b.ui_scale &&
+         (!geometry || (a.buffer_address == b.buffer_address &&
+                        ipad_hud_rect_equal(a.region_rect, b.region_rect)));
+}
+static bool ipad_hud_window_live(bContext *C, const wmWindow *win)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  return wm && win && BLI_findindex(&wm->windows, win) != -1;
+}
+static bool ipad_hud_owner_capture(bContext *C, wmWindow *win, ScrArea *area,
+                                    ARegion *hud, IPadHUDOwner &owner)
+{
+  owner = {};
+  if (!ipad_hud_window_live(C, win)) return false;
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!screen || !ED_ipad_panels_enabled(screen) || !area ||
+      BLI_findindex(&screen->areabase, area) == -1 || !hud ||
+      BLI_findindex(&area->regionbase, hud) == -1 || hud->regiontype != RGN_TYPE_HUD ||
+      !hud->runtime->ipad_hud_content_lifetime || area->spacetype != SPACE_VIEW3D ||
+      !ED_ipad_panels_area_visible(area) || !hud->runtime->visible ||
+      (hud->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER | RGN_FLAG_TOO_SMALL |
+                    RGN_FLAG_POLL_FAILED))) return false;
+  /* This function resolves only fresh list members. Never cast an old receipt
+   * address back into a region. The corner lifecycle owns quad-view selection. */
+  /* CTX_wm_area_set clears the region even when restoring the same area.
+   * Restore parent before child on every exit, including refused captures. */
+  ScrArea *previous_area = CTX_wm_area(C);
+  ARegion *previous_region = CTX_wm_region(C);
+  CTX_wm_area_set(C, area);
+  ARegion *window = UI_ipad_corner_hud_window(C, area, hud);
+  if (!window || BLI_findindex(&area->regionbase, window) == -1 ||
+      window->regiontype != RGN_TYPE_WINDOW || !window->runtime->visible) {
+    CTX_wm_area_set(C, previous_area);
+    CTX_wm_region_set(C, previous_region);
+    return false;
+  }
+  CTX_wm_region_set(C, window);
+  const bool captured = UI_ipad_context_capture(C, owner.context.data()) &&
+                        owner.context[1] == uint64_t(uintptr_t(win));
+  if (captured) {
+    const bToolRef *tool = WM_toolsystem_ref_from_context(C);
+    BLI_strncpy(owner.tool.data(), tool ? tool->idname : "", owner.tool.size());
+    const wmWindowManager *wm = CTX_wm_manager(C);
+    const UndoStack *undo = wm->runtime ? wm->runtime->undo_stack : nullptr;
+    if (undo) {
+      owner.undo_address = uint64_t(uintptr_t(undo));
+      owner.undo_lifetime = undo->ipad_lifetime_id;
+      owner.undo_mutation = undo->ipad_mutation_generation;
+    }
+    if (wmOperator *redo = WM_operator_last_redo(C)) {
+      if (BLI_findindex(&wm->runtime->operators, redo) == -1) {
+        CTX_wm_area_set(C, previous_area); CTX_wm_region_set(C, previous_region); return false;
+      }
+      wmOperatorType *registered_type = nullptr;
+      for (wmOperatorType *type : WM_operatortypes_registered_get()) {
+        if (type == redo->type) { registered_type = type; break; }
+      }
+      if (!registered_type || !registered_type->ipad_lifetime_id) {
+        CTX_wm_area_set(C, previous_area); CTX_wm_region_set(C, previous_region); return false;
+      }
+      owner.redo_address = uint64_t(uintptr_t(redo));
+      owner.redo_lifetime = WM_operator_touch_lifetime_id(redo);
+      owner.redo_type_address = uint64_t(uintptr_t(registered_type));
+      owner.redo_type_lifetime = registered_type->ipad_lifetime_id;
+      if (!owner.redo_lifetime) {
+        CTX_wm_area_set(C, previous_area); CTX_wm_region_set(C, previous_region); return false;
+      }
+    }
+    owner.hud_address = uint64_t(uintptr_t(hud));
+    owner.hud_lifetime = hud->runtime->ipad_hud_content_lifetime;
+    owner.buffer_address = uint64_t(uintptr_t(hud->runtime->draw_buffer));
+    owner.region_rect = hud->winrct;
+    owner.window_width = WM_window_native_pixel_x(win);
+    owner.window_height = WM_window_native_pixel_y(win);
+    owner.ui_scale = UI_SCALE_FAC;
+    owner.valid = true;
+  }
+  CTX_wm_area_set(C, previous_area);
+  CTX_wm_region_set(C, previous_region);
+  return captured;
+}
+static bool ipad_hud_rects_equal(const std::vector<rcti> &a, const std::vector<rcti> &b)
+{
+  if (a.size() != b.size()) return false;
+  for (size_t i = 0; i < a.size(); ++i) {
+    if (!ipad_hud_rect_equal(a[i], b[i])) return false;
+  }
+  return true;
+}
+static void ipad_hud_cache_prune(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm) return;
+  std::unordered_set<uintptr_t> windows;
+  std::unordered_set<uint64_t> content;
+  LISTBASE_FOREACH (wmWindow *, win, &wm->windows) {
+    windows.insert(uintptr_t(win));
+    bScreen *screen = WM_window_get_active_screen(win);
+    if (!screen) continue;
+    LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+      LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+        if (region->runtime->ipad_hud_content_lifetime)
+          content.insert(region->runtime->ipad_hud_content_lifetime);
+      }
+    }
+  }
+  for (auto it = ipad_hud_frames.begin(); it != ipad_hud_frames.end();) {
+    if (!windows.count(it->first)) it = ipad_hud_frames.erase(it); else ++it;
+  }
+  for (auto it = ipad_hud_contents.begin(); it != ipad_hud_contents.end();) {
+    if (!content.count(it->first)) it = ipad_hud_contents.erase(it); else ++it;
+  }
+}
+}  // namespace
