+static bool editing_shelf_preference(bContext *C, const char *name)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm) return false;
+  PointerRNA pointer = RNA_id_pointer_create(&wm->id);
+  PropertyRNA *property = RNA_struct_find_property(&pointer, name);
+  /* Registration can be absent or replaced. Never retain this dynamic RNA. */
+  return property && RNA_property_type(property) == PROP_BOOLEAN &&
+         RNA_property_array_length(&pointer, property) == 0 &&
+         RNA_property_boolean_get(&pointer, property);
+}
+
+static bool editing_shelf_expanded(bContext *C)
+{
+  return editing_shelf_preference(C, "ipad_editing_shelf_expanded");
+}
+
+static bool editing_shelf_enabled(bContext *C)
+{
+  return editing_shelf_preference(C, "ipad_editing_shelf_enabled");
+}
+
+static bool editing_shelf_rect_equal(const rcti &a, const rcti &b)
+{
+  return a.xmin == b.xmin && a.xmax == b.xmax && a.ymin == b.ymin && a.ymax == b.ymax;
+}
+
+bool ED_ipad_editing_shelf_rect(bContext *C, const ARegion *region, rcti &rect)
+{
+  rect = {};
+  const ScrArea *area = CTX_wm_area(C);
+  if (!area || area->spacetype != SPACE_VIEW3D || area->runtime.ipad_layer != 1 ||
+      !ED_ipad_panels_enabled(CTX_wm_screen(C)) || !region ||
+      region != CTX_wm_region(C) || region->regiontype != RGN_TYPE_WINDOW ||
+      !region->runtime->visible || !region->runtime->ipad_canvas)
+  {
+    return false;
+  }
+  if (!editing_shelf_enabled(C)) return false;
+  HeaderType *ht = static_cast<HeaderType *>(BLI_findstring(
+      &region->runtime->type->headertypes, "VIEW3D_HT_ipad_editing_shelf", offsetof(HeaderType, idname)));
+  if (!ht || !ht->draw || (ht->poll && !ht->poll(C, ht))) {
+    return false;
+  }
+  const rcti &canvas = region->runtime->ipad_canvas_rect;
+  rcti navigation = area->runtime.ipad_navigation_rect;
+  BLI_rcti_translate(&navigation, -region->winrct.xmin, -region->winrct.ymin);
+  const Rect shelf = policy::editing_shelf(
+      {canvas.xmin, canvas.ymin, canvas.xmax + 1, canvas.ymax + 1},
+      {navigation.xmin, navigation.ymin, navigation.xmax + 1, navigation.ymax + 1},
+      UI_SCALE_FAC, editing_shelf_expanded(C));
+  if (shelf.empty()) {
+    return false;
+  }
+  rect = to_rect(shelf);
+  return true;
+}
+
+bool ED_ipad_editing_shelf_hit(bContext *C, const int xy[2])
+{
+  const ARegion *region = CTX_wm_region(C);
+  return region && region->runtime->ipad_editing_shelf_presented &&
+         BLI_rcti_isect_pt_v(&region->runtime->ipad_editing_shelf_presented_rect, xy);
+}
+
+bool ED_ipad_editing_shelf_stale(bContext *C, ARegion *region)
+{
+  if (!region || !region->runtime->ipad_editing_shelf_presented) return false;
+  rcti desired;
+  if (!region->runtime->ipad_editing_shelf_visible ||
+      !ED_ipad_editing_shelf_rect(C, region, desired)) return true;
+  BLI_rcti_translate(&desired, region->winrct.xmin, region->winrct.ymin);
+  return !UI_ipad_context_matches(C, region->runtime->ipad_editing_shelf_context) ||
+         region->runtime->ipad_editing_shelf_expanded != editing_shelf_expanded(C) ||
+         region->runtime->ipad_editing_shelf_scale != UI_SCALE_FAC ||
+         !editing_shelf_rect_equal(region->runtime->ipad_editing_shelf_window_rect, region->winrct) ||
+         !editing_shelf_rect_equal(region->runtime->ipad_editing_shelf_presented_rect, desired);
+}
