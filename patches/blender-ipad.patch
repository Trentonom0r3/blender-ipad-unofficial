+    hrd->regionid = -1; hrd->region_index_hint = -1; hrd->redo_suppressed = true;
+    region->regiondata = hrd;
+  }
+  const bool hidden = (region->flag & RGN_FLAG_HIDDEN) || !region->runtime->visible;
+  region->flag &= ~RGN_FLAG_HIDDEN;
+  if (created || hidden || initialized) {
+    ED_area_tag_region_size_update(area, region);
+    ED_region_tag_redraw(region);
+    /* A newly inserted HUD has no View2D, UI handlers or measured rect yet.
+     * Match native HUD ensure: initialize sizes before the first panel layout. */
+    ED_area_update_region_sizes(CTX_wm_manager(C), CTX_wm_window(C), area);
+    ED_region_floating_init(region);
+  }
+  /* Native region sizing can change the exposed canvas; reacquire it. */
+  canvas = UI_ipad_corner_canvas(C);
+  if (!canvas) {
+    hud_region_hide(region);
+    ED_region_tag_redraw(region);
+    return;
+  }
+  region->runtime->visible = !(region->flag & RGN_FLAG_TOO_SMALL);
+  /* Use Blender's small lower-left margin below the launcher buttons. Only
+   * reserve the full left column when the measured HUD actually meets chrome.
+   * Keep the native bottom placement and last-operation storage unchanged. */
