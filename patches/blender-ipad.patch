+            !region->runtime->visible ||
+            (region->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED))) continue;
+        LISTBASE_FOREACH (uiBlock *, block, &region->runtime->uiblocks) {
+          if (!block->active || block->handle ||
+              block->ipad_corner_block_lifetime != lease.corner_block_lifetime ||
+              uint64_t(uintptr_t(block)) != lease.corner_block_address ||
+              block->ipad_action_origin.context != lease.origin.context ||
+              block->ipad_action_origin.lifetime != lease.origin.lifetime ||
