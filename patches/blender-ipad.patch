   if (!reports || BLI_listbase_is_empty(&reports->list) || (reports->flag & RPT_OP_HOLD) != 0) {
     return;
   }
 
   if (!wm) {
     wm = static_cast<wmWindowManager *>(G_MAIN->wm.first);
