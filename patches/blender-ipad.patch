 static bool tilt_poll(bContext *C)
 {
   Object *obedit = CTX_data_edit_object(C);
   if (!obedit) {
     return false;
   }
   if (obedit->type == OB_CURVES_LEGACY) {
     Curve *cu = (Curve *)obedit->data;
     return (cu->flag & CU_3D) && (nullptr != cu->editnurb);
   }
   if (obedit->type == OB_CURVES) {
     return true;
   }
   return true;
 }
 
