+int UI_ipad_view_navigation_mask(bContext *C, uint64_t *region_data)
+{
+  if (region_data) *region_data = 0;
+  uint64_t context[13];
+  if (!UI_ipad_context_capture(C, context)) return 0;
+  ARegion *region = CTX_wm_region(C);
+  RegionView3D *rv3d = static_cast<RegionView3D *>(region->regiondata);
+  if (!rv3d) return 0;
+  /* Executing with zero smoothing must never force-finish an older animation
+   * (that can sync/autokey a camera). BOXVIEW can update another pane. */
+  if (rv3d->persp == RV3D_CAMOB || rv3d->sms || rv3d->smooth_timer ||
+      (RV3D_LOCK_FLAGS(rv3d) & RV3D_BOXVIEW)) return 0;
+  const int locks = RV3D_LOCK_FLAGS(rv3d);
+  int mask = (locks & (RV3D_LOCK_LOCATION | RV3D_LOCK_ZOOM_AND_DOLLY)) ? 0 : 1;
+  View3D *resolved_view = nullptr;
+  ARegion *resolved_region = nullptr;
+  /* Axis/projection otherwise redirect locked quad panes to another WINDOW. */
+  if (ED_view3d_context_user_region(C, &resolved_view, &resolved_region) &&
+      resolved_view == CTX_wm_view3d(C) && resolved_region == region) {
+    if (!(locks & RV3D_LOCK_ROTATION)) mask |= 2;
+    if (!(locks & RV3D_LOCK_ANY_TRANSFORM)) mask |= 4;
+  }
+  if (mask && region_data) *region_data = uint64_t(reinterpret_cast<uintptr_t>(rv3d));
+  return mask;
+}
+
+int UI_ipad_view_navigation_layout_mask(bContext *C, uiBlock *block)
+{
+  if (!block) return 0;
+  block->ipad_view_region_data = 0;
+  if (!ui_ipad_action_origin_valid(C, block->ipad_action_origin)) return 0;
+  if (!block->ipad_action_origin.corner)
+    return UI_ipad_view_navigation_mask(C, &block->ipad_view_region_data);
+  const uintptr_t area = uintptr_t(CTX_wm_area(C)), region = uintptr_t(CTX_wm_region(C));
+  const bool rebound = ui_ipad_action_origin_rebind(C, block->ipad_action_origin);
+  const int mask = rebound ? UI_ipad_view_navigation_mask(C, &block->ipad_view_region_data) : 0;
+  ui_ipad_action_context_restore(C, area, region);
+  return mask;
+}
