+static std::vector<uintptr_t> ui_ipad_numbers_type_guards;
+struct uiIPadNumbersDisposal {
+  uintptr_t type = 0;
+  uiFreeArgFunc dispose = nullptr;
+  void *arg = nullptr;
+};
+static std::vector<uiIPadNumbersDisposal> ui_ipad_numbers_disposals;
