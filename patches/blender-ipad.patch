+static bool ui_ipad_rna_constructor_root(bContext *C,
+    const blender::ui::ipad::ActionOrigin &origin, const uiIPadRNAReceipt &receipt,
+    PointerRNA &root)
+{
+  const auto &scope = ui_ipad_numbers_constructor;
+  if (!scope.op || scope.origin.lifetime != origin.lifetime ||
+      scope.origin.context != origin.context ||
+      std::memcmp(scope.origin.tool, origin.tool, sizeof(origin.tool)) != 0 ||
+      !ui_ipad_rna_id_matches(C, origin, receipt)) return false;
+  /* Fresh registry membership precedes any saved pending metadata access. */
+  wmOperatorType *ot = WM_operatortype_find("VIEW3D_OT_ipad_transform_numbers", true);
+  if (!ot || ui_ipad_rna_address(ot) != scope.type_address ||
+      ot->ipad_lifetime_id != scope.type_lifetime ||
+      ui_ipad_rna_address(ot->srna) != receipt.root_type_address) return false;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmOperator *op = scope.op;
+  if (ui_ipad_rna_address(op) != receipt.popup_operator_address || op->type != ot ||
+      !op->ptr || ui_ipad_rna_address(op->ptr) != scope.ptr_address ||
+      !op->properties || ui_ipad_rna_address(op->properties) != receipt.subgroup_address ||
+      op->properties->type != IDP_GROUP || op->ptr->owner_id != &wm->id ||
+      op->ptr->type != ot->srna || op->ptr->data != op->properties) return false;
+  root = RNA_pointer_create_discrete(&wm->id, ot->srna, op->properties);
+  return true;
+}
+
+static bool ui_ipad_rna_pending_root(bContext *C,
+                                    const blender::ui::ipad::ActionOrigin &origin,
+                                    const uiIPadRNAReceipt &receipt, PointerRNA &root)
+{
+  /* A refresh's newly active first block has no handle until its creator
+   * returns. Resolve this synchronous gap through the explicit protected
+   * constructor, preserving its registered lifetime for native migration. */
+  if (ui_ipad_numbers_constructor.op &&
+      receipt.popup_lifetime == ui_ipad_numbers_constructor.binding.popup_lifetime &&
+      receipt.popup_operator_address == ui_ipad_numbers_constructor.binding.popup_operator_address)
+    return ui_ipad_rna_constructor_root(C, origin, receipt, root);
+  /* Zero never falls through to registered-popup scanning. */
+  if (!receipt.popup_lifetime) return false;
+  uiPopupBlockHandle *handle = ui_ipad_registered_popup_resolve(C, origin, receipt.popup_lifetime);
+  if (!handle || !handle->ipad_numbers || !ui_ipad_numbers_popup_valid(C, handle) ||
+      handle->ipad_numbers_operator != receipt.popup_operator_address ||
+      handle->ipad_numbers_properties != receipt.subgroup_address) return false;
+  wmOperator *op = handle->popup_op;
+  if (ui_ipad_rna_address(op->ptr->type) != receipt.root_type_address) return false;
+  root = RNA_pointer_create_discrete(&CTX_wm_manager(C)->id, op->ptr->type, op->properties);
+  return true;
+}
