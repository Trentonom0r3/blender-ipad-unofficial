         gz->matrix_basis[3][1] = roundf(co[1] - (icon_offset_mini * icon_mini_slot++));
         WM_gizmo_set_flag(gz, WM_GIZMO_HIDDEN, false);
       }
     }
 
     if (navgroup->state.rv3d.is_camera == true) {
       gz = navgroup->gz_array[(v3d->flag2 & V3D_LOCK_CAMERA) ? GZ_INDEX_CAMERA_LOCK :
                                                                GZ_INDEX_CAMERA_UNLOCK];
       gz->matrix_basis[3][0] = roundf(co[0]);
       gz->matrix_basis[3][1] = roundf(co[1] - (icon_offset_mini * icon_mini_slot++));
       WM_gizmo_set_flag(gz, WM_GIZMO_HIDDEN, false);
     }
   }
+#ifdef WITH_APPLE_CROSSPLATFORM
+  ScrArea *area = CTX_wm_area(C);
+  if (ED_ipad_panels_native_pin(CTX_wm_screen(C), area)) {
+    gz = navgroup->gz_array[GZ_INDEX_PANEL_LOCK];
+    gz->matrix_basis[3][0] = roundf(co[0]);
+    gz->matrix_basis[3][1] = roundf(co[1] - icon_offset_mini * icon_mini_slot);
+    RNA_enum_set(gz->ptr, "icon", ED_ipad_panels_locked(CTX_wm_screen(C)) ?
+                                      ICON_PINNED : ICON_UNPINNED);
+    WM_gizmo_set_flag(gz, WM_GIZMO_HIDDEN, false);
+    const int radius = int(gz->scale_basis * UI_SCALE_FAC);
+    const int x = region->winrct.xmin + int(gz->matrix_basis[3][0]);
+    const int y = region->winrct.ymin + int(gz->matrix_basis[3][1]);
+    area->runtime.ipad_pin_rect = {x - radius, x + radius, y - radius, y + radius};
+  }
+  if (ED_ipad_panels_enabled(CTX_wm_screen(C)) && area->runtime.ipad_layer == 1) {
+    /* Panel dismissal must not swallow native navigation/pin presses. Share the
+     * actual gizmo bounds, including axes and camera/quad-view variations. */
+    rcti &hit = area->runtime.ipad_navigation_rect;
+    hit = {region->winrct.xmax, region->winrct.xmin,
+           region->winrct.ymax, region->winrct.ymin};
+    for (wmGizmo *item : navgroup->gz_array) {
+      if (item->flag & WM_GIZMO_HIDDEN) {
+        continue;
+      }
+      const int radius = int(item->scale_basis * UI_SCALE_FAC + 4 * UI_SCALE_FAC);
+      const int x = region->winrct.xmin + int(item->matrix_basis[3][0]);
+      const int y = region->winrct.ymin + int(item->matrix_basis[3][1]);
+      hit.xmin = std::min(hit.xmin, x - radius);
+      hit.xmax = std::max(hit.xmax, x + radius);
+      hit.ymin = std::min(hit.ymin, y - radius);
+      hit.ymax = std::max(hit.ymax, y + radius);
+    }
+  }
+#endif
 }
 
