+static thread_local uiIPadNumbersConstructorContext ui_ipad_numbers_constructor;
+
+static uintptr_t ui_ipad_numbers_constructor_type(bContext *C, wmOperator *op,
+                                                   bool owned_creator,
+                                                   uiPopupBlockHandle *registered)
+{
+  const auto origin = ui_ipad_action_origin_current();
+  if (!owned_creator || !origin.present() || !ui_ipad_action_origin_valid(C, origin)) return 0;
+  if (registered && !ui_ipad_numbers_popup_valid(C, registered)) return 0;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmOperatorType *ot = WM_operatortype_find("VIEW3D_OT_ipad_transform_numbers", true);
+  /* op is the explicit creator's owned pending operator, not a history lookup. */
+  if (!wm || !ui_ipad_rna_main_member(C, &wm->id) || !ot || !ot->ipad_lifetime_id ||
+      !ot->srna || !op || op->type != ot || !op->ptr || !op->properties ||
+      op->ptr->owner_id != &wm->id || op->ptr->type != ot->srna ||
+      op->ptr->data != op->properties || op->properties->type != IDP_GROUP) return 0;
+  return uintptr_t(ot);
+}
