--- /dev/null
+++ b/scripts/startup/bl_ui/space_view3d_ipad.py
@@ -0,0 +1,1585 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compact iPad viewport controls built entirely from existing Blender operators."""
+
+import bpy
+from bpy.types import Header, Menu, Operator, Panel
+from bl_ui.space_toolsystem_common import ToolSelectPanelHelper
+
+
+# Clockwise from the top. Add Cube activates the existing interactive tool.
+IPAD_RADIAL_TOOLS = (
+    ("Select", 'builtin.select_box', 'RESTRICT_SELECT_OFF'),
+    ("Cursor", 'builtin.cursor', 'PIVOT_CURSOR'),
+    ("Move", 'builtin.move', 'EMPTY_ARROWS'),
+    ("Rotate", 'builtin.rotate', 'DRIVER_ROTATIONAL_DIFFERENCE'),
+    ("Scale", 'builtin.scale', 'ARROW_LEFTRIGHT'),
+    ("Transform", 'builtin.transform', 'ORIENTATION_GIMBAL'),
+    ("Annotate", 'builtin.annotate', 'GREASEPENCIL'),
+    ("Measure", 'builtin.measure', 'DRIVER_DISTANCE'),
+    ("Add Cube", 'builtin.primitive_cube_add', 'MESH_CUBE'),
+)
+
+
+def ipad_palette_target(context, x, y):
+    views = [area for area in context.window.screen.areas if area.type == 'VIEW_3D']
+    if not views:
+        return None, None
+    def contains(item):
+        return item.x <= x < item.x + item.width and item.y <= y < item.y + item.height
+    # The event context resolves native floating editor/layer ownership. Prefer
+    # it over an overlapping background viewport before searching other views.
+    area = context.area if context.area in views and contains(context.area) else next(
+        (area for area in views if contains(area)), None)
+    if area is None:
+        area = context.area if context.area in views else max(views, key=lambda a: a.width * a.height)
+    windows = [r for r in area.regions if r.type == 'WINDOW' and r.width > 0 and r.height > 0]
+    region = next((r for r in windows if contains(r)), None)
+    if region is None:
+        region = context.region if context.area == area and context.region in windows else next(iter(windows), None)
+    return area, region
+
+
+class WM_OT_ipad_tool_palette(Operator):
+    bl_idname = "wm.ipad_tool_palette"
+    bl_label = "Pencil Ring"
+    bl_description = "Open the base manipulation ring for the 3D viewport"
+    touch_targets: bpy.props.BoolProperty(default=False, options={'SKIP_SAVE'})
+
+    @classmethod
+    def poll(cls, context):
+        return context.window is not None and any(
+            area.type == 'VIEW_3D' for area in context.window.screen.areas)
+
+    def invoke(self, context, event):
+        area, region = ipad_palette_target(context, event.mouse_x, event.mouse_y)
+        if region is None:
+            return {'CANCELLED'}
+        with context.temp_override(area=area, region=region):
+            options = {'name': 'VIEW3D_MT_ipad_base_ring'}
+            if self.touch_targets:
+                options['ipad_touch_targets'] = True
+            # Preserve the native UI call contract: Python's default undo=False adds
+            # suppression depth even for this non-Undo popup, blocking admission.
+            bpy.ops.wm.call_menu_pie('INVOKE_DEFAULT', True, **options)
+        return {'FINISHED'}
+
+
+class VIEW3D_MT_ipad_tools(Menu):
+    bl_label = "Pencil Tools"
+
+    @classmethod
+    def poll(cls, context):
+        return context.area is not None and context.area.type == 'VIEW_3D'
+
+    def draw(self, context):
+        # Nine native tool buttons retain their familiar positions and empty center.
+        # The active editing tool opens its contextual controls when tapped again.
+        layout = self.layout.column()
+        layout.operator_context = 'INVOKE_REGION_WIN'
+        cls = ToolSelectPanelHelper._tool_class_from_space_type('VIEW_3D')
+        available = {tool.idname: tool for tool in cls._tools_flatten_with_dynamic(
+            cls.tools_from_context(context), context=context) if tool is not None}
+        active = ToolSelectPanelHelper.tool_active_from_context(context)
+        active_id = active.idname if active else None
+        for label, name, fallback_icon in IPAD_RADIAL_TOOLS:
+            slot = layout.row()
+            tool = available.get(name)
+            slot.enabled = tool is not None
+            icon_val = 0
+            if tool and getattr(tool, "icon", None):
+                try:
+                    icon_val = ToolSelectPanelHelper._icon_value_from_icon_handle(tool.icon)
+                except Exception:
+                    icon_val = 0
+            selected = active_id == name or (name == 'builtin.select_box'
+                and active_id in {item[1] for item in IPAD_SELECTION_TOOLS})
+            ring = ipad_context_ring_name(context) if selected else None
+            icon_args = {'icon_value': icon_val} if icon_val else {'icon': fallback_icon}
+            if ring:
+                # Ellipsis announces that tapping the highlighted tool opens controls.
+                slot.operator('wm.call_menu_pie', text=label + "…", depress=True,
+                              **icon_args).name = ring
+            else:
+                slot.operator('wm.tool_set_by_id', text=label, depress=selected,
+                              **icon_args).name = name
