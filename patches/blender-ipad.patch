+    const uiIPadNumbersDisposal owned = ui_ipad_numbers_disposals.back();
+    const uiIPadNumbersTypeGuard type_guard(owned.type);
+    if (!type_guard.valid()) return false;
+    ui_ipad_numbers_disposals.pop_back();
+    owned.dispose(owned.arg);
+    /* No saved UI, WM list, context or type iterator follows decref. */
+  }
