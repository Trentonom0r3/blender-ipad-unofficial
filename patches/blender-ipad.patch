+def ipad_native_tool_inventory(context):
+    """Native context inventory, including every dynamic group member."""
+    space = context.space_data
+    cls = ToolSelectPanelHelper._tool_class_from_space_type(space.type) if space else None
+    if cls is None:
+        return ()
+    seen, tools = set(), []
+    for tool in cls._tools_flatten_with_dynamic(cls.tools_from_context(context), context=context):
+        if tool is not None and tool.idname not in seen:
+            seen.add(tool.idname)
+            tools.append(tool)
+    if context.mode in {'OBJECT', 'EDIT_MESH'} and space.type == 'VIEW_3D':
+        home = {name: i for i, (_, name, _) in enumerate(IPAD_RADIAL_TOOLS)}
+        tools.sort(key=lambda tool: home.get(tool.idname, len(home)))
+    return tuple(tools)
+
+
+def ipad_native_inventory_receipt(context):
+    # Tool IDs are values; dynamic variants may change without a mode switch.
+    return '\\x1f'.join(tool.idname for tool in ipad_native_tool_inventory(context))
+
+
+def ipad_native_tool_icon(tool):
+    if tool.icon:
+        try:
+            return {'icon_value': ToolSelectPanelHelper._icon_value_from_icon_handle(tool.icon)}
+        except Exception:
+            pass
+    return {'icon': 'TOOL_SETTINGS'}
