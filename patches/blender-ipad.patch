 static void do_view3d_vgroup_buttons(bContext *C, void * /*arg*/, int event)
 {
   if (event < B_VGRP_PNL_EDIT_SINGLE) {
     /* not for me */
     return;
   }
 
   const Scene *scene = CTX_data_scene(C);
   ViewLayer *view_layer = CTX_data_view_layer(C);
