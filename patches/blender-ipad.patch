+static bool ui_ipad_hud_numeric_profile(bContext *C, uiBut *but, uiIPadHUDField &field)
+{
+  uiBlock *block = but->block;
+  if (block->name != "OPERATOR_PT_redo" || block->handle_func != ED_undo_operator_repeat_cb_evt ||
+      !but->rnaprop) return false;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || !wm->runtime) return false;
+  wmOperator *outer = WM_operator_last_redo(C);
+  if (!wm || !outer || BLI_findindex(&wm->runtime->operators, outer) == -1 ||
+      block->handle_func_arg != outer || but->rnapoin.owner_id != &wm->id) return false;
+  int budget = 256;
+  wmOperator *owner = ui_ipad_hud_operator_tree_owner(outer, but, budget);
+  if (!owner) return false;
+  const auto type = ui_ipad_operator_capture(owner->type);
+  if (!type.lifetime) return false;
+  wmOperatorType *registered_type = ui_ipad_operator_resolve(type);
+  if (!registered_type) return false;
+  PropertyRNA *property = nullptr;
+  /* Compare incoming metadata numerically to the fresh schema enumeration;
+   * never ask a potentially retired PropertyRNA for its identifier. */
+  RNA_STRUCT_BEGIN (owner->ptr, fresh) {
+    if (fresh == but->rnaprop) { property = fresh; break; }
+  }
+  RNA_STRUCT_END;
+  if (!property) return false;
+  const int length = RNA_property_array_length(owner->ptr, property);
+  if ((length && (but->rnaindex < 0 || but->rnaindex >= length)) ||
+      (!length && but->rnaindex != 0)) return false;
+  field.outer_address = uint64_t(uintptr_t(outer));
+  field.outer_lifetime = WM_operator_touch_lifetime_id(outer);
+  field.owner_address = uint64_t(uintptr_t(owner));
+  field.owner_lifetime = WM_operator_touch_lifetime_id(owner);
+  field.type = type; field.properties_address = uint64_t(uintptr_t(owner->properties));
+  field.property_address = uint64_t(uintptr_t(property));
+  field.property = RNA_property_identifier(property); field.index = but->rnaindex;
+  field.length = length; field.property_type = RNA_property_type(property);
+  field.native_property = field.outer_lifetime && field.owner_lifetime;
+  field.native_numeric = field.native_property && !registered_type->rna_ext.srna &&
+      ELEM(but->type, ButType::Num, ButType::NumSlider) &&
+      ELEM(field.property_type, PROP_FLOAT, PROP_INT) &&
+      (RNA_property_flag(property) & PROP_IDPROPERTY) &&
+      !but->func && !but->funcN && !but->apply_func && !but->optype && !but->rename_func &&
+      !but->rename_full_func && !but->identity_cmp_func;
+  return field.native_property;
+}
