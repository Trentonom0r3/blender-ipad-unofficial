+namespace {
+namespace policy = blender::ed::ipad::panels;
+using policy::Edge;
+using policy::Rect;
+
+constexpr int tools_id = 1000000;
+constexpr int shelf_id = 1000001;
+constexpr int category_first_id = 1000010;
+
+struct Tab {
+  int id;
+  Edge edge;
+  std::string label;
+  ScrArea *area = nullptr;
+  int region_type = 0;
+  std::string category;
+};
+
+struct NativeSeamControl {
+  policy::WorkingSeam seam;
+  bool fallback = false;
+  policy::WorkingAdjacency adjacency{};
+  ScrEdge *edge = nullptr;
+};
+
+/* Bind local fallback adjacency to an actual face edge, never merely a nearby
+ * collinear edge. The captured pointer is resolved again in the live snapshot. */
+static std::vector<policy::Area> working_controls(
+    bScreen *screen, const std::vector<policy::Area> &working, const Rect bounds,
+    std::vector<NativeSeamControl> &controls)
+{
+  std::vector<policy::WorkingSeam> partitions;
+  std::vector<policy::WorkingFallback> nodes;
+  auto displayed = policy::working_layout(working, bounds, int(4 * UI_SCALE_FAC),
+                                           &partitions, &nodes);
+  for (const auto &seam : partitions) { controls.push_back({seam, false, {}, nullptr}); }
+  std::vector<ScrArea *> areas;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) { areas.push_back(area); }
+  for (const auto &adj : policy::working_adjacencies(working, displayed, nodes)) {
+    if (adj.before_id < 0 || adj.after_id < 0 || adj.before_id >= int(areas.size()) ||
+        adj.after_id >= int(areas.size())) { continue; }
+    const ScrArea *before = areas[adj.before_id], *after = areas[adj.after_id];
+    ScrVert *a = adj.vertical ? before->v4 : before->v2;
+    ScrVert *b = before->v3;
+    ScrVert *c = after->v1;
+    ScrVert *d = adj.vertical ? after->v2 : after->v4;
+    ScrEdge *bound = nullptr;
+    LISTBASE_FOREACH (ScrEdge *, edge, &screen->edgebase) {
+      auto joins = [&](ScrVert *v, ScrVert *w) {
+        return (edge->v1 == v && edge->v2 == w) || (edge->v1 == w && edge->v2 == v);
+      };
+      if (!joins(a,b) && !joins(c,d)) { continue; }
+      const int x = adj.vertical ? edge->v1->vec.x : edge->v1->vec.y;
+      const int y = adj.vertical ? edge->v2->vec.x : edge->v2->vec.y;
+      const int u = adj.vertical ? edge->v1->vec.y : edge->v1->vec.x;
+      const int v = adj.vertical ? edge->v2->vec.y : edge->v2->vec.x;
+      if (x == adj.coordinate && y == x &&
+          std::min(std::max(u,v), adj.saved_max) > std::max(std::min(u,v), adj.saved_min)) {
+        bound = edge;
+        break;
+      }
+    }
+    if (!bound) { continue; }
+    Rect native_bounds = adj.node.saved_bounds;
+    --native_bounds.xmax;
+    --native_bounds.ymax;
+    controls.push_back({{adj.vertical, adj.coordinate, native_bounds, adj.node.display_bounds,
+                          adj.line, {}, {}}, true, adj, bound});
+  }
+  return displayed;
+}
+
+struct Model {
+  std::vector<ScrArea *> areas;
+  ScrArea *main = nullptr;
+  std::vector<Tab> tabs;
+  std::vector<policy::Area> working, inputs;
+  std::vector<NativeSeamControl> seams;
+  policy::State state;
+  policy::Metrics metrics;
+  policy::Layout layout;
+  Rect bounds;
+  bool sculpt = false;
+  bool object_mode = false;
+  bool default_sculpt_shelf = false;
+};
+
+static rcti to_rect(const Rect &rect)
+{
+  return {rect.xmin, std::max(rect.xmin, rect.xmax - 1),
+          rect.ymin, std::max(rect.ymin, rect.ymax - 1)};
+}
+
+static bool contains(const Rect &rect, const int xy[2])
+{
+  return xy[0] >= rect.xmin && xy[0] < rect.xmax && xy[1] >= rect.ymin && xy[1] < rect.ymax;
+}
+
+static const Tab *find_tab(const Model &model, int id)
+{
+  for (const Tab &tab : model.tabs) {
+    if (tab.id == id) {
+      return &tab;
+    }
+  }
+  return nullptr;
+}
+
+static std::string area_label(const ScrArea *area)
+{
+  if (area->spacetype == SPACE_OUTLINER) {
+    const auto *outliner = static_cast<const SpaceOutliner *>(area->spacedata.first);
+    return outliner && outliner->outlinevis == SO_DATA_API ? "Data" : "Scene";
+  }
+  if (area->spacetype == SPACE_PROPERTIES) {
+    return "Inspector";
+  }
+  if (area->spacetype == SPACE_ACTION) {
+    const SpaceAction *saction = static_cast<const SpaceAction *>(area->spacedata.first);
+    return saction && saction->mode == SACTCONT_TIMELINE ? "Timeline" : "Dope Sheet";
+  }
+  if (area->spacetype == SPACE_NODE) {
+    const auto *node = static_cast<const SpaceNode *>(area->spacedata.first);
+    if (node) {
+      if (STREQ(node->tree_idname, "GeometryNodeTree")) {
+        return "Geometry Nodes";
+      }
+      if (STREQ(node->tree_idname, "ShaderNodeTree")) {
+        return "Shader Editor";
+      }
+      if (STREQ(node->tree_idname, "CompositorNodeTree")) {
+        return "Compositor";
+      }
+    }
+  }
+  if (area->spacetype == SPACE_CLIP) {
+    const auto *clip = static_cast<const SpaceClip *>(area->spacedata.first);
+    if (clip) {
+      return clip->view == SC_VIEW_GRAPH ? "Tracking Graph" :
+             clip->view == SC_VIEW_DOPESHEET ? "Tracking Dopesheet" : "Footage";
+    }
+  }
+  if (area->spacetype == SPACE_SEQ) {
+    const auto *sequence = static_cast<const SpaceSeq *>(area->spacedata.first);
+    return sequence && sequence->view == SEQ_VIEW_PREVIEW ? "Preview" : "Sequencer";
+  }
+  return area->type ? area->type->name : "Editor";
+}
+
+static policy::Metrics panel_metrics(const ScrArea *owner, const ScrArea *side_editor = nullptr)
+{
+  policy::Metrics metrics;
+  const float scale = UI_SCALE_FAC;
+  metrics.inset = int(6 * scale);
+  metrics.gap = int(6 * scale);
+  metrics.side_rail_extent = int(44 * scale);
+  metrics.minimum_side_rail_extent = int(28 * scale);
+  metrics.bottom_rail = false;
+  const ARegion *tools = owner ? BKE_area_find_region_type(owner, RGN_TYPE_TOOLS) : nullptr;
+  metrics.tools_width = int((tools && tools->runtime->type ?
+                                tools->runtime->type->prefsizex : 40) * scale);
+  metrics.resize_extent = int(24 * scale);
+  metrics.corner_extent = int(44 * scale);
+  /* Inspector includes its native header, the labeled selector and corner chrome.
+   * Keep useful native content below them without enlarging other side editors. */
+  metrics.minimum_side_height = int((side_editor && side_editor->spacetype == SPACE_PROPERTIES ?
+                                        220 : 120) * scale);
+  metrics.minimum_canvas_width = int(160 * scale);
+  metrics.minimum_canvas_height = int(120 * scale);
+  const bool inspector = side_editor && side_editor->spacetype == SPACE_PROPERTIES;
+  metrics.minimum_side_width = int((inspector ? 280 : 180) * scale);
+  metrics.automatic_side_percent = inspector ? 35 : 45;
+  metrics.minimum_bottom_height = int(140 * scale);
+  metrics.minimum_bottom_width = int(320 * scale);
+  return metrics;
+}
+
+static bool inspector_side(const ScrArea *area)
+{
+  return area && area->spacetype == SPACE_PROPERTIES;
+}
+
+static float &saved_panel_size(bScreen *screen, const int panel, const bool inspector)
+{
+  return panel == 0 && inspector ? screen->ipad_inspector_width : screen->ipad_panel_size[panel];
+}
+
+static bool active_inspector_side(const Model &model)
+{
+  const Tab *tab = find_tab(model, model.state.side.active_id);
+  return tab && tab->region_type == 0 && inspector_side(tab->area);
+}
+
+static void preferred_sizes(const bScreen *screen, policy::State &state,
+                            const ScrArea *side_editor)
+{
+  auto size = [](float value) {
+    return std::isfinite(value) && value > 0 ?
+               int(std::clamp(value, 1.0f, 4000.0f) * UI_SCALE_FAC) : 0;
+  };
+  state.side_width = size(inspector_side(side_editor) ? screen->ipad_inspector_width :
+                                                     screen->ipad_panel_size[0]);
+  state.bottom_height = size(screen->ipad_panel_size[1]);
+  state.side_height = size(screen->ipad_panel_extent[0]);
+  state.bottom_width = size(screen->ipad_panel_extent[1]);
+}
+
+static Rect content_bounds(const wmWindow *win, const ScrArea *main)
+{
+  /* Headers and tool headers have already been laid out by Blender. Their count,
+   * alignment and height vary by workspace, mode and user configuration. */
+  const ARegion *region = BKE_area_find_region_type(main, RGN_TYPE_WINDOW);
+  if (region && region->winx > 1 && region->winy > 1) {
+    Rect bounds{region->winrct.xmin, region->winrct.ymin,
+                region->winrct.xmax + 1, region->winrct.ymax + 1};
+    /* An overlapping Sculpt tool header does not reduce WINDOW.winrct. Reserve
+     * its actual edge rectangle too, without querying our panel-aware visible
+     * rectangle (which would feed the previous panel layout back into itself). */
+    LISTBASE_FOREACH (const ARegion *, header, &main->regionbase) {
+      if (!ELEM(header->regiontype, RGN_TYPE_HEADER, RGN_TYPE_TOOL_HEADER, RGN_TYPE_FOOTER) ||
+          (header->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED)) ||
+          header->winx <= 1 || header->winy <= 1)
+      {
+        continue;
+      }
+      const rcti &rect = header->winrct;
+      const int alignment = RGN_ALIGN_ENUM_FROM_MASK(header->alignment);
+      if (rect.xmin < bounds.xmax && rect.xmax >= bounds.xmin) {
+        if (alignment == RGN_ALIGN_TOP && rect.ymax >= bounds.ymax - 2) {
+          bounds.ymax = std::max(bounds.ymin, std::min(bounds.ymax, rect.ymin));
+        }
+        else if (alignment == RGN_ALIGN_BOTTOM && rect.ymin <= bounds.ymin + 1) {
+          bounds.ymin = std::min(bounds.ymax, std::max(bounds.ymin, rect.ymax + 1));
+        }
+      }
+      if (rect.ymin < bounds.ymax && rect.ymax >= bounds.ymin) {
+        if (alignment == RGN_ALIGN_LEFT && rect.xmin <= bounds.xmin + 1) {
+          bounds.xmin = std::min(bounds.xmax, std::max(bounds.xmin, rect.xmax + 1));
+        }
+        else if (alignment == RGN_ALIGN_RIGHT && rect.xmax >= bounds.xmax - 2) {
+          bounds.xmax = std::max(bounds.xmin, std::min(bounds.xmax, rect.xmin));
+        }
+      }
+    }
+    return bounds;
+  }
+  rcti rect;
+  WM_window_screen_rect_calc(win, &rect);
+  return {rect.xmin, rect.ymin, rect.xmax, rect.ymax};
+}
+
+static Rect workspace_content_bounds(const wmWindow *win, const std::vector<ScrArea *> &areas)
+{
+  Rect result;
+  bool initialized = false;
+  for (const ScrArea *area : areas) {
+    const Rect rect = content_bounds(win, area);
+    if (rect.empty()) {
+      continue;
+    }
+    if (!initialized) {
+      result = rect;
+      initialized = true;
+    }
+    else {
+      result.xmin = std::min(result.xmin, rect.xmin);
+      result.ymin = std::min(result.ymin, rect.ymin);
+      result.xmax = std::max(result.xmax, rect.xmax);
+      result.ymax = std::max(result.ymax, rect.ymax);
+    }
+  }
+  return result;
+}
+
+/* Launcher ranks belong to editor identity or a stable native category name. */
+static int *launcher_rank(bScreen *screen, const Tab &tab, const bool create)
+{
+  if (tab.region_type == 0) { return &tab.area->ipad_launcher_order; }
+  const int kind = tab.id == tools_id ? 1 : tab.id == shelf_id ? 2 : 3;
+  LISTBASE_FOREACH (iPadPanelOrder *, entry, &screen->ipad_panel_order) {
+    if (entry->kind == kind && (kind != 3 || tab.category == entry->category)) { return &entry->rank; }
+  }
+  if (!create) { return nullptr; }
+  auto *entry = MEM_callocN<iPadPanelOrder>(__func__);
+  entry->kind = kind;
+  STRNCPY(entry->category, tab.category.c_str());
+  BLI_addtail(&screen->ipad_panel_order, entry);
+  return &entry->rank;
+}
+
+static std::string launcher_key(const Tab &tab)
+{
+  if (tab.region_type == 0) { return "editor:" + std::to_string(tab.area->runtime.ipad_launcher_session); }
+  if (tab.id == tools_id) { return "tools"; }
+  if (tab.id == shelf_id) { return "shelf"; }
+  return "category:" + tab.category;
+}
+
+static std::string launcher_signature(const bScreen *screen, const Model &model)
+{
+  std::string result = std::to_string(screen->id.session_uid) + ":" + std::to_string(screen->ipad_panel_owner);
+  LISTBASE_FOREACH (const ScrArea *, area, &screen->areabase) {
+    result += ":" + std::to_string(area->runtime.ipad_launcher_session) + "/" + std::to_string(area->spacetype);
+  }
+  result += ":owner=" + std::to_string(model.main ? model.main->runtime.ipad_launcher_session : 0);
+  for (const Tab &tab : model.tabs) {
+    const auto key = launcher_key(tab);
+    result += ":" + std::to_string(key.size()) + ":" + key;
+  }
+  return result;
+}
+
+static bool move_launcher(bScreen *screen, const Model &model, const std::string &key,
+                          const std::string &signature, const int direction)
+{
+  if (signature != launcher_signature(screen, model) || (direction != -1 && direction != 1)) { return false; }
+  const auto found = std::find_if(model.tabs.begin(), model.tabs.end(), [&](const Tab &tab) {
+    return launcher_key(tab) == key;
+  });
+  if (found == model.tabs.end()) { return false; }
+  std::vector<const Tab *> rail;
+  for (const Tab &tab : model.tabs) {
+    if ((tab.edge == Edge::Side) == (found->edge == Edge::Side)) { rail.push_back(&tab); }
+  }
+  const int index = int(std::find(rail.begin(), rail.end(), &*found) - rail.begin());
+  const int target = index + direction;
+  if (target < 0 || target >= int(rail.size())) { return false; }
+  /* Normalize all saved ranks, including currently hidden launchers. New visible
+   * entries append in natural order. Swap visible positions without discarding
+   * hidden records or modifying editor content, lock or size state. */
+  std::vector<int *> ranked;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (area->ipad_launcher_order > 0) { ranked.push_back(&area->ipad_launcher_order); }
+  }
+  LISTBASE_FOREACH (iPadPanelOrder *, entry, &screen->ipad_panel_order) {
+    if (entry->rank > 0) { ranked.push_back(&entry->rank); }
+  }
+  std::stable_sort(ranked.begin(), ranked.end(), [](const int *a, const int *b) { return *a < *b; });
+  for (const Tab &tab : model.tabs) {
+    int *rank = launcher_rank(screen, tab, true);
+    if (std::find(ranked.begin(), ranked.end(), rank) == ranked.end()) { ranked.push_back(rank); }
+  }
+  for (size_t i = 0; i < ranked.size(); ++i) { *ranked[i] = int(i + 1); }
+  std::swap(*launcher_rank(screen, *rail[index], false), *launcher_rank(screen, *rail[target], false));
+  return true;
+}
+
+static void sort_launchers(bScreen *screen, Model &model)
+{
+  std::stable_sort(model.tabs.begin(), model.tabs.end(), [&](const Tab &a, const Tab &b) {
+    const int *ra = launcher_rank(screen, a, false), *rb = launcher_rank(screen, b, false);
+    return (ra && *ra > 0 ? *ra : INT_MAX) < (rb && *rb > 0 ? *rb : INT_MAX);
+  });
+}
+
+static Model make_model(bContext *C, wmWindow *win)
+{
+  Model model;
+  bScreen *screen = WM_window_get_active_screen(win);
+  std::vector<policy::Area> inputs;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    static uint64_t next_launcher_session = 1;
+    if (area->runtime.ipad_launcher_session == 0) { area->runtime.ipad_launcher_session = next_launcher_session++; }
+    const int id = int(model.areas.size());
+    model.areas.push_back(area);
+    const bool service = ELEM(area->spacetype, SPACE_OUTLINER, SPACE_PROPERTIES, SPACE_FILE);
+    const auto *clip = area->spacetype == SPACE_CLIP ?
+                          static_cast<const SpaceClip *>(area->spacedata.first) : nullptr;
+    inputs.push_back({id,
+                      {area->v1->vec.x, area->v1->vec.y,
+                       area->v4->vec.x + 1, area->v2->vec.y + 1},
+                      area->ipad_keep_working ? policy::Role::Working :
+                      clip && clip->view == SC_VIEW_CLIP ? policy::Role::Canvas :
+                      service ? policy::Role::Service : policy::Role::Content});
+  }
+  model.inputs = inputs;
+  const policy::Mapping mapping = policy::classify(inputs, int(2 * UI_SCALE_FAC));
+  if (mapping.primary_id < 0) {
+    return model;
+  }
+  model.main = model.areas[mapping.primary_id];
+  model.working = mapping.working;
+  rcti workspace;
+  WM_window_screen_rect_calc(win, &workspace);
+  working_controls(screen, model.working,
+                   {workspace.xmin, workspace.ymin, workspace.xmax, workspace.ymax}, model.seams);
+  std::vector<ScrArea *> working_areas;
+  for (const policy::Area &working : model.working) {
+    ScrArea *area = model.areas[working.id];
+    working_areas.push_back(area);
+    if (screen->ipad_panel_owner == working.id + 1) {
+      model.main = area;
+    }
+  }
+  model.bounds = workspace_content_bounds(win, working_areas);
+
+  ScrArea *previous_area = CTX_wm_area(C);
+  ARegion *previous_region = CTX_wm_region(C);
+  CTX_wm_area_set(C, model.main);
+  ARegion *sidebar = BKE_area_find_region_type(model.main, RGN_TYPE_UI);
+  if (sidebar && !(sidebar->flag & RGN_FLAG_POLL_FAILED) && !sidebar->runtime->type) {
+    /* File load precedes region type initialization. Preserve a saved category
+     * until Blender can poll its native panels during the first layout. */
+    const std::string category = screen->ipad_panel_active[0] == -1 ?
+                                     screen->ipad_panel_category : "";
+    model.tabs.push_back({category_first_id, Edge::Side,
+                          category.empty() ? "Sidebar" : category,
+                          model.main, RGN_TYPE_UI, category});
+  }
+  if (sidebar && !(sidebar->flag & RGN_FLAG_POLL_FAILED) && sidebar->runtime->type) {
+    CTX_wm_region_set(C, sidebar);
+    std::vector<std::string> categories;
+    LISTBASE_FOREACH (PanelType *, pt, &sidebar->runtime->type->paneltypes) {
+      if (!pt->category[0] || !ED_ipad_panel_category_poll(C, pt)) {
+        continue;
+      }
+      if (std::find(categories.begin(), categories.end(), pt->category) == categories.end()) {
+        categories.emplace_back(pt->category);
+        model.tabs.push_back({category_first_id + int(categories.size()), Edge::Side,
+                              pt->category, model.main, RGN_TYPE_UI, pt->category});
+      }
+    }
+    if (categories.empty()) {
+      model.tabs.push_back({category_first_id, Edge::Side, "Sidebar", model.main, RGN_TYPE_UI, ""});
+    }
+  }
+  ARegion *tools = BKE_area_find_region_type(model.main, RGN_TYPE_TOOLS);
+  if (tools && !(tools->flag & RGN_FLAG_POLL_FAILED)) {
+    model.tabs.push_back({tools_id, Edge::Tools, "Tools", model.main, RGN_TYPE_TOOLS, ""});
+  }
+  const char *mode = CTX_data_mode_string(C);
+  model.sculpt = model.main->spacetype == SPACE_VIEW3D && mode && STREQ(mode, "SCULPT");
+  model.object_mode = model.main->spacetype == SPACE_VIEW3D && mode && STREQ(mode, "OBJECT");
+  ARegion *shelf = BKE_area_find_region_type(model.main, RGN_TYPE_ASSET_SHELF);
+  if (shelf && !(shelf->flag & RGN_FLAG_POLL_FAILED)) {
+    model.tabs.push_back({shelf_id, Edge::Bottom, "Brushes", model.main, RGN_TYPE_ASSET_SHELF, ""});
+  }
+  CTX_wm_area_set(C, previous_area);
+  CTX_wm_region_set(C, previous_region);
+  for (const policy::Panel &panel : mapping.panels) {
+    ScrArea *area = model.areas[panel.id];
+    model.tabs.push_back({panel.id, panel.edge, area_label(area), area, 0, ""});
+  }
+  for (int axis = 0; axis < 2; axis++) {
+    const Edge edge = axis == 0 ? Edge::Side : Edge::Bottom;
+    for (const Tab &tab : model.tabs) {
+      const int saved = screen->ipad_panel_active[axis];
+      const bool match = tab.region_type == 0 ? saved == tab.id + 1 :
+                         tab.region_type == RGN_TYPE_UI ?
+                             saved == -1 && tab.category == screen->ipad_panel_category :
+                         tab.region_type == RGN_TYPE_TOOLS ? saved == -2 : saved == -3;
+      if (edge == tab.edge && match) {
+        model.state.slot(edge) = {tab.id, false};
+        break;
+      }
+    }
+  }
+  /* Migrate the old per-edge pins and right-side Tools selection on first save. */
+  model.state.panels_locked = screen->ipad_panels_locked ||
+                             screen->ipad_panel_locked[0] || screen->ipad_panel_locked[1];
+  if ((screen->ipad_tools_open || screen->ipad_panel_active[0] == -2) && find_tab(model, tools_id)) {
+    model.state.tools.active_id = tools_id;
+  }
+  if (!screen->ipad_panel_initialized) {
+    /* Honor native startup visibility on first adaptation. In particular Sculpt
+     * must not lose its open brush shelf merely because tablet slots start at 0. */
+    if (!model.state.tools.open() && tools && !(tools->flag & RGN_FLAG_HIDDEN) &&
+        find_tab(model, tools_id)) {
+      model.state.tools.active_id = tools_id;
+    }
+    if (!model.state.bottom.open() && shelf && !(shelf->flag & RGN_FLAG_HIDDEN) &&
+        find_tab(model, shelf_id)) {
+      model.state.bottom.active_id = shelf_id;
+    }
+  }
+  model.default_sculpt_shelf = policy::open_default_sculpt_shelf(
+      model.state, model.sculpt, screen->ipad_sculpt_shelf_initialized,
+      find_tab(model, shelf_id) != nullptr, shelf_id);
+  const Tab *side_tab = find_tab(model, model.state.side.active_id);
+  preferred_sizes(screen, model.state,
+                  side_tab && side_tab->region_type == 0 ? side_tab->area : nullptr);
+  model.metrics = panel_metrics(model.main,
+                                side_tab && side_tab->region_type == 0 ? side_tab->area : nullptr);
+  model.layout = policy::layout(model.bounds, model.state, model.metrics);
+  sort_launchers(screen, model);
+  return model;
+}
+
+static void save_slot(bScreen *screen, const Model &model, Edge edge)
+{
+  screen->ipad_panel_initialized = 1;
+  if (model.sculpt && find_tab(model, shelf_id)) {
+    screen->ipad_sculpt_shelf_initialized = 1;
+  }
+  screen->ipad_panels_locked = model.state.panels_locked;
+  screen->ipad_panel_locked[0] = screen->ipad_panel_locked[1] = 0;
+  screen->ipad_tools_open = model.state.tools.open();
+  if (screen->ipad_panel_active[0] == -2) {
+    screen->ipad_panel_active[0] = 0;
+  }
+  if (edge == Edge::Tools) {
+    return;
+  }
+  const int axis = edge == Edge::Side ? 0 : 1;
+  const policy::Slot &slot = model.state.slot(edge);
+  const Tab *tab = find_tab(model, slot.active_id);
+  screen->ipad_panel_active[axis] = !tab ? 0 :
+                                   tab->region_type == 0 ? tab->id + 1 :
+                                   tab->region_type == RGN_TYPE_UI ? -1 :
+                                   tab->region_type == RGN_TYPE_TOOLS ? -2 : -3;
+  if (tab && tab->region_type == RGN_TYPE_UI) {
+    STRNCPY(screen->ipad_panel_category, tab->category.c_str());
+    if (!tab->category.empty()) {
+      UI_panel_category_active_set(BKE_area_find_region_type(tab->area, RGN_TYPE_UI),
+                                   tab->category.c_str());
+    }
+  }
+}
+
+static Rect panel_content(const Model &model, Edge edge)
+{
+  return policy::panel_content(model.layout, edge);
+}
+
+enum class Action { Tab, ToolHeader, Previous, Next, Resize, Lock, Seam };
+struct Button {
+  Rect rect;
+  std::string label;
+  Action action;
+  Edge edge;
+  int id = -1;
+  bool selected = false;
+  bool native = false;
+};
+
+static std::vector<Button> buttons(const Model &model, const bScreen *screen)
+{
+  std::vector<Button> result;
+  ARegion *tool_header = model.main && model.main->spacetype == SPACE_VIEW3D ?
+                             BKE_area_find_region_type(model.main, RGN_TYPE_TOOL_HEADER) : nullptr;
+  for (const bool left : {false, true}) {
+    Rect rail = left ? model.layout.left_rail : model.layout.side_rail;
+    std::vector<const Tab *> tabs;
+    bool tool_header_added = false;
+    for (const Tab &tab : model.tabs) {
+      if ((tab.edge != Edge::Side) == left) {
+        tabs.push_back(&tab);
+        if (left && tool_header && tab.id == tools_id) {
+          /* Reopen Blender's complete native tool row without leaving it above
+           * the canvas when the iPad workspace first opens. */
+          tabs.push_back(nullptr);
+          tool_header_added = true;
+        }
+      }
+    }
+    if (left && tool_header && !tool_header_added) {
+      tabs.insert(tabs.begin(), nullptr);
+    }
+    const uiFontStyle *font = &UI_style_get_dpi()->widget;
+    UI_fontstyle_set(font);
+    int label_extent = int(44 * UI_SCALE_FAC);
+    for (const Tab *tab : tabs) {
+      label_extent = std::max(label_extent,
+                              int(std::ceil(BLF_width(font->uifont_id,
+                                                      tab ? tab->label.c_str() : "Settings",
+                                                      tab ? tab->label.size() : 8) +
+                                            20 * UI_SCALE_FAC)));
+    }
+    const policy::RailPage page = policy::rail_page(
+        tabs.size(), rail.height(), std::max(0, screen->ipad_panel_page[left ? 1 : 0]),
+        label_extent, int(4 * UI_SCALE_FAC));
+    int offset = 0;
+    auto add = [&](const std::string &label, Action action, Edge edge, int id, bool selected) {
+      Rect rect = rail;
+      rect.ymax -= offset;
+      rect.ymin = rect.ymax - page.button_extent;
+      result.push_back({rect, label, action, edge, id, selected});
+      offset += page.button_extent + page.gap;
+    };
+    const Edge page_edge = left ? Edge::Bottom : Edge::Side;
+    if (page.paged) {
+      add("Prev", Action::Previous, page_edge, int(page.page > 0 ? page.page - 1 : 0), false);
+    }
+    for (size_t i = page.first; i < page.first + page.count; i++) {
+      const Tab *tab = tabs[i];
+      if (tab) {
+        add(tab->label, Action::Tab, tab->edge, tab->id,
+            model.state.slot(tab->edge).active_id == tab->id);
+      }
+      else {
+        add("Settings", Action::ToolHeader, Edge::Tools, -1,
+            !(tool_header->flag & RGN_FLAG_HIDDEN_BY_USER));
+      }
+    }
+    if (page.paged) {
+      add("Next", Action::Next, page_edge, int(std::min(page.page + 1, page.pages - 1)), false);
+    }
+  }
+  /* Editors without a navigation gizmo keep the same global lock reachable. */
+  const bool native_pin = std::any_of(model.areas.begin(), model.areas.end(),
+                                      [&](const ScrArea *area) {
+                                        return ED_ipad_panels_native_pin(screen, area);
+                                      });
+  if (native_pin) {
+    for (const ScrArea *area : model.areas) {
+      if (ED_ipad_panels_native_pin(screen, area)) {
+        const rcti &r = area->runtime.ipad_pin_rect;
+        if (r.xmax > r.xmin && r.ymax > r.ymin) {
+          result.push_back({{r.xmin, r.ymin, r.xmax + 1, r.ymax + 1}, "", Action::Lock,
+                             Edge::Side, -1, model.state.panels_locked, true});
+        }
+      }
+    }
+  }
+  if (model.main && !native_pin) {
+    const int size = std::min(int(32 * UI_SCALE_FAC), model.layout.canvas.width());
+    const Rect &canvas = model.layout.canvas;
+    result.push_back({{canvas.xmax - size, std::max(canvas.ymin, canvas.ymax - size),
+                        canvas.xmax, canvas.ymax},
+                       "", Action::Lock, Edge::Side, -1, model.state.panels_locked});
+  }
+  for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+    if (model.state.slot(edge).open()) {
+      const Rect resize = edge == Edge::Side ? model.layout.side_resize : model.layout.bottom_resize;
+      const Rect corner = edge == Edge::Side ? model.layout.side_corner : model.layout.bottom_corner;
+      result.push_back({corner, "", Action::Resize, edge, 1});
+      result.push_back({resize, "", Action::Resize, edge});
+    }
+  }
+  /* Local grips keep the rest of each seam available to native editor UI.
+   * Never place a hit target over panels, rails or another chrome control. */
+  std::vector<Rect> occluders{model.layout.side_panel, model.layout.bottom_panel,
+                              model.layout.tools_panel, model.layout.left_rail, model.layout.side_rail};
+  for (const Button &button : result) { occluders.push_back(button.rect); }
+  for (const ScrArea *area : model.areas) {
+    if (area->runtime.ipad_layer != 1) { continue; }
+    LISTBASE_FOREACH (const ARegion *, region, &area->regionbase) {
+      if (region->runtime->visible &&
+          ELEM(region->regiontype, RGN_TYPE_HEADER, RGN_TYPE_TOOL_HEADER, RGN_TYPE_FOOTER)) {
+        occluders.push_back({region->winrct.xmin, region->winrct.ymin,
+                             region->winrct.xmax + 1, region->winrct.ymax + 1});
+      }
+    }
+    occluders.push_back({area->runtime.ipad_navigation_rect.xmin,
+                         area->runtime.ipad_navigation_rect.ymin,
+                         area->runtime.ipad_navigation_rect.xmax + 1,
+                         area->runtime.ipad_navigation_rect.ymax + 1});
+  }
+  for (size_t i = 0; !(U.app_flag & USER_APP_LOCK_EDGE_RESIZE) && i < model.seams.size(); ++i) {
+    const auto &seam = model.seams[i].seam;
+    const int extent = int(44 * UI_SCALE_FAC);
+    const bool native_edge = [&]() {
+      LISTBASE_FOREACH (const ScrEdge *, edge, &screen->edgebase) {
+        const int a = seam.vertical ? edge->v1->vec.x : edge->v1->vec.y;
+        const int b = seam.vertical ? edge->v2->vec.x : edge->v2->vec.y;
+        const int u = seam.vertical ? edge->v1->vec.y : edge->v1->vec.x;
+        const int v = seam.vertical ? edge->v2->vec.y : edge->v2->vec.x;
+        const int start = seam.vertical ? seam.saved_bounds.ymin : seam.saved_bounds.xmin;
+        const int end = seam.vertical ? seam.saved_bounds.ymax : seam.saved_bounds.xmax;
+        if (a == seam.coordinate && b == a && u != v &&
+            std::max(u,v) > start && std::min(u,v) < end) { return true; }
+      }
+      return false;
+    }();
+    if (!native_edge) { continue; }
+    const Rect handle = policy::seam_handle_rect(seam, model.bounds, occluders, extent);
+    if (!handle.empty()) {
+      result.push_back({handle, "", Action::Seam,
+                         seam.vertical ? Edge::Side : Edge::Bottom, int(i)});
+      occluders.push_back(handle);
+    }
+  }
+  return result;
+}
+
+static void tag_layout(bContext *C, wmWindow *win, const bool refresh_cursor = true)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  screen->do_refresh = true;
+  screen->do_draw = true;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    ED_area_tag_redraw(area);
+  }
+  LISTBASE_FOREACH (ScrArea *, area, &win->global_areas.areabase) {
+    if (area->spacetype == SPACE_STATUSBAR) {
+      ED_area_tag_redraw(area);
+    }
+  }
+  if (refresh_cursor) {
+    WM_event_add_mousemove(win);
+  }
+  /* Refresh before the next queued input event can use the old hit rectangles. */
+  ED_screen_ensure_updated(C, CTX_wm_manager(C), win);
+}
+
+static void activate_button(bContext *C, wmWindow *win, Model &model, const Button &button)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  const int axis = button.edge == Edge::Side ? 0 : 1;
+  if (button.action == Action::Lock) {
+    model.state.toggle_panels_lock();
+    save_slot(screen, model, Edge::Tools);
+  }
+  else if (button.action == Action::Tab) {
+    model.state.tap(button.edge, button.id);
+    save_slot(screen, model, button.edge);
+  }
+  else if (button.action == Action::ToolHeader) {
+    ARegion *header = model.main ?
+                          BKE_area_find_region_type(model.main, RGN_TYPE_TOOL_HEADER) : nullptr;
+    if (header) {
+      ScrArea *previous_area = CTX_wm_area(C);
+      ARegion *previous_region = CTX_wm_region(C);
+      CTX_wm_area_set(C, model.main);
+      CTX_wm_region_set(C, header);
+      /* Match SpaceView3D.show_region_tool_header: its getter reads the user
+       * flag while its setter updates both flags. Keep native RNA, saving and
+       * workspace switching consistent with the rail's selected state. */
+      if (header->flag & RGN_FLAG_HIDDEN_BY_USER) {
+        header->flag &= ~(RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER);
+      }
+      else {
+        header->flag |= RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER;
+      }
+      ED_region_visibility_change_update(C, model.main, header);
+      CTX_wm_area_set(C, previous_area);
+      CTX_wm_region_set(C, previous_region);
+    }
+  }
+  else if (ELEM(button.action, Action::Previous, Action::Next)) {
+    screen->ipad_panel_page[axis] = button.id;
+  }
+  tag_layout(C, win);
+}
+
+static void draw_box(const Rect &rect, const char *label, bool selected, bool hovered = false)
+{
+  if (rect.empty()) {
+    return;
+  }
+  float color[4];
+  UI_GetThemeColor4fv(selected || hovered ? TH_TAB_ACTIVE : TH_TAB_INACTIVE, color);
+  color[3] = 1.0f;
+  rctf box = {float(rect.xmin), float(rect.xmax), float(rect.ymin), float(rect.ymax)};
+  UI_draw_roundbox_corner_set(UI_CNR_ALL);
+  UI_draw_roundbox_4fv(&box, true, 6 * UI_SCALE_FAC, color);
+  if (selected && label && label[0]) {
+    float accent[4];
+    UI_GetThemeColor4fv(TH_TAB_OUTLINE_ACTIVE, accent);
+    accent[3] = 1.0f;
+    rctf mark = {box.xmin, box.xmin + 3 * UI_SCALE_FAC,
+                 box.ymin + 7 * UI_SCALE_FAC, box.ymax - 7 * UI_SCALE_FAC};
+    UI_draw_roundbox_4fv(&mark, true, UI_SCALE_FAC, accent);
+  }
+  if (label && label[0]) {
+    const uiStyle *style = UI_style_get_dpi();
+    uchar text_color[4];
+    UI_GetThemeColor4ubv(selected ? TH_TAB_TEXT_HI : TH_TAB_TEXT, text_color);
+    /* Match the direction and font of Blender's native right sidebar tabs. */
+    const uiFontStyle *font = &style->widget;
+    UI_fontstyle_set(font);
+    const int fontid = font->uifont_id;
+    /* BLF clipping is evaluated before rotation: a narrow screen-space clip
+     * rectangle cuts almost every glyph. Fit text first, like native tabs. */
+    BLF_disable(fontid, BLF_CLIPPING);
+    std::string fitted = label;
+    const float available = std::max(0.0f, rect.height() - 16 * UI_SCALE_FAC);
+    if (BLF_width(fontid, fitted.c_str(), fitted.size()) > available) {
+      const std::string suffix = "...";
+      while (!fitted.empty() &&
+             BLF_width(fontid, (fitted + suffix).c_str(), fitted.size() + suffix.size()) > available)
+      {
+        size_t last = fitted.size() - 1;
+        while (last && (static_cast<unsigned char>(fitted[last]) & 0xc0) == 0x80) {
+          last--;
+        }
+        fitted.resize(last);
+      }
+      fitted += suffix;
+      if (BLF_width(fontid, fitted.c_str(), fitted.size()) > available) {
+        fitted.clear();
+      }
+    }
+    BLF_enable(fontid, BLF_ROTATION);
+    BLF_rotation(fontid, -float(M_PI_2));
+    const float length = BLF_width(fontid, fitted.c_str(), fitted.size());
+    const float padding = std::max(6 * UI_SCALE_FAC, (rect.height() - length) * 0.5f);
+    BLF_position(fontid, (rect.xmin + rect.xmax) * 0.5f - font->points * UI_SCALE_FAC * 0.35f,
+                 rect.ymax - padding, 0.0f);
+    BLF_color4ubv(fontid, text_color);
+    BLF_draw(fontid, fitted.c_str(), fitted.size());
+    BLF_disable(fontid, BLF_ROTATION);
+  }
+}
+
+struct ResizeData {
+  unsigned int screen_uid;
+  wmWindow *window;
+  int axis;
+  int start[2];
+  float original;
+  float initial_size;
+  float original_extent;
+  float initial_extent;
+  policy::Rect bounds;
+  bool inspector_width;
+};
+
+static wmOperatorStatus resize_invoke(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  bScreen *screen = CTX_wm_screen(C);
+  if (!ED_ipad_panels_enabled(screen)) {
+    return OPERATOR_CANCELLED;
+  }
+  const int axis = RNA_int_get(op->ptr, "axis");
+  if (!CTX_wm_window(C) || axis < 0 || axis > 3) {
+    return OPERATOR_CANCELLED;
+  }
+  const int panel = axis % 2;
+  const Model model = make_model(C, CTX_wm_window(C));
+  if (!model.main || !model.state.slot(panel == 0 ? Edge::Side : Edge::Bottom).open()) {
+    return OPERATOR_CANCELLED;
+  }
+  const float displayed = panel == 0 ? model.layout.side_panel.width() : model.layout.bottom_panel.height();
+  const float extent = panel == 0 ? model.layout.side_panel.height() : model.layout.bottom_panel.width();
+  op->customdata = MEM_new<ResizeData>(__func__, ResizeData{screen->id.session_uid, CTX_wm_window(C),
+                                                          axis, {event->xy[0], event->xy[1]},
+                                                          saved_panel_size(screen, panel, panel == 0 && active_inspector_side(model)),
+                                                          displayed / UI_SCALE_FAC,
+                                                          screen->ipad_panel_extent[panel], extent / UI_SCALE_FAC,
+                                                          model.bounds, panel == 0 && active_inspector_side(model)});
+  WM_event_add_modal_handler(C, op);
+  return OPERATOR_RUNNING_MODAL;
+}
+
+/* Resolve IDs through the live Main before restoring anything. The active screen
+ * can change while a modal drag is pending, and project loading can free its owner. */
+static bScreen *resize_owner(bContext *C, const ResizeData &data)
+{
+  if (Main *bmain = CTX_data_main(C)) {
+    LISTBASE_FOREACH (bScreen *, screen, &bmain->screens) {
+      if (screen->id.session_uid == data.screen_uid) {
+        return screen;
+      }
+    }
+  }
+  return nullptr;
+}
+
+static void resize_cancel(bContext *C, wmOperator *op)
+{
+  auto *data = static_cast<ResizeData *>(op->customdata);
+  if (data) {
+    if (bScreen *screen = resize_owner(C, *data)) {
+      saved_panel_size(screen, data->axis % 2, data->inspector_width) = data->original;
+      if (data->axis >= 2) { screen->ipad_panel_extent[data->axis % 2] = data->original_extent; }
+      screen->do_refresh = true;
+      screen->do_draw = true;
+      if (CTX_wm_window(C) && CTX_wm_screen(C) == screen) {
+        tag_layout(C, CTX_wm_window(C));
+      }
+    }
+    MEM_delete(data);
+    op->customdata = nullptr;
+  }
+}
+
+static wmOperatorStatus resize_modal(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  auto *data = static_cast<ResizeData *>(op->customdata);
+  if (!data) {
+    return OPERATOR_CANCELLED;
+  }
+  bScreen *screen = resize_owner(C, *data);
+  if (!screen || CTX_wm_screen(C) != screen || CTX_wm_window(C) != data->window ||
+      !ED_ipad_panels_enabled(screen))
+  {
+    resize_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  Model model = make_model(C, CTX_wm_window(C));
+  const int panel = data->axis % 2;
+  const auto &old = data->bounds;
+  if (!model.main || !model.state.slot(panel == 0 ? Edge::Side : Edge::Bottom).open() ||
+      (panel == 0 && active_inspector_side(model) != data->inspector_width) ||
+      model.bounds.xmin != old.xmin || model.bounds.xmax != old.xmax ||
+      model.bounds.ymin != old.ymin || model.bounds.ymax != old.ymax) {
+    resize_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if ((event->flag & WM_EVENT_IS_POINTER_CANCEL) ||
+      ELEM(event->type, EVT_ESCKEY, RIGHTMOUSE, WINDEACTIVATE)) {
+    resize_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type == LEFTMOUSE && event->val == KM_RELEASE) {
+    MEM_delete(data);
+    op->customdata = nullptr;
+    return OPERATOR_FINISHED;
+  }
+  if (ELEM(event->type, MOUSEMOVE, INBETWEEN_MOUSEMOVE)) {
+    const float delta = (event->xy[panel] - data->start[panel]) / UI_SCALE_FAC;
+    const float requested = data->initial_size + (panel == 0 ? -delta : delta);
+    const Edge edge = panel == 0 ? Edge::Side : Edge::Bottom;
+    if (data->axis >= 2) {
+      const float delta_other = (event->xy[1-panel] - data->start[1-panel]) / UI_SCALE_FAC;
+      const float extent = data->initial_extent + (panel == 0 ? -delta_other : delta_other);
+      policy::resize_2d(model.state, edge,
+                       int((panel == 0 ? requested : extent) * UI_SCALE_FAC),
+                       int((panel == 0 ? extent : requested) * UI_SCALE_FAC), model.bounds, model.metrics);
+      screen->ipad_panel_extent[panel] =
+          (panel == 0 ? model.state.side_height : model.state.bottom_width) / UI_SCALE_FAC;
+    }
+    else {
+      policy::resize(model.state, edge, int(requested * UI_SCALE_FAC), model.bounds, model.metrics);
+    }
+    saved_panel_size(screen, panel, data->inspector_width) =
+        (panel == 0 ? model.state.side_width : model.state.bottom_height) / UI_SCALE_FAC;
+    tag_layout(C, CTX_wm_window(C));
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
+struct SeamDragData {
+  unsigned int uid;
+  wmWindow *window;
+  policy::WorkingSeam seam;
+  bool fallback = false;
+  policy::WorkingAdjacency adjacency{};
+  std::vector<policy::WorkingAdjacency> adjacencies;
+  std::vector<policy::WorkingSeam> partitions;
+  int start, delta = 0;
+  int original_owner = 0, captured_owner = 0;
+  Rect bounds;
+  std::vector<ScrVert *> vertices;
+  std::vector<policy::SeamVertex> original, last;
+  std::vector<ScrArea *> areas;
+  std::vector<ScrEdge *> edges;
+  std::vector<policy::SeamEdge> edge_indices;
+  std::vector<policy::SeamFace> faces;
+  std::vector<bool> selected;
+  std::vector<policy::Area> working, displayed, inputs;
+  policy::SeamLimits limits;
+};
+
+static bScreen *seam_owner(bContext *C, const SeamDragData &data)
+{
+  if (Main *bmain = CTX_data_main(C)) {
+    LISTBASE_FOREACH (bScreen *, screen, &bmain->screens) {
+      if (screen->id.session_uid == data.uid) { return screen; }
+    }
+  }
+  return nullptr;
+}
+
+static bool seam_snapshot_matches(const bScreen *screen, const SeamDragData &data,
+                                   const bool coordinates = true)
+{
+  size_t i = 0;
+  LISTBASE_FOREACH (ScrVert *, vertex, &screen->vertbase) {
+    if (i >= data.vertices.size() || vertex != data.vertices[i] ||
+        (coordinates && (vertex->vec.x != data.last[i].x || vertex->vec.y != data.last[i].y))) { return false; }
+    ++i;
+  }
+  if (i != data.vertices.size()) { return false; }
+  i = 0;
+  LISTBASE_FOREACH (ScrEdge *, edge, &screen->edgebase) {
+    if (i >= data.edges.size() || edge != data.edges[i] ||
+        edge->v1 != data.vertices[data.edge_indices[i].a] ||
+        edge->v2 != data.vertices[data.edge_indices[i].b]) { return false; }
+    ++i;
+  }
+  if (i != data.edges.size()) { return false; }
+  i = 0;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (i >= data.areas.size() || area != data.areas[i]) { return false; }
+    const auto &v = data.faces[i].vertices;
+    if (area->v1 != data.vertices[v[0]] || area->v2 != data.vertices[v[1]] ||
+        area->v3 != data.vertices[v[2]] || area->v4 != data.vertices[v[3]]) { return false; }
+    ++i;
+  }
+  return i == data.areas.size();
+}
+
+static void seam_cancel(bContext *C, wmOperator *op)
+{
+  auto *data = static_cast<SeamDragData *>(op->customdata);
+  if (!data) { return; }
+  if (bScreen *screen = seam_owner(C, *data)) {
+    bool resized = false;
+    if (CTX_wm_screen(C) == screen && CTX_wm_window(C) == data->window) {
+      rcti rect;
+      WM_window_screen_rect_calc(data->window, &rect);
+      resized = rect.xmin != data->bounds.xmin || rect.ymin != data->bounds.ymin ||
+                rect.xmax != data->bounds.xmax || rect.ymax != data->bounds.ymax;
+    }
+    /* On an active window resize, restore the original layout THEN let Blender's
+     * normal refresh rescale it to the new window. Never retain the old extents. */
+    if (seam_snapshot_matches(screen, *data, !resized)) {
+      for (size_t i = 0; i < data->vertices.size(); ++i) {
+        data->vertices[i]->vec.x = data->original[i].x;
+        data->vertices[i]->vec.y = data->original[i].y;
+      }
+      if (screen->ipad_panel_owner == data->captured_owner) {
+        screen->ipad_panel_owner = data->original_owner;
+      }
+      screen->do_refresh = screen->do_draw = true;
+      if (CTX_wm_screen(C) == screen && CTX_wm_window(C)) { tag_layout(C, CTX_wm_window(C)); }
+    }
+  }
+  MEM_delete(data);
+  op->customdata = nullptr;
+}
+
+static wmOperatorStatus seam_invoke(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  bScreen *screen = CTX_wm_screen(C);
+  wmWindow *win = CTX_wm_window(C);
+  if (!win || !ED_ipad_panels_enabled(screen) || (U.app_flag & USER_APP_LOCK_EDGE_RESIZE)) {
+    return OPERATOR_CANCELLED;
+  }
+  Model model = make_model(C, win);
+  rcti window_rect;
+  WM_window_screen_rect_calc(win, &window_rect);
+  Rect bounds{window_rect.xmin, window_rect.ymin, window_rect.xmax, window_rect.ymax};
+  std::vector<NativeSeamControl> seams;
+  auto displayed = working_controls(screen, model.working, bounds, seams);
+  const int index = RNA_int_get(op->ptr, "seam");
+  if (index < 0 || index >= int(seams.size())) { return OPERATOR_CANCELLED; }
+  auto *data = MEM_new<SeamDragData>(__func__);
+  data->uid = screen->id.session_uid;
+  data->window = win;
+  data->seam = seams[index].seam;
+  data->fallback = seams[index].fallback;
+  data->adjacency = seams[index].adjacency;
+  std::vector<policy::WorkingFallback> nodes;
+  policy::working_layout(model.working, bounds, int(4 * UI_SCALE_FAC), &data->partitions, &nodes);
+  data->adjacencies = policy::working_adjacencies(model.working, displayed, nodes);
+  data->start = event->xy[data->seam.vertical ? 0 : 1];
+  data->bounds = bounds;
+  data->working = model.working;
+  data->inputs = model.inputs;
+  data->original_owner = screen->ipad_panel_owner;
+  data->captured_owner = int(std::find(model.areas.begin(), model.areas.end(), model.main) -
+                            model.areas.begin()) + 1;
+  data->displayed = std::move(displayed);
+  LISTBASE_FOREACH (ScrVert *, vertex, &screen->vertbase) {
+    data->vertices.push_back(vertex);
+    data->original.push_back({vertex->vec.x, vertex->vec.y});
+  }
+  data->last = data->original;
+  auto vertex_index = [&](ScrVert *v) {
+    return size_t(std::find(data->vertices.begin(), data->vertices.end(), v) - data->vertices.begin());
+  };
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    data->areas.push_back(area);
+    data->faces.push_back({{vertex_index(area->v1), vertex_index(area->v2),
+                            vertex_index(area->v3), vertex_index(area->v4)},
+                           int(29 * UI_SCALE_FAC + 2 * U.pixelsize),
+                           int(ED_area_headersize() + 2 * U.pixelsize)});
+  }
+  std::vector<policy::SeamEdge> edges;
+  size_t seed = size_t(-1);
+  int distance = INT_MAX;
+  const auto &seam = data->seam;
+  const int along_axis = seam.vertical ? 1 : 0;
+  const int display_low = seam.vertical ? seam.display_bounds.ymin : seam.display_bounds.xmin;
+  const int display_size = seam.vertical ? seam.display_bounds.height() : seam.display_bounds.width();
+  const int saved_low = seam.vertical ? seam.saved_bounds.ymin : seam.saved_bounds.xmin;
+  const int saved_size = seam.vertical ? seam.saved_bounds.height() : seam.saved_bounds.width();
+  const int along = saved_low + int(static_cast<long long>(event->xy[along_axis] - display_low) *
+                                   saved_size / std::max(1, display_size));
+  LISTBASE_FOREACH (ScrEdge *, edge, &screen->edgebase) {
+    const size_t a = vertex_index(edge->v1), b = vertex_index(edge->v2);
+    if (a >= data->vertices.size() || b >= data->vertices.size()) {
+      MEM_delete(data); return OPERATOR_CANCELLED;
+    }
+    const auto &v1 = data->original[a], &v2 = data->original[b];
+    const int c1 = seam.vertical ? v1.x : v1.y, c2 = seam.vertical ? v2.x : v2.y;
+    if (data->fallback && edge == seams[index].edge) { seed = edges.size(); }
+    if (!data->fallback && c1 == seam.coordinate && c2 == seam.coordinate) {
+      const int low = std::min(seam.vertical ? v1.y : v1.x, seam.vertical ? v2.y : v2.x);
+      const int high = std::max(seam.vertical ? v1.y : v1.x, seam.vertical ? v2.y : v2.x);
+      if (high >= saved_low && low < saved_low + saved_size) {
+        const int d = std::max({low - along, along - high, 0});
+        if (d < distance) { distance = d; seed = edges.size(); }
+      }
+    }
+    edges.push_back({a,b});
+    data->edges.push_back(edge);
+  }
+  data->edge_indices = edges;
+  data->selected = policy::seam_connected_vertices(data->original, edges, seed, seam.vertical);
+  data->limits = policy::seam_saved_limits(data->original, data->faces, data->selected,
+                                           seam.vertical, 1, 1);
+  if (!data->limits.valid || !seam_snapshot_matches(screen, *data)) {
+    MEM_delete(data); return OPERATOR_CANCELLED;
+  }
+  screen->ipad_panel_owner = data->captured_owner;
+  op->customdata = data;
+  WM_event_add_modal_handler(C, op);
+  return OPERATOR_RUNNING_MODAL;
+}
+
+static bool seam_candidate_valid(const SeamDragData &data, const int delta)
+{
+  auto inputs = data.inputs;
+  for (auto &area : inputs) {
+    const auto &v = data.faces[area.id].vertices;
+    if (data.seam.vertical) {
+      area.original.xmin += data.selected[v[0]] ? delta : 0;
+      area.original.xmax += data.selected[v[3]] ? delta : 0;
+    }
+    else {
+      area.original.ymin += data.selected[v[0]] ? delta : 0;
+      area.original.ymax += data.selected[v[1]] ? delta : 0;
+    }
+  }
+  const auto mapping = policy::classify(inputs, int(2 * UI_SCALE_FAC));
+  const auto original_mapping = policy::classify(data.inputs, int(2 * UI_SCALE_FAC));
+  auto ids = [](const auto &areas) {
+    std::vector<int> result;
+    for (const auto &area : areas) { result.push_back(area.id); }
+    std::sort(result.begin(), result.end());
+    return result;
+  };
+  if (ids(mapping.working) != ids(data.working) || mapping.panels.size() != original_mapping.panels.size()) {
+    return false;
+  }
+  for (const auto &panel : original_mapping.panels) {
+    if (std::none_of(mapping.panels.begin(), mapping.panels.end(), [&](const auto &p) {
+          return p.id == panel.id && p.edge == panel.edge;
+        })) { return false; }
+  }
+  std::vector<policy::WorkingSeam> seams;
+  std::vector<policy::WorkingFallback> nodes;
+  auto placed = policy::working_layout(mapping.working, data.bounds, int(4 * UI_SCALE_FAC), &seams, &nodes);
+  const auto adjacencies = policy::working_adjacencies(mapping.working, placed, nodes);
+  auto same_adjacency = [](const auto &a, const auto &b) {
+    return a.vertical == b.vertical && a.before_id == b.before_id && a.after_id == b.after_id &&
+           a.node.members == b.node.members;
+  };
+  if (adjacencies.size() != data.adjacencies.size()) { return false; }
+  for (const auto &original : data.adjacencies) {
+    if (std::none_of(adjacencies.begin(), adjacencies.end(), [&](const auto &candidate) {
+          return same_adjacency(original, candidate);
+        })) { return false; }
+  }
+  if (seams.size() != data.partitions.size()) { return false; }
+  for (const auto &original : data.partitions) {
+    if (std::none_of(seams.begin(), seams.end(), [&](const auto &candidate) {
+          return candidate.vertical == original.vertical && candidate.before == original.before &&
+                 candidate.after == original.after;
+        })) { return false; }
+  }
+  const bool same_partition = data.fallback ?
+      std::any_of(adjacencies.begin(), adjacencies.end(), [&](const auto &adj) {
+        return same_adjacency(data.adjacency, adj) && adj.coordinate == data.seam.coordinate + delta;
+      }) : std::any_of(seams.begin(), seams.end(), [&](const auto &seam) {
+    return seam.vertical == data.seam.vertical && seam.before == data.seam.before &&
+           seam.after == data.seam.after && seam.coordinate == data.seam.coordinate + delta;
+  });
+  return same_partition && policy::seam_display_valid(data.displayed, placed, data.bounds,
+                                                       int(160 * UI_SCALE_FAC), int(100 * UI_SCALE_FAC));
+}
+
+static wmOperatorStatus seam_modal(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  auto *data = static_cast<SeamDragData *>(op->customdata);
+  if (!data) { return OPERATOR_CANCELLED; }
+  bScreen *screen = seam_owner(C, *data);
+  if (!screen || CTX_wm_screen(C) != screen || CTX_wm_window(C) != data->window ||
+      !ED_ipad_panels_enabled(screen) || !seam_snapshot_matches(screen, *data) ||
+      (event->flag & WM_EVENT_IS_POINTER_CANCEL) || ELEM(event->type, EVT_ESCKEY, RIGHTMOUSE, WINDEACTIVATE)) {
+    seam_cancel(C, op); return OPERATOR_CANCELLED;
+  }
+  rcti rect;
+  WM_window_screen_rect_calc(data->window, &rect);
+  if (rect.xmin != data->bounds.xmin || rect.ymin != data->bounds.ymin ||
+      rect.xmax != data->bounds.xmax || rect.ymax != data->bounds.ymax) {
+    seam_cancel(C, op); return OPERATOR_CANCELLED;
+  }
+  if (event->type == LEFTMOUSE && event->val == KM_RELEASE) {
+    MEM_delete(data); op->customdata = nullptr;
+    WM_event_add_notifier(C, NC_SCREEN | NA_EDITED, nullptr);
+    return OPERATOR_FINISHED;
+  }
+  if (ELEM(event->type, MOUSEMOVE, INBETWEEN_MOUSEMOVE)) {
+    int requested = policy::seam_saved_delta(data->seam, event->xy[data->seam.vertical ? 0 : 1] - data->start);
+    requested = std::clamp(requested, data->limits.minimum, data->limits.maximum);
+    int accepted = 0, rejected = std::abs(requested), sign = requested < 0 ? -1 : 1;
+    if (seam_candidate_valid(*data, requested)) { accepted = rejected; }
+    else {
+      while (accepted + 1 < rejected) {
+        const int middle = accepted + (rejected - accepted) / 2;
+        if (seam_candidate_valid(*data, middle * sign)) { accepted = middle; }
+        else { rejected = middle; }
+      }
+    }
+    data->delta = accepted * sign;
+    for (size_t i = 0; i < data->vertices.size(); ++i) {
+      data->last[i] = data->original[i];
+      if (data->selected[i]) {
+        (data->seam.vertical ? data->last[i].x : data->last[i].y) += data->delta;
+      }
+      data->vertices[i]->vec.x = data->last[i].x;
+      data->vertices[i]->vec.y = data->last[i].y;
+    }
+    tag_layout(C, data->window);
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
+
+}  // namespace
+
+void ED_ipad_panels_resize_regions(bContext *C, wmWindow *win, std::vector<rcti> &regions)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!ED_ipad_panels_enabled(screen)) {
+    return;
+  }
+  const Model model = make_model(C, win);
+  if (!model.main) {
+    return;
+  }
+  for (const Button &button : buttons(model, screen)) {
+    if (ELEM(button.action, Action::Resize, Action::Seam) && !button.rect.empty()) {
+      regions.push_back(to_rect(button.rect));
+    }
+  }
+}
+
+bool ED_ipad_panels_enabled(const bScreen *screen)
+{
+  return screen && !G.background && !screen->temp && screen->state == SCREENNORMAL;
+}
+
+bool ED_ipad_panels_locked(const bScreen *screen)
+{
+  return screen && (screen->ipad_panels_locked || screen->ipad_panel_locked[0] ||
+                    screen->ipad_panel_locked[1]);
+}
+
+bool ED_ipad_panels_native_pin(const bScreen *screen, const ScrArea *area)
+{
+  if (!ED_ipad_panels_enabled(screen) || !area || area->runtime.ipad_layer != 1 ||
+      area->spacetype != SPACE_VIEW3D)
+  {
+    return false;
+  }
+  /* Keep the single lock at the outer top-right editor, independent of which
+   * working editor currently owns the native sidebar and Tools regions. */
+  LISTBASE_FOREACH (const ScrArea *, other, &screen->areabase) {
+    if (other->runtime.ipad_layer == 1 &&
+        (other->runtime.ipad_rect.xmax > area->runtime.ipad_rect.xmax ||
+         (other->runtime.ipad_rect.xmax == area->runtime.ipad_rect.xmax &&
+          other->runtime.ipad_rect.ymax > area->runtime.ipad_rect.ymax))) {
+      return false;
+    }
+  }
+  const auto *v3d = static_cast<const View3D *>(area->spacedata.first);
+  return v3d && !(v3d->gizmo_flag & (V3D_GIZMO_HIDE | V3D_GIZMO_HIDE_NAVIGATE)) &&
+         ((U.uiflag & USER_SHOW_GIZMO_NAVIGATE) || U.mini_axis_type == USER_MINI_AXIS_TYPE_GIZMO);
+}
+
+bool ED_ipad_panels_area_visible(const ScrArea *area)
+{
+  return area->runtime.ipad_layer != 4;
+}
+
+int ED_ipad_panels_area_layer(const ScrArea *area)
+{
+  return area->runtime.ipad_layer == 2 ? 1 : area->runtime.ipad_layer == 3 ? 2 : 0;
+}
+
+int ED_ipad_panels_area_hit_layer(const ScrArea *area, const int xy[2])
+{
+  if (!ED_ipad_panels_area_visible(area)) {
+    return -1;
+  }
+  if (area->runtime.ipad_layer == 1) {
+    LISTBASE_FOREACH (const ARegion *, region, &area->regionbase) {
+      if (region->runtime->ipad_floating && region->runtime->visible &&
+          BLI_rcti_isect_pt_v(&region->winrct, xy)) {
+        return 2;
+      }
+    }
+  }
+  return BLI_rcti_isect_pt_v(&area->totrct, xy) ? ED_ipad_panels_area_layer(area) : -1;
+}
+
+void ED_ipad_panels_prepare(bContext *C, wmWindow *win)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    area->runtime.ipad_layer = 0;
+    area->runtime.ipad_panel_host = 0;
+    area->runtime.ipad_side_region = 0;
+    area->runtime.ipad_bottom_region = 0;
+    area->runtime.ipad_tools_region = 0;
+    LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+      region->runtime->ipad_floating = false;
+      region->runtime->ipad_canvas = false;
+    }
+  }
+  if (!ED_ipad_panels_enabled(screen)) {
+    return;
+  }
+  Model model = make_model(C, win);
+  if (!model.main) {
+    return;
+  }
+  WorkSpace *workspace = CTX_wm_workspace(C);
+  Main *bmain = CTX_data_main(C);
+  /* Saved projects own their Tool Header preference even when their workspace
+   * retains the factory name. Only adapt an unsaved startup/new layout. */
+  const bool factory_new_file = bmain && BKE_main_blendfile_path(bmain)[0] == '\0';
+  if (!screen->ipad_panel_initialized && factory_new_file && workspace &&
+      STREQ(workspace->id.name + 2, "Layout") && model.main->spacetype == SPACE_VIEW3D &&
+      find_tab(model, tools_id) && model.object_mode)
+  {
+    ARegion *header = BKE_area_find_region_type(model.main, RGN_TYPE_TOOL_HEADER);
+    if (header && !(header->flag & RGN_FLAG_HIDDEN_BY_USER)) {
+      header->flag |= RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER;
+      ED_region_tag_redraw(header);
+      model = make_model(C, win);
+    }
+  }
+  rcti screen_rect;
+  WM_window_screen_rect_calc(win, &screen_rect);
+  for (ScrArea *area : model.areas) {
+    area->runtime.ipad_layer = 4;
+  }
+  const Rect workspace_bounds{screen_rect.xmin, screen_rect.ymin, screen_rect.xmax, screen_rect.ymax};
+  for (const policy::Area &working : policy::working_layout(model.working, workspace_bounds,
+                                                          int(4 * UI_SCALE_FAC))) {
+    ScrArea *area = model.areas[working.id];
+    area->runtime.ipad_layer = 1;
+    area->runtime.ipad_rect = to_rect(working.original);
+  }
+  model.main->runtime.ipad_panel_host = 1;
+  const ARegion *main_window = BKE_area_find_region_type(model.main, RGN_TYPE_WINDOW);
+  if (!screen->ipad_panel_initialized && main_window && main_window->runtime->type) {
+    save_slot(screen, model, Edge::Bottom);
+    save_slot(screen, model, Edge::Tools);
+  }
+  if (model.sculpt && !screen->ipad_sculpt_shelf_initialized && find_tab(model, shelf_id)) {
+    save_slot(screen, model, Edge::Bottom);
+  }
+  model.main->runtime.ipad_side_rect = to_rect(panel_content(model, Edge::Side));
+  model.main->runtime.ipad_bottom_rect = to_rect(panel_content(model, Edge::Bottom));
+  model.main->runtime.ipad_tools_rect = to_rect(model.layout.tools_panel);
+  model.main->runtime.ipad_tools_region = model.state.tools.open() ? RGN_TYPE_TOOLS : 0;
+  for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+    const Tab *tab = find_tab(model, model.state.slot(edge).active_id);
+    if (!tab) {
+      continue;
+    }
+    if (tab->region_type == 0) {
+      tab->area->runtime.ipad_layer = edge == Edge::Side ? 3 : 2;
+      tab->area->runtime.ipad_rect = to_rect(panel_content(model, edge));
+    }
+    else if (edge == Edge::Side) {
+      model.main->runtime.ipad_side_region = tab->region_type;
+    }
+    else {
+      model.main->runtime.ipad_bottom_region = tab->region_type;
+    }
+  }
+}
+
+bool ED_ipad_panels_main_region_layout(const wmWindow *win, ScrArea *main)
+{
+  if (main->runtime.ipad_layer != 1) {
+    return false;
+  }
+  bScreen *screen = WM_window_get_active_screen(win);
+  Model model;
+  std::vector<ScrArea *> working_areas;
+  ScrArea *host = nullptr;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (area->runtime.ipad_layer == 1) {
+      working_areas.push_back(area);
+      if (area->runtime.ipad_panel_host) {
+        host = area;
+      }
+    }
+  }
+  if (!host) {
+    return false;
+  }
+  model.main = host;
+  model.bounds = workspace_content_bounds(win, working_areas);
+  ScrArea *side_editor = nullptr;
+  /* prepare() has already selected the real editor/region instances. Recompute
+   * only their geometry here, after native headers establish the WINDOW rect. */
+  model.state.tools.active_id = host->runtime.ipad_tools_region ? tools_id : -1;
+  model.state.side.active_id = host->runtime.ipad_side_region ? 0 : -1;
+  model.state.bottom.active_id = host->runtime.ipad_bottom_region ? 0 : -1;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (area->runtime.ipad_layer == 3) {
+      model.state.side.active_id = 0;
+      side_editor = area;
+    }
+    else if (area->runtime.ipad_layer == 2) {
+      model.state.bottom.active_id = 0;
+    }
+  }
+  preferred_sizes(screen, model.state, side_editor);
+  model.metrics = panel_metrics(model.main, side_editor);
+  model.layout = policy::layout(model.bounds, model.state, model.metrics);
+  const rcti side = to_rect(panel_content(model, Edge::Side));
+  const rcti bottom = to_rect(panel_content(model, Edge::Bottom));
+  auto assign = [](rcti &target, const rcti &value) {
+    if (target.xmin == value.xmin && target.ymin == value.ymin &&
+        target.xmax == value.xmax && target.ymax == value.ymax)
+    {
+      return false;
+    }
+    target = value;
+    return true;
+  };
+  bool changed = assign(host->runtime.ipad_side_rect, side);
+  changed |= assign(host->runtime.ipad_bottom_rect, bottom);
+  changed |= assign(host->runtime.ipad_tools_rect, to_rect(model.layout.tools_panel));
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (ELEM(area->runtime.ipad_layer, 2, 3)) {
+      const rcti &rect = area->runtime.ipad_layer == 3 ? side : bottom;
+      if (assign(area->runtime.ipad_rect, rect)) {
+        area->flag |= AREA_FLAG_REGION_SIZE_UPDATE;
+        ED_area_tag_redraw(area);
+      }
+    }
+  }
+  if (changed && host != main) {
+    host->flag |= AREA_FLAG_REGION_SIZE_UPDATE;
+    ED_area_tag_redraw(host);
+  }
+  for (ScrArea *area : working_areas) {
+    LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+      if (region->regiontype != RGN_TYPE_WINDOW) {
+        continue;
+      }
+      const Rect &canvas = model.layout.canvas;
+      const rcti &window = region->winrct;
+      const Rect clipped{std::clamp(canvas.xmin, window.xmin, window.xmax),
+                           std::clamp(canvas.ymin, window.ymin, window.ymax),
+                           std::clamp(canvas.xmax, window.xmin + 1, window.xmax + 1),
+                           std::clamp(canvas.ymax, window.ymin + 1, window.ymax + 1)};
+      region->runtime->ipad_canvas = true;
+      region->runtime->ipad_canvas_rect = to_rect(clipped);
+      BLI_rcti_translate(&region->runtime->ipad_canvas_rect, -window.xmin, -window.ymin);
+      region->runtime->visible_rect = {};
+    }
+  }
+  return changed && host == main;
+}
+
+bool ED_ipad_panels_region_managed(const ScrArea *area, const ARegion *region)
+{
+  return area->runtime.ipad_layer == 1 &&
+         ELEM(region->regiontype, RGN_TYPE_UI, RGN_TYPE_TOOLS,
+              RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER);
+}
+
+bool ED_ipad_panels_region_rect(ScrArea *area, ARegion *region)
+{
+  if (!ED_ipad_panels_region_managed(area, region)) {
+    region->runtime->ipad_floating = false;
+    return false;
+  }
+  const bool bottom = ELEM(region->regiontype, RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER);
+  const bool tools = region->regiontype == RGN_TYPE_TOOLS;
+  const bool open = tools ? area->runtime.ipad_tools_region != 0 : bottom ? area->runtime.ipad_bottom_region != 0 :
+                            area->runtime.ipad_side_region == region->regiontype;
+  const bool visible = open && !(region->flag & RGN_FLAG_POLL_FAILED);
+  region->runtime->ipad_floating = true;
+  region->overlap = true;
+  region->flag &= ~RGN_FLAG_TOO_SMALL;
+  region->winrct = tools ? area->runtime.ipad_tools_rect : bottom ? area->runtime.ipad_bottom_rect : area->runtime.ipad_side_rect;
+  if (bottom) {
+    const rcti &r = region->winrct;
+    const policy::ShelfRegions shelf = policy::shelf_regions(
+        {r.xmin, r.ymin, r.xmax + 1, r.ymax + 1},
+        blender::ed::asset::shelf::header_region_size());
+    const Rect &rect = region->regiontype == RGN_TYPE_ASSET_SHELF_HEADER ? shelf.header : shelf.body;
+    region->winrct = to_rect(rect);
+  }
+  if (!visible || region->winrct.xmax <= region->winrct.xmin ||
+      region->winrct.ymax <= region->winrct.ymin)
+  {
+    region->flag |= RGN_FLAG_TOO_SMALL;
+    region->winrct = {0, 0, 0, 0};
+  }
+  region->winx = BLI_rcti_size_x(&region->winrct) + 1;
+  region->winy = BLI_rcti_size_y(&region->winrct) + 1;
+  region->runtime->visible_rect = {};
+  return true;
+}
+
+bool ED_ipad_panels_toggle_region(bContext *C, ARegion *region)
+{
+  if (!region || !CTX_wm_area(C) || !ED_ipad_panels_enabled(CTX_wm_screen(C)) ||
+      !ED_ipad_panels_region_managed(CTX_wm_area(C), region))
+  {
+    return false;
+  }
+  wmWindow *win = CTX_wm_window(C);
+  bScreen *screen = CTX_wm_screen(C);
+  Model model = make_model(C, win);
+  const Edge edge = ELEM(region->regiontype, RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER) ?
+                        Edge::Bottom : region->regiontype == RGN_TYPE_TOOLS ? Edge::Tools : Edge::Side;
+  const Tab *active = find_tab(model, model.state.slot(edge).active_id);
+  if (active && active->region_type == region->regiontype) {
+    model.state.tap(edge, active->id);
+  }
+  else {
+    for (const Tab &tab : model.tabs) {
+      if (tab.region_type == region->regiontype) {
+        model.state.tap(edge, tab.id);
+        break;
+      }
+    }
+  }
+  save_slot(screen, model, edge);
+  tag_layout(C, win);
+  return true;
+}
