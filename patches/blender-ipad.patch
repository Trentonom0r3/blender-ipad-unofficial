+def draw_compact_editing_shelf(column, context, width, mode_name, title, state, active_id):
+    top = column.row(align=True)
+    modes = top.column(align=True)
+    modes.ui_units_x = 4.4
+    modes.scale_y = 2.2
+    ipad_mode_button(modes, context, short=True)
+    caption = top.column(align=True)
+    if state and state[2]:
+        operation, operator, slot = state[1:]
+        props = state[0].operator_properties(operator)
+        constraint = next((text for _, text, axes in IPAD_TRANSFORM_AXES
+                           if tuple(props.constraint_axis) == axes), 'Custom')
+        tool_name = operation.title() if active_id != 'builtin.transform' else 'Transform: ' + operation.title()
+        caption.label(text=f'{tool_name} · {constraint}')
+        detail = ipad_transform_orientation(context, slot).type.title()
+        if props.use_accurate: detail += ' · Fine'
+        if context.tool_settings.use_snap: detail += ' · Snap'
+        caption.label(text=detail)
+    elif active_id in {'builtin.select_box', 'builtin.select_lasso'}:
+        _, mode, shape = ipad_selection_state(context)
+        action = dict((value, text) for text, value in IPAD_SELECTION_MODES).get(mode, 'Custom')
+        caption.label(text=f'Select · {shape}')
+        if context.mode == 'EDIT_MESH':
+            elements = '/'.join(name for name, enabled in zip(
+                ('V', 'E', 'F') if width < 13.2 else ('Vertex', 'Edge', 'Face'),
+                context.tool_settings.mesh_select_mode) if enabled)
+            action += ' · ' + elements
+        caption.label(text=action)
+    else:
+        caption.label(text=title)
+    ring = ipad_context_ring_name(context)
+    panel = ('VIEW3D_PT_ipad_transform' if state and not state[2] else
+             'VIEW3D_PT_ipad_bevel' if ipad_bevel_state(context) else None)
+    has_context = bool(ring or panel)
+    narrow = width < 13.2
+    row = column.grid_flow(row_major=True, columns=(3 if has_context else 2) if narrow else (5 if has_context else 4),
+                           even_columns=True, even_rows=True, align=True)
+    row.scale_y = 2.2
+    row.operator('wm.ipad_tool_palette', text='Ring').touch_targets = True
+    if ring:
+        label = 'Select' if ring == 'VIEW3D_MT_ipad_selection_ring' else state[1].title()
+        props = row.operator('wm.call_menu_pie', text=label + '…')
+        props.name, props.ipad_touch_targets = ring, True
+    elif panel:
+        row.popover(panel=panel, text='Action' if state else 'Bevel')
+    if narrow:
+        row.operator('view3d.ipad_shelf_toggle', text='Expand').expanded = True
+        row = column.grid_flow(row_major=True, columns=2, even_columns=True, even_rows=True, align=True)
+        row.scale_y = 2.2
+    row.operator('ed.undo', text='Undo', icon='LOOP_BACK')
+    row.operator('ed.redo', text='Redo', icon='LOOP_FORWARDS')
+    if not narrow:
+        row.operator('view3d.ipad_shelf_toggle', text='Expand').expanded = True
