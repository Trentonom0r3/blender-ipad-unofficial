+      if (can_handoff) {
+        ipad_close_callback_handoff = callback;
+      }
+#endif
       const wmOperatorStatus status = WM_operator_name_call(
           C, "WM_OT_save_mainfile", blender::wm::OpCallContext::ExecDefault, nullptr, nullptr);
-      if (status & OPERATOR_CANCELLED) {
+#ifdef WITH_APPLE_CROSSPLATFORM
+      if (can_handoff) {
+        if (ipad_close_callback_handoff == callback) {
+          ipad_close_callback_handoff = nullptr;
+        }
+        else {
+          /* The live provider-save modal now owns the callback. */
+          callback = nullptr;
+        }
+      }
+#endif
+      if ((status & OPERATOR_FINISHED) == 0) {
         execute_callback = false;
+#ifdef WITH_APPLE_CROSSPLATFORM
+        if ((status & OPERATOR_RUNNING_MODAL) && callback) {
+          BKE_report(&wm->runtime->reports,
+                     RPT_INFO,
+                     "Finish saving to Files, then open the project again");
+        }
+#endif
       }
     }
   }
   else {
     WM_operator_name_call(
         C, "WM_OT_save_mainfile", blender::wm::OpCallContext::InvokeDefault, nullptr, nullptr);
     execute_callback = false;
   }
 
-  if (execute_callback) {
-    callback->exec(C, callback->user_data);
+  if (callback) {
+    if (execute_callback) {
+      callback->exec(C, callback->user_data);
+    }
+    WM_generic_callback_free(callback);
   }
-  WM_generic_callback_free(callback);
 }
 
