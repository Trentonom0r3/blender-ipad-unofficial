   else if (region->alignment == RGN_ALIGN_BOTTOM) {
     region->alignment = RGN_ALIGN_TOP;
   }
   else if (region->alignment == RGN_ALIGN_LEFT) {
     region->alignment = RGN_ALIGN_RIGHT;
