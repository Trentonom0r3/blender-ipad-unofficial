           // retval &= ~OPERATOR_PASS_THROUGH;
         }
       }
     }
     else {
       CLOG_ERROR(WM_LOG_EVENTS, "Missing modal '%s'", op->idname);
     }
   }
   else {
     wmOperatorType *ot = WM_operatortype_find(kmi_idname, false);
 
     if (ot && wm_operator_check_locked_interface(C, ot)) {
+#ifdef WITH_APPLE_CROSSPLATFORM
+      /* If Apple Pencil is touching while Annotate or Grease Pencil tool is active,
+       * disable 3D selection (left click) so Apple Pencil draws strokes cleanly. */
+      if (event->tablet.active == EVT_TABLET_STYLUS &&
+          (BLI_strcasestr(ot->idname, "select") != nullptr))
+      {
+        bToolRef *tref = WM_toolsystem_ref_from_context(C);
+        if (tref && (BLI_strcasestr(tref->idname, "annotate") != nullptr ||
+                     BLI_strcasestr(tref->idname, "gpencil") != nullptr))
+        {
+          /* In Annotate mode, route Pencil taps to annotation stroke instead of selecting objects */
+          wmOperatorType *annot_ot = WM_operatortype_find("GPENCIL_OT_annotate", false);
+          if (annot_ot) {
+            WM_operator_name_call(C, "GPENCIL_OT_annotate", blender::wm::OpCallContext::InvokeDefault, nullptr, event);
+          }
+          return WM_HANDLER_BREAK;
+        }
+      }
+#endif
       bool use_last_properties = true;
       PointerRNA tool_properties = {};
 
       bToolRef *keymap_tool = nullptr;
       if (handler_base->type == WM_HANDLER_TYPE_KEYMAP) {
         keymap_tool = ((wmEventHandler_Keymap *)handler_base)->keymap_tool;
       }
       else if (handler_base->type == WM_HANDLER_TYPE_GIZMO) {
         wmGizmoMap *gizmo_map = ((wmEventHandler_Gizmo *)handler_base)->gizmo_map;
         wmGizmo *gz = wm_gizmomap_highlight_get(gizmo_map);
         if (gz && (gz->flag & WM_GIZMO_OPERATOR_TOOL_INIT)) {
           keymap_tool = WM_toolsystem_ref_from_context(C);
         }
       }
 
       const bool is_tool = (keymap_tool != nullptr);
       const bool use_tool_properties = is_tool;
 
       if (use_tool_properties) {
         WM_toolsystem_ref_properties_init_for_keymap(
             keymap_tool, &tool_properties, properties, ot);
+#ifdef WITH_APPLE_CROSSPLATFORM
+        /* Fine gain is deliberate tool state for canvas and gizmo drags.
+         * Native gizmos still own their basis, including the view-facing rotation ring. */
+        WM_toolsystem_ref_properties_for_transform(C, keymap_tool, &tool_properties, ot,
+                                                  handler_base->type == WM_HANDLER_TYPE_KEYMAP);
+#endif
         properties = &tool_properties;
         use_last_properties = false;
       }
 
       retval = wm_operator_invoke(C, ot, event, properties, nullptr, false, use_last_properties);
 
       if (use_tool_properties) {
         WM_operator_properties_free(&tool_properties);
       }
 
       /* Link gizmo if #WM_GIZMOGROUPTYPE_TOOL_INIT is set. */
       if (retval & OPERATOR_FINISHED) {
         if (is_tool) {
           bToolRef_Runtime *tref_rt = keymap_tool->runtime;
           if (tref_rt->gizmo_group[0]) {
             const char *idname = tref_rt->gizmo_group;
             wmGizmoGroupType *gzgt = WM_gizmogrouptype_find(idname, false);
             if (gzgt != nullptr) {
               if ((gzgt->flag & WM_GIZMOGROUPTYPE_TOOL_INIT) != 0) {
                 ARegion *region = CTX_wm_region(C);
                 if (region != nullptr) {
                   wmGizmoMapType *gzmap_type = WM_gizmomaptype_ensure(&gzgt->gzmap_params);
                   WM_gizmo_group_type_ensure_ptr_ex(gzgt, gzmap_type);
                   wmGizmoGroup *gzgroup = WM_gizmomaptype_group_init_runtime_with_region(
                       gzmap_type, gzgt, region);
                   /* We can't rely on drawing to initialize gizmo's since disabling
                    * overlays/gizmos will prevent pre-drawing setup calls, see #60905. */
                   WM_gizmogroup_ensure_init(C, gzgroup);
                 }
               }
             }
           }
         }
       }
       /* Done linking gizmo. */
     }
   }
 
   /* Finished and pass through flag as handled. */
   if (retval == (OPERATOR_FINISHED | OPERATOR_PASS_THROUGH)) {
     return WM_HANDLER_HANDLED;
   }
 
   /* Modal unhandled, break. */
   if (retval == (OPERATOR_PASS_THROUGH | OPERATOR_RUNNING_MODAL)) {
     return (WM_HANDLER_BREAK | WM_HANDLER_MODAL);
   }
 
   if (retval & OPERATOR_PASS_THROUGH) {
     return WM_HANDLER_CONTINUE;
   }
 
   return WM_HANDLER_BREAK;
 }
 
+#ifdef WITH_APPLE_CROSSPLATFORM
+enum class eIPadPencilPaintPreDispatch : uint8_t { Proceed, DispatchModal, Consume };
+
+/* Ring packets and a pending ring-reopen dismissal are handled before the
+ * ordinary modal list. Retire a live paint lease through Blender's normal
+ * operator status path before either route can change tools or swallow input.
+ * Matching contact packets still go to their owning native modal handler. */
+static eIPadPencilPaintPreDispatch wm_ipad_pencil_paint_modal_pre_dispatch(
+    bContext *C, wmWindow *win, wmEvent *event)
+{
+  if (!C || !win || !event || CTX_wm_window(C) != win) {
+    return eIPadPencilPaintPreDispatch::Consume;
+  }
+
+  LISTBASE_FOREACH_MUTABLE (wmEventHandler *, handler_base, &win->modalhandlers) {
+    if (handler_base->type != WM_HANDLER_TYPE_OP) {
+      continue;
+    }
+    wmEventHandler_Op *handler = reinterpret_cast<wmEventHandler_Op *>(handler_base);
+    if (!handler->ipad_pencil_paint_serial) {
+      continue;
+    }
+
+    ScrArea *area = CTX_wm_area(C);
+    ARegion *region = CTX_wm_region(C);
+    wm_handler_op_context(C, handler, event);
+    const eIPadPencilPaintModalAdmission admission =
+        wm_ipad_pencil_paint_modal_admit(C, win, event, handler);
+    const bool interface_unlocked =
+        admission == eIPadPencilPaintModalAdmission::Cancel &&
+        handler->op && wm_operator_check_locked_interface(C, handler->op->type);
+    CTX_wm_area_set(C, area);
+    CTX_wm_region_set(C, region);
+
+    if (admission == eIPadPencilPaintModalAdmission::Consume) {
+      return eIPadPencilPaintPreDispatch::Consume;
+    }
+    if (admission == eIPadPencilPaintModalAdmission::Dispatch) {
+      return eIPadPencilPaintPreDispatch::DispatchModal;
+    }
+    if (!interface_unlocked) {
+      return eIPadPencilPaintPreDispatch::Consume;
+    }
+
+    /* Re-enter the actual WM operator path so native cancel, undo-depth
+     * bookkeeping and once-only handler/operator disposal stay centralized. */
+    wm_handler_operator_call(C, &win->modalhandlers, handler_base, event, nullptr, nullptr);
+    if (CTX_wm_window(C) != win ||
+        BLI_findindex(&win->modalhandlers, handler_base) != -1)
+    {
+      return eIPadPencilPaintPreDispatch::Consume;
+    }
+  }
+  return eIPadPencilPaintPreDispatch::Proceed;
+}
+
+#endif
+
+#ifdef WITH_APPLE_CROSSPLATFORM
+/* A native picker can finish after its file-select handler has gone away.
+ * Reused operator or window-manager addresses must not acquire its callback. */
+static std::unordered_map<wmOperator *, uint64_t> ipad_native_import_tokens;
+static std::unordered_map<wmOperator *, std::string> ipad_native_library_paths;
+static uint64_t ipad_native_import_next_token = 0;
+
+static bool wm_ipad_import_operator_is_live(wmWindowManager *candidate,
+                                             wmOperator *op,
+                                             uint64_t token)
+{
+  const auto it = ipad_native_import_tokens.find(op);
+  if (it == ipad_native_import_tokens.end() || it->second != token || !G_MAIN) {
+    return false;
+  }
+  bool manager_live = false;
+  LISTBASE_FOREACH (wmWindowManager *, manager, &G_MAIN->wm) {
+    if (manager == candidate) {
+      manager_live = true;
+      break;
+    }
+  }
+  if (!manager_live) {
+    return false;
+  }
+  LISTBASE_FOREACH (wmWindow *, win, &candidate->windows) {
+    LISTBASE_FOREACH (wmEventHandler *, base_h, &win->modalhandlers) {
+      if (base_h->type == WM_HANDLER_TYPE_OP && ((wmEventHandler_Op *)base_h)->op == op) {
+        return true;
+      }
+    }
+    LISTBASE_FOREACH (wmEventHandler *, base_h, &win->handlers) {
+      if (base_h->type == WM_HANDLER_TYPE_OP && ((wmEventHandler_Op *)base_h)->op == op) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+#endif
+
+#ifdef WITH_APPLE_CROSSPLATFORM
+/* Retire a leased Pencil stroke before its original region is dismantled. Never
+ * invoke a mode callback after the live scene/tool/context no longer matches. */
+void WM_event_ipad_pencil_paint_owner_teardown(bContext *C,
+                                                wmWindow *win,
+                                                const ScrArea *area,
+                                                const ARegion *region)
+{
+  if (!C || !win || !win->runtime) {
+    return;
+  }
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm) {
+    return;
+  }
+  bContext *owner_C = C;
+  bContext *owner_context_copy = nullptr;
+  if (CTX_wm_window(C) != win) {
+    bool window_live = false;
+    LISTBASE_FOREACH (wmWindow *, live_win, &wm->windows) {
+      if (live_win == win) {
+        window_live = true;
+        break;
+      }
+    }
+    if (!window_live) {
+      return;
+    }
+    owner_context_copy = CTX_copy(C);
+    if (!owner_context_copy) {
+      return;
+    }
+    bContext_PyState owner_context_python_state{};
+    CTX_py_state_push(owner_context_copy, &owner_context_python_state, nullptr);
+    CTX_wm_window_set(owner_context_copy, win);
+    owner_C = owner_context_copy;
+  }
+  struct OwnerContextCopyGuard {
+    bContext *context;
+    ~OwnerContextCopyGuard()
+    {
+      if (context) {
+        CTX_free(context);
+      }
+    }
+  } owner_context_copy_guard{owner_context_copy};
+  if (CTX_wm_window(owner_C) != win) {
+    return;
+  }
+  for (;;) {
+    wmEventHandler_Op *candidate = nullptr;
+    LISTBASE_FOREACH (wmEventHandler *, handler_base, &win->modalhandlers) {
+      if (handler_base->type != WM_HANDLER_TYPE_OP) continue;
+      wmEventHandler_Op *handler = reinterpret_cast<wmEventHandler_Op *>(handler_base);
+      if (!handler->ipad_pencil_paint_serial ||
+          (area && handler->ipad_pencil_area != uintptr_t(area)) ||
+          (region && handler->ipad_pencil_region != uintptr_t(region))) continue;
+      candidate = handler;
+      break;
+    }
+    if (!candidate || !wm_ipad_pencil_paint_handler_registered(win, candidate)) return;
+
+    /* Resolve the value identity back through the current screen before using
+     * coordinates. Registration has proved the same live visible WINDOW region
+     * and operator/type lifetimes. */
+    bScreen *screen = WM_window_get_active_screen(win);
+    if (!screen) return;
+    ScrArea *owner_area = nullptr;
+    ARegion *owner_region = nullptr;
+    LISTBASE_FOREACH (ScrArea *, screen_area, &screen->areabase) {
+      if (uintptr_t(screen_area) != candidate->ipad_pencil_area) continue;
+      owner_area = screen_area;
+      LISTBASE_FOREACH (ARegion *, screen_region, &screen_area->regionbase) {
+        if (uintptr_t(screen_region) == candidate->ipad_pencil_region) {
+          owner_region = screen_region;
+          break;
+        }
+      }
+      break;
+    }
+    if (!owner_area || !owner_region) return;
+
+    /* This synthetic event selects the proven owner context; EVENT_NONE and zero
+     * contact provenance prevent it from reaching operator modal. */
+    wmEvent cancel_event{};
+    cancel_event.type = EVENT_NONE;
+    cancel_event.val = KM_NOTHING;
+    cancel_event.xy[0] = (owner_region->winrct.xmin + owner_region->winrct.xmax) / 2;
+    cancel_event.xy[1] = (owner_region->winrct.ymin + owner_region->winrct.ymax) / 2;
+    ScrArea *area_prev = CTX_wm_area(owner_C);
+    ARegion *region_prev = CTX_wm_region(owner_C);
+    CTX_wm_area_set(owner_C, owner_area);
+    CTX_wm_region_set(owner_C, owner_region);
+    const eIPadPencilPaintModalAdmission admission =
+        wm_ipad_pencil_paint_modal_admit(owner_C, win, &cancel_event, candidate, true);
+    const uint64_t owner_lifetime = candidate->ipad_pencil_operator_lifetime;
+    if (admission != eIPadPencilPaintModalAdmission::Cancel) {
+      CTX_wm_area_set(owner_C, area_prev);
+      CTX_wm_region_set(owner_C, region_prev);
+      return;
+    }
+
+    /* Keep mode-specific Cancel, Undo-depth accounting and handler disposal on
+     * Blender's normal native status path. The dedicated flag permits this
+     * cleanup while the interface is locked, matching WM_event_remove_handlers. */
+    wm_handler_operator_call(
+        owner_C, &win->modalhandlers, &candidate->head, &cancel_event, nullptr, nullptr, true);
+    /* Native cancellation callbacks may replace the active context. Do not
+     * dereference the old window or restore area/region values after that. */
+    if (CTX_wm_window(owner_C) != win || CTX_wm_manager(owner_C) != wm) {
+      return;
+    }
+    CTX_wm_area_set(owner_C, area_prev);
+    CTX_wm_region_set(owner_C, region_prev);
+    /* Reacquire after callbacks by value lifetime; keep no old pointer. */
+    bool owner_still_registered = false;
+    LISTBASE_FOREACH (wmEventHandler *, handler_base, &win->modalhandlers) {
+      if (handler_base->type != WM_HANDLER_TYPE_OP) continue;
+      const wmEventHandler_Op *handler = reinterpret_cast<const wmEventHandler_Op *>(handler_base);
+      if (handler->ipad_pencil_operator_lifetime == owner_lifetime) {
+        owner_still_registered = true;
+        break;
+      }
+    }
+    if (owner_still_registered) return;
+  }
+}
+#endif
+
 static void wm_operator_free_for_fileselect(wmOperator *file_operator)
 {
+#ifdef WITH_APPLE_CROSSPLATFORM
+  ipad_native_import_tokens.erase(file_operator);
+  const auto library = ipad_native_library_paths.find(file_operator);
+  if (library != ipad_native_library_paths.end()) {
+    GHOST_IOS_discard_blend_library(library->second.c_str());
+    ipad_native_library_paths.erase(library);
+  }
+#endif
   LISTBASE_FOREACH (bScreen *, screen, &G_MAIN->screens) {
     LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
       if (area->spacetype == SPACE_FILE) {
         SpaceFile *sfile = static_cast<SpaceFile *>(area->spacedata.first);
         if (sfile->op == file_operator) {
           sfile->op = nullptr;
         }
       }
     }
   }
 
   WM_operator_free(file_operator);
 }
 
 /**
  * File-select handlers are only in the window queue,
  * so it's safe to switch screens or area types.
  */
 static eHandlerActionFlag wm_handler_fileselect_do(bContext *C,
                                                    ListBase *handlers,
                                                    wmEventHandler_Op *handler,
                                                    int val)
 {
   wmWindowManager *wm = CTX_wm_manager(C);
   eHandlerActionFlag action = WM_HANDLER_CONTINUE;
 
   switch (val) {
     case EVT_FILESELECT_FULL_OPEN: {
+#ifdef WITH_APPLE_CROSSPLATFORM
+      wmOperator *op = handler->op;
+      const char *idname = op ? op->type->idname : "";
+      const bool is_export = (BLI_strcasestr(idname, "export") != nullptr) ||
+                             (BLI_strcasestr(idname, "save") != nullptr);
+      const bool is_import = (BLI_strcasestr(idname, "import") != nullptr) ||
+                             (BLI_strcasestr(idname, "open") != nullptr);
+      const bool is_link_append = STREQ(idname, "WM_OT_link") || STREQ(idname, "WM_OT_append");
+
+      if (is_link_append && ipad_native_library_paths.find(op) ==
+                                ipad_native_library_paths.end())
+      {
+        const uint64_t picker_token = ++ipad_native_import_next_token;
+        ipad_native_import_tokens[op] = picker_token;
+        const bool presented = GHOST_IOS_pick_blend_library(
+            [wm, op, picker_token](const char *local_path) {
+              if (!wm_ipad_import_operator_is_live(wm, op, picker_token) ||
+                  strlen(local_path) + 2 >= FILE_MAX)
+              {
+                return false;
+              }
+              std::string browser_path(local_path);
+              browser_path.push_back('/');
+              RNA_string_set(op->ptr, "filepath", browser_path.c_str());
+              RNA_string_set(op->ptr, "directory", browser_path.c_str());
+              RNA_string_set(op->ptr, "filename", "");
+              if (PropertyRNA *files_prop = RNA_struct_find_property(op->ptr, "files")) {
+                RNA_property_collection_clear(op->ptr, files_prop);
+              }
+              ipad_native_library_paths[op] = local_path;
+              WM_event_fileselect_event(wm, op, EVT_FILESELECT_FULL_OPEN);
+              return true;
+            },
+            [wm, op, picker_token]() {
+              if (wm_ipad_import_operator_is_live(wm, op, picker_token)) {
+                WM_event_fileselect_event(wm, op, EVT_FILESELECT_CANCEL);
+              }
+            });
+        if (!presented) {
+          BKE_report(&wm->runtime->reports, RPT_ERROR, "Could not open Blender library in Files");
+          WM_event_fileselect_event(wm, op, EVT_FILESELECT_CANCEL);
+        }
+        action = WM_HANDLER_BREAK;
+        break;
+      }
+
+      if (is_export) {
+        ScrArea *orig_area = CTX_wm_area(C);
+        ARegion *orig_region = CTX_wm_region(C);
+        wmWindow *ctx_win = CTX_wm_window(C);
+        wmWindow *root_win = handler->context.win;
+        if (!root_win) {
+          root_win = ctx_win;
+        }
+        wmEvent *eventstate = ctx_win ? ctx_win->eventstate : (root_win ? root_win->eventstate : nullptr);
+
+        /* FBX export requires NumPy which is unavailable in the iOS Python runtime.
+         * Intercept early to prevent fatal crash and display clean notification. */
+        if (BLI_strcasestr(idname, "fbx") != nullptr) {
+          BKE_report(&wm->runtime->reports,
+                     RPT_ERROR,
+                     "FBX export is unsupported on iOS (requires NumPy). "
+                     "Please use Universal Scene Description (.usd*), Wavefront (.obj), or STL (.stl)");
+          BLI_remlink(handlers, handler);
+          wm_operator_free_for_fileselect(handler->op);
+          if (orig_area) {
+            CTX_wm_area_set(C, orig_area);
+            CTX_wm_region_set(C, orig_region);
+          }
+          wm_event_free_handler(&handler->head);
+          action = WM_HANDLER_BREAK;
+          break;
+        }
+
+        char filename[FILE_MAXFILE];
+        filename[0] = '\0';
+        if (RNA_struct_find_property(op->ptr, "filename") &&
+            RNA_struct_property_is_set(op->ptr, "filename"))
+        {
+          RNA_string_get(op->ptr, "filename", filename);
+        }
+        else if (RNA_struct_find_property(op->ptr, "filepath") &&
+                 RNA_struct_property_is_set(op->ptr, "filepath"))
+        {
+          char filepath[FILE_MAX];
+          RNA_string_get(op->ptr, "filepath", filepath);
+          STRNCPY(filename, BLI_path_basename(filepath));
+        }
+
+        if (filename[0] == '\0') {
+          Main *bmain = CTX_data_main(C);
+          if (bmain && bmain->filepath[0] != '\0') {
+            char base[FILE_MAXFILE];
+            STRNCPY(base, BLI_path_basename(bmain->filepath));
+            char *dot = strrchr(base, '.');
+            if (dot) {
+              *dot = '\0';
+            }
+            if (base[0] != '\0') {
+              STRNCPY(filename, base);
+            }
+          }
+          if (filename[0] == '\0') {
+            STRNCPY(filename, "Model");
+          }
+        }
+
+        /* If filename has no extension, extract default extension from filter_glob. */
+        const char *ext = strrchr(filename, '.');
+        if (!ext) {
+          if (PropertyRNA *glob_prop = RNA_struct_find_property(op->ptr, "filter_glob")) {
+            char filter_glob[FILE_MAX];
+            RNA_property_string_get(op->ptr, glob_prop, filter_glob);
+            const char *star = strstr(filter_glob, "*.");
+            if (star) {
+              char ext_buf[32];
+              ext_buf[0] = '.';
+              size_t i = 0;
+              star += 2;
+              while (star[i] && star[i] != ';' && star[i] != ':' && star[i] != ',' &&
+                     star[i] != ' ' && i < 30)
+              {
+                ext_buf[1 + i] = star[i];
+                i++;
+              }
+              ext_buf[1 + i] = '\0';
+              if (i > 0) {
+                BLI_strncat(filename, ext_buf, sizeof(filename));
+              }
+            }
+          }
+        }
+
+        const bool presented = GHOST_IOS_export_file(filename, [&](const char *staging_path) -> bool {
+          if (strlen(staging_path) >= FILE_MAX) {
+            BKE_report(&wm->runtime->reports, RPT_ERROR, "The export filepath is too long");
+            return false;
+          }
+          if (root_win) {
+            CTX_wm_window_set(C, root_win);
+            bScreen *screen = WM_window_get_active_screen(root_win);
+            if (screen) {
+              CTX_wm_screen_set(C, screen);
+            }
+          }
+          if (eventstate) {
+            wm_handler_op_context(C, handler, eventstate);
+          }
+          /* Always force 3D viewport context for model export operators. */
+          if (root_win) {
+            bScreen *screen = WM_window_get_active_screen(root_win);
+            if (screen) {
+              ScrArea *v3d_area = nullptr;
+              ARegion *v3d_region = nullptr;
+              ED_screen_areas_iter(root_win, screen, area_iter) {
+                if (area_iter->spacetype == SPACE_VIEW3D) {
+                  v3d_area = area_iter;
+                  v3d_region = BKE_area_find_region_type(v3d_area, RGN_TYPE_WINDOW);
+                  break;
+                }
+              }
+              if (!v3d_area) {
+                v3d_area = static_cast<ScrArea *>(screen->areabase.first);
+                if (v3d_area) {
+                  v3d_region = BKE_area_find_region_type(v3d_area, RGN_TYPE_WINDOW);
+                }
+              }
+              if (v3d_area) {
+                CTX_wm_area_set(C, v3d_area);
+                CTX_wm_region_set(C, v3d_region);
+              }
+            }
+          }
+          ScrArea *handler_area = CTX_wm_area(C);
+          if (handler_area) {
+            ED_area_do_refresh(C, handler_area);
+          }
+          RNA_string_set(op->ptr, "filepath", staging_path);
+          if (RNA_struct_find_property(op->ptr, "directory")) {
+            char dir[FILE_MAX];
+            STRNCPY(dir, staging_path);
+            BLI_path_parent_dir(dir);
+            RNA_string_set(op->ptr, "directory", dir);
+          }
+          if (PropertyRNA *files_prop = RNA_struct_find_property(op->ptr, "files")) {
+            RNA_property_collection_clear(op->ptr, files_prop);
+            PointerRNA file_elem;
+            RNA_property_collection_add(op->ptr, files_prop, &file_elem);
+            RNA_string_set(&file_elem, "name", BLI_path_basename(staging_path));
+          }
+          if (RNA_struct_find_property(op->ptr, "check_existing")) {
+            RNA_boolean_set(op->ptr, "check_existing", false);
+          }
+          if (op->reports == nullptr) {
+            op->reports = MEM_callocN<ReportList>("wmOperatorReportList");
+            BKE_reports_init(op->reports, RPT_STORE | RPT_FREE);
+          }
+          if (op->type->check) {
+            op->type->check(C, op);
+          }
+          if (op->type->flag & OPTYPE_UNDO) {
+            wm->op_undo_depth++;
+          }
+          wmOperatorStatus status = OPERATOR_CANCELLED;
+          try {
+            if (op->type->exec != nullptr) {
+              status = op->type->exec(C, op);
+            }
+            else if (op->type->invoke != nullptr) {
+              status = op->type->invoke(C, op, eventstate);
+            }
+          }
+          catch (const std::exception &e) {
+            CLOG_ERROR(WM_LOG_OPERATORS, "Exception in export operator %s: %s", op->type->idname, e.what());
+            status = OPERATOR_CANCELLED;
+          }
+          catch (...) {
+            CLOG_ERROR(WM_LOG_OPERATORS, "Unknown exception in export operator %s", op->type->idname);
+            status = OPERATOR_CANCELLED;
+          }
+          if (op->type->flag & OPTYPE_UNDO && CTX_wm_manager(C) == wm) {
+            wm->op_undo_depth--;
+          }
+          if ((status & OPERATOR_FINISHED) || BLI_exists(staging_path)) {
+            wm_operator_reports(C, op, status, true);
+            WM_operator_last_properties_store(op);
+            return BLI_exists(staging_path) != 0;
+          }
+          wm_operator_reports(C, op, status, true);
+          return false;
+        });
+
+        if (!presented) {
+          BKE_report(&wm->runtime->reports,
+                     RPT_ERROR,
+                     "Could not export model. Please verify file path and export settings");
+        }
+
+        BLI_remlink(handlers, handler);
+        wm_operator_free_for_fileselect(handler->op);
+        if (orig_area != nullptr) {
+          CTX_wm_area_set(C, orig_area);
+          CTX_wm_region_set(C, orig_region);
+        }
+        else if (root_win) {
+          bScreen *screen = WM_window_get_active_screen(root_win);
+          if (screen && screen->areabase.first) {
+            ScrArea *fa = static_cast<ScrArea *>(screen->areabase.first);
+            CTX_wm_area_set(C, fa);
+            CTX_wm_region_set(C, BKE_area_find_region_type(fa, RGN_TYPE_WINDOW));
+          }
+        }
+        wm_event_free_handler(&handler->head);
+
+        action = WM_HANDLER_BREAK;
+        break;
+      }
+      else if (is_import) {
+        char filter_glob[FILE_MAX];
+        filter_glob[0] = '\0';
+        if (RNA_struct_find_property(op->ptr, "filter_glob")) {
+          RNA_string_get(op->ptr, "filter_glob", filter_glob);
+        }
+
+        const uint64_t picker_token = ++ipad_native_import_next_token;
+        ipad_native_import_tokens[op] = picker_token;
+        const bool presented = GHOST_IOS_import_file(
+            filter_glob,
+            [wm, op, picker_token](const char *local_path) {
+              if (!wm_ipad_import_operator_is_live(wm, op, picker_token)) {
+                return false;
+              }
+
+              if (RNA_struct_find_property(op->ptr, "filepath")) {
+                RNA_string_set(op->ptr, "filepath", local_path);
+              }
+              if (RNA_struct_find_property(op->ptr, "directory")) {
+                char dir[FILE_MAX];
+                STRNCPY(dir, local_path);
+                BLI_path_parent_dir(dir);
+                RNA_string_set(op->ptr, "directory", dir);
+              }
+              if (PropertyRNA *files_prop = RNA_struct_find_property(op->ptr, "files")) {
+                RNA_property_collection_clear(op->ptr, files_prop);
+                PointerRNA file_elem;
+                RNA_property_collection_add(op->ptr, files_prop, &file_elem);
+                RNA_string_set(&file_elem, "name", BLI_path_basename(local_path));
+              }
+              WM_event_fileselect_event(wm, op, EVT_FILESELECT_EXEC);
+              return true;
+            },
+            [wm, op, picker_token]() {
+              if (wm_ipad_import_operator_is_live(wm, op, picker_token)) {
+                WM_event_fileselect_event(wm, op, EVT_FILESELECT_CANCEL);
+              }
+            });
+
+        if (!presented) {
+          WM_event_fileselect_event(wm, op, EVT_FILESELECT_CANCEL);
+        }
+        action = WM_HANDLER_BREAK;
+        break;
+      }
+#endif
+
       ScrArea *area = ED_screen_temp_space_open(
           C, IFACE_("Blender File View"), SPACE_FILE, U.filebrowser_display_type, true);
       if (!area) {
         BKE_report(&wm->runtime->reports, RPT_ERROR, "Failed to open file browser!");
         return WM_HANDLER_BREAK;
       }
 
       ARegion *region_header = BKE_area_find_region_type(area, RGN_TYPE_HEADER);
       BLI_assert(area->spacetype == SPACE_FILE);
 
       region_header->flag |= RGN_FLAG_HIDDEN;
       /* Header on bottom, #AZone triangle to toggle header looks misplaced at the top. */
       region_header->alignment = RGN_ALIGN_BOTTOM;
 
       /* Settings for file-browser, #sfile is not operator owner but sends events. */
       SpaceFile *sfile = (SpaceFile *)area->spacedata.first;
       sfile->op = handler->op;
 
       ED_fileselect_set_params_from_userdef(sfile);
+#ifdef WITH_APPLE_CROSSPLATFORM
+      if (is_link_append) {
+        /* Apple Files already chose the library. Keep the data-block list and
+         * operator settings, but omit the desktop filesystem shortcuts. */
+        if (ARegion *source_list = BKE_area_find_region_type(area, RGN_TYPE_TOOLS)) {
+          source_list->flag |= RGN_FLAG_HIDDEN;
+        }
+      }
+#endif
 
       action = WM_HANDLER_BREAK;
       break;
     }
 
     case EVT_FILESELECT_EXEC:
     case EVT_FILESELECT_CANCEL:
     case EVT_FILESELECT_EXTERNAL_CANCEL: {
       wmWindow *ctx_win = CTX_wm_window(C);
       wmEvent *eventstate = ctx_win->eventstate;
       /* The root window of the operation as determined in #WM_event_add_fileselect(). */
       wmWindow *root_win = handler->context.win;
 
       /* Remove link now, for load file case before removing. */
       BLI_remlink(handlers, handler);
 
       if (val == EVT_FILESELECT_EXTERNAL_CANCEL) {
         /* The window might have been freed already. */
         if (BLI_findindex(&wm->windows, handler->context.win) == -1) {
           handler->context.win = nullptr;
         }
       }
       else {
         ScrArea *ctx_area = CTX_wm_area(C);
 
         wmWindow *temp_win = nullptr;
         LISTBASE_FOREACH (wmWindow *, win, &wm->windows) {
           bScreen *screen = WM_window_get_active_screen(win);
           ScrArea *file_area = static_cast<ScrArea *>(screen->areabase.first);
 
           if ((file_area->spacetype != SPACE_FILE) || !WM_window_is_temp_screen(win)) {
             continue;
           }
 
           if (file_area->full) {
             /* Users should not be able to maximize/full-screen an area in a temporary screen.
              * So if there's a maximized file browser in a temporary screen,
              * it was likely opened by #EVT_FILESELECT_FULL_OPEN. */
             continue;
           }
 
           ED_fileselect_params_to_userdef(static_cast<SpaceFile *>(file_area->spacedata.first));
 
           if (BLI_listbase_is_single(&file_area->spacedata)) {
             BLI_assert(root_win != win);
 
             wm_window_close(C, wm, win);
 
             /* #wm_window_close() sets the context's window to null. */
             CTX_wm_window_set(C, root_win);
 
             /* Some operators expect a drawable context (for #EVT_FILESELECT_EXEC). */
             wm_window_make_drawable(wm, root_win);
             /* Ensure correct cursor position, otherwise, popups may close immediately after
              * opening (#UI_BLOCK_MOVEMOUSE_QUIT). */
             int xy[2];
             if (wm_cursor_position_get(root_win, &xy[0], &xy[1])) {
               copy_v2_v2_int(eventstate->xy, xy);
             }
             wm->runtime->winactive = root_win; /* Reports use this... */
           }
           else if (file_area->full) {
             ED_screen_full_prevspace(C, file_area);
           }
           else {
             ED_area_prevspace(C, file_area);
           }
 
           temp_win = win;
           break;
         }
 
         if (!temp_win && ctx_area->full) {
           ED_fileselect_params_to_userdef(static_cast<SpaceFile *>(ctx_area->spacedata.first));
           ED_screen_full_prevspace(C, ctx_area);
         }
       }
 
       CTX_wm_window_set(C, root_win);
       wm_handler_op_context(C, handler, eventstate);
       /* At this point context is supposed to match the root context determined by
        * #WM_event_add_fileselect(). */
       BLI_assert(!CTX_wm_area(C) || (CTX_wm_area(C) == handler->context.area));
       BLI_assert(!CTX_wm_region(C) || (CTX_wm_region(C) == handler->context.region));
 
       ScrArea *handler_area = CTX_wm_area(C);
       /* Make sure new context area is ready, the operator callback may operate on it. */
       if (handler_area) {
         ED_area_do_refresh(C, handler_area);
       }
 
       /* Needed for #UI_popup_menu_reports. */
 
       if (val == EVT_FILESELECT_EXEC) {
         if (handler->op->type->flag & OPTYPE_UNDO) {
           wm->op_undo_depth++;
         }
 
         const wmOperatorStatus retval = handler->op->type->exec(C, handler->op);
         OPERATOR_RETVAL_CHECK(retval);
 
         /* XXX check this carefully, `CTX_wm_manager(C) == wm` is a bit hackish. */
         if (handler->op->type->flag & OPTYPE_UNDO && CTX_wm_manager(C) == wm) {
           wm->op_undo_depth--;
         }
 
         /* XXX check this carefully, `CTX_wm_manager(C) == wm` is a bit hackish. */
         if (retval & OPERATOR_FINISHED) {
           if (CTX_wm_manager(C) == wm && wm->op_undo_depth == 0) {
             if (handler->op->type->flag & OPTYPE_UNDO) {
               ED_undo_push_op(C, handler->op);
             }
             else if (handler->op->type->flag & OPTYPE_UNDO_GROUPED) {
               ED_undo_grouped_push_op(C, handler->op);
             }
           }
         }
 
         if (handler->op->reports->list.first) {
 
           /* FIXME(@ideasman42): temp setting window, this is really bad!
            * only have because lib linking errors need to be seen by users :(
            * it can be removed without breaking anything but then no linking errors. */
           wmWindow *win_prev = CTX_wm_window(C);
           ScrArea *area_prev = CTX_wm_area(C);
           ARegion *region_prev = CTX_wm_region(C);
 
           if (win_prev == nullptr) {
             CTX_wm_window_set(C, static_cast<wmWindow *>(CTX_wm_manager(C)->windows.first));
           }
 
           BKE_report_print_level_set(handler->op->reports, RPT_WARNING);
           UI_popup_menu_reports(C, handler->op->reports);
 
           WM_reports_from_reports_move(CTX_wm_manager(C), handler->op->reports);
 
           CTX_wm_window_set(C, win_prev);
           CTX_wm_area_set(C, area_prev);
           CTX_wm_region_set(C, region_prev);
         }
 
         /* For #WM_operator_pystring only, custom report handling is done above. */
         wm_operator_reports(C, handler->op, retval, true);
 
         if (retval & OPERATOR_FINISHED) {
           WM_operator_last_properties_store(handler->op);
         }
 
         if (retval & (OPERATOR_CANCELLED | OPERATOR_FINISHED)) {
+#ifdef WITH_APPLE_CROSSPLATFORM
+          if (retval & OPERATOR_FINISHED) {
+            /* Linked IDs may refer to this durable snapshot after relaunch. */
+            ipad_native_library_paths.erase(handler->op);
+          }
+#endif
           wm_operator_free_for_fileselect(handler->op);
         }
       }
       else {
         if (handler->op->type->cancel) {
           if (handler->op->type->flag & OPTYPE_UNDO) {
             wm->op_undo_depth++;
           }
 
           handler->op->type->cancel(C, handler->op);
 
           if (handler->op->type->flag & OPTYPE_UNDO) {
             wm->op_undo_depth--;
           }
         }
         wm_operator_free_for_fileselect(handler->op);
       }
 
       CTX_wm_area_set(C, nullptr);
 
       wm_event_free_handler(&handler->head);
 
       action = WM_HANDLER_BREAK;
       break;
     }
   }
 
   return action;
 }
 
 static eHandlerActionFlag wm_handler_fileselect_call(bContext *C,
                                                      ListBase *handlers,
                                                      wmEventHandler_Op *handler,
                                                      const wmEvent *event)
 {
   eHandlerActionFlag action = WM_HANDLER_CONTINUE;
 
   if (event->type != EVT_FILESELECT) {
     return action;
   }
   if (handler->op != (wmOperator *)event->customdata) {
     return action;
   }
 
   return wm_handler_fileselect_do(C, handlers, handler, event->val);
 }
 
 static bool wm_action_not_handled(const eHandlerActionFlag action)
 {
   return action == WM_HANDLER_CONTINUE || action == (WM_HANDLER_BREAK | WM_HANDLER_MODAL);
 }
 
 static const char *keymap_handler_log_action_str(const eHandlerActionFlag action)
 {
   if (action & WM_HANDLER_BREAK) {
     return "handled";
   }
   if (action & WM_HANDLER_HANDLED) {
     return "handled (and pass on)";
   }
   return "un-handled";
 }
 
 static std::optional<std::string> keymap_handler_log_kmi_event_str(const wmKeyMapItem *kmi)
 {
   /* Short representation of the key that was pressed,
    * include this since it may differ from the event in minor details
    * which can help looking up the key-map definition. */
   return WM_keymap_item_to_string(kmi, false);
 }
 
 static std::string keymap_handler_log_kmi_op_str(bContext *C, const wmKeyMapItem *kmi)
 {
   /* The key-map item properties can further help distinguish this item from others. */
   std::optional<std::string> kmi_props;
   if (kmi->properties != nullptr) {
     wmOperatorType *ot = WM_operatortype_find(kmi->idname, false);
     if (ot) {
       kmi_props = RNA_pointer_as_string_keywords(C, kmi->ptr, false, false, true, 512);
     }
     else { /* Fallback. */
       char *c_str = IDP_reprN(kmi->properties, nullptr);
       kmi_props = c_str;
       MEM_freeN(c_str);
     }
   }
   return fmt::format("{}({})", kmi->idname, kmi_props.value_or(""));
 }
 
 #define PRINT \
   if (do_debug_handler) \
   printf
 
 static eHandlerActionFlag wm_handlers_do_keymap_with_keymap_handler(
     /* From 'wm_handlers_do_intern'. */
     bContext *C,
     wmEvent *event,
     ListBase *handlers,
     wmEventHandler_Keymap *handler,
     /* Additional. */
     wmKeyMap *keymap,
     const bool do_debug_handler)
 {
   eHandlerActionFlag action = WM_HANDLER_CONTINUE;
 
   if (keymap == nullptr) {
     /* Only callback is allowed to have nullptr key-maps. */
     BLI_assert(handler->dynamic.keymap_fn);
   }
   else {
     PRINT("%s:   checking '%s' ...", __func__, keymap->idname);
 
     if (WM_keymap_poll(C, keymap)) {
 
       PRINT("pass\n");
 
       LISTBASE_FOREACH (wmKeyMapItem *, kmi, &keymap->items) {
         if (wm_eventmatch(event, kmi)) {
           wmEventHandler_KeymapPost keymap_post = handler->post;
 
           action |= wm_handler_operator_call(
               C, handlers, &handler->head, event, kmi->ptr, kmi->idname);
 
           CLOG_DEBUG(WM_LOG_EVENTS,
                      "Keymap '%s', %s, %s, event: %s",
                      keymap->idname,
                      keymap_handler_log_kmi_op_str(C, kmi).c_str(),
                      keymap_handler_log_action_str(action),
                      keymap_handler_log_kmi_event_str(kmi).value_or("").c_str());
 
           if (action & WM_HANDLER_BREAK) {
             /* Not always_pass here, it denotes removed handler_base. */
             if (keymap_post.post_fn != nullptr) {
               keymap_post.post_fn(keymap, kmi, keymap_post.user_data);
             }
             break;
           }
         }
       }
     }
     else {
       PRINT("fail\n");
     }
   }
 
   return action;
 }
 
 static eHandlerActionFlag wm_handlers_do_keymap_with_gizmo_handler(
     /* From #wm_handlers_do_intern. */
     bContext *C,
     wmEvent *event,
     ListBase *handlers,
     wmEventHandler_Gizmo *handler,
     /* Additional. */
     wmGizmoGroup *gzgroup,
     wmKeyMap *keymap,
     const bool do_debug_handler,
     bool *r_keymap_poll)
 {
   eHandlerActionFlag action = WM_HANDLER_CONTINUE;
   bool keymap_poll = false;
 
   PRINT("%s:   checking '%s' ...", __func__, keymap->idname);
 
   if (WM_keymap_poll(C, keymap)) {
     keymap_poll = true;
     PRINT("pass\n");
     LISTBASE_FOREACH (wmKeyMapItem *, kmi, &keymap->items) {
       if (wm_eventmatch(event, kmi)) {
         PRINT("%s:     item matched '%s'\n", __func__, kmi->idname);
 
         CTX_wm_gizmo_group_set(C, gzgroup);
 
         /* `handler->op` is called later, we want key-map op to be triggered here. */
         action |= wm_handler_operator_call(
             C, handlers, &handler->head, event, kmi->ptr, kmi->idname);
 
         CTX_wm_gizmo_group_set(C, nullptr);
 
         if (action & WM_HANDLER_BREAK) {
           if (G.debug & (G_DEBUG_EVENTS | G_DEBUG_HANDLERS)) {
             printf("%s:       handled - and pass on! '%s'\n", __func__, kmi->idname);
           }
           break;
         }
         if (action & WM_HANDLER_HANDLED) {
           if (G.debug & (G_DEBUG_EVENTS | G_DEBUG_HANDLERS)) {
             printf("%s:       handled - and pass on! '%s'\n", __func__, kmi->idname);
           }
         }
         else {
           PRINT("%s:       un-handled '%s'\n", __func__, kmi->idname);
         }
       }
     }
   }
   else {
     PRINT("fail\n");
   }
 
   if (r_keymap_poll) {
     *r_keymap_poll = keymap_poll;
   }
 
   return action;
 }
 
 static eHandlerActionFlag wm_handlers_do_gizmo_handler(bContext *C,
                                                        wmWindowManager *wm,
                                                        wmEventHandler_Gizmo *handler,
                                                        wmEvent *event,
                                                        const bool always_pass,
                                                        ListBase *handlers,
                                                        const bool do_debug_handler)
 {
   eHandlerActionFlag action = WM_HANDLER_CONTINUE;
 
   /* NOTE(@ideasman42): early exit for always-pass events (typically timers)
    * which pass through from running modal operators which may have started them.
    * In the case of blocking modal operators, it's not expected that gizmos would
    * be used at the same time as navigating or painting for example.
    *
    * In principle these could be handled, however in practice:
    * `handle_highlight` & `handle_keymap` would be set to false for timers,
    * making this function do practically nothing.
    *
    * Early exit to avoid complicating checks below.
    * The early return can be replaced with checks that only run
    * necessary logic if these events need to be handled in the future.
    *
    * Without this, gizmos can become highlighted and the cursor changed
    * while navigating in the 3D viewport, see: #139681. */
   if (always_pass) {
     return action;
   }
 
   /* Drag events use the previous click location to highlight the gizmos,
    * Get the highlight again in case the user dragged off the gizmo. */
   const bool is_event_drag = (event->val == KM_PRESS_DRAG);
   const bool is_event_modifier = ISKEYMODIFIER(event->type);
   /* Only keep the highlight if the gizmo becomes modal as result of event handling.
    * Without this check, even un-handled drag events will set the highlight if the drag
    * was initiated over a gizmo. */
   const bool restore_highlight_unless_activated = is_event_drag;
 
   ScrArea *area = CTX_wm_area(C);
   ARegion *region = CTX_wm_region(C);
   wmGizmoMap *gzmap = handler->gizmo_map;
   BLI_assert(gzmap != nullptr);
   wmGizmo *gz = wm_gizmomap_highlight_get(gzmap);
 
   if (gz && ISMOUSE(event->type) && event->val == KM_PRESS) {
     /* Remove any tooltips on mouse down. #83589 */
     WM_tooltip_clear(C, CTX_wm_window(C));
   }
 
   /* Needed so UI blocks over gizmos don't let events fall through to the gizmos,
    * noticeable for the node editor - where dragging on a node should move it, see: #73212.
    * note we still allow for starting the gizmo drag outside, then travel 'inside' the node. */
   if (region->runtime->type->clip_gizmo_events_by_ui) {
     if (UI_region_block_find_mouse_over(region, event->xy, true)) {
       if (gz != nullptr && event->type != EVT_GIZMO_UPDATE) {
         if (restore_highlight_unless_activated == false) {
           WM_tooltip_clear(C, CTX_wm_window(C));
           wm_gizmomap_highlight_set(gzmap, C, nullptr, 0);
         }
       }
       return action;
     }
   }
 
   struct PrevGizmoData {
     wmGizmo *gz_modal;
     wmGizmo *gz;
     int part;
   };
   PrevGizmoData prev{};
   prev.gz_modal = wm_gizmomap_modal_get(gzmap);
   prev.gz = gz;
   prev.part = gz ? gz->highlight_part : 0;
 
   if (region->runtime->gizmo_map != handler->gizmo_map) {
     WM_gizmomap_tag_refresh(handler->gizmo_map);
   }
 
   wm_gizmomap_handler_context_gizmo(C, handler);
   wm_region_mouse_co(C, event);
 
   bool handle_highlight = false;
   bool handle_keymap = false;
 
   /* Handle gizmo highlighting. */
   if ((prev.gz_modal == nullptr) &&
       ((event->type == MOUSEMOVE) || is_event_modifier || is_event_drag))
   {
     handle_highlight = true;
     if (is_event_modifier || is_event_drag) {
       handle_keymap = true;
     }
   }
   else {
     handle_keymap = true;
   }
 
   /* There is no need to handle this event when the key-map isn't being applied
    * since any change to the highlight will be restored to the previous value. */
   if (restore_highlight_unless_activated) {
     if ((handle_highlight == true) && (handle_keymap == false)) {
       return action;
     }
   }
 
   if (prev.gz_modal == nullptr) {
     if (handle_highlight == false && wm_gizmomap_highlight_pending(gzmap)) {
       handle_highlight = true;
     }
   }
 
   if (handle_highlight) {
     int part = -1;
     gz = wm_gizmomap_highlight_find(gzmap, C, event, &part);
 
     /* If no gizmos are/were active, don't clear tool-tips. */
     if (gz || prev.gz) {
       if ((prev.gz != gz) || (prev.part != part)) {
         WM_tooltip_clear(C, CTX_wm_window(C));
       }
     }
 
     if (wm_gizmomap_highlight_set(gzmap, C, gz, part)) {
       if (gz != nullptr) {
         if ((U.flag & USER_TOOLTIPS) && (gz->flag & WM_GIZMO_NO_TOOLTIP) == 0) {
           WM_tooltip_timer_init(C, CTX_wm_window(C), area, region, WM_gizmomap_tooltip_init);
         }
       }
     }
 
     wm_gizmomap_highlight_handled(gzmap);
   }
 
   /* Don't use from now on. */
   bool is_event_handle_all = gz && (gz->flag & WM_GIZMO_EVENT_HANDLE_ALL);
 
   if (handle_keymap) {
     /* Handle highlight gizmo. */
     if ((gz != nullptr) && (gz->flag & WM_GIZMO_HIDDEN_KEYMAP) == 0) {
       bool keymap_poll = false;
       wmGizmoGroup *gzgroup = gz->parent_gzgroup;
       wmKeyMap *keymap = WM_keymap_active(wm, gz->keymap ? gz->keymap : gzgroup->type->keymap);
       action |= wm_handlers_do_keymap_with_gizmo_handler(
           C, event, handlers, handler, gzgroup, keymap, do_debug_handler, &keymap_poll);
 
 #ifdef USE_GIZMO_MOUSE_PRIORITY_HACK
       if (((action & WM_HANDLER_BREAK) == 0) && !is_event_handle_all && keymap_poll) {
         if ((event->val == KM_PRESS) && ELEM(event->type, LEFTMOUSE, MIDDLEMOUSE, RIGHTMOUSE)) {
 
           wmEvent event_test_click = *event;
           event_test_click.val = KM_CLICK;
 
           wmEvent event_test_press_drag = *event;
           event_test_press_drag.val = KM_PRESS_DRAG;
 
           LISTBASE_FOREACH (wmKeyMapItem *, kmi, &keymap->items) {
             if ((kmi->flag & KMI_INACTIVE) == 0) {
               if (wm_eventmatch(&event_test_click, kmi) ||
                   wm_eventmatch(&event_test_press_drag, kmi))
               {
                 wmOperatorType *ot = WM_operatortype_find(kmi->idname, false);
                 const bool success = WM_operator_poll_context(
                     C, ot, blender::wm::OpCallContext::InvokeDefault);
                 if (success) {
                   is_event_handle_all = true;
                   break;
                 }
               }
             }
           }
         }
       }
 #endif /* `USE_GIZMO_MOUSE_PRIORITY_HACK` */
     }
 
     /* Don't use from now on. */
     gz = nullptr;
 
     /* Fall back to selected gizmo (when un-handled). */
     if ((action & WM_HANDLER_BREAK) == 0) {
       if (WM_gizmomap_is_any_selected(gzmap)) {
         const ListBase *groups = WM_gizmomap_group_list(gzmap);
         LISTBASE_FOREACH (wmGizmoGroup *, gzgroup, groups) {
           if (wm_gizmogroup_is_any_selected(gzgroup)) {
             wmKeyMap *keymap = WM_keymap_active(wm, gzgroup->type->keymap);
             action |= wm_handlers_do_keymap_with_gizmo_handler(
                 C, event, handlers, handler, gzgroup, keymap, do_debug_handler, nullptr);
             if (action & WM_HANDLER_BREAK) {
               break;
             }
           }
         }
       }
     }
   }
 
   if (handle_highlight) {
     if (restore_highlight_unless_activated) {
       /* Check handling the key-map didn't activate a gizmo. */
       wmGizmo *gz_modal = wm_gizmomap_modal_get(gzmap);
       if (!(gz_modal && (gz_modal != prev.gz_modal))) {
         wm_gizmomap_highlight_set(gzmap, C, prev.gz, prev.part);
       }
     }
   }
 
   if (is_event_handle_all) {
     if (action == WM_HANDLER_CONTINUE) {
       action |= WM_HANDLER_BREAK | WM_HANDLER_MODAL;
     }
   }
 
   /* Restore the area. */
   CTX_wm_area_set(C, area);
   CTX_wm_region_set(C, region);
 
   return action;
 }
 
