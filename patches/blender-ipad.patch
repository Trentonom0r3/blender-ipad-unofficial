+    slot_index: bpy.props.IntProperty(default=0, min=0, max=3, options={'HIDDEN', 'SKIP_SAVE'})
+    offset: bpy.props.FloatVectorProperty(name="Offset", size=3, default=(0, 0, 0),
+                                         subtype='TRANSLATION', unit='LENGTH', options={'SKIP_SAVE'})
+    factors: bpy.props.FloatVectorProperty(name="Factors", size=3, default=(1, 1, 1),
+                                          options={'SKIP_SAVE'})
+    angle: bpy.props.FloatProperty(name="Angle", default=0, subtype='ANGLE', unit='ROTATION',
