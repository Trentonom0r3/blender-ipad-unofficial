+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* Included after GHOST_ProjectSaveIOS.hh by GHOST_SystemIOS.mm. A Recent
+ * provider document is inspected without touching its app-owned working file.
+ * Blender decides whether the current scene may be replaced. */
+#include <string>
+#include <cstdint>
+#include <climits>
+#import <dispatch/dispatch.h>
+
+class GHOST_EventIOSRecentProjectReady final : public GHOST_Event {
+  std::string path_;
+  GHOST_IOSRecentProjectOpenData payload_;
+
+ public:
+  GHOST_EventIOSRecentProjectReady(uint64_t time,
+                                   GHOST_IWindow *window,
+                                   NSString *path,
+                                   int ticket,
+                                   bool loadUISet,
+                                   bool loadUI,
+                                   bool useScriptsSet,
+                                   bool useScripts)
+      : GHOST_Event(time, GHOST_kEventIOSRecentProjectReady, window),
+        path_(path.UTF8String ? path.UTF8String : "")
+  {
+    payload_ = {path_.c_str(), ticket, loadUISet, loadUI, useScriptsSet, useScripts};
+    data_ = &payload_;
+  }
+};
+
+@interface GHOST_IOSRecentProjectOpener : NSObject
+{
+  GHOST_IWindow *_window;
+  UIViewController *_presenter;
+  UIAlertController *_sheet;
+  NSString *_workingPath;
+  NSString *_documentPath;
+  NSData *_bookmark;
+  NSData *_expectedDigest;
+  NSData *_localDigest;
+  NSData *_providerDigest;
+  NSData *_renewedBookmark;
+  NSURL *_stageDirectory;
+  NSURL *_stageFile;
+  NSURL *_backupFile;
+  NSUInteger _generation;
+  int _ticket;
+  BOOL _busy;
+  BOOL _ready;
+  BOOL _refresh;
+  BOOL _openLocalCopy;
+  BOOL _installed;
+  BOOL _bookmarkUpdated;
+  bool _loadUISet;
+  bool _loadUI;
+  bool _useScriptsSet;
+  bool _useScripts;
+}
+- (BOOL)begin:(NSString *)path
+    loadUISet:(bool)loadUISet
+       loadUI:(bool)loadUI
+useScriptsSet:(bool)useScriptsSet
+   useScripts:(bool)useScripts;
+- (GHOST_IOSRecentProjectCommit)commit:(NSString *)path ticket:(int)ticket;
+- (BOOL)isReady:(NSString *)path ticket:(int)ticket;
+- (void)continueAfterChoice:(NSUInteger)generation retry:(BOOL)retry remaining:(int)remaining;
+- (void)finishOpen:(int)ticket success:(BOOL)success;
+- (void)cancel;
+@end
