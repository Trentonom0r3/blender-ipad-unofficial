+def ipad_transform_state(context):
+    active = ToolSelectPanelHelper.tool_active_from_context(context)
+    if active is None:
+        return None
+    if active.idname == 'builtin.transform':
+        action = active.gizmo_group_properties('VIEW3D_GGT_xform_gizmo').drag_action
+        if action not in IPAD_TRANSFORM_ACTIONS:
+            return active, None, None, 1
+        operation, operator = IPAD_TRANSFORM_ACTIONS[action]
+        slot = 1
+    elif active.idname in IPAD_TRANSFORM_TOOLS:
+        operation, operator, slot = IPAD_TRANSFORM_TOOLS[active.idname]
+    else:
+        return None
+    return active, operation, operator, slot
