+/* Value-only physical-contact ownership is separate from rendered HUD pixels.
+ * Only the exact native Redo callback can advance its own accepted history. */
+#ifdef WITH_APPLE_CROSSPLATFORM
+struct uiIPadHUDField {
+  uint64_t generation = 0, serial = 0, button = 0, hud_address = 0, hud_lifetime = 0;
+  std::array<uint64_t, 13> context{};
+  std::string tool;
+  uint64_t undo_address = 0, undo_lifetime = 0, undo_mutation = 0;
+  int width = 0, height = 0;
+  float scale = 0;
+  uint64_t outer_address = 0, outer_lifetime = 0, owner_address = 0, owner_lifetime = 0;
+  uiIPadOperatorReceipt type{}, outer_type{};
+  uint64_t properties_address = 0, property_address = 0;
+  std::string property;
+  int index = -1, length = 0, property_type = 0;
+  bool native_property = false, native_numeric = false;
+  bool physical_terminal = false;
+};
+static std::unordered_map<uint64_t, uiIPadHUDField> ui_ipad_hud_fields;
+struct uiIPadHUDContactState { uint64_t serial = 0, ended_serial = 0; };
+static std::unordered_map<uintptr_t, uiIPadHUDContactState> ui_ipad_hud_contacts;
+
+
+static bool ui_ipad_hud_bound_numeric(const uiBut *but)
+{
+  const auto found = ui_ipad_hud_fields.find(but->ipad_ui_lifetime);
+  return found != ui_ipad_hud_fields.end() && found->second.native_numeric;
+}
+static bool ui_ipad_hud_single_numeric(const uiBut *but)
+{
+  const uiHandleButtonData *data = but->active;
+  if (!data) return true;
+#ifdef USE_DRAG_MULTINUM
+  if (data->multi_data.has_mbuts || data->multi_data.mbuts || data->multi_data.bs_mbuts ||
+      ELEM(data->multi_data.init, uiHandleButtonMulti::INIT_SETUP, uiHandleButtonMulti::INIT_ENABLE))
+    return false;
+#endif
+#ifdef USE_ALLSELECT
+  if (data->select_others.is_enabled || !data->select_others.elems.is_empty()) return false;
+#endif
+  return true;
+}
+
+static uiBut *ui_ipad_hud_field_button(bContext *C, const uiIPadHUDField &field,
+                                       ARegion **result_region = nullptr)
+{
+  Main *main = CTX_data_main(C); wmWindowManager *wm = CTX_wm_manager(C);
+  wmWindow *win = CTX_wm_window(C);
+  if (!main || uintptr_t(main) != field.context[0] || !wm ||
+      BLI_findindex(&main->wm, wm) == -1 || wm->id.session_uid != field.context[12] ||
+      !win || BLI_findindex(&wm->windows, win) == -1 || uintptr_t(win) != field.context[1] ||
+      uint64_t(win->winid) != field.context[11]) return nullptr;
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!screen || uintptr_t(screen) != field.context[2] || screen->id.session_uid != field.context[5])
+    return nullptr;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (uintptr_t(area) != field.context[3]) continue;
+    LISTBASE_FOREACH (ARegion *, hud, &area->regionbase) {
+      if (hud->regiontype != RGN_TYPE_HUD || uintptr_t(hud) != field.hud_address ||
+          hud->runtime->ipad_hud_content_lifetime != field.hud_lifetime) continue;
+      LISTBASE_FOREACH (uiBlock *, block, &hud->runtime->uiblocks) {
+        if (!block->active) continue;
+        for (const auto &candidate : block->buttons) {
+          if (candidate->ipad_ui_lifetime == field.button && candidate->block == block) {
+            if (result_region) *result_region = hud;
+            return candidate.get();
+          }
+        }
+      }
+    }
+  }
+  return nullptr;
+}
+
+static bool ui_ipad_hud_field_world(bContext *C, uiBut *but, ARegion *hud,
+                                     uiIPadHUDField &field)
+{
+  const uintptr_t previous_area = uintptr_t(CTX_wm_area(C)), previous_region = uintptr_t(CTX_wm_region(C));
+  wmWindowManager *wm = CTX_wm_manager(C); wmWindow *win = CTX_wm_window(C);
+  if (!wm || !win || BLI_findindex(&wm->windows, win) == -1) return false;
+  bScreen *screen = WM_window_get_active_screen(win);
+  ScrArea *area = nullptr;
+  LISTBASE_FOREACH (ScrArea *, candidate, &screen->areabase) {
+    if (BLI_findindex(&candidate->regionbase, hud) != -1) { area = candidate; break; }
+  }
+  if (!area || hud->regiontype != RGN_TYPE_HUD || !hud->runtime->visible ||
+      (hud->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED))) return false;
+  CTX_wm_area_set(C, area);
+  ARegion *canvas = UI_ipad_corner_hud_window(C, area, hud);
+  if (!canvas) { ui_ipad_action_context_restore(C, previous_area, previous_region); return false; }
+  CTX_wm_region_set(C, canvas);
+  const bool captured = UI_ipad_context_capture(C, field.context.data()) && WM_event_ipad_mode_safe(C);
+  if (captured) {
+    field.tool = ui_ipad_ring_tool_identity(C);
+    const auto pixels = WM_window_native_pixel_size(win);
+    field.width = pixels[0]; field.height = pixels[1]; field.scale = UI_SCALE_FAC;
+    const UndoStack *undo = wm->runtime ? wm->runtime->undo_stack : nullptr;
+    field.undo_address = uint64_t(uintptr_t(undo));
+    field.undo_lifetime = undo ? undo->ipad_lifetime_id : 0;
+    field.undo_mutation = undo ? undo->ipad_mutation_generation : 0;
+    field.button = but->ipad_ui_lifetime; field.hud_address = uint64_t(uintptr_t(hud));
+    field.hud_lifetime = hud->runtime->ipad_hud_content_lifetime;
+    if (but->block->name == "OPERATOR_PT_redo") {
+      wmOperator *outer = WM_operator_last_redo(C);
+      if (!outer || BLI_findindex(&wm->runtime->operators, outer) == -1 ||
+          !(field.outer_type = ui_ipad_operator_capture(outer->type)).lifetime)
+      {
+        ui_ipad_action_context_restore(C, previous_area, previous_region);
+        return false;
+      }
+      field.outer_address = uint64_t(uintptr_t(outer));
+      field.outer_lifetime = WM_operator_touch_lifetime_id(outer);
+      if (!field.outer_lifetime) {
+        ui_ipad_action_context_restore(C, previous_area, previous_region);
+        return false;
+      }
+    }
+  }
+  ui_ipad_action_context_restore(C, previous_area, previous_region);
+  return captured;
+}
+
+static wmOperator *ui_ipad_hud_operator_tree_owner(wmOperator *op, const uiBut *but,
+                                                   int &budget, int depth = 0)
+{
+  if (!op || --budget < 0 || depth > 8) return nullptr;
+  wmOperatorType *type = ui_ipad_operator_type_live(uint64_t(uintptr_t(op->type)));
+  if (!type || !op->ptr || !op->properties || op->properties->type != IDP_GROUP ||
+      op->ptr->type != type->srna || op->ptr->data != op->properties) return nullptr;
+  if (but->rnapoin.owner_id == op->ptr->owner_id && but->rnapoin.type == type->srna &&
+      but->rnapoin.data == op->properties) return op;
+  LISTBASE_FOREACH (wmOperator *, child, &op->macro) {
+    if (wmOperator *found = ui_ipad_hud_operator_tree_owner(child, but, budget, depth + 1)) return found;
+  }
+  return nullptr;
+}
+
+static bool ui_ipad_hud_numeric_profile(bContext *C, uiBut *but, uiIPadHUDField &field)
+{
+  uiBlock *block = but->block;
+  if (block->name != "OPERATOR_PT_redo" || block->handle_func != ED_undo_operator_repeat_cb_evt ||
+      !but->rnaprop) return false;
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || !wm->runtime) return false;
+  wmOperator *outer = WM_operator_last_redo(C);
+  if (!wm || !outer || BLI_findindex(&wm->runtime->operators, outer) == -1 ||
+      block->handle_func_arg != outer || but->rnapoin.owner_id != &wm->id) return false;
+  int budget = 256;
+  wmOperator *owner = ui_ipad_hud_operator_tree_owner(outer, but, budget);
+  if (!owner) return false;
+  const auto type = ui_ipad_operator_capture(owner->type);
+  if (!type.lifetime) return false;
+  wmOperatorType *registered_type = ui_ipad_operator_resolve(type);
+  if (!registered_type) return false;
+  PropertyRNA *property = nullptr;
+  /* Compare incoming metadata numerically to the fresh schema enumeration;
+   * never ask a potentially retired PropertyRNA for its identifier. */
+  RNA_STRUCT_BEGIN (owner->ptr, fresh) {
+    if (fresh == but->rnaprop) { property = fresh; break; }
+  }
+  RNA_STRUCT_END;
+  if (!property) return false;
+  const int length = RNA_property_array_length(owner->ptr, property);
+  if ((length && (but->rnaindex < 0 || but->rnaindex >= length)) ||
+      (!length && but->rnaindex != 0)) return false;
+  field.outer_address = uint64_t(uintptr_t(outer));
+  field.outer_lifetime = WM_operator_touch_lifetime_id(outer);
+  field.owner_address = uint64_t(uintptr_t(owner));
+  field.owner_lifetime = WM_operator_touch_lifetime_id(owner);
+  field.type = type; field.properties_address = uint64_t(uintptr_t(owner->properties));
+  field.property_address = uint64_t(uintptr_t(property));
+  field.property = RNA_property_identifier(property); field.index = but->rnaindex;
+  field.length = length; field.property_type = RNA_property_type(property);
+  field.native_property = field.outer_lifetime && field.owner_lifetime;
+  field.native_numeric = field.native_property && !registered_type->rna_ext.srna &&
+      ELEM(but->type, ButType::Num, ButType::NumSlider) &&
+      ELEM(field.property_type, PROP_FLOAT, PROP_INT) &&
+      (RNA_property_flag(property) & PROP_IDPROPERTY) &&
+      !but->func && !but->funcN && !but->apply_func && !but->optype && !but->rename_func &&
+      !but->rename_full_func && !but->identity_cmp_func;
+  return field.native_property;
+}
+
+static bool ui_ipad_hud_same_field(const uiIPadHUDField &a, const uiIPadHUDField &b,
+                                   bool history = true)
+{
+  if (a.button != b.button || a.hud_address != b.hud_address || a.hud_lifetime != b.hud_lifetime ||
+      a.width != b.width || a.height != b.height || a.scale != b.scale || a.tool != b.tool ||
+      a.outer_address != b.outer_address || a.outer_lifetime != b.outer_lifetime ||
+      a.outer_type.address != b.outer_type.address || a.outer_type.lifetime != b.outer_type.lifetime ||
+      a.outer_type.srna_address != b.outer_type.srna_address) return false;
+  if (history && (a.context != b.context || a.undo_address != b.undo_address ||
+      a.undo_lifetime != b.undo_lifetime || a.undo_mutation != b.undo_mutation)) return false;
+  if (!history) {
+    for (int index : {0, 1, 2, 3, 4, 5, 9, 11, 12})
+      if (a.context[index] != b.context[index]) return false;
+  }
+  return !a.native_property || (b.native_property && a.native_numeric == b.native_numeric && a.outer_address == b.outer_address &&
+      a.outer_lifetime == b.outer_lifetime && a.owner_address == b.owner_address &&
+      a.owner_lifetime == b.owner_lifetime && a.type.address == b.type.address &&
+      a.type.lifetime == b.type.lifetime && a.type.srna_address == b.type.srna_address &&
+      a.properties_address == b.properties_address && a.property_address == b.property_address &&
+      a.property == b.property && a.index == b.index && a.length == b.length &&
+      a.property_type == b.property_type);
+}
+
+static bool ui_ipad_hud_field_proof(bContext *C, const uiIPadHUDField &field,
+                                    uiIPadHUDField *current = nullptr, bool history = true)
+{
+  ARegion *hud = nullptr; uiBut *but = ui_ipad_hud_field_button(C, field, &hud);
+  if (!but) return false;
+  uiIPadHUDField fresh = field;
+  if (!ui_ipad_hud_field_world(C, but, hud, fresh)) return false;
+  if (field.native_property && !ui_ipad_hud_numeric_profile(C, but, fresh)) return false;
+  if (!field.native_property && but->block->ipad_action_origin.present() &&
+      (!ui_ipad_but_self_callback_allowed(C, but) || !ui_ipad_but_rna_rebind(C, but))) return false;
+  if (!ui_ipad_hud_same_field(field, fresh, history)) return false;
+  if (current) *current = std::move(fresh);
+  return true;
+}
+
+static void ui_ipad_hud_field_retire(bContext *C, const uiIPadHUDField field)
+{
+  const auto found = ui_ipad_hud_fields.find(field.button);
+  if (found == ui_ipad_hud_fields.end() || found->second.serial != field.serial) return;
+  const auto contact = ui_ipad_hud_contacts.find(uintptr_t(field.context[1]));
+  if (contact != ui_ipad_hud_contacts.end() && contact->second.serial == field.serial)
+    contact->second.ended_serial = field.serial; /* Shield the rest of this refused stream. */
+  ui_ipad_hud_fields.erase(found); /* Erase before native disposal/reentrancy. */
+  ARegion *hud = nullptr; uiBut *but = ui_ipad_hud_field_button(C, field, &hud);
+  if (!but) return;
+  but->ipad_callback_retired = true; but->flag |= UI_BUT_DISABLED;
+  if (!but->active && !but->semi_modal_state) return;
+  const uintptr_t area = uintptr_t(CTX_wm_area(C)), region = uintptr_t(CTX_wm_region(C));
+  bScreen *screen = WM_window_get_active_screen(CTX_wm_window(C));
+  LISTBASE_FOREACH (ScrArea *, live, &screen->areabase) {
+    if (BLI_findindex(&live->regionbase, hud) != -1) { CTX_wm_area_set(C, live); break; }
+  }
+  CTX_wm_region_set(C, hud);
+  if (but->semi_modal_state && but->semi_modal_state != but->active)
+    ui_but_semi_modal_state_free(C, but);
+  /* Reacquire after each disposal callback; no old But/hud/frame access. */
+  but = ui_ipad_hud_field_button(C, field);
+  if (but && but->active) ui_but_active_free(C, but);
+  ui_ipad_action_context_restore(C, area, region);
+}
+
+static uint64_t ui_ipad_hud_field_for_button(const uiBut *but)
+{
+  return ui_ipad_hud_fields.count(but->ipad_ui_lifetime) ? but->ipad_ui_lifetime : 0;
+}
+static bool ui_ipad_hud_field_allowed(bContext *C, uint64_t uid)
+{
+  if (!uid) return true;
+  const auto it = ui_ipad_hud_fields.find(uid);
+  return it != ui_ipad_hud_fields.end() && ui_ipad_hud_field_proof(C, it->second);
+}
+static bool ui_ipad_hud_button_input(bContext *C, const wmEvent *event, uiBut *but)
+{
+  const auto old = ui_ipad_hud_fields.find(but->ipad_ui_lifetime);
+  if (old != ui_ipad_hud_fields.end()) {
+    const uiIPadHUDField receipt = old->second;
+    if (receipt.physical_terminal && !event->ipad_hud_generation && event->type == LEFTMOUSE &&
+        event->val == KM_PRESS && but->active && but->active->state == BUTTON_STATE_HIGHLIGHT)
+    {
+      /* A genuinely new hardware press follows the completed native UI exit
+       * and its deferred callbacks. Do not disable the new native interaction.
+       * Keyboard continuation of Pencil-created text editing keeps its receipt. */
+      ui_ipad_hud_fields.erase(old);
+    }
+    else {
+      if (!ui_ipad_hud_field_proof(C, receipt) ||
+          (receipt.native_numeric && !ui_ipad_hud_single_numeric(but)))
+      { ui_ipad_hud_field_retire(C, receipt); return false; }
+      if (receipt.physical_terminal && event->ipad_hud_generation == receipt.generation &&
+          event->ipad_hud_serial == receipt.serial) return false;
+    }
+  }
+  if (!event->ipad_hud_generation || !event->ipad_hud_serial || event->type != LEFTMOUSE ||
+      event->val != KM_PRESS || !but->active || but->active->state != BUTTON_STATE_HIGHLIGHT)
+    return true;
+  ARegion *hud = but->active->region;
+  if (!hud || hud->regiontype != RGN_TYPE_HUD) return true;
+  int x = event->xy[0], y = event->xy[1];
+  ui_window_to_block(hud, but->block, &x, &y);
+  if (!BLI_rctf_isect_pt(&but->rect, float(x), float(y))) return true;
+  if (!ED_ipad_hud_input_admit(C, CTX_wm_window(C), event->ipad_hud_generation)) return false;
+  uiIPadHUDField field;
+  field.generation = event->ipad_hud_generation; field.serial = event->ipad_hud_serial;
+  if (!ui_ipad_hud_field_world(C, but, hud, field)) return false;
+  const bool profile = ui_ipad_hud_numeric_profile(C, but, field);
+  if (but->block->name == "OPERATOR_PT_redo" && but->rnaprop && !profile) return false;
+  if (field.native_numeric) {
+    if (!ui_ipad_hud_single_numeric(but)) return false;
+#ifdef USE_DRAG_MULTINUM
+    /* This physical receipt proves one field, not a vertical-drag selection of
+     * sibling properties. Disable setup before native numeric dispatch. */
+    but->active->multi_data.init = uiHandleButtonMulti::INIT_DISABLE;
+#endif
+  }
+  /* Prune lost/inactive records before binding a fresh physical press. */
+  for (auto it = ui_ipad_hud_fields.begin(); it != ui_ipad_hud_fields.end();) {
+    uiBut *live = ui_ipad_hud_field_button(C, it->second);
+    if (!live || (!live->active && !live->semi_modal_state)) it = ui_ipad_hud_fields.erase(it);
+    else ++it;
+  }
+  if (ui_ipad_hud_fields.size() >= 64 && !ui_ipad_hud_fields.count(field.button)) return false;
+  ui_ipad_hud_fields[field.button] = std::move(field);
+  return true;
+}
+
+static bool ui_ipad_hud_numeric_pointer_terminal(bContext *C, uiBut *but, const wmEvent *event)
+{
+  if (event->type != LEFTMOUSE || event->val != KM_RELEASE ||
+      !event->ipad_hud_generation || !event->ipad_hud_serial) return false;
+  const auto found = ui_ipad_hud_fields.find(but->ipad_ui_lifetime);
+  if (found == ui_ipad_hud_fields.end()) return false;
+  const uiIPadHUDField receipt = found->second;
+  if (!receipt.native_numeric || receipt.physical_terminal ||
+      receipt.generation != event->ipad_hud_generation || receipt.serial != event->ipad_hud_serial ||
+      !ui_ipad_hud_single_numeric(but) || !ui_ipad_hud_field_proof(C, receipt)) return false;
+  const auto live = ui_ipad_hud_fields.find(receipt.button);
+  if (live == ui_ipad_hud_fields.end() || live->second.serial != receipt.serial) return false;
+  live->second.physical_terminal = true;
+  /* Keep the value receipt for native exit/application and its deferred Redo.
+   * Any duplicate physical terminal is consumed before UI dispatch. */
+  return (event->flag & WM_EVENT_IS_POINTER_CANCEL) != 0;
+}
+
+static bool ui_ipad_hud_native_repeat(bContext *C, uint64_t uid, const void *argument)
+{
+  const auto it = ui_ipad_hud_fields.find(uid);
+  if (it == ui_ipad_hud_fields.end()) return false;
+  const uiIPadHUDField before = it->second;
+  if (!before.native_numeric) return false; /* Ordinary terminal native controls retain their callback. */
+  if (before.outer_address != uint64_t(uintptr_t(argument)) ||
+      !ui_ipad_hud_field_proof(C, before)) { ui_ipad_hud_field_retire(C, before); return true; }
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmOperator *outer = nullptr;
+  LISTBASE_FOREACH (wmOperator *, live, &wm->runtime->operators) {
+    if (uint64_t(uintptr_t(live)) == before.outer_address &&
+        WM_operator_touch_lifetime_matches(live, before.outer_lifetime)) { outer = live; break; }
+  }
+  if (!outer) { ui_ipad_hud_field_retire(C, before); return true; }
+  if (!ED_undo_operator_repeat(C, outer)) {
+    ui_ipad_hud_field_retire(C, before); return true;
+  } /* Exactly one native repeat, no extra Undo. */
+  uiIPadHUDField after;
+  if (ui_ipad_hud_field_proof(C, before, &after, false)) {
+    const auto still = ui_ipad_hud_fields.find(uid);
+    if (still != ui_ipad_hud_fields.end() && still->second.serial == before.serial)
+      still->second = std::move(after); /* Only this callback advances its field's history. */
+  }
+  else ui_ipad_hud_field_retire(C, before);
+  return true;
+}
+#else
+static uint64_t ui_ipad_hud_field_for_button(const uiBut *) { return 0; }
+static bool ui_ipad_hud_field_allowed(bContext *, uint64_t) { return true; }
+static bool ui_ipad_hud_button_input(bContext *, const wmEvent *, uiBut *) { return true; }
+static bool ui_ipad_hud_native_repeat(bContext *, uint64_t, const void *) { return false; }
+static bool ui_ipad_hud_bound_numeric(const uiBut *) { return false; }
+static bool ui_ipad_hud_numeric_pointer_terminal(bContext *, uiBut *, const wmEvent *) { return false; }
+#endif
+
+bool ui_ipad_hud_button_owner_allowed(bContext *C, const uiBut *but)
+{
+  return ui_ipad_hud_field_allowed(C, ui_ipad_hud_field_for_button(but));
+}
+
+bool UI_ipad_hud_event_admit(bContext *C, wmWindow *win, const wmEvent *event)
+{
+#ifdef WITH_APPLE_CROSSPLATFORM
+  if (!event->ipad_hud_generation) return true;
+  if (!event->ipad_hud_serial || event->ipad_hud_serial == UINT64_MAX) return false;
+  /* Physical contact serials never wrap/restart within the GHOST process.
+   * Even an unchanged presentation cannot turn an old terminal into the
+   * release of a newer field. Store no borrowed window/context owner. */
+
+  const uintptr_t window = uintptr_t(win);
+  const auto previous = ui_ipad_hud_contacts.find(window);
+  const uint64_t serial = previous == ui_ipad_hud_contacts.end() ? 0 : previous->second.serial;
+  if (previous != ui_ipad_hud_contacts.end() && event->ipad_hud_serial <= previous->second.ended_serial)
+    return false;
+  if (event->ipad_hud_serial < serial) return false;
+  if (event->ipad_hud_serial > serial && event->type != MOUSEMOVE &&
+      !(event->type == LEFTMOUSE && event->val == KM_PRESS)) return false;
+  /* A known physical release ends that contact before any proof or onfree
+   * disposal. This denies future input, without granting value restoration.
+   * The current first release still needs its full field/presentation proof. */
+  if (previous != ui_ipad_hud_contacts.end() && event->ipad_hud_serial == serial &&
+      event->type == LEFTMOUSE && event->val == KM_RELEASE)
+    previous->second.ended_serial = serial;
+  auto remember_contact = [&]() {
+    if (ui_ipad_hud_contacts.size() >= 64) {
+      wmWindowManager *wm = CTX_wm_manager(C);
+      for (auto it = ui_ipad_hud_contacts.begin(); it != ui_ipad_hud_contacts.end();) {
+        bool live = false;
+        if (wm) LISTBASE_FOREACH (wmWindow *, candidate, &wm->windows) {
+          live |= uintptr_t(candidate) == it->first;
+        }
+        if (!live) it = ui_ipad_hud_contacts.erase(it); else ++it;
+      }
+    }
+    if (ui_ipad_hud_contacts.size() >= 64 && !ui_ipad_hud_contacts.count(window)) return false;
+    uiIPadHUDContactState &state = ui_ipad_hud_contacts[window];
+    state.serial = event->ipad_hud_serial;
+    if (event->type == LEFTMOUSE && event->val == KM_RELEASE)
+      state.ended_serial = event->ipad_hud_serial;
+    return true;
+  };
+  for (const auto &entry : ui_ipad_hud_fields) {
+    const uiIPadHUDField receipt = entry.second;
+    if (receipt.generation != event->ipad_hud_generation || receipt.serial != event->ipad_hud_serial)
+      continue;
+    if (receipt.physical_terminal) return false;
+    if (ui_ipad_hud_field_proof(C, receipt)) return remember_contact();
+    ui_ipad_hud_field_retire(C, receipt); return false;
+  }
+  return ED_ipad_hud_input_admit(C, win, event->ipad_hud_generation) && remember_contact();
+#else
+  UNUSED_VARS(C, win, event); return true;
+#endif
+}
