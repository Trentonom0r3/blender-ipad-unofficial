+static bool ui_ipad_rna_id_matches(bContext *C,
+                                  const blender::ui::ipad::ActionOrigin &origin,
+                                  const uiIPadRNAReceipt &receipt)
+{
+  if (!ui_ipad_action_origin_valid(C, origin) || !ui_ipad_rna_history_matches(C, receipt))
+    return false;
+  ID *id = ui_ipad_rna_id_root(C, receipt.owner);
+  Main *main = CTX_data_main(C);
+  /* Stored UID/type lookup reads only current Main members, never a context
+   * candidate that may have been removed or replaced during a callback. */
+  if (!main || !id || ui_ipad_rna_address(id) != receipt.owner_address ||
+      BKE_libblock_find_session_uid(main, receipt.owner_id_type, receipt.owner_uid) != id)
+    return false;
+  if (ui_ipad_rna_is_tool(receipt.owner)) {
+    PointerRNA root;return ui_ipad_rna_tool_root(C, receipt, root);
+  }
+  return true;
+}
