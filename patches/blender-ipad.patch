+uiIPadButtonLease ui_ipad_button_lease_capture(const uiBut *but)
+{
+  uiIPadButtonLease lease;
+  const uiBlock *block = but->block;
+  lease.origin = block->ipad_action_origin;
+  if (!lease.origin.present()) return lease;
+  lease.popup_lifetime = block->handle ? block->handle->ipad_popup_lifetime : 0;
+#ifdef WITH_APPLE_CROSSPLATFORM
+  if (!block->handle && block->ipad_corner_block_lifetime) {
+    lease.corner_block_lifetime = block->ipad_corner_block_lifetime;
+    lease.corner_region_address = block->ipad_corner_region_address;
+    lease.corner_block_address = uint64_t(uintptr_t(block));
+  }
+#endif
+  lease.button_lifetime = but->ipad_ui_lifetime;
+  lease.button_address = uint64_t(reinterpret_cast<uintptr_t>(but));
+  return lease;
+}
+
+uiBut *ui_ipad_button_lease_resolve(bContext *C, const uiIPadButtonLease &lease)
+{
+  if (!lease.origin.present() || (!lease.popup_lifetime && !lease.corner_block_lifetime) || !lease.button_lifetime ||
+      !lease.button_address || !ui_ipad_action_origin_valid(C, lease.origin)) return nullptr;
+  wmWindow *win = CTX_wm_window(C);
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!win || !wm || BLI_findindex(&wm->windows, win) == -1) return nullptr;
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!screen) return nullptr;
+#ifdef WITH_APPLE_CROSSPLATFORM
+  if (lease.corner_block_lifetime) {
+    if (!lease.origin.corner || !lease.corner_region_address || !lease.corner_block_address)
+      return nullptr;
+    LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+      if (uint64_t(uintptr_t(area)) != lease.origin.context[3]) continue;
+      LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+        if (region->regiontype != RGN_TYPE_HUD ||
+            uint64_t(uintptr_t(region)) != lease.corner_region_address ||
+            !region->runtime->visible ||
+            (region->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED))) continue;
+        LISTBASE_FOREACH (uiBlock *, block, &region->runtime->uiblocks) {
+          if (!block->active || block->handle ||
+              block->ipad_corner_block_lifetime != lease.corner_block_lifetime ||
+              uint64_t(uintptr_t(block)) != lease.corner_block_address ||
+              block->ipad_action_origin.context != lease.origin.context ||
+              block->ipad_action_origin.lifetime != lease.origin.lifetime ||
+              std::memcmp(block->ipad_action_origin.tool, lease.origin.tool,
+                          sizeof(lease.origin.tool)) != 0 ||
+              !ui_ipad_corner_history_matches(C, block)) continue;
+          for (const std::unique_ptr<uiBut> &candidate : block->buttons) {
+            if (candidate->block == block && candidate->ipad_ui_lifetime == lease.button_lifetime &&
+                uint64_t(uintptr_t(candidate.get())) == lease.button_address) return candidate.get();
+          }
+        }
+      }
+    }
+    return nullptr;
+  }
+#endif
+  /* Native popup regions own their blocks, including nested children which
+   * have no separate WM handler. Start at these live lists, never saved UI. */
+  LISTBASE_FOREACH (ARegion *, region, &screen->regionbase) {
+    LISTBASE_FOREACH (uiBlock *, block, &region->runtime->uiblocks) {
+      if (!block->active || !block->handle || block->handle->region != region ||
+          block->handle->ipad_popup_lifetime != lease.popup_lifetime ||
+          (block->handle->menuretval & UI_RETURN_CANCEL) ||
+          block->ipad_action_origin.lifetime != lease.origin.lifetime ||
+          block->ipad_action_origin.context != lease.origin.context ||
+          std::memcmp(block->ipad_action_origin.tool, lease.origin.tool,
+                      sizeof(lease.origin.tool)) != 0) continue;
+      for (const std::unique_ptr<uiBut> &candidate : block->buttons) {
+        if (candidate->block == block && candidate->ipad_ui_lifetime == lease.button_lifetime &&
+            uint64_t(reinterpret_cast<uintptr_t>(candidate.get())) == lease.button_address)
+          return candidate.get();
+      }
+    }
+  }
+  return nullptr;
+}
+
+static uint64_t ui_ipad_rna_address(const void *value)
+{
+  return uint64_t(reinterpret_cast<uintptr_t>(value));
+}
