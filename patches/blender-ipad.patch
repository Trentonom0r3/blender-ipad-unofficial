+
+def ipad_draw_native_tool_inventory(layout, context, *, more_tools=False):
+    """Native tools; the owned compositor presents only nine at a time."""
+    layout.operator_context = 'INVOKE_REGION_WIN'
+    active = ToolSelectPanelHelper.tool_active_from_context(context)
+    active_id = active.idname if active else ''
+    receipt = ipad_native_inventory_receipt(context)
+    home_labels = {name: label for label, name, _ in IPAD_RADIAL_TOOLS}
+    tools = ipad_more_tool_inventory(context) if more_tools else ipad_native_tool_inventory(context)
+    for tool in tools:
+        label = home_labels.get(tool.idname, tool.label) if context.mode in {'OBJECT', 'EDIT_MESH'} else tool.label
+        selected = active_id == tool.idname
+        # Tool selection remains a tool action. Applicable settings are
+        # automatically available in the collapsed native corner stack.
+        props = layout.operator('view3d.ipad_native_tool', text=label,
+                                depress=selected, **ipad_native_tool_icon(tool))
+        props.name, props.inventory, props.expected_tool = tool.idname, receipt, active_id
