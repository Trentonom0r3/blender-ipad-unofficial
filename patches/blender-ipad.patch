+  if (region && (region->flag & RGN_FLAG_HIDDEN_BY_USER)) return;
+  ARegionType *art = BKE_regiontype_from_id(area->type, RGN_TYPE_HUD);
+  if (!art) return;
+  /* Do not call ED_area_type_hud_ensure here: that would overwrite the last
+   * accepted operation's origin or clear Redo in another native editor. */
+  const bool created = region == nullptr;
