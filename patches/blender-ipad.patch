+bool ui_ipad_context_store_rebind(bContext *C, const blender::ui::ipad::ActionOrigin &origin,
+                                  bContextStore &store)
+{
+  if (!origin.present()) return true;
+  if (!ui_ipad_action_origin_valid(C, origin)) return false;
+  /* A native context-store copy owns its strings, but its PointerRNA entries
+   * still reference the former tree. Only the named current tool has an
+   * audited fresh resolver. Unknown pointer overrides refuse the action. */
+  for (const bContextStoreEntry &entry : store.entries) {
+    const PointerRNA *saved = std::get_if<PointerRNA>(&entry.value);
+    if (!saved) continue;
+    if (entry.name != "tool") return false;
+    WorkSpace *workspace = CTX_wm_workspace(C);
+    if (!ui_ipad_rna_main_member(C, reinterpret_cast<ID *>(workspace))) return false;
+    bToolRef *tool = WM_toolsystem_ref_from_context(C);
+    if (!tool || saved->data != tool || saved->type != &RNA_WorkSpaceTool ||
+        saved->owner_id != &workspace->id) return false;
+  }
+  for (bContextStoreEntry &entry : store.entries) {
+    if (!std::holds_alternative<PointerRNA>(entry.value)) continue;
+    WorkSpace *workspace = CTX_wm_workspace(C);
+    bToolRef *tool = WM_toolsystem_ref_from_context(C);
+    entry.value = RNA_pointer_create_discrete(&workspace->id, &RNA_WorkSpaceTool, tool);
+  }
+  return true;
+}
