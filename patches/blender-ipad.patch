 using blender::Set;
 using blender::Vector;
 
 /** We only need this locally. */
 static CLG_LogRef LOG = {"undo"};
 
 /* -------------------------------------------------------------------- */
 /** \name Generic Undo System Access
  *
  * Non-operator undo editor functions.
  * \{ */
 
+#ifdef WITH_APPLE_CROSSPLATFORM
+using blender::bke::TouchUndoPhase;
+using blender::bke::TouchUndoRecovery;
+
+/* Resolve owner and every context member through live containers before using it.
+ * Stored addresses are comparison values only, never dereferenced. */
+static wmWindowManager *touch_undo_context(bContext *C, const TouchUndoRecovery &receipt,
+                                           const bool require_edit = true)
+{
+  Main *main = CTX_data_main(C);
+  if (!main || uintptr_t(main) != receipt.main_address) {
+    return nullptr;
+  }
+  LISTBASE_FOREACH (wmWindowManager *, wm, &main->wm) {
+    if (wm->id.session_uid != receipt.wm_uid || wm != CTX_wm_manager(C)) {
+      continue;
+    }
+    bool accepted_operator_live = false;
+    LISTBASE_FOREACH (wmOperator *, op, &wm->runtime->operators) {
+      if (WM_operator_touch_lifetime_matches(op, receipt.accepted_operator_id) &&
+          STREQ(op->type->idname, "MESH_OT_extrude_context_move")) {
+        accepted_operator_live = true;
+        break;
+      }
+    }
+    if (!accepted_operator_live) {
+      return nullptr;
+    }
+    LISTBASE_FOREACH (wmWindow *, win, &wm->windows) {
+      if (win != CTX_wm_window(C) || win->winid != receipt.window_id ||
+          uintptr_t(win) != receipt.window_address ||
+          !win->scene || win->scene->id.session_uid != receipt.scene_uid) {
+        continue;
+      }
+      bScreen *screen = WM_window_get_active_screen(win);
+      if (!screen || screen->id.session_uid != receipt.screen_uid) {
+        return nullptr;
+      }
+      LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+        if (uintptr_t(area) != receipt.area_address || area->spacetype != SPACE_VIEW3D) {
+          continue;
+        }
+        LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+          if (uintptr_t(region) == receipt.region_address && region->regiontype == RGN_TYPE_WINDOW) {
+            CTX_wm_window_set(C, win);
+            CTX_wm_area_set(C, area);
+            CTX_wm_region_set(C, region);
+            if (require_edit) {
+              if (!WM_event_touch_undo_safe(win)) {
+                return nullptr;
+              }
+              ViewLayer *view_layer = WM_window_get_active_view_layer(win);
+              Object *object = CTX_data_edit_object(C);
+              const bToolRef *tool = WM_toolsystem_ref_from_context(C);
+              if (uintptr_t(view_layer) != receipt.view_layer_address ||
+                  CTX_data_view_layer(C) != view_layer || !ED_operator_editmesh(C) ||
+                  !object || object->id.session_uid != receipt.active_object_uid ||
+                  !object->data || static_cast<ID *>(object->data)->session_uid != receipt.mesh_uid ||
+                  !tool || !STREQ(tool->idname, "builtin.extrude_region")) {
+                return nullptr;
+              }
+            }
+            return wm;
+          }
+        }
+      }
+    }
+  }
+  return nullptr;
+}
+
+static wmWindowManager *touch_undo_owner(bContext *C, const uint32_t uid)
+{
+  Main *main = CTX_data_main(C);
+  if (main) {
+    LISTBASE_FOREACH (wmWindowManager *, wm, &main->wm) {
+      if (wm->id.session_uid == uid) {
+        return wm;
+      }
+    }
+  }
+  return nullptr;
+}
+
+/* This edit-mode adjustment must not decode a different Main before invoke.
+ * Mesh steps may implicitly load their preceding MemFile, even without an
+ * explicit MemFile in the traversal. Check both paths before changing history. */
+static bool touch_undo_step_context_valid(bContext *C, const UndoStack *stack,
+                                            const UndoStep *step)
+{
+  if (!EDBM_touch_undo_context_matches(C, step)) {
+    return false;
+  }
+  for (const UndoStep *previous = step->prev; previous; previous = previous->prev) {
+    if (previous->type == BKE_UNDOSYS_TYPE_MEMFILE) {
+      return previous == stack->step_active_memfile;
+    }
+  }
+  return true;
+}
+
+static bool touch_undo_redo_valid(bContext *C, const UndoStack *stack,
+                                  const UndoTouchReceipt &receipt)
+{
+  if (!BKE_undosys_touch_validate(stack, receipt)) {
+    return false;
+  }
+  for (const UndoStep *step = stack->step_active; step; step = step->next) {
+    if (!touch_undo_step_context_valid(C, stack, step)) {
+      return false;
+    }
+    if (step->ipad_lifetime_id == receipt.accepted_id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static bool touch_undo_pop_valid(bContext *C, const UndoStack *stack, const UndoTouchReceipt &receipt)
+{
+  if (!stack || stack->ipad_lifetime_id != receipt.stack_id ||
+      stack->ipad_mutation_generation != receipt.generation || stack->step_init ||
+      stack->group_level || !stack->step_active || stack->step_active->skip ||
+      stack->step_active->ipad_lifetime_id != receipt.accepted_id) {
+    return false;
+  }
+  for (const UndoStep *step = stack->step_active; step; step = step->prev) {
+    if (!touch_undo_step_context_valid(C, stack, step)) {
+      return false;
+    }
+    if (step != stack->step_active && !step->skip) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ED_undo_touch_begin(bContext *C, const wmEvent *event)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmWindow *win = CTX_wm_window(C);
+  Scene *scene = CTX_data_scene(C);
+  bScreen *screen = CTX_wm_screen(C);
+  ScrArea *area = CTX_wm_area(C);
+  ARegion *region = CTX_wm_region(C);
+  if (!wm || !win || !scene || !screen || !area || !region || !event || wm->op_undo_depth ||
+      wm->runtime->touch_undo_recovery.phase != TouchUndoPhase::Empty ||
+      WM_jobs_test(wm, scene, WM_JOB_TYPE_ANY) || !WM_event_touch_undo_safe(win) ||
+      !ED_operator_editmesh(C)) {
+    return false;
+  }
+  wmOperator *accepted_op = WM_operator_last_redo(C);
+  if (!accepted_op || BLI_findindex(&wm->runtime->operators, accepted_op) == -1 ||
+      !STREQ(accepted_op->type->idname, "MESH_OT_extrude_context_move") ||
+      !wm->runtime->undo_stack ||
+      BKE_undosys_step_find_by_name(wm->runtime->undo_stack, accepted_op->type->name) !=
+          wm->runtime->undo_stack->step_active) {
+    return false;
+  }
+  TouchUndoRecovery receipt;
+  receipt.accepted_operator_id = WM_operator_touch_lifetime_id(accepted_op);
+  if (!BKE_undosys_touch_capture(wm->runtime->undo_stack, receipt.undo)) {
+    return false;
+  }
+  if (!touch_undo_pop_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    return false;
+  }
+  receipt.wm_uid = wm->id.session_uid;
+  receipt.scene_uid = scene->id.session_uid;
+  receipt.screen_uid = screen->id.session_uid;
+  Object *object = CTX_data_edit_object(C);
+  const bToolRef *tool = WM_toolsystem_ref_from_context(C);
+  if (!object || !object->data || !tool || !STREQ(tool->idname, "builtin.extrude_region")) {
+    return false;
+  }
+  receipt.active_object_uid = object->id.session_uid;
+  receipt.mesh_uid = static_cast<ID *>(object->data)->session_uid;
+  receipt.view_layer_address = uintptr_t(WM_window_get_active_view_layer(win));
+  receipt.window_id = win->winid;
+  receipt.main_address = uintptr_t(CTX_data_main(C));
+  receipt.window_address = uintptr_t(win);
+  receipt.area_address = uintptr_t(area);
+  receipt.region_address = uintptr_t(region);
+  receipt.event_address = uintptr_t(event);
+  receipt.phase = TouchUndoPhase::PendingInvoke;
+  wm->runtime->touch_undo_recovery = receipt;
+  return true;
+}
+
+bool ED_undo_touch_pop(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || wm->runtime->touch_undo_recovery.phase != TouchUndoPhase::PendingInvoke) {
+    return false;
+  }
+  TouchUndoRecovery receipt = wm->runtime->touch_undo_recovery;
+  wm->runtime->touch_undo_recovery = {};
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !touch_undo_pop_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return false;
+  }
+  WM_jobs_kill_all(wm);
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !touch_undo_pop_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return false;
+  }
+  wm->op_undo_depth++;
+  BKE_callback_exec_id(CTX_data_main(C), &CTX_data_scene(C)->id, BKE_CB_EVT_UNDO_PRE);
+  wm = touch_undo_owner(C, receipt.wm_uid);
+  if (wm) {
+    wm->op_undo_depth--;
+  }
+  wm = touch_undo_context(C, receipt);
+  bool popped = false;
+  if (wm && touch_undo_pop_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    UndoStack *stack = wm->runtime->undo_stack;
+    /* Fresh target after PRE; never use a pointer saved before callbacks. */
+    popped = BKE_undosys_step_load_data_ex(stack, C, stack->step_active->prev, nullptr, true);
+    wm = touch_undo_context(C, receipt);
+    popped = popped && wm && BKE_undosys_touch_seal(wm->runtime->undo_stack, receipt.undo);
+  }
+  wm = touch_undo_context(C, receipt, false);
+  if (wm) {
+    wm->op_undo_depth++;
+    BKE_callback_exec_id(CTX_data_main(C), &CTX_data_scene(C)->id, BKE_CB_EVT_UNDO_POST);
+    wm = touch_undo_owner(C, receipt.wm_uid);
+    if (wm) {
+      wm->op_undo_depth--;
+    }
+  }
+  wm = touch_undo_context(C, receipt);
+  if (!popped || !wm || !BKE_undosys_touch_validate(wm->runtime->undo_stack, receipt.undo)) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment stopped after an Undo callback changed its context");
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return false;
+  }
+  wm->runtime->touch_undo_recovery = receipt;
+  WM_event_add_notifier(C, NC_WINDOW, nullptr);
+  WM_event_add_notifier(C, NC_WM | ND_UNDO, nullptr);
+  return true;
+}
+
+bool ED_undo_touch_seal(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || wm->runtime->touch_undo_recovery.phase != TouchUndoPhase::PendingInvoke) {
+    return false;
+  }
+  TouchUndoRecovery receipt = wm->runtime->touch_undo_recovery;
+  wm->runtime->touch_undo_recovery = {};
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !BKE_undosys_touch_seal(wm->runtime->undo_stack, receipt.undo)) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment stopped because its Undo state changed");
+    return false;
+  }
+  wm->runtime->touch_undo_recovery = receipt;
+  return true;
+}
+
+blender::bke::TouchUndoClaim ED_undo_touch_claim(bContext *C, const wmEvent *event, TouchUndoRecovery &receipt)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  using blender::bke::TouchUndoClaim;
+  if (!wm || wm->runtime->touch_undo_recovery.phase != TouchUndoPhase::PendingInvoke) {
+    return TouchUndoClaim::None;
+  }
+  if (wm->runtime->touch_undo_recovery.event_address != uintptr_t(event)) {
+    return TouchUndoClaim::Rejected;
+  }
+  const TouchUndoRecovery pending = wm->runtime->touch_undo_recovery;
+  wm = touch_undo_context(C, pending);
+  if (!wm || !touch_undo_redo_valid(C, wm->runtime->undo_stack, pending.undo)) {
+    return TouchUndoClaim::Rejected;
+  }
+  receipt = pending;
+  wm->runtime->touch_undo_recovery = {};
+  return TouchUndoClaim::Claimed;
+}
+
+void ED_undo_touch_finish(bContext *C, const TouchUndoRecovery &receipt, const bool cancelled)
+{
+  if (!cancelled || receipt.phase == TouchUndoPhase::Empty) {
+    return;
+  }
+  wmWindowManager *wm = touch_undo_owner(C, receipt.wm_uid);
+  if (wm && wm->runtime->touch_undo_recovery.phase == TouchUndoPhase::Empty) {
+    wm->runtime->touch_undo_recovery = receipt;
+    wm->runtime->touch_undo_recovery.phase = TouchUndoPhase::Ready;
+  }
+}
+
+void ED_undo_touch_finalize_invoke(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (wm && wm->runtime->touch_undo_recovery.phase == TouchUndoPhase::PendingInvoke) {
+    /* Gizmo invoke/poll may fail before the macro acquires the transaction. */
+    wm->runtime->touch_undo_recovery.phase = TouchUndoPhase::Ready;
+  }
+}
+
+bool ED_undo_touch_recover(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || wm->runtime->touch_undo_recovery.phase != TouchUndoPhase::Ready) {
+    return false;
+  }
+  const TouchUndoRecovery receipt = wm->runtime->touch_undo_recovery;
+  wm->runtime->touch_undo_recovery = {}; /* Consume before any callback/decode. */
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !touch_undo_redo_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment recovery stopped after a scene or Undo change");
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return true;
+  }
+
+  /* Native pre semantics, with fresh owner resolution after callbacks. */
+  WM_jobs_kill_all(wm);
+  wm = touch_undo_context(C, receipt);
+  if (!wm || !touch_undo_redo_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment recovery stopped after a scene or Undo change");
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+    return true;
+  }
+  if ((G.debug & G_DEBUG_IO) && CTX_data_main(C)->lock) {
+    BLO_main_validate_libraries(CTX_data_main(C), nullptr);
+  }
+  wm->op_undo_depth++;
+  BKE_callback_exec_id(CTX_data_main(C), &CTX_data_scene(C)->id, BKE_CB_EVT_REDO_PRE);
+  wm = touch_undo_owner(C, receipt.wm_uid);
+  if (wm) {
+    wm->op_undo_depth--;
+  }
+  wm = touch_undo_context(C, receipt);
+  bool restored = false;
+  uint64_t completed_generation = 0;
+  if (wm && touch_undo_redo_valid(C, wm->runtime->undo_stack, receipt.undo)) {
+    restored = BKE_undosys_step_redo(wm->runtime->undo_stack, C);
+    /* Resolve again; decode can rebuild edit owners or the entire Main. */
+    wm = touch_undo_owner(C, receipt.wm_uid);
+    const UndoStack *stack = wm ? wm->runtime->undo_stack : nullptr;
+    restored = restored && stack && stack->ipad_lifetime_id == receipt.undo.stack_id &&
+               stack->step_active &&
+               stack->step_active->ipad_lifetime_id == receipt.undo.accepted_id;
+    completed_generation = stack ? stack->ipad_mutation_generation : 0;
+  }
+
+  /* Pair PRE even on refusal, provided the original owner still exists. */
+  wm = touch_undo_context(C, receipt, false);
+  if (wm && CTX_data_scene(C)) {
+    wm->op_undo_depth++;
+    BKE_callback_exec_id(CTX_data_main(C), &CTX_data_scene(C)->id, BKE_CB_EVT_REDO_POST);
+    wm = touch_undo_owner(C, receipt.wm_uid);
+    if (wm) {
+      wm->op_undo_depth--;
+    }
+  }
+  wm = touch_undo_owner(C, receipt.wm_uid);
+  const UndoStack *completed = wm ? wm->runtime->undo_stack : nullptr;
+  restored = restored && completed && completed->ipad_lifetime_id == receipt.undo.stack_id &&
+             completed->ipad_mutation_generation == completed_generation &&
+             completed->step_active &&
+             completed->step_active->ipad_lifetime_id == receipt.undo.accepted_id;
+  /* No saved context/operator/gizmo pointer is used after either callback. */
+  wm = touch_undo_context(C, receipt, false);
+  if (wm) {
+    WM_event_add_notifier(C, NC_WINDOW, nullptr);
+    WM_event_add_notifier(C, NC_WM | ND_UNDO, nullptr);
+    WM_toolsystem_refresh_active(C);
+    WM_toolsystem_refresh_screen_all(CTX_data_main(C));
+    blender::ed::asset::list::storage_tag_main_data_dirty();
+  }
+  else {
+    /* A callback may have deleted the originating area/region. Do not leave
+     * stale spatial context for the dispatcher which will return immediately. */
+    CTX_wm_region_set(C, nullptr);
+    CTX_wm_area_set(C, nullptr);
+  }
+  if (!restored) {
+    WM_global_report(RPT_WARNING, "Extrude adjustment could not restore its accepted Undo state");
+  }
+  return true;
+}
+#endif
+
 bool ED_undo_is_state_valid(bContext *C)
 {
   wmWindowManager *wm = CTX_wm_manager(C);
 
   /* Currently only checks matching begin/end calls. */
   if (wm->runtime->undo_stack == nullptr) {
     /* No undo stack is valid, nothing to do. */
     return true;
   }
   if (wm->runtime->undo_stack->group_level != 0) {
     /* If this fails #ED_undo_grouped_begin, #ED_undo_grouped_end calls don't match. */
     return false;
   }
   if (wm->runtime->undo_stack->step_active != nullptr) {
     if (wm->runtime->undo_stack->step_active->skip == true) {
       /* Skip is only allowed between begin/end calls,
        * a state that should never happen in main event loop. */
       return false;
     }
   }
   return true;
 }
 
 void ED_undo_group_begin(bContext *C)
 {
   wmWindowManager *wm = CTX_wm_manager(C);
   BKE_undosys_stack_group_begin(wm->runtime->undo_stack);
 }
 
 void ED_undo_group_end(bContext *C)
 {
   wmWindowManager *wm = CTX_wm_manager(C);
   BKE_undosys_stack_group_end(wm->runtime->undo_stack);
 }
 
 void ED_undo_push(bContext *C, const char *str)
 {
   CLOG_INFO(&LOG, "Push '%s'", str);
   WM_file_tag_modified();
 
   wmWindowManager *wm = CTX_wm_manager(C);
   int steps = U.undosteps;
 
   /* Ensure steps that have been initialized are always pushed,
    * even when undo steps are zero.
    *
    * Note that some modes (paint, sculpt) initialize an undo step before an action runs,
    * then accumulate changes there, or restore data from it in the case of 2D painting.
    *
    * For this reason we need to handle the undo step even when undo steps is set to zero.
    */
   if ((steps <= 0) && wm->runtime->undo_stack->step_init != nullptr) {
     steps = 1;
   }
   if (steps <= 0) {
     return;
   }
   if (G.background) {
     /* Python developers may have explicitly created the undo stack in background mode,
      * otherwise allow it to be nullptr, see: #60934.
      * Otherwise it must never be nullptr, even when undo is disabled. */
     if (wm->runtime->undo_stack == nullptr) {
       return;
     }
   }
 
   eUndoPushReturn push_retval;
 
   /* Only apply limit if this is the last undo step. */
   if (wm->runtime->undo_stack->step_active &&
       (wm->runtime->undo_stack->step_active->next == nullptr))
   {
     BKE_undosys_stack_limit_steps_and_memory(wm->runtime->undo_stack, steps - 1, 0);
   }
 
   push_retval = BKE_undosys_step_push(wm->runtime->undo_stack, C, str);
 
   if (U.undomemory != 0) {
     const size_t memory_limit = size_t(U.undomemory) * 1024 * 1024;
     BKE_undosys_stack_limit_steps_and_memory(wm->runtime->undo_stack, -1, memory_limit);
   }
 
   if (CLOG_CHECK(&LOG, CLG_LEVEL_DEBUG)) {
     BKE_undosys_print(wm->runtime->undo_stack);
   }
 
   if (push_retval & UNDO_PUSH_RET_OVERRIDE_CHANGED) {
     WM_main_add_notifier(NC_WM | ND_LIB_OVERRIDE_CHANGED, nullptr);
   }
 }
 
 /**
  * Common pre management of undo/redo (killing all running jobs, calling pre handlers, etc.).
  */
 static void ed_undo_step_pre(bContext *C,
                              wmWindowManager *wm,
                              const enum eUndoStepDir undo_dir,
                              ReportList *reports)
 {
   BLI_assert(ELEM(undo_dir, STEP_UNDO, STEP_REDO));
 
   Main *bmain = CTX_data_main(C);
   Scene *scene = CTX_data_scene(C);
 
   /* undo during jobs are running can easily lead to freeing data using by jobs,
    * or they can just lead to freezing job in some other cases */
   WM_jobs_kill_all(wm);
 
   if (G.debug & G_DEBUG_IO) {
     if (bmain->lock != nullptr) {
       BKE_report(
           reports, RPT_DEBUG, "Checking validity of current .blend file *BEFORE* undo step");
       BLO_main_validate_libraries(bmain, reports);
     }
   }
 
   /* App-Handlers (pre). */
   {
     /* NOTE: ignore grease pencil for now. */
     wm->op_undo_depth++;
     BKE_callback_exec_id(
         bmain, &scene->id, (undo_dir == STEP_UNDO) ? BKE_CB_EVT_UNDO_PRE : BKE_CB_EVT_REDO_PRE);
     wm->op_undo_depth--;
   }
 }
 
 /**
  * Common post management of undo/redo (calling post handlers, adding notifiers etc.).
  *
  * \note Also check #undo_history_exec in bottom if you change notifiers.
  */
 static void ed_undo_step_post(bContext *C,
                               wmWindowManager *wm,
                               const enum eUndoStepDir undo_dir,
                               ReportList *reports)
 {
   using namespace blender::ed;
   BLI_assert(ELEM(undo_dir, STEP_UNDO, STEP_REDO));
 
   Main *bmain = CTX_data_main(C);
   Scene *scene = CTX_data_scene(C);
 
   /* App-Handlers (post). */
   {
     wm->op_undo_depth++;
     BKE_callback_exec_id(
         bmain, &scene->id, (undo_dir == STEP_UNDO) ? BKE_CB_EVT_UNDO_POST : BKE_CB_EVT_REDO_POST);
     wm->op_undo_depth--;
   }
 
   if (G.debug & G_DEBUG_IO) {
     if (bmain->lock != nullptr) {
       BKE_report(reports, RPT_INFO, "Checking validity of current .blend file *AFTER* undo step");
       BLO_main_validate_libraries(bmain, reports);
     }
   }
 
   WM_event_add_notifier(C, NC_WINDOW, nullptr);
   WM_event_add_notifier(C, NC_WM | ND_UNDO, nullptr);
 
   WM_toolsystem_refresh_active(C);
   WM_toolsystem_refresh_screen_all(bmain);
 
   asset::list::storage_tag_main_data_dirty();
 
   if (CLOG_CHECK(&LOG, CLG_LEVEL_DEBUG)) {
     BKE_undosys_print(wm->runtime->undo_stack);
   }
 }
 
 /**
  * Undo or redo one step from current active one.
  * May undo or redo several steps at once only if the target step is a 'skipped' one.
  * The target step will be the one immediately before or after the active one.
  */
 static wmOperatorStatus ed_undo_step_direction(bContext *C,
                                                enum eUndoStepDir step,
                                                ReportList *reports)
 {
   BLI_assert(ELEM(step, STEP_UNDO, STEP_REDO));
 
   CLOG_INFO(&LOG, "Step direction=%s", (step == STEP_UNDO) ? "STEP_UNDO" : "STEP_REDO");
 
   wmWindowManager *wm = CTX_wm_manager(C);
 
   ed_undo_step_pre(C, wm, step, reports);
 
   if (step == STEP_UNDO) {
     BKE_undosys_step_undo(wm->runtime->undo_stack, C);
   }
   else {
     BKE_undosys_step_redo(wm->runtime->undo_stack, C);
   }
 
   ed_undo_step_post(C, wm, step, reports);
 
   return OPERATOR_FINISHED;
 }
 
 /**
  * Undo the step matching given name.
  * May undo several steps at once.
  * The target step will be the one immediately before given named one.
  */
 static int ed_undo_step_by_name(bContext *C, const char *undo_name, ReportList *reports)
 {
   BLI_assert(undo_name != nullptr);
 
   wmWindowManager *wm = CTX_wm_manager(C);
   UndoStep *undo_step_from_name = BKE_undosys_step_find_by_name(wm->runtime->undo_stack,
                                                                 undo_name);
   if (undo_step_from_name == nullptr) {
     CLOG_ERROR(&LOG, "Step name='%s' not found in current undo stack", undo_name);
 
     return OPERATOR_CANCELLED;
   }
 
   UndoStep *undo_step_target = undo_step_from_name->prev;
   if (undo_step_target == nullptr) {
     CLOG_ERROR(&LOG, "Step name='%s' cannot be undone", undo_name);
 
     return OPERATOR_CANCELLED;
   }
 
   const int undo_dir_i = BKE_undosys_step_calc_direction(
       wm->runtime->undo_stack, undo_step_target, nullptr);
   BLI_assert(ELEM(undo_dir_i, -1, 1));
   const enum eUndoStepDir undo_dir = (undo_dir_i == -1) ? STEP_UNDO : STEP_REDO;
 
   CLOG_INFO(&LOG,
             "Step name='%s', found direction=%s",
             undo_name,
             (undo_dir == STEP_UNDO) ? "STEP_UNDO" : "STEP_REDO");
 
   ed_undo_step_pre(C, wm, undo_dir, reports);
 
   BKE_undosys_step_load_data_ex(wm->runtime->undo_stack, C, undo_step_target, nullptr, true);
 
   ed_undo_step_post(C, wm, undo_dir, reports);
 
   return OPERATOR_FINISHED;
 }
 
 /**
  * Load the step matching given index in the stack.
  * May undo or redo several steps at once.
  * The target step will be the one indicated by the given index.
  */
 static int ed_undo_step_by_index(bContext *C, const int undo_index, ReportList *reports)
 {
   BLI_assert(undo_index >= 0);
 
   wmWindowManager *wm = CTX_wm_manager(C);
   const int active_step_index = BLI_findindex(&wm->runtime->undo_stack->steps,
                                               wm->runtime->undo_stack->step_active);
   if (undo_index == active_step_index) {
     return OPERATOR_CANCELLED;
   }
   const enum eUndoStepDir undo_dir = (undo_index < active_step_index) ? STEP_UNDO : STEP_REDO;
 
   CLOG_INFO(&LOG,
             "Step index='%d', found direction=%s",
             undo_index,
             (undo_dir == STEP_UNDO) ? "STEP_UNDO" : "STEP_REDO");
 
   ed_undo_step_pre(C, wm, undo_dir, reports);
 
   BKE_undosys_step_load_from_index(wm->runtime->undo_stack, C, undo_index);
 
   ed_undo_step_post(C, wm, undo_dir, reports);
 
   return OPERATOR_FINISHED;
 }
 
 void ED_undo_grouped_push(bContext *C, const char *str)
 {
   /* do nothing if previous undo task is the same as this one (or from the same undo group) */
   wmWindowManager *wm = CTX_wm_manager(C);
   const UndoStep *us = wm->runtime->undo_stack->step_active;
   if (us && STREQ(str, us->name)) {
     BKE_undosys_stack_clear_active(wm->runtime->undo_stack);
   }
 
   /* push as usual */
   ED_undo_push(C, str);
 }
 
 void ED_undo_pop(bContext *C)
 {
   ed_undo_step_direction(C, STEP_UNDO, nullptr);
 }
 void ED_undo_redo(bContext *C)
 {
   ed_undo_step_direction(C, STEP_REDO, nullptr);
 }
 
 void ED_undo_push_op(bContext *C, wmOperator *op)
 {
   /* in future, get undo string info? */
   ED_undo_push(C, op->type->name);
 }
 
 void ED_undo_grouped_push_op(bContext *C, wmOperator *op)
 {
   if (op->type->undo_group[0] != '\0') {
     ED_undo_grouped_push(C, op->type->undo_group);
   }
   else {
     ED_undo_grouped_push(C, op->type->name);
   }
 }
 
 void ED_undo_pop_op(bContext *C, wmOperator *op)
 {
   /* search back a couple of undo's, in case something else added pushes */
   ed_undo_step_by_name(C, op->type->name, op->reports);
 }
 
 bool ED_undo_is_valid(const bContext *C, const char *undoname)
 {
   wmWindowManager *wm = CTX_wm_manager(C);
   return BKE_undosys_stack_has_undo(wm->runtime->undo_stack, undoname);
 }
 
 bool ED_undo_is_memfile_compatible(const bContext *C)
 {
   /* Some modes don't co-exist with memfile undo, disable their use: #60593
    * (this matches 2.7x behavior). */
   const Scene *scene = CTX_data_scene(C);
   ViewLayer *view_layer = CTX_data_view_layer(C);
   if (view_layer != nullptr) {
     BKE_view_layer_synced_ensure(scene, view_layer);
     Object *obact = BKE_view_layer_active_object_get(view_layer);
     if (obact != nullptr) {
       if (obact->mode & OB_MODE_EDIT) {
         return false;
       }
     }
   }
   return true;
 }
 
 bool ED_undo_is_legacy_compatible_for_property(bContext *C, ID *id, PointerRNA &ptr)
 {
   if (!RNA_struct_undo_check(ptr.type)) {
     return false;
   }
   /* If the whole ID type doesn't support undo there is no need to check the current context. */
   if (id && !ID_CHECK_UNDO(id)) {
     return false;
   }
 
   const Scene *scene = CTX_data_scene(C);
   ViewLayer *view_layer = CTX_data_view_layer(C);
   if (view_layer != nullptr) {
     BKE_view_layer_synced_ensure(scene, view_layer);
     Object *obact = BKE_view_layer_active_object_get(view_layer);
     if (obact != nullptr) {
       if (obact->mode & (OB_MODE_ALL_PAINT & ~(OB_MODE_WEIGHT_PAINT | OB_MODE_VERTEX_PAINT))) {
         /* For all non-weight-paint paint modes: Don't store property changes when painting.
          * Weight Paint and Vertex Paint use global undo, and thus don't need to be special-cased
          * here. */
         CLOG_DEBUG(&LOG, "skipping undo for paint-mode");
         return false;
       }
       if (obact->mode & OB_MODE_EDIT) {
         if ((id == nullptr) || (obact->data == nullptr) ||
             (GS(id->name) != GS(((ID *)obact->data)->name)))
         {
           /* No undo push on id type mismatch in edit-mode. */
           CLOG_DEBUG(&LOG, "skipping undo for edit-mode");
           return false;
         }
       }
     }
   }
   return true;
 }
 
 UndoStack *ED_undo_stack_get()
 {
   wmWindowManager *wm = static_cast<wmWindowManager *>(G_MAIN->wm.first);
   return wm->runtime->undo_stack;
 }
 
 /** \} */
 
 /* -------------------------------------------------------------------- */
 /** \name Undo, Undo Push & Redo Operators
  * \{ */
 
 /**
  * Refresh to run after user activated undo/redo actions.
  */
 static void ed_undo_refresh_for_op(bContext *C)
 {
   /* The "last operator" should disappear, later we can tie this with undo stack nicer. */
   WM_operator_stack_clear(CTX_wm_manager(C));
 
   /* Keep button under the cursor active. */
   WM_event_add_mousemove(CTX_wm_window(C));
 
   ED_outliner_select_sync_from_all_tag(C);
 }
 
 static wmOperatorStatus ed_undo_exec(bContext *C, wmOperator *op)
 {
   /* "last operator" should disappear, later we can tie this with undo stack nicer */
   WM_operator_stack_clear(CTX_wm_manager(C));
   wmOperatorStatus ret = ed_undo_step_direction(C, STEP_UNDO, op->reports);
   if (ret & OPERATOR_FINISHED) {
     ed_undo_refresh_for_op(C);
   }
   return ret;
 }
 
 static wmOperatorStatus ed_undo_push_exec(bContext *C, wmOperator *op)
 {
   if (G.background) {
     /* Exception for background mode, see: #60934.
      * NOTE: since the undo stack isn't initialized on startup, background mode behavior
      * won't match regular usage, this is just for scripts to do explicit undo pushes. */
     wmWindowManager *wm = CTX_wm_manager(C);
     if (wm->runtime->undo_stack == nullptr) {
       wm->runtime->undo_stack = BKE_undosys_stack_create();
     }
   }
   char str[BKE_UNDO_STR_MAX];
   RNA_string_get(op->ptr, "message", str);
   ED_undo_push(C, str);
   return OPERATOR_FINISHED;
 }
 
 static wmOperatorStatus ed_redo_exec(bContext *C, wmOperator *op)
 {
   wmOperatorStatus ret = ed_undo_step_direction(C, STEP_REDO, op->reports);
   if (ret & OPERATOR_FINISHED) {
     ed_undo_refresh_for_op(C);
   }
   return ret;
 }
 
 static wmOperatorStatus ed_undo_redo_exec(bContext *C, wmOperator * /*op*/)
 {
   wmOperator *last_op = WM_operator_last_redo(C);
   wmOperatorStatus ret = ED_undo_operator_repeat(C, last_op) ? OPERATOR_FINISHED :
                                                                OPERATOR_CANCELLED;
   if (ret & OPERATOR_FINISHED) {
     /* Keep button under the cursor active. */
     WM_event_add_mousemove(CTX_wm_window(C));
   }
   return ret;
 }
 
 /* Disable in background mode, we could support if it's useful, #60934. */
 
 static bool ed_undo_is_init_poll(bContext *C)
 {
   wmWindowManager *wm = CTX_wm_manager(C);
   if (wm->runtime->undo_stack == nullptr) {
     /* This message is intended for Python developers,
      * it will be part of the exception when attempting to call undo in background mode. */
     CTX_wm_operator_poll_msg_set(
         C,
         "Undo disabled at startup in background-mode "
         "(call `ed.undo_push()` to explicitly initialize the undo-system)");
     return false;
   }
   return true;
 }
 
 static bool ed_undo_is_init_and_screenactive_poll(bContext *C)
 {
   if (ed_undo_is_init_poll(C) == false) {
     return false;
   }
   return ED_operator_screenactive(C);
 }
 
 static bool ed_undo_redo_poll(bContext *C)
 {
   wmOperator *last_op = WM_operator_last_redo(C);
   return (last_op && ed_undo_is_init_and_screenactive_poll(C) &&
           WM_operator_check_ui_enabled(C, last_op->type->name));
 }
 
 static bool ed_undo_poll(bContext *C)
 {
   if (!ed_undo_is_init_and_screenactive_poll(C)) {
     return false;
   }
   UndoStack *undo_stack = CTX_wm_manager(C)->runtime->undo_stack;
   return (undo_stack->step_active != nullptr) && (undo_stack->step_active->prev != nullptr);
 }
 
 void ED_OT_undo(wmOperatorType *ot)
 {
   /* identifiers */
   ot->name = "Undo";
   ot->description = "Undo previous action";
   ot->idname = "ED_OT_undo";
 
   /* API callbacks. */
   ot->exec = ed_undo_exec;
   ot->poll = ed_undo_poll;
 }
 
