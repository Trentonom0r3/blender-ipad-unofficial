 def _fallback_id(text, fallback):
     if fallback:
         return text + " (fallback)"
     return text
 
 
 def any_except(*args):
     mod = {"ctrl": -1, "alt": -1, "shift": -1, "oskey": -1, "hyper": -1}
     for arg in args:
         del mod[arg]
     return mod
 
 
