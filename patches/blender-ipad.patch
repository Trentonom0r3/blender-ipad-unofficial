+@implementation GHOST_IOSRecentProjectOpener
+
+- (BOOL)hasLiveWindow
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  return system && _window && system->getWindowManager()->getWindowFound(_window) &&
+         _presenter.view.window != nil;
+}
+
+- (void)finish
+{
+  _busy = NO;
+  _ready = NO;
+  _refresh = NO;
+  _openLocalCopy = NO;
+  _installed = NO;
+  _bookmarkUpdated = NO;
+  _ticket = 0;
+  if (_sheet) {
+    UIAlertController *sheet = _sheet;
+    _sheet = nil;
+    [sheet dismissViewControllerAnimated:NO completion:nil];
+    [sheet release];
+  }
+  NSURL *directory = _stageDirectory;
+  _stageDirectory = nil;
+  if (directory) {
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+      @autoreleasepool {
+        [[NSFileManager defaultManager] removeItemAtURL:directory error:nil];
+        [directory release];
+      }
+    });
+  }
+  [_stageFile release];
+  _stageFile = nil;
+  [_backupFile release];
+  _backupFile = nil;
+  [_workingPath release];
+  _workingPath = nil;
+  [_documentPath release];
+  _documentPath = nil;
+  [_bookmark release];
+  _bookmark = nil;
+  [_expectedDigest release];
+  _expectedDigest = nil;
+  [_localDigest release];
+  _localDigest = nil;
+  [_providerDigest release];
+  _providerDigest = nil;
+  [_renewedBookmark release];
+  _renewedBookmark = nil;
+  [_presenter release];
+  _presenter = nil;
+  _window = nullptr;
+}
+
+- (void)cancel
+{
+  ++_generation;
+  [self finish];
+}
+
+- (void)queueReady
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!_busy || ![self hasLiveWindow] || !system) {
+    [self cancel];
+    return;
+  }
+  _ready = YES;
+  system->pushEvent(new GHOST_EventIOSRecentProjectReady(system->getMilliSeconds(),
+                                                         _window,
+                                                         _workingPath,
+                                                         _ticket,
+                                                         _loadUISet,
+                                                         _loadUI,
+                                                         _useScriptsSet,
+                                                         _useScripts));
+}
+
+- (void)continueAfterChoice:(NSUInteger)generation retry:(BOOL)retry remaining:(int)remaining
+{
+  if (generation != _generation || !_busy) {
+    return;
+  }
+  if (![self hasLiveWindow]) {
+    [self cancel];
+    return;
+  }
+  if (_presenter.presentedViewController) {
+    if (remaining <= 0) {
+      NSLog(@"Open Recent choice could not continue while another dialog is presented");
+      [self cancel];
+      return;
+    }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC),
+                   dispatch_get_main_queue(), ^{
+      [self continueAfterChoice:generation retry:retry remaining:remaining - 1];
+    });
+    return;
+  }
+  if (!retry) {
+    [self queueReady];
+    return;
+  }
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!system || system->getWindowManager()->getActiveWindow() != _window) {
+    [self cancel];
+    return;
+  }
+  NSString *path = [_workingPath copy];
+  const bool loadUISet = _loadUISet, loadUI = _loadUI;
+  const bool scriptsSet = _useScriptsSet, scripts = _useScripts;
+  [self cancel];
+  if (![self begin:path loadUISet:loadUISet loadUI:loadUI
+             useScriptsSet:scriptsSet useScripts:scripts]) {
+    NSLog(@"Open Recent could not restart its Files check");
+  }
+  [path release];
+}
+
+- (void)showChoice:(NSString *)message allowLocal:(BOOL)allowLocal
+{
+  if (![self hasLiveWindow]) {
+    [self cancel];
+    return;
+  }
+  const NSUInteger generation = _generation;
+  UIAlertController *alert = [[UIAlertController alertControllerWithTitle:@"Open Recent"
+                                                                   message:message
+                                                            preferredStyle:UIAlertControllerStyleAlert] retain];
+  _sheet = alert;
+  if (allowLocal) {
+    [alert addAction:[UIAlertAction actionWithTitle:@"Open Local Copy"
+                                             style:UIAlertActionStyleDefault
+                                           handler:^(UIAlertAction *action) {
+      if (generation != _generation) {
+        return;
+      }
+      UIAlertController *shown = _sheet;
+      _sheet = nil;
+      [shown release];
+      _refresh = NO;
+      _openLocalCopy = YES;
+      [self continueAfterChoice:generation retry:NO remaining:20];
+    }]];
+  }
+  [alert addAction:[UIAlertAction actionWithTitle:@"Retry Files"
+                                           style:UIAlertActionStyleDefault
+                                         handler:^(UIAlertAction *action) {
+    if (generation != _generation) {
+      return;
+    }
+    UIAlertController *shown = _sheet;
+    _sheet = nil;
+    [shown release];
+    [self continueAfterChoice:generation retry:YES remaining:20];
+  }]];
+  [alert addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                           style:UIAlertActionStyleCancel
+                                         handler:^(UIAlertAction *action) {
+    if (generation == _generation) {
+      [self cancel];
+    }
+  }]];
+  [_presenter presentViewController:alert animated:YES completion:nil];
+}
+
+- (void)showResult
+{
+  if (!_busy || ![self hasLiveWindow]) {
+    [self cancel];
+    return;
+  }
+  if (!_localDigest) {
+    [self showChoice:@"The local working project cannot be read. The Files original is unchanged."
+         allowLocal:NO];
+  }
+  else if (!_providerDigest) {
+    [self showChoice:@"The Files project is unavailable. Retry, or open the last local copy independently. Saving that copy will not update the Files original."
+         allowLocal:YES];
+  }
+  else if (![_localDigest isEqualToData:_expectedDigest]) {
+    [self showChoice:@"The local copy has changed since it was linked to Files. Open it independently, or retry. To open the Files version, choose Open Project from Files."
+         allowLocal:YES];
+  }
+  else {
+    _refresh = ![_providerDigest isEqualToData:_expectedDigest];
+    [self queueReady];
+  }
+}
