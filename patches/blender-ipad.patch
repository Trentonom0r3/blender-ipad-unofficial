+        for text, action in (("All", 'SELECT'), ("Clear", 'DESELECT'), ("Invert", 'INVERT')):
+            actions.operator(IPAD_SELECT_ALL[context.mode], text=text).action = action
+        # Keep the mode's complete native selection commands one tap away.
+        native_menu = 'VIEW3D_MT_select_' + context.mode.lower()
+        if hasattr(bpy.types, native_menu):
+            layout.menu(native_menu, text="More Selection Commands")
