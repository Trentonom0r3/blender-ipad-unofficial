+
+void ui_ipad_ring_draw_browse_cue(const uiBlock *block, const rcti &local_bounds,
+                                 const std::vector<uiIPadRingDrawItem> &drawn)
+{
+  /* The immediately preceding actual-draw publication is the admission.
+   * Failed/partial/clipped labels, grid failures and suspended children refuse. */
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS) || ui_ipad_ring_waits_for_draw(block) ||
+      !block->handle || !block->handle->can_refresh ||
+      block->handle->popup_create_vars.handle_create_func != ui_ipad_ring_create) return;
+  const auto *data = static_cast<const uiIPadRingData *>(block->handle->popup_create_vars.arg);
+  if (!data || data->inventory_count <= data->visible_count ||
+      data->presented_generation != block->ipad_ring_generation ||
+      data->visible_count != int(drawn.size())) return;
+  const uiFontStyle *font = &UI_style_get_dpi()->widget;
+  const std::string count = "+" + std::to_string(data->inventory_count - data->visible_count);
+  const char *caption = IFACE_("Press & circle");
+  const float width = std::max(float(UI_fontstyle_string_width(font, caption)),
+                               float(UI_fontstyle_string_width(font, count.c_str()))) + 2;
+  const float row_height = 0.75f * UI_UNIT_Y;
+  std::vector<ipad_ring::Rect> buttons;
+  for (const auto &item : drawn) buttons.push_back({float(item.rect.xmin), float(item.rect.xmax),
+                                                   float(item.rect.ymin), float(item.rect.ymax)});
+  const auto cue = ipad_ring::ring_browse_cue_layout(
+      {float(local_bounds.xmin), float(local_bounds.xmax),
+       float(local_bounds.ymin), float(local_bounds.ymax)}, buttons,
+      data->inventory_count, data->visible_count, width, 2 * row_height, 0.2f * UI_UNIT_X);
+  if (!cue.fits) return; /* Native grid remains reachable; never draw into its targets. */
+  uchar color[4]; UI_GetThemeColor4ubv(TH_TEXT, color); color[3] = uchar(color[3] * 0.65f);
+  const uiFontStyleDraw_Params params = {UI_STYLE_TEXT_CENTER, false};
+  const char *lines[2] = {caption, count.c_str()};
+  for (int i = 0; i < 2; ++i) {
+    const rcti row{int(cue.bounds.xmin), int(cue.bounds.xmax),
+                   int(cue.bounds.ymax - (i + 1) * row_height),
+                   int(cue.bounds.ymax - i * row_height)};
+    UI_fontstyle_draw(font, &row, lines[i], std::strlen(lines[i]), color, &params);
+  }
+}
+
+bool ui_ipad_ring_contact_input(bContext *C, uiBlock *block, const wmEvent *event, uiBut **tap)
+{
+  *tap = nullptr;
+  if (event->type != PENCIL_RING_INPUT || event->custom != EVT_DATA_PENCIL_RING ||
+      !event->customdata) return false;
+  const auto &packet = *static_cast<const GHOST_TEventPencilRingData *>(event->customdata);
+  if (packet.phase == GHOST_kPencilRingHome) return false;
+  if (packet.phase >= GHOST_kPencilRingRollBegin && packet.phase <= GHOST_kPencilRingRollEnd)
+    return ui_ipad_ring_roll_input(C, block, event);
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS) ||
+      !ui_ipad_ring_context_valid(C, block)) return true;
+  auto *data = static_cast<uiIPadRingData *>(block->handle->popup_create_vars.arg);
+  if (!ipad_ring::ring_uses_pages(ipad_ring::ring_kind(data->menu.c_str())) ||
+      packet.lifetime != data->lifetime || !packet.contact || ui_ipad_ring_child_open(block)) return true;
+  ipad_ring::RingInputOutcome result;
+  if (packet.phase == GHOST_kPencilRingBegin) {
+    if (ui_ipad_ring_waits_for_draw(block) || !data->browse.can_begin(packet.generation) ||
+        data->browse.contact) return true;
+    result = data->browse.press(packet.lifetime, event->xy[0], event->xy[1], packet.generation);
+    if (!data->browse.contact) return true;
+    data->contact_serial = packet.contact; data->contact_generation = packet.generation;
+    data->roll_serial = 0;
+    for (const auto &button : block->buttons) {
+      if (button->semi_modal_state && button->semi_modal_state != button->active)
+        ui_but_semi_modal_state_free(C, button.get());
+      if (button->active) ui_but_active_free(C, button.get());
+    }
+  }
+  else {
+    if (packet.contact != data->contact_serial || packet.generation != data->contact_generation)
+      return true;
+    if (packet.phase == GHOST_kPencilRingMotion)
+      result = data->browse.motion(packet.lifetime, event->xy[0], event->xy[1]);
+    else if (packet.phase == GHOST_kPencilRingEnd || packet.phase == GHOST_kPencilRingCancel) {
+      result = data->browse.release(packet.lifetime, event->xy[0], event->xy[1],
+                                   packet.phase == GHOST_kPencilRingCancel);
+      data->contact_serial = 0;
+    }
+    else return true;
+  }
+  if (result.result == ipad_ring::RingInputResult::Rebuild) {
+    data->phase = data->browse.phase; data->input_suspended = true;
+    ED_region_tag_refresh_ui(block->handle->region); ED_region_tag_redraw(block->handle->region);
+  }
+  else if (result.result == ipad_ring::RingInputResult::Close)
+    block->handle->menuretval = UI_RETURN_CANCEL;
+  else if (result.result == ipad_ring::RingInputResult::Tap && !ui_ipad_ring_waits_for_draw(block)) {
+    /* Resolve the last-presented identity against only this live generation.
+     * Native activation happens synchronously after this value check. */
+    for (int i = 0; i < int(block->buttons.size()); ++i) {
+      uiBut *button = block->buttons[i].get();
+      if (!(button->flag & (UI_HIDDEN | UI_SCROLLED | UI_BUT_DISABLED)) &&
+          data->menu + ":" + std::to_string(i) == result.identity) {
+        *tap = button; break;
+      }
+    }
+  }
+  return true;
+}
+
+bool ui_ipad_ring_dismiss_input(uiBlock *block, const wmEvent *event)
+{
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS) || !block->handle) return false;
+  const bool dismiss = event->type == WINDEACTIVATE ||
+      ((event->type == PENCIL_TOOL_PALETTE || event->type == EVT_ESCKEY ||
+        event->type == RIGHTMOUSE) && event->val == KM_PRESS);
+  if (!dismiss) return false;
+  /* Terminal dismissal has priority over incomplete/failed presentations.
+   * The popup handler still owns ordinary child/button/property teardown. */
+  block->handle->menuretval = UI_RETURN_CANCEL;
+  return true;
+}
+
+bool ui_ipad_ring_home_input(bContext *C, uiBlock *block, const wmEvent *event)
+{
+  if (event->type != PENCIL_RING_INPUT) return false;
+  /* Always consume a scoped packet, even after its page/context was retired.
+   * It must never become an ordinary right mouse or screen double-tap. */
+  if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS) ||
+      event->custom != EVT_DATA_PENCIL_RING || !event->customdata ||
+      !ui_ipad_ring_context_valid(C, block)) return true;
+  const auto &packet = *static_cast<const GHOST_TEventPencilRingData *>(event->customdata);
+  auto *data = static_cast<uiIPadRingData *>(block->handle->popup_create_vars.arg);
+  if (!ipad_ring::ring_uses_pages(ipad_ring::ring_kind(data->menu.c_str())) ||
+      packet.phase != GHOST_kPencilRingHome || packet.lifetime != data->lifetime ||
+      packet.generation != data->presented_generation) return true;
+  data->browse.home(packet.lifetime);
+  data->contact_serial = 0; data->roll_serial = 0;
+  data->phase = data->browse.phase;
+  data->input_suspended = true;
+  for (const auto &button : block->buttons) {
+    if (button->semi_modal_state && button->semi_modal_state != button->active)
+      ui_but_semi_modal_state_free(C, button.get());
+    if (button->active) ui_but_active_free(C, button.get());
+  }
+  ED_region_tag_refresh_ui(block->handle->region);
+  ED_region_tag_redraw(block->handle->region);
+  return true;
+}
+
+void ui_ipad_ring_selection_rebase(
+    bContext *C, const uint64_t values[13], const std::string &before,
+    const std::string &target, const uint64_t lifetime)
+{
+  /* A native Box/Lasso preference may intentionally change the active tool.
+   * Reacquire only a matching live popup after its operator returns. Other
+   * mode/history/tool/workspace actions close and never rebase a stale page. */
+  if (!lifetime || !UI_ipad_context_matches(C, values)) return;
+  const std::string observed = ui_ipad_ring_tool_identity(C);
+  if (observed != target || (target != "builtin.select_box" && target != "builtin.select_lasso")) return;
+  bScreen *screen = WM_window_get_active_screen(CTX_wm_window(C));
+  LISTBASE_FOREACH (ARegion *, region, &screen->regionbase) {
+    LISTBASE_FOREACH (uiBlock *, block, &region->runtime->uiblocks) {
+      uiPopupBlockHandle *handle = block->handle;
+      if (!(block->pie_data.flags & UI_PIE_IPAD_SELECTION) || !handle || !handle->can_refresh ||
+          handle->popup_create_vars.handle_create_func != ui_ipad_ring_create) continue;
+      auto *data = static_cast<uiIPadRingData *>(handle->popup_create_vars.arg);
+      if (!data || data->lifetime != lifetime || data->tool_identity != before ||
+          !ipad_ring::ring_context_matches(data->context, ui_ipad_ring_identity(C))) continue;
+      data->tool_identity = observed;
+      block->ipad_action_origin = ipad_ring::ActionOrigin::capture(
+          ipad_ring::context_values(data->context), observed, lifetime);
+      handle->ipad_action_origin = block->ipad_action_origin;
+      data->input_suspended = true;
+      /* Retired button presentation is rebuilt before another ordinary event
+       * lookup. Input admission will additionally bind the drawn generation. */
+      ED_region_tag_refresh_ui(region);
+      ED_region_tag_redraw(region);
+      return;
+    }
+  }
+}
+
+static ipad_ring::Rect ui_ipad_ring_viewport(bContext *C)
+{
+  ARegion *region = CTX_wm_region(C);
+  rcti rect = region->winrct;
+#ifdef WITH_APPLE_CROSSPLATFORM
+  ScrArea *area = CTX_wm_area(C);
+  if (region->runtime->ipad_canvas) {
+    std::vector<rcti> parts;
+    ED_ipad_editing_canvas_parts(C, region, parts);
+    if (!parts.empty()) {
+      rect = *std::max_element(parts.begin(), parts.end(), [](const rcti &a, const rcti &b) {
+        return BLI_rcti_size_x(&a) * BLI_rcti_size_y(&a) <
+               BLI_rcti_size_x(&b) * BLI_rcti_size_y(&b);
+      });
+    }
+    const rcti &nav = area->runtime.ipad_navigation_rect;
+    rcti overlap;
+    if (BLI_rcti_isect(&rect, &nav, &overlap)) {
+      /* The navigation stack occupies the right corner. Choose the larger
+       * exposed rectangle on its left or below it, never cover its controls. */
+      rcti left = rect, below = rect;
+      left.xmax = overlap.xmin - 1;
+      below.ymax = overlap.ymin - 1;
+      const int left_area = std::max(0, BLI_rcti_size_x(&left)) * BLI_rcti_size_y(&left);
+      const int below_area = BLI_rcti_size_x(&below) * std::max(0, BLI_rcti_size_y(&below));
+      rect = left_area >= below_area ? left : below;
+    }
+  }
+#endif
+  return {float(rect.xmin), float(rect.xmax + 1), float(rect.ymin), float(rect.ymax + 1)};
+}
