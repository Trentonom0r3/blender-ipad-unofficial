 bool ED_operator_posemode(bContext *C)
 {
   Object *obact = CTX_data_active_object(C);
 
   if (obact && !(obact->mode & OB_MODE_EDIT)) {
     Object *obpose = BKE_object_pose_armature_get(obact);
