+struct RingBrowseCue {
+  Rect bounds{};
+  bool fits = false;
+};
+/* Measured noninteractive text inside an already proved presented footprint.
+ * No new target, center content or desired-layout input reservation. */
+inline RingBrowseCue ring_browse_cue_layout(const Rect &bounds,
+    const std::vector<Rect> &buttons, int inventory, int visible,
+    float width, float height, float padding)
+{
+  if (inventory <= visible || visible < 1 || buttons.size() != size_t(visible) ||
+      !std::isfinite(width) || !std::isfinite(height) || !std::isfinite(padding) ||
+      width <= 0 || height <= 0 || padding < 0) return {};
+  const std::array<Rect, 4> candidates{{
+      {bounds.xmin + padding, bounds.xmin + padding + width,
+       bounds.ymin + padding, bounds.ymin + padding + height},
+      {bounds.xmax - padding - width, bounds.xmax - padding,
+       bounds.ymax - padding - height, bounds.ymax - padding},
+      {bounds.xmax - padding - width, bounds.xmax - padding,
+       bounds.ymin + padding, bounds.ymin + padding + height},
+      {bounds.xmin + padding, bounds.xmin + padding + width,
+       bounds.ymax - padding - height, bounds.ymax - padding}}};
+  for (const Rect &candidate : candidates) {
+    if (candidate.xmin < bounds.xmin || candidate.xmax > bounds.xmax ||
+        candidate.ymin < bounds.ymin || candidate.ymax > bounds.ymax) continue;
+    bool free = true;
+    for (const Rect &button : buttons) {
+      if (candidate.xmin < button.xmax + padding && button.xmin - padding < candidate.xmax &&
+          candidate.ymin < button.ymax + padding && button.ymin - padding < candidate.ymax) {
+        free = false; break;
+      }
+    }
+    if (free) return {candidate, true};
+  }
+  return {};
+}
+
+struct RingLabelMetrics {
+  float width = 0, xmin = 0, ymin = 0, ymax = 0;
+};
+struct RingLabelLine {
+  std::string text;
+  RingLabelMetrics metrics;
+};
+struct RingLabelFit {
+  std::vector<RingLabelLine> lines;
+  float scale = 1, height = 0;
+  int word_splits = 0;
+  bool fits = false;
+};
+
+/* Full labels only: never ellipsize or reduce the font below 90% of the native
+ * style. Wrapping is UTF-8 boundary safe, with word/slash breaks preferred.
+ * Native glyph bounds (including bearings and fallback fonts) supply metrics.
+ * The measured result is also the exact set of lines used by the renderer. */
+template<typename Measure>
+inline RingLabelFit ring_label_fit(std::string_view text, float width, float height,
+                                   float gap, Measure measure)
+{
+  RingLabelFit refused;
+  if (text.empty() || text.size() > 512 || text.find('\0') != std::string_view::npos ||
+      !std::isfinite(width) || !std::isfinite(height) || !std::isfinite(gap) ||
+      width <= 0 || height <= 0 || gap < 0) return refused;
+  const auto space = [](char c) { return c == ' ' || c == '\t' || c == '\r'; };
+  const auto next = [&](size_t index) -> size_t {
+    const auto c = static_cast<unsigned char>(text[index]);
+    const size_t bytes = c < 0x80 ? 1 : c >= 0xc2 && c <= 0xdf ? 2 :
+        c >= 0xe0 && c <= 0xef ? 3 : c >= 0xf0 && c <= 0xf4 ? 4 : 0;
+    if (!bytes || index + bytes > text.size()) return 0;
+    for (size_t i = 1; i < bytes; ++i)
+      if ((static_cast<unsigned char>(text[index + i]) & 0xc0) != 0x80) return 0;
+    if (bytes >= 3) {
+      const auto second = static_cast<unsigned char>(text[index + 1]);
+      if ((c == 0xe0 && second < 0xa0) || (c == 0xed && second >= 0xa0) ||
+          (c == 0xf0 && second < 0x90) || (c == 0xf4 && second >= 0x90)) return 0;
+    }
+    return index + bytes;
+  };
+  for (float scale : {1.f, .95f, .9f}) {
+    RingLabelFit result;
+    result.scale = scale;
+    size_t start = 0;
+    bool valid = true;
+    while (start < text.size()) {
+      while (start < text.size() && space(text[start])) ++start;
+      if (start == text.size()) break;
+      if (text[start] == '\n' || result.lines.size() == 3) { valid = false; break; }
+      size_t end = start, last_break = start;
+      bool hard_break = false;
+      while (end < text.size()) {
+        if (text[end] == '\n') { hard_break = true; break; }
+        const size_t candidate = next(end);
+        if (!candidate) { valid = false; break; }
+        const auto metric = measure(text.substr(start, candidate - start), scale);
+        if (!std::isfinite(metric.width) || !std::isfinite(metric.xmin) ||
+            !std::isfinite(metric.ymin) || !std::isfinite(metric.ymax) ||
+            metric.width < 0 || metric.ymax <= metric.ymin) { valid = false; break; }
+        if (metric.width > width) break;
+        end = candidate;
+        if (space(text[end - 1]) || text[end - 1] == '/') last_break = end;
+      }
+      if (!valid || end == start) { valid = false; break; }
+      if (!hard_break && end < text.size()) {
+        if (last_break > start) end = last_break;
+        else if (!space(text[end]) && text[end] != '\n') ++result.word_splits;
+      }
+      size_t trimmed = end;
+      while (trimmed > start && space(text[trimmed - 1])) --trimmed;
+      if (trimmed == start) { valid = false; break; }
+      const std::string_view line = text.substr(start, trimmed - start);
+      const auto metric = measure(line, scale);
+      const float line_height = metric.ymax - metric.ymin;
+      if (result.lines.size()) result.height += gap;
+      result.height += line_height;
+      result.lines.push_back({std::string(line), metric});
+      start = end + (hard_break ? 1 : 0);
+    }
+    if (valid && !result.lines.empty() && result.height <= height) {
+      result.fits = true;
+      if (!result.word_splits) return result;
+      /* Prefer a bounded smaller whole word to a larger mid-word split. Only
+       * fall back to character wrapping when none of the native sizes avoids it. */
+      if (!refused.fits || result.word_splits < refused.word_splits ||
+          (result.word_splits == refused.word_splits && result.lines.size() < refused.lines.size()))
+        refused = std::move(result);
+    }
+  }
+  return refused;
+}
+struct ToolRingLayout {
+  std::array<Rect, 9> buttons;
+  bool grid = false;
+  bool needs_scroll = false;
+  bool fits = true;
+  float anchor_x = 0, anchor_y = 0;
+};
+
+inline ToolRingLayout tool_ring_layout(float unit, Rect viewport, float x, float y,
+                                       bool context_controls = false)
+{
+  ToolRingLayout result;
+  /* Match paged rings while retaining the original nine clockwise home slots. */
+  const float width = 4.7f * unit;
+  const float height = (context_controls ? 2.2f : 1.7f) * unit;
+  const float gap = 0.25f * unit;
+  const float radius = 7.4f * unit;
+  auto button = [&](int i, float cx, float cy) {
+    result.buttons[i] = {cx - width / 2, cx + width / 2,
+                         cy - height / 2, cy + height / 2};
+  };
+  for (int i = 0; i < 9; ++i) {
+    const float angle = float(i) * 6.283185307179586f / 9.0f;
+    button(i, std::sin(angle) * radius, std::cos(angle) * radius);
+  }
+  /* Center remains open and empty (Settings removed per user review). */
+  auto bounds = [&]() {
+    Rect bounds = result.buttons[0];
+    for (const Rect &rect : result.buttons) {
+      bounds.xmin = std::min(bounds.xmin, rect.xmin);
+      bounds.xmax = std::max(bounds.xmax, rect.xmax);
+      bounds.ymin = std::min(bounds.ymin, rect.ymin);
+      bounds.ymax = std::max(bounds.ymax, rect.ymax);
+    }
+    return bounds;
+  };
+  Rect extent = bounds();
+  const float available_width = viewport.xmax - viewport.xmin - 2 * gap;
+  const float available_height = viewport.ymax - viewport.ymin - 2 * gap;
+  if (extent.xmax - extent.xmin > available_width ||
+      extent.ymax - extent.ymin > available_height)
+  {
+    /* A narrow split editor cannot hold a usable ring. Preserve button size and
+     * access in a compact grid; ordinary popup scrolling handles tiny heights. */
+    result.grid = true;
+    const int columns = std::clamp(int((available_width + gap) / (width + gap)), 1, 3);
+    for (int i = 0; i < 9; ++i) {
+      button(i, (i % columns) * (width + gap), -(i / columns) * (height + gap));
+    }
+    extent = bounds();
+  }
+  const float left = viewport.xmin + gap - extent.xmin;
+  const float right = viewport.xmax - gap - extent.xmax;
+  const float bottom = viewport.ymin + gap - extent.ymin;
+  const float top = viewport.ymax - gap - extent.ymax;
+  result.needs_scroll = bottom > top;
+  result.fits = left <= right && bottom <= top;
+  result.anchor_x = x = left <= right ? std::clamp(x, left, right) : left;
+  result.anchor_y = y = bottom <= top ? std::clamp(y, bottom, top) : top;
+  x = left <= right ? std::clamp(x, left, right) : left;
+  y = bottom <= top ? std::clamp(y, bottom, top) : top;
+  for (Rect &rect : result.buttons) {
+    rect.xmin += x;
+    rect.xmax += x;
+    rect.ymin += y;
+    rect.ymax += y;
+  }
+  return result;
+}
+
+
+struct RingPageLayout {
+  std::vector<Rect> buttons;
+  std::vector<int> indices;
+  Rect footprint{};
+  float center_x = 0, center_y = 0;
+  bool fits = false, grid = false;
+};
+
+/* Every category uses the same Tools footprint and origin. Base is limited
+ * to nine positions; no separate compact geometry is presented or captured. */
+inline RingPageLayout ring_page_layout(float unit, Rect viewport, float x, float y,
+                                       int total, float phase, bool touch = false,
+                                       bool compact_base = false)
+{
+  RingPageLayout result;
+  if (!std::isfinite(unit) || unit <= 0 || total < 1 || total > 4096 ||
+      !std::isfinite(x) || !std::isfinite(y) || !std::isfinite(phase) ||
+      !std::isfinite(viewport.xmin) || !std::isfinite(viewport.xmax) ||
+      !std::isfinite(viewport.ymin) || !std::isfinite(viewport.ymax)) return result;
+  const float width = 4.7f * unit;
+  const float height = (touch ? 2.2f : 1.7f) * unit;
+  if (compact_base && total > 9) return result;
+  float radius = 7.6f * unit;
+  const float gap = .25f * unit;
+  float extent_x = 2 * radius + width, extent_y = 2 * radius + height;
+  const float available_x = viewport.xmax - viewport.xmin - 2 * gap;
+  const float available_y = viewport.ymax - viewport.ymin - 2 * gap;
+  int columns = 3;
+  if (extent_x > available_x || extent_y > available_y) {
+    result.grid = true;
+    if (available_x < width || available_y < height) return result;
+    columns = std::clamp(int((available_x + gap) / (width + gap)), 1, 3);
+    extent_x = columns * width + (columns - 1) * gap;
+    const int rows = (9 + columns - 1) / columns;
+    extent_y = rows * height + (rows - 1) * gap;
+  }
+  if (extent_x > available_x || extent_y > available_y) return result;
+  result.center_x = x = std::clamp(x, viewport.xmin + gap + extent_x / 2,
+                                  viewport.xmax - gap - extent_x / 2);
+  result.center_y = y = std::clamp(y, viewport.ymin + gap + extent_y / 2,
+                                  viewport.ymax - gap - extent_y / 2);
+  result.footprint = {x - extent_x / 2, x + extent_x / 2,
+                      y - extent_y / 2, y + extent_y / 2};
+  const int visible = std::min(total, 9);
+  const int angular_slots = visible;
+  phase = total > 9 ? std::remainder(phase, float(total)) : 0;
+  const int first = int(std::floor(phase));
+  const float fraction = phase - std::floor(phase);
+  for (int i = 0; i < visible; ++i) {
+    float cx, cy;
+    if (result.grid) {
+      cx = result.footprint.xmin + width / 2 + (i % columns) * (width + gap);
+      cy = result.footprint.ymax - height / 2 - (i / columns) * (height + gap);
+    }
+    else {
+      const float angle = (float(i) - fraction) * 6.283185307179586f / angular_slots;
+      cx = x + std::sin(angle) * radius;
+      cy = y + std::cos(angle) * radius;
+    }
+    result.buttons.push_back({cx - width / 2, cx + width / 2, cy - height / 2, cy + height / 2});
+    result.indices.push_back(((first + i) % total + total) % total);
+  }
+  result.fits = true;
+  return result;
+}
+
+inline bool ring_viewport_matches(const Rect &a, const Rect &b)
+{
+  return a.xmin == b.xmin && a.xmax == b.xmax && a.ymin == b.ymin && a.ymax == b.ymax;
+}
