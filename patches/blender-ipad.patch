+static wmOperatorStatus resize_invoke(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  bScreen *screen = CTX_wm_screen(C);
+  if (!ED_ipad_panels_enabled(screen)) {
+    return OPERATOR_CANCELLED;
+  }
+  const int axis = RNA_int_get(op->ptr, "axis");
+  if (!CTX_wm_window(C) || axis < 0 || axis > 3) {
+    return OPERATOR_CANCELLED;
+  }
+  const int panel = axis % 2;
+  const Model model = make_model(C, CTX_wm_window(C));
+  if (!model.main || !model.state.slot(panel == 0 ? Edge::Side : Edge::Bottom).open()) {
+    return OPERATOR_CANCELLED;
+  }
+  const float displayed = panel == 0 ? model.layout.side_panel.width() : model.layout.bottom_panel.height();
+  const float extent = panel == 0 ? model.layout.side_panel.height() : model.layout.bottom_panel.width();
+  op->customdata = MEM_new<ResizeData>(__func__, ResizeData{screen->id.session_uid, CTX_wm_window(C),
+                                                          axis, {event->xy[0], event->xy[1]},
+                                                          saved_panel_size(screen, panel, panel == 0 && active_inspector_side(model)),
+                                                          displayed / UI_SCALE_FAC,
+                                                          screen->ipad_panel_extent[panel], extent / UI_SCALE_FAC,
+                                                          model.bounds, panel == 0 && active_inspector_side(model)});
+  WM_event_add_modal_handler(C, op);
+  return OPERATOR_RUNNING_MODAL;
+}
+
+/* Resolve IDs through the live Main before restoring anything. The active screen
+ * can change while a modal drag is pending, and project loading can free its owner. */
+static bScreen *resize_owner(bContext *C, const ResizeData &data)
+{
+  if (Main *bmain = CTX_data_main(C)) {
+    LISTBASE_FOREACH (bScreen *, screen, &bmain->screens) {
+      if (screen->id.session_uid == data.screen_uid) {
+        return screen;
+      }
+    }
+  }
+  return nullptr;
+}
+
+static void resize_cancel(bContext *C, wmOperator *op)
+{
+  auto *data = static_cast<ResizeData *>(op->customdata);
+  if (data) {
+    if (bScreen *screen = resize_owner(C, *data)) {
+      saved_panel_size(screen, data->axis % 2, data->inspector_width) = data->original;
+      if (data->axis >= 2) { screen->ipad_panel_extent[data->axis % 2] = data->original_extent; }
+      screen->do_refresh = true;
+      screen->do_draw = true;
+      if (CTX_wm_window(C) && CTX_wm_screen(C) == screen) {
+        tag_layout(C, CTX_wm_window(C));
+      }
+    }
+    MEM_delete(data);
+    op->customdata = nullptr;
+  }
+}
+
+static wmOperatorStatus resize_modal(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  auto *data = static_cast<ResizeData *>(op->customdata);
+  if (!data) {
+    return OPERATOR_CANCELLED;
+  }
+  bScreen *screen = resize_owner(C, *data);
+  if (!screen || CTX_wm_screen(C) != screen || CTX_wm_window(C) != data->window ||
+      !ED_ipad_panels_enabled(screen))
+  {
+    resize_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  Model model = make_model(C, CTX_wm_window(C));
+  const int panel = data->axis % 2;
+  const auto &old = data->bounds;
+  if (!model.main || !model.state.slot(panel == 0 ? Edge::Side : Edge::Bottom).open() ||
+      (panel == 0 && active_inspector_side(model) != data->inspector_width) ||
+      model.bounds.xmin != old.xmin || model.bounds.xmax != old.xmax ||
+      model.bounds.ymin != old.ymin || model.bounds.ymax != old.ymax) {
+    resize_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if ((event->flag & WM_EVENT_IS_POINTER_CANCEL) ||
+      ELEM(event->type, EVT_ESCKEY, RIGHTMOUSE, WINDEACTIVATE)) {
+    resize_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type == LEFTMOUSE && event->val == KM_RELEASE) {
+    MEM_delete(data);
+    op->customdata = nullptr;
+    return OPERATOR_FINISHED;
+  }
+  if (ELEM(event->type, MOUSEMOVE, INBETWEEN_MOUSEMOVE)) {
+    const float delta = (event->xy[panel] - data->start[panel]) / UI_SCALE_FAC;
+    const float requested = data->initial_size + (panel == 0 ? -delta : delta);
+    const Edge edge = panel == 0 ? Edge::Side : Edge::Bottom;
+    if (data->axis >= 2) {
+      const float delta_other = (event->xy[1-panel] - data->start[1-panel]) / UI_SCALE_FAC;
+      const float extent = data->initial_extent + (panel == 0 ? -delta_other : delta_other);
+      policy::resize_2d(model.state, edge,
+                       int((panel == 0 ? requested : extent) * UI_SCALE_FAC),
+                       int((panel == 0 ? extent : requested) * UI_SCALE_FAC), model.bounds, model.metrics);
+      screen->ipad_panel_extent[panel] =
+          (panel == 0 ? model.state.side_height : model.state.bottom_width) / UI_SCALE_FAC;
+    }
+    else {
+      policy::resize(model.state, edge, int(requested * UI_SCALE_FAC), model.bounds, model.metrics);
+    }
+    saved_panel_size(screen, panel, data->inspector_width) =
+        (panel == 0 ? model.state.side_width : model.state.bottom_height) / UI_SCALE_FAC;
+    tag_layout(C, CTX_wm_window(C));
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
+struct SeamDragData {
+  unsigned int uid;
+  wmWindow *window;
+  policy::WorkingSeam seam;
+  bool fallback = false;
+  policy::WorkingAdjacency adjacency{};
+  std::vector<policy::WorkingAdjacency> adjacencies;
+  std::vector<policy::WorkingSeam> partitions;
+  int start, delta = 0;
+  int original_owner = 0, captured_owner = 0;
+  Rect bounds;
+  std::vector<ScrVert *> vertices;
+  std::vector<policy::SeamVertex> original, last;
+  std::vector<ScrArea *> areas;
+  std::vector<ScrEdge *> edges;
+  std::vector<policy::SeamEdge> edge_indices;
+  std::vector<policy::SeamFace> faces;
+  std::vector<bool> selected;
+  std::vector<policy::Area> working, displayed, inputs;
+  policy::SeamLimits limits;
+};
+
+static bScreen *seam_owner(bContext *C, const SeamDragData &data)
+{
+  if (Main *bmain = CTX_data_main(C)) {
+    LISTBASE_FOREACH (bScreen *, screen, &bmain->screens) {
+      if (screen->id.session_uid == data.uid) { return screen; }
+    }
+  }
+  return nullptr;
+}
+
+static bool seam_snapshot_matches(const bScreen *screen, const SeamDragData &data,
+                                   const bool coordinates = true)
+{
+  size_t i = 0;
+  LISTBASE_FOREACH (ScrVert *, vertex, &screen->vertbase) {
+    if (i >= data.vertices.size() || vertex != data.vertices[i] ||
+        (coordinates && (vertex->vec.x != data.last[i].x || vertex->vec.y != data.last[i].y))) { return false; }
+    ++i;
+  }
+  if (i != data.vertices.size()) { return false; }
+  i = 0;
+  LISTBASE_FOREACH (ScrEdge *, edge, &screen->edgebase) {
+    if (i >= data.edges.size() || edge != data.edges[i] ||
+        edge->v1 != data.vertices[data.edge_indices[i].a] ||
+        edge->v2 != data.vertices[data.edge_indices[i].b]) { return false; }
+    ++i;
+  }
+  if (i != data.edges.size()) { return false; }
+  i = 0;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (i >= data.areas.size() || area != data.areas[i]) { return false; }
+    const auto &v = data.faces[i].vertices;
+    if (area->v1 != data.vertices[v[0]] || area->v2 != data.vertices[v[1]] ||
+        area->v3 != data.vertices[v[2]] || area->v4 != data.vertices[v[3]]) { return false; }
+    ++i;
+  }
+  return i == data.areas.size();
+}
+
+static void seam_cancel(bContext *C, wmOperator *op)
+{
+  auto *data = static_cast<SeamDragData *>(op->customdata);
+  if (!data) { return; }
+  if (bScreen *screen = seam_owner(C, *data)) {
+    bool resized = false;
+    if (CTX_wm_screen(C) == screen && CTX_wm_window(C) == data->window) {
+      rcti rect;
+      WM_window_screen_rect_calc(data->window, &rect);
+      resized = rect.xmin != data->bounds.xmin || rect.ymin != data->bounds.ymin ||
+                rect.xmax != data->bounds.xmax || rect.ymax != data->bounds.ymax;
+    }
+    /* On an active window resize, restore the original layout THEN let Blender's
+     * normal refresh rescale it to the new window. Never retain the old extents. */
+    if (seam_snapshot_matches(screen, *data, !resized)) {
+      for (size_t i = 0; i < data->vertices.size(); ++i) {
+        data->vertices[i]->vec.x = data->original[i].x;
+        data->vertices[i]->vec.y = data->original[i].y;
+      }
+      if (screen->ipad_panel_owner == data->captured_owner) {
+        screen->ipad_panel_owner = data->original_owner;
+      }
+      screen->do_refresh = screen->do_draw = true;
+      if (CTX_wm_screen(C) == screen && CTX_wm_window(C)) { tag_layout(C, CTX_wm_window(C)); }
+    }
+  }
+  MEM_delete(data);
+  op->customdata = nullptr;
+}
+
+static wmOperatorStatus seam_invoke(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  bScreen *screen = CTX_wm_screen(C);
+  wmWindow *win = CTX_wm_window(C);
+  if (!win || !ED_ipad_panels_enabled(screen) || (U.app_flag & USER_APP_LOCK_EDGE_RESIZE)) {
+    return OPERATOR_CANCELLED;
+  }
+  Model model = make_model(C, win);
+  rcti window_rect;
+  WM_window_screen_rect_calc(win, &window_rect);
+  Rect bounds{window_rect.xmin, window_rect.ymin, window_rect.xmax, window_rect.ymax};
+  std::vector<NativeSeamControl> seams;
+  auto displayed = working_controls(screen, model.working, bounds, seams);
+  const int index = RNA_int_get(op->ptr, "seam");
+  if (index < 0 || index >= int(seams.size())) { return OPERATOR_CANCELLED; }
+  auto *data = MEM_new<SeamDragData>(__func__);
+  data->uid = screen->id.session_uid;
+  data->window = win;
+  data->seam = seams[index].seam;
+  data->fallback = seams[index].fallback;
+  data->adjacency = seams[index].adjacency;
+  std::vector<policy::WorkingFallback> nodes;
+  policy::working_layout(model.working, bounds, int(4 * UI_SCALE_FAC), &data->partitions, &nodes);
+  data->adjacencies = policy::working_adjacencies(model.working, displayed, nodes);
+  data->start = event->xy[data->seam.vertical ? 0 : 1];
+  data->bounds = bounds;
+  data->working = model.working;
+  data->inputs = model.inputs;
+  data->original_owner = screen->ipad_panel_owner;
+  data->captured_owner = int(std::find(model.areas.begin(), model.areas.end(), model.main) -
+                            model.areas.begin()) + 1;
+  data->displayed = std::move(displayed);
+  LISTBASE_FOREACH (ScrVert *, vertex, &screen->vertbase) {
+    data->vertices.push_back(vertex);
+    data->original.push_back({vertex->vec.x, vertex->vec.y});
+  }
+  data->last = data->original;
+  auto vertex_index = [&](ScrVert *v) {
+    return size_t(std::find(data->vertices.begin(), data->vertices.end(), v) - data->vertices.begin());
+  };
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    data->areas.push_back(area);
+    data->faces.push_back({{vertex_index(area->v1), vertex_index(area->v2),
+                            vertex_index(area->v3), vertex_index(area->v4)},
+                           int(29 * UI_SCALE_FAC + 2 * U.pixelsize),
+                           int(ED_area_headersize() + 2 * U.pixelsize)});
+  }
+  std::vector<policy::SeamEdge> edges;
+  size_t seed = size_t(-1);
+  int distance = INT_MAX;
+  const auto &seam = data->seam;
+  const int along_axis = seam.vertical ? 1 : 0;
+  const int display_low = seam.vertical ? seam.display_bounds.ymin : seam.display_bounds.xmin;
+  const int display_size = seam.vertical ? seam.display_bounds.height() : seam.display_bounds.width();
+  const int saved_low = seam.vertical ? seam.saved_bounds.ymin : seam.saved_bounds.xmin;
+  const int saved_size = seam.vertical ? seam.saved_bounds.height() : seam.saved_bounds.width();
+  const int along = saved_low + int(static_cast<long long>(event->xy[along_axis] - display_low) *
+                                   saved_size / std::max(1, display_size));
+  LISTBASE_FOREACH (ScrEdge *, edge, &screen->edgebase) {
+    const size_t a = vertex_index(edge->v1), b = vertex_index(edge->v2);
+    if (a >= data->vertices.size() || b >= data->vertices.size()) {
+      MEM_delete(data); return OPERATOR_CANCELLED;
+    }
+    const auto &v1 = data->original[a], &v2 = data->original[b];
+    const int c1 = seam.vertical ? v1.x : v1.y, c2 = seam.vertical ? v2.x : v2.y;
+    if (data->fallback && edge == seams[index].edge) { seed = edges.size(); }
+    if (!data->fallback && c1 == seam.coordinate && c2 == seam.coordinate) {
+      const int low = std::min(seam.vertical ? v1.y : v1.x, seam.vertical ? v2.y : v2.x);
+      const int high = std::max(seam.vertical ? v1.y : v1.x, seam.vertical ? v2.y : v2.x);
+      if (high >= saved_low && low < saved_low + saved_size) {
+        const int d = std::max({low - along, along - high, 0});
+        if (d < distance) { distance = d; seed = edges.size(); }
+      }
+    }
+    edges.push_back({a,b});
+    data->edges.push_back(edge);
+  }
+  data->edge_indices = edges;
+  data->selected = policy::seam_connected_vertices(data->original, edges, seed, seam.vertical);
+  data->limits = policy::seam_saved_limits(data->original, data->faces, data->selected,
+                                           seam.vertical, 1, 1);
+  if (!data->limits.valid || !seam_snapshot_matches(screen, *data)) {
+    MEM_delete(data); return OPERATOR_CANCELLED;
+  }
+  screen->ipad_panel_owner = data->captured_owner;
+  op->customdata = data;
+  WM_event_add_modal_handler(C, op);
+  return OPERATOR_RUNNING_MODAL;
+}
+
+static bool seam_candidate_valid(const SeamDragData &data, const int delta)
+{
+  auto inputs = data.inputs;
+  for (auto &area : inputs) {
+    const auto &v = data.faces[area.id].vertices;
+    if (data.seam.vertical) {
+      area.original.xmin += data.selected[v[0]] ? delta : 0;
+      area.original.xmax += data.selected[v[3]] ? delta : 0;
+    }
+    else {
+      area.original.ymin += data.selected[v[0]] ? delta : 0;
+      area.original.ymax += data.selected[v[1]] ? delta : 0;
+    }
+  }
+  const auto mapping = policy::classify(inputs, int(2 * UI_SCALE_FAC));
+  const auto original_mapping = policy::classify(data.inputs, int(2 * UI_SCALE_FAC));
+  auto ids = [](const auto &areas) {
+    std::vector<int> result;
+    for (const auto &area : areas) { result.push_back(area.id); }
+    std::sort(result.begin(), result.end());
+    return result;
+  };
+  if (ids(mapping.working) != ids(data.working) || mapping.panels.size() != original_mapping.panels.size()) {
+    return false;
+  }
+  for (const auto &panel : original_mapping.panels) {
+    if (std::none_of(mapping.panels.begin(), mapping.panels.end(), [&](const auto &p) {
+          return p.id == panel.id && p.edge == panel.edge;
+        })) { return false; }
+  }
+  std::vector<policy::WorkingSeam> seams;
+  std::vector<policy::WorkingFallback> nodes;
+  auto placed = policy::working_layout(mapping.working, data.bounds, int(4 * UI_SCALE_FAC), &seams, &nodes);
+  const auto adjacencies = policy::working_adjacencies(mapping.working, placed, nodes);
+  auto same_adjacency = [](const auto &a, const auto &b) {
+    return a.vertical == b.vertical && a.before_id == b.before_id && a.after_id == b.after_id &&
+           a.node.members == b.node.members;
+  };
+  if (adjacencies.size() != data.adjacencies.size()) { return false; }
+  for (const auto &original : data.adjacencies) {
+    if (std::none_of(adjacencies.begin(), adjacencies.end(), [&](const auto &candidate) {
+          return same_adjacency(original, candidate);
+        })) { return false; }
+  }
+  if (seams.size() != data.partitions.size()) { return false; }
+  for (const auto &original : data.partitions) {
+    if (std::none_of(seams.begin(), seams.end(), [&](const auto &candidate) {
+          return candidate.vertical == original.vertical && candidate.before == original.before &&
+                 candidate.after == original.after;
+        })) { return false; }
+  }
+  const bool same_partition = data.fallback ?
+      std::any_of(adjacencies.begin(), adjacencies.end(), [&](const auto &adj) {
+        return same_adjacency(data.adjacency, adj) && adj.coordinate == data.seam.coordinate + delta;
+      }) : std::any_of(seams.begin(), seams.end(), [&](const auto &seam) {
+    return seam.vertical == data.seam.vertical && seam.before == data.seam.before &&
+           seam.after == data.seam.after && seam.coordinate == data.seam.coordinate + delta;
+  });
+  return same_partition && policy::seam_display_valid(data.displayed, placed, data.bounds,
+                                                       int(160 * UI_SCALE_FAC), int(100 * UI_SCALE_FAC));
+}
+
+static wmOperatorStatus seam_modal(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  auto *data = static_cast<SeamDragData *>(op->customdata);
+  if (!data) { return OPERATOR_CANCELLED; }
+  bScreen *screen = seam_owner(C, *data);
+  if (!screen || CTX_wm_screen(C) != screen || CTX_wm_window(C) != data->window ||
+      !ED_ipad_panels_enabled(screen) || !seam_snapshot_matches(screen, *data) ||
+      (event->flag & WM_EVENT_IS_POINTER_CANCEL) || ELEM(event->type, EVT_ESCKEY, RIGHTMOUSE, WINDEACTIVATE)) {
+    seam_cancel(C, op); return OPERATOR_CANCELLED;
+  }
+  rcti rect;
+  WM_window_screen_rect_calc(data->window, &rect);
+  if (rect.xmin != data->bounds.xmin || rect.ymin != data->bounds.ymin ||
+      rect.xmax != data->bounds.xmax || rect.ymax != data->bounds.ymax) {
+    seam_cancel(C, op); return OPERATOR_CANCELLED;
+  }
+  if (event->type == LEFTMOUSE && event->val == KM_RELEASE) {
+    MEM_delete(data); op->customdata = nullptr;
+    WM_event_add_notifier(C, NC_SCREEN | NA_EDITED, nullptr);
+    return OPERATOR_FINISHED;
+  }
+  if (ELEM(event->type, MOUSEMOVE, INBETWEEN_MOUSEMOVE)) {
+    int requested = policy::seam_saved_delta(data->seam, event->xy[data->seam.vertical ? 0 : 1] - data->start);
+    requested = std::clamp(requested, data->limits.minimum, data->limits.maximum);
+    int accepted = 0, rejected = std::abs(requested), sign = requested < 0 ? -1 : 1;
+    if (seam_candidate_valid(*data, requested)) { accepted = rejected; }
+    else {
+      while (accepted + 1 < rejected) {
+        const int middle = accepted + (rejected - accepted) / 2;
+        if (seam_candidate_valid(*data, middle * sign)) { accepted = middle; }
+        else { rejected = middle; }
+      }
+    }
+    data->delta = accepted * sign;
+    for (size_t i = 0; i < data->vertices.size(); ++i) {
+      data->last[i] = data->original[i];
+      if (data->selected[i]) {
+        (data->seam.vertical ? data->last[i].x : data->last[i].y) += data->delta;
+      }
+      data->vertices[i]->vec.x = data->last[i].x;
+      data->vertices[i]->vec.y = data->last[i].y;
+    }
+    tag_layout(C, data->window);
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
+
+}  // namespace
+
+void ED_ipad_panels_resize_regions(bContext *C, wmWindow *win, std::vector<rcti> &regions)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  if (!ED_ipad_panels_enabled(screen)) {
+    return;
+  }
+  const Model model = make_model(C, win);
+  if (!model.main) {
+    return;
+  }
+  for (const Button &button : buttons(model, screen)) {
+    if (ELEM(button.action, Action::Resize, Action::Seam) && !button.rect.empty()) {
+      regions.push_back(to_rect(button.rect));
+    }
+  }
+}
+
+bool ED_ipad_panels_enabled(const bScreen *screen)
+{
+  return screen && !G.background && !screen->temp && screen->state == SCREENNORMAL;
+}
+
+bool ED_ipad_panels_locked(const bScreen *screen)
+{
+  return screen && (screen->ipad_panels_locked || screen->ipad_panel_locked[0] ||
+                    screen->ipad_panel_locked[1]);
+}
+
+bool ED_ipad_panels_native_pin(const bScreen *screen, const ScrArea *area)
+{
+  if (!ED_ipad_panels_enabled(screen) || !area || area->runtime.ipad_layer != 1 ||
+      area->spacetype != SPACE_VIEW3D)
+  {
+    return false;
+  }
+  /* Keep the single lock at the outer top-right editor, independent of which
+   * working editor currently owns the native sidebar and Tools regions. */
+  LISTBASE_FOREACH (const ScrArea *, other, &screen->areabase) {
+    if (other->runtime.ipad_layer == 1 &&
+        (other->runtime.ipad_rect.xmax > area->runtime.ipad_rect.xmax ||
+         (other->runtime.ipad_rect.xmax == area->runtime.ipad_rect.xmax &&
+          other->runtime.ipad_rect.ymax > area->runtime.ipad_rect.ymax))) {
+      return false;
+    }
+  }
+  const auto *v3d = static_cast<const View3D *>(area->spacedata.first);
+  return v3d && !(v3d->gizmo_flag & (V3D_GIZMO_HIDE | V3D_GIZMO_HIDE_NAVIGATE)) &&
+         ((U.uiflag & USER_SHOW_GIZMO_NAVIGATE) || U.mini_axis_type == USER_MINI_AXIS_TYPE_GIZMO);
+}
+
+bool ED_ipad_panels_area_visible(const ScrArea *area)
+{
+  return area->runtime.ipad_layer != 4;
+}
+
+int ED_ipad_panels_area_layer(const ScrArea *area)
+{
+  return area->runtime.ipad_layer == 2 ? 1 : area->runtime.ipad_layer == 3 ? 2 : 0;
+}
+
+int ED_ipad_panels_area_hit_layer(const ScrArea *area, const int xy[2])
+{
+  if (!ED_ipad_panels_area_visible(area)) {
+    return -1;
+  }
+  if (area->runtime.ipad_layer == 1) {
+    LISTBASE_FOREACH (const ARegion *, region, &area->regionbase) {
+      if (region->runtime->ipad_floating && region->runtime->visible &&
+          BLI_rcti_isect_pt_v(&region->winrct, xy)) {
+        return 2;
+      }
+    }
+  }
+  return BLI_rcti_isect_pt_v(&area->totrct, xy) ? ED_ipad_panels_area_layer(area) : -1;
+}
+
+void ED_ipad_panels_prepare(bContext *C, wmWindow *win)
+{
+  bScreen *screen = WM_window_get_active_screen(win);
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    area->runtime.ipad_layer = 0;
+    area->runtime.ipad_panel_host = 0;
+    area->runtime.ipad_side_region = 0;
+    area->runtime.ipad_bottom_region = 0;
+    area->runtime.ipad_tools_region = 0;
+    LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+      region->runtime->ipad_floating = false;
+      region->runtime->ipad_canvas = false;
+    }
+  }
+  if (!ED_ipad_panels_enabled(screen)) {
+    return;
+  }
+  Model model = make_model(C, win);
+  if (!model.main) {
+    return;
+  }
+  WorkSpace *workspace = CTX_wm_workspace(C);
+  Main *bmain = CTX_data_main(C);
+  /* Saved projects own their Tool Header preference even when their workspace
+   * retains the factory name. Only adapt an unsaved startup/new layout. */
+  const bool factory_new_file = bmain && BKE_main_blendfile_path(bmain)[0] == '\0';
+  if (!screen->ipad_panel_initialized && factory_new_file && workspace &&
+      STREQ(workspace->id.name + 2, "Layout") && model.main->spacetype == SPACE_VIEW3D &&
+      find_tab(model, tools_id) && model.object_mode)
+  {
+    ARegion *header = BKE_area_find_region_type(model.main, RGN_TYPE_TOOL_HEADER);
+    if (header && !(header->flag & RGN_FLAG_HIDDEN_BY_USER)) {
+      header->flag |= RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER;
+      ED_region_tag_redraw(header);
+      model = make_model(C, win);
+    }
+  }
+  rcti screen_rect;
+  WM_window_screen_rect_calc(win, &screen_rect);
+  for (ScrArea *area : model.areas) {
+    area->runtime.ipad_layer = 4;
+  }
+  const Rect workspace_bounds{screen_rect.xmin, screen_rect.ymin, screen_rect.xmax, screen_rect.ymax};
+  for (const policy::Area &working : policy::working_layout(model.working, workspace_bounds,
+                                                          int(4 * UI_SCALE_FAC))) {
+    ScrArea *area = model.areas[working.id];
+    area->runtime.ipad_layer = 1;
+    area->runtime.ipad_rect = to_rect(working.original);
+  }
+  model.main->runtime.ipad_panel_host = 1;
+  const ARegion *main_window = BKE_area_find_region_type(model.main, RGN_TYPE_WINDOW);
+  if (!screen->ipad_panel_initialized && main_window && main_window->runtime->type) {
+    save_slot(screen, model, Edge::Bottom);
+    save_slot(screen, model, Edge::Tools);
+  }
+  if (model.sculpt && !screen->ipad_sculpt_shelf_initialized && find_tab(model, shelf_id)) {
+    save_slot(screen, model, Edge::Bottom);
+  }
+  model.main->runtime.ipad_side_rect = to_rect(panel_content(model, Edge::Side));
+  model.main->runtime.ipad_bottom_rect = to_rect(panel_content(model, Edge::Bottom));
+  model.main->runtime.ipad_tools_rect = to_rect(model.layout.tools_panel);
+  model.main->runtime.ipad_tools_region = model.state.tools.open() ? RGN_TYPE_TOOLS : 0;
+  for (const Edge edge : {Edge::Side, Edge::Bottom}) {
+    const Tab *tab = find_tab(model, model.state.slot(edge).active_id);
+    if (!tab) {
+      continue;
+    }
+    if (tab->region_type == 0) {
+      tab->area->runtime.ipad_layer = edge == Edge::Side ? 3 : 2;
+      tab->area->runtime.ipad_rect = to_rect(panel_content(model, edge));
+    }
+    else if (edge == Edge::Side) {
+      model.main->runtime.ipad_side_region = tab->region_type;
+    }
+    else {
+      model.main->runtime.ipad_bottom_region = tab->region_type;
+    }
+  }
+  ipad_hud_chrome_capture(win, screen, model);
+}
+
+bool ED_ipad_panels_main_region_layout(const wmWindow *win, ScrArea *main)
+{
+  if (main->runtime.ipad_layer != 1) {
+    return false;
+  }
+  bScreen *screen = WM_window_get_active_screen(win);
+  Model model;
+  std::vector<ScrArea *> working_areas;
+  ScrArea *host = nullptr;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (area->runtime.ipad_layer == 1) {
+      working_areas.push_back(area);
+      if (area->runtime.ipad_panel_host) {
+        host = area;
+      }
+    }
+  }
+  if (!host) {
+    return false;
+  }
+  model.main = host;
+  model.bounds = workspace_content_bounds(win, working_areas);
+  ScrArea *side_editor = nullptr;
+  /* prepare() has already selected the real editor/region instances. Recompute
+   * only their geometry here, after native headers establish the WINDOW rect. */
+  model.state.tools.active_id = host->runtime.ipad_tools_region ? tools_id : -1;
+  model.state.side.active_id = host->runtime.ipad_side_region ? 0 : -1;
+  model.state.bottom.active_id = host->runtime.ipad_bottom_region ? 0 : -1;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (area->runtime.ipad_layer == 3) {
+      model.state.side.active_id = 0;
+      side_editor = area;
+    }
+    else if (area->runtime.ipad_layer == 2) {
+      model.state.bottom.active_id = 0;
+    }
+  }
+  preferred_sizes(screen, model.state, side_editor);
+  model.metrics = panel_metrics(model.main, side_editor);
+  model.layout = policy::layout(model.bounds, model.state, model.metrics);
+  const rcti side = to_rect(panel_content(model, Edge::Side));
+  const rcti bottom = to_rect(panel_content(model, Edge::Bottom));
+  auto assign = [](rcti &target, const rcti &value) {
+    if (target.xmin == value.xmin && target.ymin == value.ymin &&
+        target.xmax == value.xmax && target.ymax == value.ymax)
+    {
+      return false;
+    }
+    target = value;
+    return true;
+  };
+  bool changed = assign(host->runtime.ipad_side_rect, side);
+  changed |= assign(host->runtime.ipad_bottom_rect, bottom);
+  changed |= assign(host->runtime.ipad_tools_rect, to_rect(model.layout.tools_panel));
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    if (ELEM(area->runtime.ipad_layer, 2, 3)) {
+      const rcti &rect = area->runtime.ipad_layer == 3 ? side : bottom;
+      if (assign(area->runtime.ipad_rect, rect)) {
+        area->flag |= AREA_FLAG_REGION_SIZE_UPDATE;
+        ED_area_tag_redraw(area);
+      }
+    }
+  }
+  if (changed && host != main) {
+    host->flag |= AREA_FLAG_REGION_SIZE_UPDATE;
+    ED_area_tag_redraw(host);
+  }
+  for (ScrArea *area : working_areas) {
+    LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+      if (region->regiontype != RGN_TYPE_WINDOW) {
+        continue;
+      }
+      const Rect &canvas = model.layout.canvas;
+      const rcti &window = region->winrct;
+      const Rect clipped{std::clamp(canvas.xmin, window.xmin, window.xmax),
+                           std::clamp(canvas.ymin, window.ymin, window.ymax),
+                           std::clamp(canvas.xmax, window.xmin + 1, window.xmax + 1),
+                           std::clamp(canvas.ymax, window.ymin + 1, window.ymax + 1)};
+      region->runtime->ipad_canvas = true;
+      region->runtime->ipad_canvas_rect = to_rect(clipped);
+      BLI_rcti_translate(&region->runtime->ipad_canvas_rect, -window.xmin, -window.ymin);
+      region->runtime->visible_rect = {};
+    }
+  }
+  return changed && host == main;
+}
+
+bool ED_ipad_panels_region_managed(const ScrArea *area, const ARegion *region)
+{
+  return area->runtime.ipad_layer == 1 &&
+         ELEM(region->regiontype, RGN_TYPE_UI, RGN_TYPE_TOOLS,
+              RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER);
+}
+
+bool ED_ipad_panels_region_rect(ScrArea *area, ARegion *region)
+{
+  if (!ED_ipad_panels_region_managed(area, region)) {
+    region->runtime->ipad_floating = false;
+    return false;
+  }
+  const bool bottom = ELEM(region->regiontype, RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER);
+  const bool tools = region->regiontype == RGN_TYPE_TOOLS;
+  const bool open = tools ? area->runtime.ipad_tools_region != 0 : bottom ? area->runtime.ipad_bottom_region != 0 :
+                            area->runtime.ipad_side_region == region->regiontype;
+  const bool visible = open && !(region->flag & RGN_FLAG_POLL_FAILED);
+  region->runtime->ipad_floating = true;
+  region->overlap = true;
+  region->flag &= ~RGN_FLAG_TOO_SMALL;
+  region->winrct = tools ? area->runtime.ipad_tools_rect : bottom ? area->runtime.ipad_bottom_rect : area->runtime.ipad_side_rect;
+  if (bottom) {
+    const rcti &r = region->winrct;
+    const policy::ShelfRegions shelf = policy::shelf_regions(
+        {r.xmin, r.ymin, r.xmax + 1, r.ymax + 1},
+        blender::ed::asset::shelf::header_region_size());
+    const Rect &rect = region->regiontype == RGN_TYPE_ASSET_SHELF_HEADER ? shelf.header : shelf.body;
+    region->winrct = to_rect(rect);
+  }
+  if (!visible || region->winrct.xmax <= region->winrct.xmin ||
+      region->winrct.ymax <= region->winrct.ymin)
+  {
+    region->flag |= RGN_FLAG_TOO_SMALL;
+    region->winrct = {0, 0, 0, 0};
+  }
+  region->winx = BLI_rcti_size_x(&region->winrct) + 1;
+  region->winy = BLI_rcti_size_y(&region->winrct) + 1;
+  region->runtime->visible_rect = {};
+  return true;
+}
+
+bool ED_ipad_panels_toggle_region(bContext *C, ARegion *region)
+{
+  if (!region || !CTX_wm_area(C) || !ED_ipad_panels_enabled(CTX_wm_screen(C)) ||
+      !ED_ipad_panels_region_managed(CTX_wm_area(C), region))
+  {
+    return false;
+  }
+  wmWindow *win = CTX_wm_window(C);
+  bScreen *screen = CTX_wm_screen(C);
+  Model model = make_model(C, win);
+  const Edge edge = ELEM(region->regiontype, RGN_TYPE_ASSET_SHELF, RGN_TYPE_ASSET_SHELF_HEADER) ?
+                        Edge::Bottom : region->regiontype == RGN_TYPE_TOOLS ? Edge::Tools : Edge::Side;
+  const Tab *active = find_tab(model, model.state.slot(edge).active_id);
+  if (active && active->region_type == region->regiontype) {
+    model.state.tap(edge, active->id);
+  }
+  else {
+    for (const Tab &tab : model.tabs) {
+      if (tab.region_type == region->regiontype) {
+        model.state.tap(edge, tab.id);
+        break;
+      }
+    }
+  }
+  save_slot(screen, model, edge);
+  tag_layout(C, win);
+  return true;
+}
