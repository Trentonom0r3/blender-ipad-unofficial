+/* Values only: membership in the current native lists is checked before building
+ * a live receipt. No saved Object/ID/tool/property pointer is dereferenced. */
+struct RingContextIdentity {
+  uintptr_t main = 0, window = 0, screen = 0, area = 0, region = 0;
+  unsigned int screen_uid = 0, scene_uid = 0, object_uid = 0, data_uid = 0;
+  int mode = 0;
+  uintptr_t view_layer = 0;
+  int window_id = 0;
+  unsigned int wm_uid = 0;
+};
+inline bool ring_context_matches(const RingContextIdentity &a, const RingContextIdentity &b)
+{
+  return a.main == b.main && a.window == b.window && a.screen == b.screen &&
+         a.area == b.area && a.region == b.region && a.screen_uid == b.screen_uid &&
+         a.scene_uid == b.scene_uid && a.object_uid == b.object_uid &&
+         a.data_uid == b.data_uid && a.mode == b.mode &&
+         a.view_layer == b.view_layer && a.window_id == b.window_id && a.wm_uid == b.wm_uid;
+}
+inline std::array<uint64_t, 13> context_values(const RingContextIdentity &c)
+{
+  return {uint64_t(c.main), uint64_t(c.window), uint64_t(c.screen), uint64_t(c.area),
+          uint64_t(c.region), c.screen_uid, c.scene_uid, c.object_uid, c.data_uid,
+          uint64_t(c.mode), uint64_t(c.view_layer), uint64_t(c.window_id), c.wm_uid};
+}
+
+/* Non-interactive feedback, bounded by the same exposed canvas as the rings. */
+struct StrokeCueLayout {
+  Rect bounds{};
+  std::array<Rect, 3> lines{};
+  bool fits = false;
+};
+inline StrokeCueLayout stroke_cue_layout(float unit, Rect viewport,
+                                         const std::array<float, 3> &text_widths)
+{
+  StrokeCueLayout result;
+  if (!std::isfinite(unit) || unit <= 0 ||
+      !std::isfinite(viewport.xmin) || !std::isfinite(viewport.xmax) ||
+      !std::isfinite(viewport.ymin) || !std::isfinite(viewport.ymax)) return result;
+  for (float width : text_widths) if (!std::isfinite(width) || width < 0) return result;
+  const float margin = 0.4f * unit, pad = 0.4f * unit;
+  const float available = viewport.xmax - viewport.xmin - 2 * margin;
+  const float cap = std::min(16.8f * unit, available);
+  /* Instructions must fit in full; only the live operation/constraint may clip. */
+  const float critical = std::max(text_widths[1], text_widths[2]) + 0.1f * unit;
+  const float height = 3 * unit + 2 * pad;
+  if (cap < critical + 2 * pad ||
+      viewport.ymax - viewport.ymin < height + 2 * margin + 2 * unit) return result;
+  const float width = std::min(cap, std::max(12.8f * unit,
+      std::max(text_widths[0], critical) + 2 * pad));
+  const float cx = (viewport.xmin + viewport.xmax) * 0.5f;
+  /* Keep the top native AutoKey/info band clear; cue sits above the shelf. */
+  const float top = viewport.ymin + margin + height;
+  result.bounds = {cx - width * 0.5f, cx + width * 0.5f, top - height, top};
+  for (int i = 0; i < 3; ++i) {
+    const float y = top - pad - i * unit;
+    result.lines[i] = {result.bounds.xmin + pad, result.bounds.xmax - pad, y - unit, y};
+  }
+  result.fits = true;
+  return result;
+}
+
+struct ModeMenuLayout {
+  std::vector<Rect> buttons;
+  bool fits = false;
+};
+/* Modes have their own dynamic layout; they never occupy the fixed-nine ring. */
+inline ModeMenuLayout mode_menu_layout(float unit, Rect viewport, float x, float y,
+                                       int count, float label_width)
+{
+  ModeMenuLayout result;
+  if (!(unit > 0) || count < 1 || count > 32 || !std::isfinite(label_width)) return result;
+  const float gap = .25f * unit, height = 2.2f * unit;
+  const float width = std::max(7.f * unit, label_width + 3.f * unit);
+  const float available_width = viewport.xmax - viewport.xmin - 2 * gap;
+  const float available_height = viewport.ymax - viewport.ymin - 2 * gap;
+  const int columns = count > 1 && available_width >= 2 * width + gap ? 2 : 1;
+  const int rows = (count + columns - 1) / columns;
+  const float extent_x = columns * width + (columns - 1) * gap;
+  const float extent_y = rows * height + (rows - 1) * gap;
+  if (extent_x > available_width || extent_y > available_height) return result;
+  const float left = std::clamp(x - extent_x / 2, viewport.xmin + gap,
+                               viewport.xmax - gap - extent_x);
+  const float top = std::clamp(y + extent_y / 2, viewport.ymin + gap + extent_y,
+                              viewport.ymax - gap);
+  for (int i = 0; i < count; ++i) {
+    const float bx = left + (i % columns) * (width + gap);
+    const float by = top - (i / columns) * (height + gap);
+    result.buttons.push_back({bx, bx + width, by - height, by});
+  }
+  result.fits = true;
+  return result;
+}
