+enum class RingKind { None, Tools, Selection, Transform, Mode, Base, Layout, Workspaces, Inventory, SelectOptions, TransformOptions, View };
+inline RingKind ring_kind(const char *name)
+{
+  if (!name) return RingKind::None;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_tools") == 0) return RingKind::Tools;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_selection_ring") == 0) return RingKind::Selection;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_transform_ring") == 0) return RingKind::Transform;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_modes") == 0) return RingKind::Mode;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_base_ring") == 0) return RingKind::Base;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_layout_mode_ring") == 0) return RingKind::Layout;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_workspaces_ring") == 0) return RingKind::Workspaces;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_tool_inventory") == 0) return RingKind::Inventory;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_selection_options") == 0) return RingKind::SelectOptions;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_transform_options") == 0) return RingKind::TransformOptions;
+  if (std::strcmp(name, "VIEW3D_MT_ipad_view_ring") == 0) return RingKind::View;
+  return RingKind::None;
+}
+
+inline bool ring_uses_pages(RingKind kind)
+{
+  return kind == RingKind::Base || kind == RingKind::Layout || kind == RingKind::Workspaces ||
+         kind == RingKind::Inventory || kind == RingKind::SelectOptions || kind == RingKind::TransformOptions ||
+         kind == RingKind::View;
+}
+
+inline bool ring_setting_stays_open(RingKind kind, const char *operator_id)
+{
+  if (!operator_id) return false;
+  if (kind == RingKind::Selection || kind == RingKind::SelectOptions) {
+    return std::strcmp(operator_id, "VIEW3D_OT_ipad_selection_tool") == 0 ||
+           std::strcmp(operator_id, "MESH_OT_select_mode") == 0;
+  }
+  if (kind == RingKind::Transform || kind == RingKind::TransformOptions) {
+    return std::strcmp(operator_id, "VIEW3D_OT_ipad_transform_axis") == 0 ||
+           std::strcmp(operator_id, "VIEW3D_OT_ipad_transform_option") == 0;
+  }
+  return false;
+}
