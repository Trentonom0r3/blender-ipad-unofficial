 /* -------------------------------------------------------------------- */
 /** \name Region Drawing
  *
  * Each region draws into its own frame-buffer, which is then blit on the
  * window draw buffer. This helps with fast redrawing if only some regions
  * change. It also means we can share a single context for multiple windows,
  * so that for example VAOs can be shared between windows.
  * \{ */
 
+#ifdef WITH_APPLE_CROSSPLATFORM
+struct wmIPadFingerPaintCandidate {
+  uintptr_t region;
+  uint64_t generation;
+  ghost::ios::NavigationRect bounds, navigation;
+  bool unknown_widgets, navigation_present;
+  size_t order;
+};
+struct wmIPadFingerPaintBlocker { ghost::ios::NavigationRect bounds; size_t order; };
+struct wmIPadFingerPaintFrame {
+  uint64_t screen_uid, window_id;
+  size_t order = 0;
+  bool dismissible_panel = false;
+  bool opaque_window_callback = false;
+  std::vector<wmIPadFingerPaintCandidate> candidates;
+  std::vector<wmIPadFingerPaintBlocker> blockers;
+};
+static ghost::ios::NavigationRect wm_ipad_finger_rect(const rcti &r)
+{
+  return {r.xmin, r.ymin, r.xmax, r.ymax};
+}
+static ghost::ios::NavigationRect wm_ipad_finger_rect(const int r[4])
+{
+  return {r[0], r[1], r[2], r[3]};
+}
+static void wm_ipad_finger_rect_copy(int target[4], const rcti &r)
+{
+  target[0] = r.xmin; target[1] = r.ymin; target[2] = r.xmax; target[3] = r.ymax;
+}
+static bool wm_ipad_finger_rect_equal(const int stored[4], const rcti &r)
+{
+  return stored[0] == r.xmin && stored[1] == r.ymin &&
+         stored[2] == r.xmax && stored[3] == r.ymax;
+}
+static void wm_ipad_finger_paint_record(bContext *C, wmWindow *win, ScrArea *area,
+                                        ARegion *region, wmIPadFingerPaintFrame &frame,
+                                        const rcti &drawn, bool overlap)
+{
+  const size_t order = ++frame.order;
+  /* Every actually composited higher region reserves its real footprint. */
+  frame.blockers.push_back({wm_ipad_finger_rect(drawn), order});
+  const bScreen *screen = WM_window_get_active_screen(win);
+  if (!ED_ipad_panels_locked(screen) &&
+      (area->runtime.ipad_layer > 1 || ED_ipad_panels_region_managed(area, region)))
+    frame.dismissible_panel = true;
+  const wmDrawBuffer *buffer = region->runtime->draw_buffer;
+  if (overlap || !buffer || !buffer->ipad_finger_paint_generation) return;
+  if (!wm_ipad_finger_rect_equal(buffer->ipad_finger_paint_region, region->winrct)) {
+    ED_region_tag_redraw(region); return;
+  }
+  frame.candidates.push_back({uintptr_t(region), buffer->ipad_finger_paint_generation,
+                              wm_ipad_finger_rect(buffer->ipad_finger_paint_rect),
+                              wm_ipad_finger_rect(buffer->ipad_finger_paint_navigation),
+                              buffer->ipad_finger_paint_unknown_widgets,
+                              buffer->ipad_finger_paint_navigation_present, order});
+  UNUSED_VARS(C);
+}
+static void wm_ipad_finger_paint_publish(bContext *C, wmWindow *win,
+                                         const wmIPadFingerPaintFrame &frame)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || BLI_findindex(&wm->windows, win) == -1) return;
+  bScreen *screen = WM_window_get_active_screen(win);
+  std::vector<ghost::ios::FingerPaintRect> result;
+  bool blocked = !screen || screen->id.session_uid != frame.screen_uid ||
+      uint64_t(win->winid) != frame.window_id || frame.dismissible_panel ||
+      !ED_ipad_panels_enabled(screen) || win->gesture.first || win->drawcalls.first ||
+      frame.opaque_window_callback;
+  const wmWindow *modifier_window = wm->runtime && wm->runtime->winactive ?
+      wm->runtime->winactive : win;
+  if (!modifier_window->eventstate || modifier_window->eventstate->modifier ||
+      modifier_window->eventstate->keymodifier) blocked = true;
+  LISTBASE_FOREACH (wmEventHandler *, handler, &win->modalhandlers)
+    if (ELEM(handler->type, WM_HANDLER_TYPE_UI, WM_HANDLER_TYPE_OP)) blocked = true;
+  if (screen) LISTBASE_FOREACH (ARegion *, popup, &screen->regionbase) {
+    if (popup->runtime->visible && popup != (screen->tool_tip ? screen->tool_tip->region : nullptr))
+      blocked = true;
+  }
+  if (!blocked) for (const auto &candidate : frame.candidates) {
+    ScrArea *owner_area = nullptr;
+    ARegion *owner = nullptr;
+    /* Callback/overlay drawing may have changed the lists. Find fresh members;
+     * never dereference a saved region address or retain frame pointers. */
+    LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+      LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+        if (uintptr_t(region) == candidate.region) { owner = region; owner_area = area; break; }
+      }
+      if (owner) break;
+    }
+    if (!owner || !owner->runtime->visible || !owner->runtime->draw_buffer ||
+        owner->runtime->draw_buffer->ipad_finger_paint_generation != candidate.generation ||
+        candidate.unknown_widgets || owner->runtime->ipad_finger_paint_overlay_blocked ||
+        (owner->runtime->type && owner->runtime->type->drawcalls.first)) continue;
+    std::vector<ghost::ios::NavigationRect> parts{candidate.bounds};
+    for (const auto &blocker : frame.blockers)
+      if (blocker.order > candidate.order)
+        parts = ghost::ios::finger_paint_subtract(parts, blocker.bounds);
+    if (candidate.navigation_present)
+      parts = ghost::ios::finger_paint_subtract(parts, candidate.navigation);
+    if (owner->runtime->ipad_finger_paint_navigation_drawn)
+      parts = ghost::ios::finger_paint_subtract(parts, wm_ipad_finger_rect(owner_area->runtime.ipad_navigation_rect));
+    if (owner->runtime->ipad_editing_shelf_presented)
+      parts = ghost::ios::finger_paint_subtract(parts, wm_ipad_finger_rect(owner->runtime->ipad_editing_shelf_presented_rect));
+    const int height = WM_window_native_pixel_y(win);
+    for (const auto &part : parts)
+      result.push_back({{part.xmin, height - 1 - part.ymax,
+                         part.xmax, height - 1 - part.ymin}, candidate.generation,
+                        candidate.region});
+  }
+  ghost::ios::set_finger_paint_regions(win->ghostwin, std::move(result));
+}
+#endif
+
