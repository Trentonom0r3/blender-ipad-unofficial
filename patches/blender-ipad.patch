+- (BOOL)begin:(NSString *)path
+    loadUISet:(bool)loadUISet
+       loadUI:(bool)loadUI
+useScriptsSet:(bool)useScriptsSet
+   useScripts:(bool)useScripts
+{
+  if (_busy) {
+    [self cancel];
+  }
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  GHOST_IWindow *window = system ? system->getWindowManager()->getActiveWindow() : nullptr;
+  NSString *documentPath = GHOST_IOS_document_path_for_project(path);
+  NSData *bookmark = GHOST_IOS_bookmark_for_project(path);
+  NSData *digest = GHOST_IOS_document_digest_for_project(path);
+  if (!window || !path.length || !documentPath.length ||
+      [documentPath isEqualToString:path] || !bookmark.length || !digest.length)
+  {
+    return NO;
+  }
+  UIViewController *presenter =
+      static_cast<GHOST_WindowIOS *>(window)->rootWindow.rootViewController;
+  if (!presenter.view.window || presenter.presentedViewController) {
+    return NO;
+  }
+  static uint32_t nextTicket = 0;
+  nextTicket = (nextTicket + 1) & INT32_MAX;
+  if (!nextTicket) {
+    nextTicket = 1;
+  }
+  _busy = YES;
+  ++_generation;
+  _window = window;
+  _ticket = int(nextTicket);
+  _presenter = [presenter retain];
+  _workingPath = [path copy];
+  _documentPath = [documentPath copy];
+  _bookmark = [bookmark retain];
+  _expectedDigest = [digest retain];
+  _loadUISet = loadUISet;
+  _loadUI = loadUI;
+  _useScriptsSet = useScriptsSet;
+  _useScripts = useScripts;
+
+  NSURL *root = [NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES];
+  _stageDirectory = [[root URLByAppendingPathComponent:
+      [@"BlenderRecent-" stringByAppendingString:[NSUUID UUID].UUIDString]
+                                       isDirectory:YES] retain];
+  _stageFile = [[_stageDirectory URLByAppendingPathComponent:@"provider.blend"] retain];
+  _backupFile = [[_stageDirectory URLByAppendingPathComponent:@"previous.blend"] retain];
+  const NSUInteger generation = _generation;
+  _sheet = [[UIAlertController alertControllerWithTitle:@"Checking Files Project"
+                                                message:@"Checking the latest version in Files..."
+                                         preferredStyle:UIAlertControllerStyleAlert] retain];
+  [_sheet setModalInPresentation:YES];
+  [_sheet addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                           style:UIAlertActionStyleCancel
+                                         handler:^(UIAlertAction *action) {
+    if (generation == _generation) {
+      [self cancel];
+    }
+  }]];
+  @try {
+    [_presenter presentViewController:_sheet animated:YES completion:nil];
+  }
+  @catch (NSException *exception) {
+    NSLog(@"Could not show Open Recent preparation: %@", exception);
+    [self cancel];
+    return NO;
+  }
+
+  NSString *working = [_workingPath copy];
+  NSString *expectedPath = [_documentPath copy];
+  NSData *savedBookmark = [_bookmark retain];
+  NSURL *stageDirectory = [_stageDirectory retain];
+  NSURL *stageFile = [_stageFile retain];
+  dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+    @autoreleasepool {
+      BOOL stale = NO;
+      NSError *resolveError = nil;
+      NSURL *provider = [NSURL URLByResolvingBookmarkData:savedBookmark options:0
+          relativeToURL:nil bookmarkDataIsStale:&stale error:&resolveError];
+      const BOOL scoped = provider && [provider startAccessingSecurityScopedResource];
+      const BOOL owned = provider && [provider.path hasPrefix:
+          [NSHomeDirectory() stringByAppendingString:@"/"]];
+      NSData *providerDigest = nil;
+      NSData *renewedBookmark = nil;
+      if (provider && [provider.path isEqualToString:expectedPath] && (scoped || owned)) {
+        NSFileManager *manager = [NSFileManager defaultManager];
+        __block NSError *copyError = nil;
+        NSError *coordinateError = nil;
+        if ([manager createDirectoryAtURL:stageDirectory withIntermediateDirectories:YES
+                               attributes:nil error:&copyError])
+        {
+          NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+          [coordinator coordinateReadingItemAtURL:provider options:0 error:&coordinateError
+                                       byAccessor:^(NSURL *readURL) {
+            [manager copyItemAtURL:readURL toURL:stageFile error:&copyError];
+          }];
+          [coordinator release];
+          if (!copyError && !coordinateError) {
+            NSData *bytes = [NSData dataWithContentsOfURL:stageFile
+                                                 options:NSDataReadingMappedIfSafe error:&copyError];
+            providerDigest = [GHOST_IOS_project_digest(bytes) retain];
+            if (providerDigest && stale) {
+              renewedBookmark = [[provider bookmarkDataWithOptions:0
+                  includingResourceValuesForKeys:nil relativeToURL:nil error:nil] retain];
+            }
+          }
+        }
+        if (copyError || coordinateError) {
+          NSLog(@"Open Recent could not read Files project: %@ %@", copyError, coordinateError);
+        }
+      }
+      else {
+        NSLog(@"Open Recent provider bookmark unavailable: %@", resolveError);
+      }
+      if (scoped) {
+        [provider stopAccessingSecurityScopedResource];
+      }
+      NSError *localError = nil;
+      NSData *localBytes = [NSData dataWithContentsOfFile:working
+                                                  options:NSDataReadingMappedIfSafe error:&localError];
+      NSData *localDigest = [GHOST_IOS_project_digest(localBytes) retain];
+      dispatch_async(dispatch_get_main_queue(), ^{
+        if (generation == _generation && _busy && [self hasLiveWindow]) {
+          _providerDigest = [providerDigest retain];
+          _localDigest = [localDigest retain];
+          _renewedBookmark = [renewedBookmark retain];
+          UIAlertController *sheet = _sheet;
+          _sheet = nil;
+          [sheet dismissViewControllerAnimated:YES completion:^{
+            [sheet release];
+            if (generation == _generation && _busy) {
+              [self showResult];
+            }
+          }];
+        }
+        else {
+          [[NSFileManager defaultManager] removeItemAtURL:stageDirectory error:nil];
+        }
+        [providerDigest release];
+        [localDigest release];
+        [renewedBookmark release];
+        [working release];
+        [expectedPath release];
+        [savedBookmark release];
+        [stageDirectory release];
+        [stageFile release];
+      });
+    }
+  });
+  return YES;
+}
+
+- (GHOST_IOSRecentProjectCommit)commit:(NSString *)path ticket:(int)ticket
+{
+  if (![self isReady:path ticket:ticket])
+  {
+    return GHOST_IOSRecentProjectCommit_Failed;
+  }
+  NSData *currentExpected = GHOST_IOS_document_digest_for_project(_workingPath);
+  NSError *error = nil;
+  NSData *localBytes = [NSData dataWithContentsOfFile:_workingPath
+                                             options:NSDataReadingMappedIfSafe error:&error];
+  NSData *currentLocal = GHOST_IOS_project_digest(localBytes);
+  if (!currentExpected || ![currentExpected isEqualToData:_expectedDigest] ||
+      !currentLocal || ![currentLocal isEqualToData:_localDigest])
+  {
+    return GHOST_IOSRecentProjectCommit_Stale;
+  }
+  if (_refresh) {
+    NSData *newBytes = [NSData dataWithContentsOfURL:_stageFile
+                                             options:NSDataReadingMappedIfSafe error:&error];
+    NSData *newDigest = GHOST_IOS_project_digest(newBytes);
+    if (!newDigest || ![newDigest isEqualToData:_providerDigest] ||
+        ![localBytes writeToURL:_backupFile options:NSDataWritingAtomic error:&error] ||
+        ![newBytes writeToFile:_workingPath options:NSDataWritingAtomic error:&error])
+    {
+      NSLog(@"Open Recent could not refresh the working project: %@", error);
+      return GHOST_IOSRecentProjectCommit_Failed;
+    }
+    GHOST_IOS_remember_project_digest(_workingPath, _providerDigest);
+    _installed = YES;
+  }
+  if (_renewedBookmark && !_openLocalCopy) {
+    GHOST_IOS_remember_project_bookmark(_workingPath, _renewedBookmark);
+    _bookmarkUpdated = YES;
+  }
+  _ready = NO;
+  return GHOST_IOSRecentProjectCommit_Proceed;
+}
+
+- (BOOL)isReady:(NSString *)path ticket:(int)ticket
+{
+  return _busy && _ready && ticket > 0 && ticket == _ticket &&
+         [path isEqualToString:_workingPath] && [self hasLiveWindow];
+}
+
+- (void)finishOpen:(int)ticket success:(BOOL)success
+{
+  if (!_busy || ticket != _ticket) {
+    return;
+  }
+  if (success && _openLocalCopy) {
+    /* The recovery choice must not make an ordinary Save overwrite the Files
+     * original. Keep the app-owned file and detach only after it loads. */
+    NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+    NSMutableDictionary *entries = [[defaults dictionaryForKey:@"BlenderWorkingProjectBookmarks"]
+                                    mutableCopy];
+    if (entries) {
+      [entries removeObjectForKey:_workingPath];
+      [defaults setObject:entries forKey:@"BlenderWorkingProjectBookmarks"];
+      [entries release];
+    }
+    if ([_workingPath isEqualToString:[defaults stringForKey:@"BlenderWorkingProjectPath"]]) {
+      [defaults removeObjectForKey:@"BlenderWorkingProjectPath"];
+      [defaults removeObjectForKey:@"BlenderWorkingProjectBookmark"];
+    }
+  }
+  if (!success) {
+    if (_installed) {
+      NSError *error = nil;
+      NSData *oldBytes = [NSData dataWithContentsOfURL:_backupFile
+                                               options:NSDataReadingMappedIfSafe error:&error];
+      if (oldBytes && [oldBytes writeToFile:_workingPath
+                                   options:NSDataWritingAtomic error:&error])
+      {
+        GHOST_IOS_remember_project_digest(_workingPath, _expectedDigest);
+      }
+      else {
+        NSLog(@"Could not restore the previous Open Recent working copy: %@", error);
+        NSURL *documents = [[[NSFileManager defaultManager]
+            URLsForDirectory:NSDocumentDirectory inDomains:NSUserDomainMask] firstObject];
+        NSURL *recovery = [documents URLByAppendingPathComponent:@"Recovery" isDirectory:YES];
+        [[NSFileManager defaultManager] createDirectoryAtURL:recovery
+                                 withIntermediateDirectories:YES attributes:nil error:nil];
+        NSURL *saved = [recovery URLByAppendingPathComponent:
+            [@"OpenRecent-" stringByAppendingString:[NSUUID UUID].UUIDString]];
+        saved = [saved URLByAppendingPathExtension:@"blend"];
+        NSError *moveError = nil;
+        if ([[NSFileManager defaultManager] moveItemAtURL:_backupFile toURL:saved
+                                                    error:&moveError]) {
+          NSLog(@"Previous working project retained at %@", saved.path);
+        }
+        else {
+          NSLog(@"Could not retain previous working project: %@", moveError);
+        }
+      }
+    }
+    if (_bookmarkUpdated) {
+      GHOST_IOS_remember_project_bookmark(_workingPath, _bookmark);
+    }
+  }
+  [self cancel];
+}
+@end
+
+static GHOST_IOSRecentProjectOpener *GHOST_IOS_recent_project_opener()
+{
+  static GHOST_IOSRecentProjectOpener *opener = nil;
+  if (!opener) {
+    opener = [[GHOST_IOSRecentProjectOpener alloc] init];
+  }
+  return opener;
+}
+
+/* The picker already coordinated and copied this exact provider revision.
+ * A one-shot exemption avoids immediately showing a second preparation sheet.
+ * Any other open consumes the exemption without using it. */
+static NSString *GHOST_IOS_fresh_linked_project = nil;
+static NSTimeInterval GHOST_IOS_fresh_linked_since = 0;
+
+void GHOST_IOS_recent_project_mark_fresh(const char *path)
+{
+  if (![NSThread isMainThread]) {
+    return;
+  }
+  [GHOST_IOS_fresh_linked_project release];
+  GHOST_IOS_fresh_linked_project = path ? [[NSString stringWithUTF8String:path] copy] : nil;
+  GHOST_IOS_fresh_linked_since = [NSDate timeIntervalSinceReferenceDate];
+}
+
+bool GHOST_IOS_recent_project_consume_fresh(const char *path)
+{
+  if (![NSThread isMainThread]) {
+    return false;
+  }
+  NSString *candidate = path ? [NSString stringWithUTF8String:path] : nil;
+  const bool fresh = candidate &&
+                     [NSDate timeIntervalSinceReferenceDate] - GHOST_IOS_fresh_linked_since < 30 &&
+                     [candidate isEqualToString:GHOST_IOS_fresh_linked_project];
+  [GHOST_IOS_fresh_linked_project release];
+  GHOST_IOS_fresh_linked_project = nil;
+  GHOST_IOS_fresh_linked_since = 0;
+  return fresh;
+}
+
+bool GHOST_IOS_recent_project_is_linked(const char *path)
+{
+  if (![NSThread isMainThread] || !path) {
+    return false;
+  }
+  NSString *working = [NSString stringWithUTF8String:path];
+  if (!working.length) {
+    return false;
+  }
+  NSString *document = GHOST_IOS_document_path_for_project(working);
+  return document.length && ![document isEqualToString:working] &&
+         [GHOST_IOS_bookmark_for_project(working) length] &&
+         [GHOST_IOS_document_digest_for_project(working) length];
+}
+
+bool GHOST_IOS_recent_project_begin(const char *path,
+                                     bool loadUISet,
+                                     bool loadUI,
+                                     bool useScriptsSet,
+                                     bool useScripts)
+{
+  if (![NSThread isMainThread] || !path) {
+    return false;
+  }
+  NSString *working = [NSString stringWithUTF8String:path];
+  return working && [GHOST_IOS_recent_project_opener() begin:working
+      loadUISet:loadUISet loadUI:loadUI useScriptsSet:useScriptsSet useScripts:useScripts];
+}
+
+bool GHOST_IOS_recent_project_is_ready(const char *path, int ticket)
+{
+  if (![NSThread isMainThread] || !path) {
+    return false;
+  }
+  NSString *working = [NSString stringWithUTF8String:path];
+  return working && [GHOST_IOS_recent_project_opener() isReady:working ticket:ticket];
+}
+
+GHOST_IOSRecentProjectCommit GHOST_IOS_recent_project_commit(const char *path, int ticket)
+{
+  if (![NSThread isMainThread] || !path) {
+    return GHOST_IOSRecentProjectCommit_Failed;
+  }
+  NSString *working = [NSString stringWithUTF8String:path];
+  return working ? [GHOST_IOS_recent_project_opener() commit:working ticket:ticket] :
+                   GHOST_IOSRecentProjectCommit_Failed;
+}
+
+void GHOST_IOS_recent_project_finish_open(int ticket, bool success)
+{
+  if ([NSThread isMainThread]) {
+    [GHOST_IOS_recent_project_opener() finishOpen:ticket success:success];
+  }
+}
+
+void GHOST_IOS_recent_project_cancel()
+{
+  if ([NSThread isMainThread]) {
+    [GHOST_IOS_recent_project_opener() cancel];
+  }
+}
+
+void GHOST_IOS_cleanup_abandoned_recent_stages()
+{
+  NSURL *root = [NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES];
+  NSArray<NSURL *> *entries = [[NSFileManager defaultManager]
+      contentsOfDirectoryAtURL:root includingPropertiesForKeys:nil options:0 error:nil];
+  for (NSURL *entry in entries) {
+    if ([entry.lastPathComponent hasPrefix:@"BlenderRecent-"]) {
+      [[NSFileManager defaultManager] removeItemAtURL:entry error:nil];
+    }
+  }
+}
diff --git a/intern/ghost/intern/GHOST_ProjectSaveIOS.hh b/intern/ghost/intern/GHOST_ProjectSaveIOS.hh
new file mode 100644
index 0000000..12d0ad6
--- /dev/null
+++ b/intern/ghost/intern/GHOST_ProjectSaveIOS.hh
@@ -0,0 +1,783 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* Included only by GHOST_SystemIOS.mm. UIKit reports choices as GHOST events;
+ * the live Blender operator performs document serialization and state changes. */
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+#import <CommonCrypto/CommonDigest.h>
+
+/* The event owns its ticket storage until Blender consumes it. */
+class GHOST_EventIOSProjectCloseResume final : public GHOST_Event {
+  uint64_t ticket_;
+
+ public:
+  GHOST_EventIOSProjectCloseResume(uint64_t time, GHOST_IWindow *window, uint64_t ticket)
+      : GHOST_Event(time, GHOST_kEventIOSProjectCloseResume, window), ticket_(ticket)
+  {
+    data_ = &ticket_;
+  }
+};
+
+/* A content fingerprint prevents a stale working copy opened from Recent from
+ * overwriting a Files document edited in another app or device. */
+static NSData *GHOST_IOS_project_digest(NSData *data)
+{
+  if (!data) {
+    return nil;
+  }
+  CC_SHA256_CTX context;
+  CC_SHA256_Init(&context);
+  const uint8_t *bytes = static_cast<const uint8_t *>(data.bytes);
+  NSUInteger remaining = data.length;
+  while (remaining) {
+    const CC_LONG chunk = static_cast<CC_LONG>(MIN(remaining, NSUInteger(1) << 20));
+    CC_SHA256_Update(&context, bytes, chunk);
+    bytes += chunk;
+    remaining -= chunk;
+  }
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256_Final(digest, &context);
+  return [NSData dataWithBytes:digest length:sizeof(digest)];
+}
+
+@interface GHOST_IOSProjectSaveExporter : NSObject <UIDocumentPickerDelegate,
+                                                    UIAdaptivePresentationControllerDelegate>
+{
+  UIViewController *_presenter;
+  UIAlertController *_compressAlert;
+  UIDocumentPickerViewController *_picker;
+  NSURL *_staging;
+  NSURL *_source;
+  NSString *_filename;
+  NSString *_destination;
+  NSData *_documentBookmark;
+  NSData *_documentDigest;
+  NSString *_documentPath;
+  NSString *_workingPath;
+  GHOST_IWindow *_window;
+  GHOST_IOSProjectExportAction _pendingAction;
+  BOOL _busy;
+  BOOL _saveCopy;
+  BOOL _remembering;
+  NSUInteger _generation;
+}
+- (BOOL)begin:(NSString *)filename saveCopy:(BOOL)saveCopy;
+- (BOOL)beginUpdate:(NSString *)path;
+- (BOOL)stagingPath:(char *)outPath maxLength:(size_t)maxLength;
+- (GHOST_IOSProjectExportAction)takeAction:(char *)outPath maxLength:(size_t)maxLength;
+- (BOOL)presentPicker;
+- (BOOL)publishUpdate;
+- (void)finish;
+- (void)cancel;
+- (void)queueAction:(GHOST_IOSProjectExportAction)action destination:(NSString *)destination;
+- (BOOL)queueCloseResume:(uint64_t)ticket;
+- (void)dismissPickerWithAction:(GHOST_IOSProjectExportAction)action
+                    destination:(NSString *)destination;
+@end
+
+/* Keep access for every Files document saved by Blender. A prior build stored
+ * only the most recent document; read that pair until it is migrated here. */
+static NSData *GHOST_IOS_bookmark_for_project(NSString *path)
+{
+  if (!path.length) {
+    return nil;
+  }
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  id saved = [defaults dictionaryForKey:@"BlenderWorkingProjectBookmarks"][path];
+  if ([saved isKindOfClass:[NSDictionary class]]) {
+    saved = saved[@"bookmark"];
+  }
+  if ([saved isKindOfClass:[NSData class]]) {
+    return saved;
+  }
+  NSString *legacyPath = [defaults stringForKey:@"BlenderWorkingProjectPath"];
+  return [path isEqualToString:legacyPath] ?
+             [defaults dataForKey:@"BlenderWorkingProjectBookmark"] : nil;
+}
+
+static NSData *GHOST_IOS_document_digest_for_project(NSString *path)
+{
+  id entry = [[NSUserDefaults standardUserDefaults]
+      dictionaryForKey:@"BlenderWorkingProjectBookmarks"][path];
+  if (![entry isKindOfClass:[NSDictionary class]]) {
+    return nil;
+  }
+  id digest = entry[@"digest"];
+  return [digest isKindOfClass:[NSData class]] ? digest : nil;
+}
+
+static NSString *GHOST_IOS_document_path_for_project(NSString *path)
+{
+  id entry = [[NSUserDefaults standardUserDefaults]
+      dictionaryForKey:@"BlenderWorkingProjectBookmarks"][path];
+  if ([entry isKindOfClass:[NSDictionary class]]) {
+    id documentPath = entry[@"documentPath"];
+    if ([documentPath isKindOfClass:[NSString class]] && [documentPath length]) {
+      return documentPath;
+    }
+  }
+  return path;
+}
+
+static void GHOST_IOS_remember_project_bookmark(NSString *path, NSData *bookmark)
+{
+  if (!path.length || !bookmark.length) {
+    return;
+  }
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  NSMutableDictionary *bookmarks = [[defaults dictionaryForKey:@"BlenderWorkingProjectBookmarks"]
+                                    mutableCopy];
+  if (!bookmarks) {
+    bookmarks = [[NSMutableDictionary alloc] init];
+  }
+  NSString *legacyPath = [defaults stringForKey:@"BlenderWorkingProjectPath"];
+  NSData *legacyBookmark = [defaults dataForKey:@"BlenderWorkingProjectBookmark"];
+  if (legacyPath.length && legacyBookmark.length && !bookmarks[legacyPath]) {
+    bookmarks[legacyPath] = legacyBookmark;
+  }
+  id existing = bookmarks[path];
+  if ([existing isKindOfClass:[NSDictionary class]]) {
+    NSMutableDictionary *entry = [existing mutableCopy];
+    entry[@"bookmark"] = bookmark;
+    bookmarks[path] = entry;
+    [entry release];
+  }
+  else {
+    bookmarks[path] = bookmark;
+  }
+  [defaults setObject:bookmarks forKey:@"BlenderWorkingProjectBookmarks"];
+  [bookmarks release];
+}
+
+static void GHOST_IOS_remember_imported_project_bookmark(NSString *workingPath,
+                                                         NSString *documentPath,
+                                                         NSData *bookmark,
+                                                         NSData *digest)
+{
+  if (!workingPath.length || !documentPath.length || !bookmark.length || !digest.length) {
+    return;
+  }
+  GHOST_IOS_remember_project_bookmark(workingPath, bookmark);
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  NSMutableDictionary *bookmarks = [[defaults dictionaryForKey:@"BlenderWorkingProjectBookmarks"]
+                                    mutableCopy];
+  bookmarks[workingPath] = @{@"bookmark": bookmark, @"documentPath": documentPath,
+                             @"digest": digest};
+  [defaults setObject:bookmarks forKey:@"BlenderWorkingProjectBookmarks"];
+  [bookmarks release];
+}
+
+static void GHOST_IOS_remember_project_digest(NSString *workingPath, NSData *digest)
+{
+  if (!workingPath.length || !digest.length) {
+    return;
+  }
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  NSMutableDictionary *bookmarks = [[defaults dictionaryForKey:@"BlenderWorkingProjectBookmarks"]
+                                    mutableCopy];
+  id saved = bookmarks[workingPath];
+  if ([saved isKindOfClass:[NSDictionary class]]) {
+    NSMutableDictionary *entry = [saved mutableCopy];
+    entry[@"digest"] = digest;
+    bookmarks[workingPath] = entry;
+    [entry release];
+    [defaults setObject:bookmarks forKey:@"BlenderWorkingProjectBookmarks"];
+  }
+  [bookmarks release];
+}
+
+@implementation GHOST_IOSProjectSaveExporter
+
+- (BOOL)hasLiveWindow
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  return system && _window && system->getWindowManager()->getWindowFound(_window);
+}
+
+- (void)finish
+{
+  if (_staging) {
+    [[NSFileManager defaultManager] removeItemAtURL:_staging error:nil];
+    [_staging release];
+    _staging = nil;
+  }
+  [_source release];
+  _source = nil;
+  [_presenter release];
+  _presenter = nil;
+  [_compressAlert release];
+  _compressAlert = nil;
+  [_picker release];
+  _picker = nil;
+  [_filename release];
+  _filename = nil;
+  [_destination release];
+  _destination = nil;
+  [_documentBookmark release];
+  _documentBookmark = nil;
+  [_documentDigest release];
+  _documentDigest = nil;
+  [_documentPath release];
+  _documentPath = nil;
+  [_workingPath release];
+  _workingPath = nil;
+  _window = nullptr;
+  _pendingAction = GHOST_IOSProjectExportAction_None;
+  _busy = NO;
+  _saveCopy = NO;
+  _remembering = NO;
+}
+
+- (BOOL)queueCloseResume:(uint64_t)ticket
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!_busy || !ticket || !system || ![self hasLiveWindow]) {
+    return NO;
+  }
+  system->pushEvent(new GHOST_EventIOSProjectCloseResume(
+      system->getMilliSeconds(), _window, ticket));
+  return YES;
+}
+
+- (void)queueAction:(GHOST_IOSProjectExportAction)action destination:(NSString *)destination
+{
+  if (!_busy || _pendingAction != GHOST_IOSProjectExportAction_None) {
+    return;
+  }
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!system || ![self hasLiveWindow]) {
+    [self finish];
+    return;
+  }
+  _pendingAction = action;
+  [_destination release];
+  _destination = [destination copy];
+  system->pushEvent(new GHOST_Event(
+      system->getMilliSeconds(), GHOST_kEventIOSProjectExport, _window));
+}
+
+- (void)dismissCompressAlertWithAction:(GHOST_IOSProjectExportAction)action
+{
+  UIAlertController *alert = _compressAlert;
+  _compressAlert = nil;
+  if (!alert) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [self queueAction:action destination:nil];
+    });
+    return;
+  }
+  [alert dismissViewControllerAnimated:YES completion:^{
+    [alert release];
+    [self queueAction:action destination:nil];
+  }];
+}
+
+- (BOOL)begin:(NSString *)filename saveCopy:(BOOL)saveCopy
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  GHOST_IWindow *window = system ? system->getWindowManager()->getActiveWindow() : nullptr;
+  if (_busy || !window) {
+    return NO;
+  }
+  UIViewController *presenter =
+      static_cast<GHOST_WindowIOS *>(window)->rootWindow.rootViewController;
+  if (!presenter.view.window || presenter.presentedViewController) {
+    return NO;
+  }
+
+  NSString *name = filename.lastPathComponent;
+  if (!name.length || [name isEqualToString:@"."] || [name isEqualToString:@".."]) {
+    name = @"Untitled.blend";
+  }
+  if ([name.pathExtension caseInsensitiveCompare:@"blend"] != NSOrderedSame) {
+    name = [name stringByAppendingPathExtension:@"blend"];
+  }
+
+  _busy = YES;
+  _generation++;
+  _saveCopy = saveCopy;
+  _window = window;
+  _presenter = [presenter retain];
+  _filename = [name copy];
+  _pendingAction = GHOST_IOSProjectExportAction_None;
+
+  NSString *title = saveCopy ? @"Save a Copy to Files" : @"Save Project As";
+  _compressAlert = [[UIAlertController alertControllerWithTitle:title
+                                                        message:@"Compress .blend file?"
+                                                 preferredStyle:UIAlertControllerStyleAlert] retain];
+  [_compressAlert addAction:[UIAlertAction actionWithTitle:@"Compress (Yes)"
+                                                   style:UIAlertActionStyleDefault
+                                                 handler:^(UIAlertAction *action) {
+    [self dismissCompressAlertWithAction:GHOST_IOSProjectExportAction_Compress];
+  }]];
+  [_compressAlert addAction:[UIAlertAction actionWithTitle:@"Don't Compress (No)"
+                                                   style:UIAlertActionStyleDefault
+                                                 handler:^(UIAlertAction *action) {
+    [self dismissCompressAlertWithAction:GHOST_IOSProjectExportAction_NoCompress];
+  }]];
+  [_compressAlert addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                                   style:UIAlertActionStyleCancel
+                                                 handler:^(UIAlertAction *action) {
+    [self dismissCompressAlertWithAction:GHOST_IOSProjectExportAction_Cancelled];
+  }]];
+  @try {
+    [_presenter presentViewController:_compressAlert animated:YES completion:nil];
+    _compressAlert.presentationController.delegate = self;
+  }
+  @catch (NSException *exception) {
+    NSLog(@"Failed to present project compression prompt: %@", exception);
+    [self finish];
+    return NO;
+  }
+  return YES;
+}
+
+- (BOOL)beginUpdate:(NSString *)path
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  GHOST_IWindow *window = system ? system->getWindowManager()->getActiveWindow() : nullptr;
+  NSData *bookmark = GHOST_IOS_bookmark_for_project(path);
+  NSString *documentPath = GHOST_IOS_document_path_for_project(path);
+  NSData *digest = GHOST_IOS_document_digest_for_project(path);
+  if (_busy || !window || !bookmark ||
+      (![documentPath isEqualToString:path] && !digest.length))
+  {
+    return NO;
+  }
+  _busy = YES;
+  _generation++;
+  _window = window;
+  _filename = [path.lastPathComponent copy];
+  _documentBookmark = [bookmark retain];
+  _documentDigest = [digest retain];
+  _documentPath = [documentPath copy];
+  _workingPath = [path copy];
+  _pendingAction = GHOST_IOSProjectExportAction_None;
+  return YES;
+}
+
+- (BOOL)stagingPath:(char *)outPath maxLength:(size_t)maxLength
+{
+  if (!_busy || !outPath || maxLength == 0) {
+    return NO;
+  }
+  if (!_staging) {
+    NSURL *root = [NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES];
+    _staging = [[root URLByAppendingPathComponent:
+        [@"BlenderProject-" stringByAppendingString:[NSUUID UUID].UUIDString]
+                                     isDirectory:YES] retain];
+    NSError *error = nil;
+    if (![[NSFileManager defaultManager] createDirectoryAtURL:_staging
+                                  withIntermediateDirectories:YES
+                                                   attributes:nil
+                                                        error:&error])
+    {
+      NSLog(@"Cannot prepare Blender project export: %@", error);
+      [self finish];
+      return NO;
+    }
+    _source = [[_staging URLByAppendingPathComponent:_filename] retain];
+  }
+  const char *path = _source.path.UTF8String;
+  if (!path || strlen(path) >= maxLength) {
+    return NO;
+  }
+  strncpy(outPath, path, maxLength - 1);
+  outPath[maxLength - 1] = '\0';
+  return YES;
+}
+
+- (BOOL)presentPicker
+{
+  if (!_busy || !_source || _picker || ![self hasLiveWindow] ||
+      ![[NSFileManager defaultManager] fileExistsAtPath:_source.path])
+  {
+    return NO;
+  }
+  @try {
+    /* Save As moves the staged document into a writable provider location;
+     * Save Copy leaves the active document independent. */
+    _picker = [[UIDocumentPickerViewController alloc] initForExportingURLs:@[_source]
+                                                                   asCopy:_saveCopy];
+    _picker.delegate = self;
+    _picker.modalPresentationStyle = UIModalPresentationFormSheet;
+    _picker.title = @"Save to Files";
+    [_presenter presentViewController:_picker animated:YES completion:nil];
+    _picker.presentationController.delegate = self;
+    return YES;
+  }
+  @catch (NSException *exception) {
+    NSLog(@"Failed to present project destination picker: %@", exception);
+    return NO;
+  }
+}
+
+- (BOOL)publishUpdate
+{
+  if (!_busy || !_source || _picker || _compressAlert ||
+      _pendingAction != GHOST_IOSProjectExportAction_None ||
+      ![[NSFileManager defaultManager] fileExistsAtPath:_source.path])
+  {
+    return NO;
+  }
+  NSData *bookmark = [_documentBookmark retain];
+  NSData *expectedDigest = [_documentDigest retain];
+  NSString *expected = [_documentPath copy];
+  NSString *working = [_workingPath copy];
+  if (!bookmark || !expected || !working) {
+    [bookmark release];
+    [expectedDigest release];
+    [expected release];
+    [working release];
+    return NO;
+  }
+  NSURL *source = [_source retain];
+  const NSUInteger generation = _generation;
+  dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+    @autoreleasepool {
+      BOOL stale = NO;
+      NSError *error = nil;
+      NSURL *destination = [NSURL URLByResolvingBookmarkData:bookmark options:0
+          relativeToURL:nil bookmarkDataIsStale:&stale error:&error];
+      const BOOL scoped = destination && [destination startAccessingSecurityScopedResource];
+      const BOOL owned = destination && [destination.path hasPrefix:
+          [NSHomeDirectory() stringByAppendingString:@"/"]];
+      NSError *readError = nil;
+      NSData *bytes = [NSData dataWithContentsOfURL:source
+                                             options:NSDataReadingMappedIfSafe error:&readError];
+      __block BOOL providerWritten = NO;
+      __block BOOL conflict = NO;
+      if (bytes && destination && [destination.path isEqualToString:expected] && (scoped || owned)) {
+        NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+        NSError *coordinateError = nil;
+        [coordinator coordinateWritingItemAtURL:destination
+                                        options:NSFileCoordinatorWritingForReplacing
+                                          error:&coordinateError
+                                     byAccessor:^(NSURL *url) {
+          NSError *writeError = nil;
+          if (expectedDigest) {
+            NSData *current = [NSData dataWithContentsOfURL:url
+                                                    options:NSDataReadingMappedIfSafe
+                                                      error:&writeError];
+            NSData *currentDigest = GHOST_IOS_project_digest(current);
+            if (!currentDigest || ![currentDigest isEqualToData:expectedDigest]) {
+              conflict = YES;
+              NSLog(@"Files project changed or could not be read before Save: %@", writeError);
+              return;
+            }
+          }
+          providerWritten = [bytes writeToURL:url options:NSDataWritingAtomic error:&writeError];
+          if (!providerWritten) {
+            NSLog(@"Could not write coordinated Blender project: %@", writeError);
+          }
+        }];
+        if (coordinateError) {
+          NSLog(@"Could not coordinate Blender project Save: %@", coordinateError);
+        }
+        providerWritten = providerWritten && !coordinateError;
+        [coordinator release];
+      }
+      else {
+        NSLog(@"Files project bookmark, access or staged bytes unavailable: %@ %@", error, readError);
+      }
+      /* The local working file backs Open Recent and relative paths. Once the
+       * provider accepts the snapshot, keep that mirror at the same revision. */
+      BOOL mirrorWritten = YES;
+      if (providerWritten && ![working isEqualToString:expected]) {
+        NSError *mirrorError = nil;
+        mirrorWritten = [bytes writeToFile:working options:NSDataWritingAtomic error:&mirrorError];
+        if (!mirrorWritten) {
+          NSLog(@"Files project updated but local working copy could not be refreshed: %@",
+                mirrorError);
+        }
+      }
+      NSData *newDigest = providerWritten && expectedDigest ?
+          [GHOST_IOS_project_digest(bytes) retain] : nil;
+      NSData *refreshed = nil;
+      if (providerWritten && stale) {
+        refreshed = [[destination bookmarkDataWithOptions:0
+                        includingResourceValuesForKeys:nil relativeToURL:nil error:nil] retain];
+      }
+      if (scoped) {
+        [destination stopAccessingSecurityScopedResource];
+      }
+      NSString *path = [destination.path copy];
+      dispatch_async(dispatch_get_main_queue(), ^{
+        if (_busy && _generation == generation && !_picker) {
+          if (refreshed) {
+            GHOST_IOS_remember_project_bookmark(working, refreshed);
+            NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+            if ([expected isEqualToString:[defaults stringForKey:@"BlenderWorkingProjectPath"]]) {
+              [defaults setObject:refreshed forKey:@"BlenderWorkingProjectBookmark"];
+            }
+          }
+          if (newDigest) {
+            GHOST_IOS_remember_project_digest(working, newDigest);
+          }
+          const GHOST_IOSProjectExportAction action = conflict ?
+              GHOST_IOSProjectExportAction_Conflict :
+              !providerWritten ? GHOST_IOSProjectExportAction_Failed :
+              mirrorWritten ? GHOST_IOSProjectExportAction_Saved :
+                              GHOST_IOSProjectExportAction_MirrorFailed;
+          [self queueAction:action destination:providerWritten ? path : nil];
+        }
+        [path release];
+        [refreshed release];
+        [newDigest release];
+        [source release];
+        [bookmark release];
+        [expectedDigest release];
+        [expected release];
+        [working release];
+      });
+    }
+  });
+  return YES;
+}
+
+- (void)dismissPickerWithAction:(GHOST_IOSProjectExportAction)action
+                    destination:(NSString *)destination
+{
+  if (!_picker) {
+    return;
+  }
+  UIDocumentPickerViewController *picker = _picker;
+  _picker = nil;
+  picker.delegate = nil;
+  picker.presentationController.delegate = nil;
+  [picker dismissViewControllerAnimated:YES completion:^{
+    [self queueAction:action destination:destination];
+  }];
+  [picker release];
+}
+
+- (GHOST_IOSProjectExportAction)takeAction:(char *)outPath maxLength:(size_t)maxLength
+{
+  GHOST_IOSProjectExportAction action = _pendingAction;
+  _pendingAction = GHOST_IOSProjectExportAction_None;
+  if (action == GHOST_IOSProjectExportAction_Saved) {
+    const char *path = _destination.UTF8String;
+    if (!outPath || maxLength == 0 || !path || strlen(path) >= maxLength) {
+      action = GHOST_IOSProjectExportAction_Cancelled;
+    }
+    else {
+      strncpy(outPath, path, maxLength - 1);
+      outPath[maxLength - 1] = '\0';
+    }
+  }
+  if (outPath && maxLength > 0 && action != GHOST_IOSProjectExportAction_Saved) {
+    outPath[0] = '\0';
+  }
+  [_destination release];
+  _destination = nil;
+  return action;
+}
+
+- (void)cancel
+{
+  if (!_busy) {
+    return;
+  }
+  _busy = NO;
+  _pendingAction = GHOST_IOSProjectExportAction_None;
+  _remembering = NO;
+  [_destination release];
+  _destination = nil;
+
+  UIDocumentPickerViewController *picker = _picker;
+  _picker = nil;
+  picker.delegate = nil;
+  picker.presentationController.delegate = nil;
+  UIAlertController *alert = _compressAlert;
+  _compressAlert = nil;
+
+  if (picker) {
+    [picker dismissViewControllerAnimated:NO completion:^{ [self finish]; }];
+    [picker release];
+  }
+  else if (alert) {
+    [alert dismissViewControllerAnimated:NO completion:^{ [self finish]; }];
+    [alert release];
+  }
+  else {
+    [self finish];
+  }
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller
+{
+  if (controller == _picker) {
+    [self dismissPickerWithAction:GHOST_IOSProjectExportAction_Cancelled destination:nil];
+  }
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller
+    didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls
+{
+  if (controller != _picker) {
+    return;
+  }
+  NSURL *destination = urls.firstObject;
+  if (!destination) {
+    [self dismissPickerWithAction:GHOST_IOSProjectExportAction_Cancelled destination:nil];
+    return;
+  }
+  if (_saveCopy) {
+    [self dismissPickerWithAction:GHOST_IOSProjectExportAction_Saved destination:destination.path];
+    return;
+  }
+  if (_remembering) {
+    return;
+  }
+  _remembering = YES;
+  const NSUInteger generation = _generation;
+  NSURL *document = [destination retain];
+  dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+    @autoreleasepool {
+      const BOOL scoped = [document startAccessingSecurityScopedResource];
+      NSError *error = nil;
+      /* On iOS, a bookmark made from the picker URL retains its implicit scope;
+       * the macOS-only WithSecurityScope option is not declared by the iOS SDK. */
+      NSData *bookmark = [[document bookmarkDataWithOptions:0
+                          includingResourceValuesForKeys:nil relativeToURL:nil error:&error] retain];
+      if (scoped) {
+        [document stopAccessingSecurityScopedResource];
+      }
+      NSString *errorText = [error.localizedDescription copy];
+      NSString *path = [document.path copy];
+      dispatch_async(dispatch_get_main_queue(), ^{
+        if (_busy && _generation == generation && _picker) {
+          _remembering = NO;
+          if (bookmark && path.length) {
+            NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+            GHOST_IOS_remember_project_bookmark(path, bookmark);
+            [defaults setObject:bookmark forKey:@"BlenderWorkingProjectBookmark"];
+            [defaults setObject:path forKey:@"BlenderWorkingProjectPath"];
+            [self dismissPickerWithAction:GHOST_IOSProjectExportAction_Saved destination:path];
+          }
+          else {
+            NSLog(@"Cannot retain access to moved Blender project: %@", errorText);
+            [self dismissPickerWithAction:GHOST_IOSProjectExportAction_Failed destination:nil];
+          }
+        }
+        [path release];
+        [errorText release];
+        [bookmark release];
+        [document release];
+      });
+    }
+  });
+}
+
+- (void)presentationControllerDidDismiss:(UIPresentationController *)controller
+{
+  if (controller.presentedViewController == _picker && _picker) {
+    if (_remembering) {
+      /* The picker may auto-dismiss after a move while the bookmark is created.
+       * The pending move callback, rather than dismissal, owns completion. */
+      return;
+    }
+    UIDocumentPickerViewController *picker = _picker;
+    _picker = nil;
+    picker.delegate = nil;
+    picker.presentationController.delegate = nil;
+    [picker release];
+    [self queueAction:GHOST_IOSProjectExportAction_Cancelled destination:nil];
+  }
+  else if (controller.presentedViewController == _compressAlert && _compressAlert) {
+    UIAlertController *alert = _compressAlert;
+    _compressAlert = nil;
+    [alert release];
+    [self queueAction:GHOST_IOSProjectExportAction_Cancelled destination:nil];
+  }
+}
+@end
+
+static GHOST_IOSProjectSaveExporter *GHOST_IOS_project_save_exporter()
+{
+  static GHOST_IOSProjectSaveExporter *exporter = nil;
+  if (!exporter) {
+    exporter = [[GHOST_IOSProjectSaveExporter alloc] init];
+  }
+  return exporter;
+}
+
+bool GHOST_IOS_begin_project_export(const char *filename, const bool save_copy)
+{
+  if (![NSThread isMainThread] || !filename) {
+    return false;
+  }
+  NSString *name = [NSString stringWithUTF8String:filename];
+  if (!name) {
+    return false;
+  }
+  return [GHOST_IOS_project_save_exporter() begin:name saveCopy:save_copy];
+}
+
+bool GHOST_IOS_begin_project_update(const char *path)
+{
+  if (![NSThread isMainThread] || !path) {
+    return false;
+  }
+  NSString *name = [NSString stringWithUTF8String:path];
+  return name && [GHOST_IOS_project_save_exporter() beginUpdate:name];
+}
+
+GHOST_IOSProjectExportAction GHOST_IOS_project_export_take_action(char *out_path,
+                                                                  const size_t max_len)
+{
+  if (![NSThread isMainThread]) {
+    return GHOST_IOSProjectExportAction_None;
+  }
+  return [GHOST_IOS_project_save_exporter() takeAction:out_path maxLength:max_len];
+}
+
+bool GHOST_IOS_project_export_staging_path(char *out_path, const size_t max_len)
+{
+  if (![NSThread isMainThread]) {
+    return false;
+  }
+  return [GHOST_IOS_project_save_exporter() stagingPath:out_path maxLength:max_len];
+}
+
+bool GHOST_IOS_project_export_present_picker()
+{
+  if (![NSThread isMainThread]) {
+    return false;
+  }
+  return [GHOST_IOS_project_save_exporter() presentPicker];
+}
+
+bool GHOST_IOS_project_export_publish_update()
+{
+  if (![NSThread isMainThread]) {
+    return false;
+  }
+  return [GHOST_IOS_project_save_exporter() publishUpdate];
+}
+
+bool GHOST_IOS_project_export_queue_close_resume(uint64_t ticket)
+{
+  if (![NSThread isMainThread]) {
+    return false;
+  }
+  return [GHOST_IOS_project_save_exporter() queueCloseResume:ticket];
+}
+
+bool GHOST_IOS_project_document_bookmark_matches(const char *path)
+{
+  if (![NSThread isMainThread] || !path) {
+    return false;
+  }
+  NSString *candidate = [NSString stringWithUTF8String:path];
+  return candidate && GHOST_IOS_bookmark_for_project(candidate) != nil;
+}
+
+void GHOST_IOS_project_export_finish()
+{
+  [GHOST_IOS_project_save_exporter() finish];
+}
+
+void GHOST_IOS_project_export_cancel()
+{
+  [GHOST_IOS_project_save_exporter() cancel];
+}
diff --git a/scripts/startup/bl_ui/space_view3d_ipad.py b/scripts/startup/bl_ui/space_view3d_ipad.py
new file mode 100644
index 0000000..83a06ac
--- /dev/null
+++ b/scripts/startup/bl_ui/space_view3d_ipad.py
@@ -0,0 +1,1601 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compact iPad viewport controls built entirely from existing Blender operators."""
+
+import bpy
+from bpy.types import Header, Menu, Operator, Panel
+from bl_ui.space_toolsystem_common import ToolSelectPanelHelper
+
+
+# Clockwise from the top. Add Cube activates the existing interactive tool.
+IPAD_RADIAL_TOOLS = (
+    ("Select", 'builtin.select_box', 'RESTRICT_SELECT_OFF'),
+    ("Cursor", 'builtin.cursor', 'PIVOT_CURSOR'),
+    ("Move", 'builtin.move', 'EMPTY_ARROWS'),
+    ("Rotate", 'builtin.rotate', 'DRIVER_ROTATIONAL_DIFFERENCE'),
+    ("Scale", 'builtin.scale', 'ARROW_LEFTRIGHT'),
+    ("Transform", 'builtin.transform', 'ORIENTATION_GIMBAL'),
+    ("Annotate", 'builtin.annotate', 'GREASEPENCIL'),
+    ("Measure", 'builtin.measure', 'DRIVER_DISTANCE'),
+    ("Add Cube", 'builtin.primitive_cube_add', 'MESH_CUBE'),
+)
+
+
+# Direct Base tools are exact native identities, never whole groups or labels.
+IPAD_BASE_TOOL_IDS = frozenset({
+    'builtin.select_box', 'builtin.move', 'builtin.rotate', 'builtin.scale', 'builtin.cursor',
+})
+
+def ipad_palette_target(context, x, y):
+    views = [area for area in context.window.screen.areas if area.type == 'VIEW_3D']
+    if not views:
+        return None, None
+    def contains(item):
+        return item.x <= x < item.x + item.width and item.y <= y < item.y + item.height
+    # The event context resolves native floating editor/layer ownership. Prefer
+    # it over an overlapping background viewport before searching other views.
+    area = context.area if context.area in views and contains(context.area) else next(
+        (area for area in views if contains(area)), None)
+    if area is None:
+        area = context.area if context.area in views else max(views, key=lambda a: a.width * a.height)
+    windows = [r for r in area.regions if r.type == 'WINDOW' and r.width > 0 and r.height > 0]
+    region = next((r for r in windows if contains(r)), None)
+    if region is None:
+        region = context.region if context.area == area and context.region in windows else next(iter(windows), None)
+    return area, region
+
+
+class WM_OT_ipad_tool_palette(Operator):
+    bl_idname = "wm.ipad_tool_palette"
+    bl_label = "Pencil Ring"
+    bl_description = "Open the base manipulation ring for the 3D viewport"
+    touch_targets: bpy.props.BoolProperty(default=False, options={'SKIP_SAVE'})
+
+    @classmethod
+    def poll(cls, context):
+        return context.window is not None and any(
+            area.type == 'VIEW_3D' for area in context.window.screen.areas)
+
+    def invoke(self, context, event):
+        area, region = ipad_palette_target(context, event.mouse_x, event.mouse_y)
+        if region is None:
+            return {'CANCELLED'}
+        with context.temp_override(area=area, region=region):
+            options = {'name': 'VIEW3D_MT_ipad_base_ring'}
+            if self.touch_targets:
+                options['ipad_touch_targets'] = True
+            # Preserve the native UI call contract: Python's default undo=False adds
+            # suppression depth even for this non-Undo popup, blocking admission.
+            bpy.ops.wm.call_menu_pie('INVOKE_DEFAULT', True, **options)
+        return {'FINISHED'}
+
+
+class VIEW3D_MT_ipad_tools(Menu):
+    bl_label = "Pencil Tools"
+
+    @classmethod
+    def poll(cls, context):
+        return context.area is not None and context.area.type == 'VIEW_3D'
+
+    def draw(self, context):
+        # Nine native tool buttons retain their familiar positions and empty center.
+        # The active editing tool opens its contextual controls when tapped again.
+        layout = self.layout.column()
+        layout.operator_context = 'INVOKE_REGION_WIN'
+        cls = ToolSelectPanelHelper._tool_class_from_space_type('VIEW_3D')
+        available = {tool.idname: tool for tool in cls._tools_flatten_with_dynamic(
+            cls.tools_from_context(context), context=context) if tool is not None}
+        active = ToolSelectPanelHelper.tool_active_from_context(context)
+        active_id = active.idname if active else None
+        for label, name, fallback_icon in IPAD_RADIAL_TOOLS:
+            slot = layout.row()
+            tool = available.get(name)
+            slot.enabled = tool is not None
+            icon_val = 0
+            if tool and getattr(tool, "icon", None):
+                try:
+                    icon_val = ToolSelectPanelHelper._icon_value_from_icon_handle(tool.icon)
+                except Exception:
+                    icon_val = 0
+            selected = active_id == name or (name == 'builtin.select_box'
+                and active_id in {item[1] for item in IPAD_SELECTION_TOOLS})
+            ring = ipad_context_ring_name(context) if selected else None
+            icon_args = {'icon_value': icon_val} if icon_val else {'icon': fallback_icon}
+            if ring:
+                # Ellipsis announces that tapping the highlighted tool opens controls.
+                slot.operator('wm.call_menu_pie', text=label + "…", depress=True,
+                              **icon_args).name = ring
+            else:
+                slot.operator('wm.tool_set_by_id', text=label, depress=selected,
+                              **icon_args).name = name
