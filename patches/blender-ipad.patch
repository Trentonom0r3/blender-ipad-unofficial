+    inventory: bpy.props.StringProperty(options={'SKIP_SAVE'})
+    expected_tool: bpy.props.StringProperty(options={'SKIP_SAVE'})
+
+    @classmethod
+    def poll(cls, context):
+        return context.area is not None and context.area.type == 'VIEW_3D'
+
+    def execute(self, context):
+        active = ToolSelectPanelHelper.tool_active_from_context(context)
+        if ((active.idname if active else '') != self.expected_tool
+                or ipad_native_inventory_receipt(context) != self.inventory
+                or self.name not in {tool.idname for tool in ipad_native_tool_inventory(context)}):
+            return {'CANCELLED'}
+        return bpy.ops.wm.tool_set_by_id(name=self.name, cycle=False, as_fallback=False)
