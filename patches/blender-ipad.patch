+ARegion *UI_ipad_corner_canvas(bContext *C)
+{
+#ifdef WITH_APPLE_CROSSPLATFORM
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmWindow *win = CTX_wm_window(C);
+  if (!wm || !win || BLI_findindex(&wm->windows, win) == -1) return nullptr;
+  bScreen *screen = WM_window_get_active_screen(win);
+  ScrArea *area = CTX_wm_area(C);
+  if (!screen || !ED_ipad_panels_enabled(screen) || !area ||
+      BLI_findindex(&screen->areabase, area) == -1 || area->spacetype != SPACE_VIEW3D ||
+      area->runtime.ipad_layer != 1) return nullptr;
+  ARegion *canvas = nullptr;
+  LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+    if (region->regiontype != RGN_TYPE_WINDOW) continue;
+    if (canvas) return nullptr; /* No ambiguous quad origin. */
+    canvas = region;
+  }
+  if (!canvas || !canvas->runtime->visible || !canvas->runtime->ipad_canvas ||
+      (canvas->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED))) return nullptr;
+  const rcti &bounds = canvas->runtime->ipad_canvas_rect;
+  if (BLI_rcti_size_x(&bounds) + 1 < 24 * UI_UNIT_X ||
+      BLI_rcti_size_y(&bounds) + 1 < 14 * UI_UNIT_Y) return nullptr;
+  return canvas;
+#else
+  UNUSED_VARS(C);
+  return nullptr;
+#endif
+}
+
+ARegion *UI_ipad_corner_hud_window(bContext *C, ScrArea *area, ARegion *hud)
+{
+  if (!area || CTX_wm_area(C) != area || !hud || hud->regiontype != RGN_TYPE_HUD ||
+      BLI_findindex(&area->regionbase, hud) == -1) return nullptr;
+  if (ARegion *canvas = UI_ipad_corner_canvas(C)) return canvas;
+  HudRegionData *hrd = static_cast<HudRegionData *>(hud->regiondata);
+  if (!hrd || hrd->regionid == -1) return nullptr;
+  return area_find_region_by_type_and_index_hint(area, hrd->regionid, hrd->region_index_hint);
+}
