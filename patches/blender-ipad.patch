+static bool ui_ipad_ring_reopen_leaf(bContext *C, uiAfterFunc &after,
+                                     wmOperatorType *type, PointerRNA *properties)
+{
+  if (!after.ipad_ring_reopen.present() || !type || !type->idname || type->macro.first ||
+      WM_operator_depends_on_cursor(*C, *type, properties)) return false;
+  /* Exact terminal synchronous actions. Native dialogs/modal operations and
+   * category replacement keep their existing owning native dispatch path. */
+  if (STREQ(type->idname, "WM_OT_context_set_id")) {
+    if (!properties || properties->type != type->srna) return false;
+    PropertyRNA *path = RNA_struct_find_property(properties, "data_path");
+    PropertyRNA *value = RNA_struct_find_property(properties, "value");
+    if (!path || !value || RNA_property_type(path) != PROP_STRING ||
+        RNA_property_type(value) != PROP_STRING) return false;
+    if (RNA_property_string_length(properties, path) >= 128 ||
+        RNA_property_string_length(properties, value) >= 128) return false;
+    char data_path[128], workspace[128];
+    RNA_property_string_get(properties, path, data_path);
+    RNA_property_string_get(properties, value, workspace);
+    if (!STREQ(data_path, "window.workspace")) return false;
+    return UI_ipad_ring_reopen_workspace_target(C, after.ipad_ring_reopen, workspace);
+  }
+  return STREQ(type->idname, "VIEW3D_OT_ipad_native_tool") ||
+         STREQ(type->idname, "VIEW3D_OT_ipad_selection_tool") ||
+         STREQ(type->idname, "VIEW3D_OT_ipad_transform_axis") ||
+         STREQ(type->idname, "VIEW3D_OT_ipad_transform_option") ||
+         STREQ(type->idname, "OBJECT_OT_mode_set") ||
+         STREQ(type->idname, "ED_OT_undo") || STREQ(type->idname, "ED_OT_redo") ||
+         ui_ipad_view_action_bit(type) != 0 ||
+         STREQ(type->idname, "OBJECT_OT_select_all") ||
+         STREQ(type->idname, "MESH_OT_select_all") ||
+         STREQ(type->idname, "MESH_OT_select_mode") ||
+         STREQ(type->idname, "POSE_OT_select_all") ||
+         STREQ(type->idname, "CURVE_OT_select_all") ||
+         STREQ(type->idname, "ARMATURE_OT_select_all") ||
+         STREQ(type->idname, "LATTICE_OT_select_all") ||
+         STREQ(type->idname, "MBALL_OT_select_all") ||
+         STREQ(type->idname, "GREASE_PENCIL_OT_select_all") ||
+         STREQ(type->idname, "POINTCLOUD_OT_select_all") ||
+         STREQ(type->idname, "CURVES_OT_select_all");
+}
