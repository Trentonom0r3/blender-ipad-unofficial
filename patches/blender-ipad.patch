+ * work. The event carries only a path, options and ticket, never Blender state. */
+struct GHOST_IOSRecentProjectOpenData {
+  const char *path;
+  int ticket;
+  bool load_ui_set;
+  bool load_ui;
+  bool use_scripts_set;
+  bool use_scripts;
+};
+enum GHOST_IOSRecentProjectCommit {
+  GHOST_IOSRecentProjectCommit_Failed,
+  GHOST_IOSRecentProjectCommit_Stale,
+  GHOST_IOSRecentProjectCommit_Proceed,
+};
+bool GHOST_IOS_recent_project_is_linked(const char *path);
+bool GHOST_IOS_recent_project_is_ready(const char *path, int ticket);
+/* Skip a second Files check only for the first open of a just-copied linked file. */
