+uiIPadNumbersTypeGuard::uiIPadNumbersTypeGuard(const uintptr_t type_address)
+{
+  wmOperatorType *ot = WM_operatortype_find("VIEW3D_OT_ipad_transform_numbers", true);
+  if (type_address && uintptr_t(ot) == type_address) {
