diff --git a/intern/ghost/intern/GHOST_ProjectImportIOS.hh b/intern/ghost/intern/GHOST_ProjectImportIOS.hh
new file mode 100644
--- /dev/null
+++ b/intern/ghost/intern/GHOST_ProjectImportIOS.hh
@@ -0,0 +1,241 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* Included only by GHOST_SystemIOS.mm. This service imports an independent
+ * project copy. It does not claim to own or save the provider's original file. */
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+@interface GHOST_IOSProjectImporter : NSObject <UIDocumentPickerDelegate,
+                                               UIAdaptivePresentationControllerDelegate>
+{
+  UIViewController *_presenter;
+  UIDocumentPickerViewController *_picker;
+  UIAlertController *_progress;
+  NSUInteger _generation;
+  BOOL _busy;
+}
+- (BOOL)present;
+@end
+
+@implementation GHOST_IOSProjectImporter
+
+- (BOOL)hasLivePresenter
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (!system || !system->current_active_window_) {
+    return NO;
+  }
+  return system->current_active_window_->rootWindow.rootViewController == _presenter &&
+         _presenter.view.window != nil;
+}
+
+- (void)finish
+{
+  _busy = NO;
+  [_presenter release];
+  _presenter = nil;
+}
+
+- (void)showError:(NSString *)message
+{
+  if ([self hasLivePresenter]) {
+    UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"Project Import"
+                                                                  message:message
+                                                           preferredStyle:UIAlertControllerStyleAlert];
+    [alert addAction:[UIAlertAction actionWithTitle:@"OK"
+                                             style:UIAlertActionStyleCancel
+                                           handler:nil]];
+    [_presenter presentViewController:alert animated:YES completion:nil];
+  }
+  else {
+    NSLog(@"Project import: %@", message);
+  }
+  [self finish];
+}
+
+- (void)dismissPicker:(void (^)(void))completion
+{
+  UIDocumentPickerViewController *picker = _picker;
+  _picker = nil;
+  picker.delegate = nil;
+  picker.presentationController.delegate = nil;
+  [picker dismissViewControllerAnimated:YES completion:completion];
+  [picker release];
+}
+
+- (BOOL)present
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (_busy || !system || !system->current_active_window_) {
+    return NO;
+  }
+  UIViewController *presenter = system->current_active_window_->rootWindow.rootViewController;
+  if (!presenter.view.window || presenter.presentedViewController) {
+    return NO;
+  }
+  _presenter = [presenter retain];
+  _busy = YES;
+  ++_generation;
+  UTType *blend = [UTType typeWithFilenameExtension:@"blend" conformingToType:UTTypeData];
+  _picker = [[UIDocumentPickerViewController alloc] initForOpeningContentTypes:@[blend ?: UTTypeData]
+                                                                     asCopy:YES];
+  _picker.allowsMultipleSelection = NO;
+  _picker.delegate = self;
+  _picker.modalPresentationStyle = UIModalPresentationFormSheet;
+  _picker.title = @"Import a Project Copy";
+  [_presenter presentViewController:_picker animated:YES completion:nil];
+  _picker.presentationController.delegate = self;
+  return YES;
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller
+{
+  if (controller != _picker) {
+    return;
+  }
+  ++_generation;
+  [self dismissPicker:^{ [self finish]; }];
+}
+
+- (void)presentationControllerDidDismiss:(UIPresentationController *)controller
+{
+  if (controller.presentedViewController != _picker) {
+    return;
+  }
+  ++_generation;
+  _picker.delegate = nil;
+  _picker.presentationController.delegate = nil;
+  [_picker release];
+  _picker = nil;
+  [self finish];
+}
+
+- (void)importURL:(NSURL *)source
+{
+  if (![self hasLivePresenter]) {
+    [self finish];
+    return;
+  }
+  if (!source.isFileURL || [source.pathExtension caseInsensitiveCompare:@"blend"] != NSOrderedSame) {
+    [self showError:@"Choose a Blender (.blend) project."];
+    return;
+  }
+  const NSUInteger generation = _generation;
+  _progress = [[UIAlertController alertControllerWithTitle:@"Importing Project"
+                                                  message:@"Creating a copy in Blender's Projects folder."
+                                           preferredStyle:UIAlertControllerStyleAlert] retain];
+  [_progress addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                               style:UIAlertActionStyleCancel
+                                             handler:^(UIAlertAction *action) {
+    /* File-provider work may finish later. Its generation cannot open a project
+     * or dismiss UI belonging to a newer request. */
+    ++_generation;
+    [_progress release];
+    _progress = nil;
+    [self finish];
+  }]];
+  [_presenter presentViewController:_progress animated:YES completion:^{
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+      @autoreleasepool {
+        NSFileManager *manager = [NSFileManager defaultManager];
+        NSURL *documents = [[manager URLsForDirectory:NSDocumentDirectory
+                                            inDomains:NSUserDomainMask] firstObject];
+        /* Never overwrite an existing import, even for equal filenames. Keep the
+         * original filename inside its own visible project directory. */
+        NSString *folder = [NSString stringWithFormat:@"%@ - %@",
+                            source.lastPathComponent.stringByDeletingPathExtension,
+                            [NSUUID UUID].UUIDString];
+        NSURL *project = [[documents URLByAppendingPathComponent:@"Projects" isDirectory:YES]
+                          URLByAppendingPathComponent:folder isDirectory:YES];
+        NSURL *destination = [project URLByAppendingPathComponent:source.lastPathComponent];
+        __block NSError *copy_error = nil;
+        NSError *coordination_error = nil;
+        __block BOOL copied = NO;
+        const BOOL scoped = [source startAccessingSecurityScopedResource];
+        NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+        [coordinator coordinateReadingItemAtURL:source options:0 error:&coordination_error
+                                     byAccessor:^(NSURL *read_url) {
+          NSNumber *regular = nil;
+          if (![read_url getResourceValue:&regular forKey:NSURLIsRegularFileKey error:&copy_error] ||
+              !regular.boolValue) {
+            return;
+          }
+          if ([manager createDirectoryAtURL:project withIntermediateDirectories:YES
+                                 attributes:nil error:&copy_error]) {
+            /* The actual copy is inside the coordinator's accessor. Blender
+             * subsequently reads our local copy, outside the provider lease. */
+            copied = [manager copyItemAtURL:read_url toURL:destination error:&copy_error];
+          }
+        }];
+        [coordinator release];
+        if (scoped) {
+          [source stopAccessingSecurityScopedResource];
+        }
+        NSString *failure = (coordination_error ?: copy_error).localizedDescription;
+        if (!copied) {
+          [manager removeItemAtURL:project error:nullptr];
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+          if (generation != _generation) {
+            if (copied) {
+              dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                [[NSFileManager defaultManager] removeItemAtURL:project error:nullptr];
+              });
+            }
+            return;
+          }
+          UIAlertController *progress = _progress;
+          _progress = nil;
+          [progress dismissViewControllerAnimated:YES completion:^{
+            if (generation != _generation) {
+              return;
+            }
+            if (!copied) {
+              [self showError:failure ?: @"The project could not be copied. Check available storage and try again."];
+              return;
+            }
+            GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+            if (![self hasLivePresenter] || !system->handleOpenDocumentRequest(destination.path)) {
+              [self showError:@"The copy is in Blender's Projects folder. Return to the workspace and open it from the file browser."];
+              return;
+            }
+            /* Normal GHOST open event retains Blender's unsaved-changes dialog
+             * and script policy. No operator/context pointer survives UIKit. */
+            [self finish];
+          }];
+          [progress release];
+        });
+      }
+    });
+  }];
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller
+    didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls
+{
+  if (controller != _picker) {
+    return;
+  }
+  NSURL *source = urls.firstObject;
+  [self dismissPicker:^{
+    if (source) {
+      [self importURL:source];
+    }
+    else {
+      [self finish];
+    }
+  }];
+}
+@end
+
+bool GHOST_IOS_import_project()
+{
+  /* Application-lifetime delegate; UIKit delegates are non-owning. */
+  static GHOST_IOSProjectImporter *importer = nil;
+  if (![NSThread isMainThread]) {
+    return false;
+  }
+  if (!importer) {
+    importer = [[GHOST_IOSProjectImporter alloc] init];
+  }
+  return [importer present];
+}
