+uiIPadNumbersConstructorScope::uiIPadNumbersConstructorScope(
+    bContext *C, wmOperator *op, bool owned_creator, uiPopupBlockHandle *registered)
+    : type_guard_(ui_ipad_numbers_constructor_type(C, op, owned_creator, registered))
+{
+  if (!owned_creator || !type_guard_.valid()) return;
+  const uintptr_t type = ui_ipad_numbers_constructor_type(C, op, owned_creator, registered);
+  if (!type) return;
+  previous_ = ui_ipad_numbers_constructor;
+  uiIPadNumbersConstructorContext context;
+  context.op = op;context.type_address = type;context.type_lifetime = op->type->ipad_lifetime_id;
+  context.ptr_address = ui_ipad_rna_address(op->ptr);
+  context.origin = ui_ipad_action_origin_current();
+  wmWindowManager *wm = CTX_wm_manager(C);
+  auto &receipt = context.binding;
+  receipt.owner = uiIPadRNAOwner::PopupProperties;
+  receipt.owner_address = ui_ipad_rna_address(wm);
+  receipt.owner_uid = wm->id.session_uid;receipt.owner_id_type = GS(wm->id.name);
+  receipt.popup_lifetime = registered ? registered->ipad_popup_lifetime : 0;
+  receipt.popup_operator_address = ui_ipad_rna_address(op);
+  receipt.subgroup_address = ui_ipad_rna_address(op->properties);
+  receipt.root_type_address = ui_ipad_rna_address(op->ptr->type);
+  ui_ipad_rna_history_capture(C, receipt);
+  ui_ipad_numbers_constructor = std::move(context);installed_ = true;
+}
