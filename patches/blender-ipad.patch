+static void ui_ipad_ring_free(void *arg)
+{
+  auto *data = static_cast<uiIPadRingData *>(arg);
+#ifdef WITH_APPLE_CROSSPLATFORM
+  ghost::ios::retire_pencil_ring(data->ghost_window, data->lifetime);
+#endif
+  data->browse.retire();
+  MEM_delete(data);
+}
