+bool UI_ipad_ring_event_dispatch(bContext *C, const wmEvent *event)
+{
+  if (event->type != PENCIL_RING_INPUT || event->custom != EVT_DATA_PENCIL_RING ||
+      !event->customdata) return false;
+  const auto &packet = *static_cast<const GHOST_TEventPencilRingData *>(event->customdata);
+  wmWindow *win = CTX_wm_window(C);
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!win || !wm || BLI_findindex(&wm->windows, win) == -1) return true;
+  Main *main_before = CTX_data_main(C);
+  bScreen *screen = WM_window_get_active_screen(win);
+  ScrArea *saved_area = CTX_wm_area(C);
+  ARegion *saved_region = CTX_wm_region(C), *saved_popup = CTX_wm_region_popup(C);
+  if (!screen) return true;
+  LISTBASE_FOREACH (ARegion *, popup, &screen->regionbase) {
+    uiBlock *block = static_cast<uiBlock *>(popup->runtime->uiblocks.first);
+    if (block && block->active) {
+      if (!(block->pie_data.flags & UI_PIE_IPAD_TOOLS) ||
+          block->ipad_ring_lifetime != packet.lifetime || !block->handle) continue;
+      uiPopupBlockHandle *handle = block->handle;
+      bool registered = false;
+      LISTBASE_FOREACH (wmEventHandler *, base, &win->modalhandlers) {
+        if (base->type != WM_HANDLER_TYPE_UI || (base->flag & WM_HANDLER_DO_FREE)) continue;
+        auto *handler = reinterpret_cast<wmEventHandler_UI *>(base);
+        if (handler->handle_fn == ui_popup_handler && handler->remove_fn == ui_popup_handler_remove &&
+            handler->user_data == handle) { registered = true; break; }
+      }
+      /* Prove native handler ownership before reading saved popup context. */
+      if (!registered || handle->region != popup || !win->eventstate) return true;
+      /* Test membership before reading a saved area's WINDOW list. */
+      ScrArea *area = handle->ctx_area; ARegion *region = handle->ctx_region;
+      if (!area || BLI_findindex(&screen->areabase, area) == -1 || !region ||
+          BLI_findindex(&area->regionbase, region) == -1) return true;
+      CTX_wm_area_set(C, area); CTX_wm_region_set(C, region);
+      CTX_wm_region_popup_set(C, nullptr);
+      /* Native INVOKE_REGION_WIN/dialog positioning reads eventstate when UI
+       * defers with a null event. Scope only its cursor coordinates to this
+       * admitted presentation; never synthesize hardware button/modifier state. */
+      const int cursor_before[2] = {win->eventstate->xy[0], win->eventstate->xy[1]};
+      const int window_id = win->winid; const void *ghost_window = win->ghostwin;
+      win->eventstate->xy[0] = event->xy[0]; win->eventstate->xy[1] = event->xy[1];
+      ui_popup_handler(C, event, handle);
+      /* Native execution may free the popup, decode Undo, switch workspaces or
+       * load a Main. Do not retain/dereference any old button or popup after it. */
+      if (CTX_data_main(C) != main_before || CTX_wm_manager(C) != wm ||
+          CTX_wm_window(C) != win || BLI_findindex(&wm->windows, win) == -1) return true;
+      if (win->winid != window_id || win->ghostwin != ghost_window) return true;
+      if (win->eventstate && win->eventstate->xy[0] == event->xy[0] &&
+          win->eventstate->xy[1] == event->xy[1]) {
+        win->eventstate->xy[0] = cursor_before[0]; win->eventstate->xy[1] = cursor_before[1];
+      }
+      bScreen *live = WM_window_get_active_screen(win);
+      if (!live) { CTX_wm_area_set(C, nullptr); CTX_wm_region_set(C, nullptr);
+                   CTX_wm_region_popup_set(C, nullptr); return true; }
+      const bool area_live = saved_area && BLI_findindex(&live->areabase, saved_area) != -1;
+      CTX_wm_area_set(C, area_live ? saved_area : nullptr);
+      CTX_wm_region_set(C, area_live && saved_region &&
+          BLI_findindex(&saved_area->regionbase, saved_region) != -1 ? saved_region : nullptr);
+      CTX_wm_region_popup_set(C, saved_popup &&
+          BLI_findindex(&live->regionbase, saved_popup) != -1 ? saved_popup : nullptr);
+      return true;
+    }
+  }
+  return true; /* Owned provenance never falls through into another popup/scene. */
+}
