+static int ui_ipad_view_action_bit(const wmOperatorType *type)
+{
+  if (!type || !type->idname) return 0;
+  if (STREQ(type->idname, "VIEW3D_OT_view_all") ||
+      STREQ(type->idname, "VIEW3D_OT_view_selected")) return 1;
+  if (STREQ(type->idname, "VIEW3D_OT_view_axis")) return 2;
+  if (STREQ(type->idname, "VIEW3D_OT_view_persportho")) return 4;
+  return 0;
+}
+
+static bool ui_ipad_view_dispatch_allowed(bContext *C, const uiAfterFunc &after,
+                                           wmOperatorType *type, PointerRNA *properties)
+{
+  if (!after.ipad_action_origin.present() || !after.ipad_view_guarded) return true;
+  const int bit = ui_ipad_view_action_bit(type);
+  if (!bit || after.opcontext != blender::wm::OpCallContext::ExecRegionWin ||
+      !after.ipad_view_region_data || type->flag || !type->exec || type->invoke) return false;
+  uint64_t identity = 0;
+  if (!(UI_ipad_view_navigation_mask(C, &identity) & bit) ||
+      identity != after.ipad_view_region_data) return false;
+  if (bit != 4) {
+    if (!properties || properties->type != type->srna || !properties->data) return false;
+    const auto explicit_false = [&](const char *name) {
+      PropertyRNA *property = RNA_struct_find_property(properties, name);
+      return property && RNA_property_type(property) == PROP_BOOLEAN &&
+             RNA_property_array_length(properties, property) == 0 &&
+             RNA_struct_property_is_set(properties, name) &&
+             !RNA_property_boolean_get(properties, property);
+    };
+    if (bit == 1 && (!explicit_false("use_all_regions") ||
+        (STREQ(type->idname, "VIEW3D_OT_view_all") && !explicit_false("center")))) return false;
+    if (bit == 2) {
+      PropertyRNA *axis = RNA_struct_find_property(properties, "type");
+      if (!axis || RNA_property_type(axis) != PROP_ENUM ||
+          !RNA_struct_property_is_set(properties, "type") ||
+          !explicit_false("align_active") || !explicit_false("relative")) return false;
+      const int value = RNA_property_enum_get(properties, axis);
+      if (!ELEM(value, RV3D_VIEW_TOP, RV3D_VIEW_FRONT, RV3D_VIEW_RIGHT)) return false;
+    }
+  }
+  /* Recheck after property reads: no cached region/RNA pointer is used by the
+   * native operation until the final live owner/state proof succeeds. */
+  return (UI_ipad_view_navigation_mask(C, &identity) & bit) &&
+         identity == after.ipad_view_region_data;
+}
