 /** \name Internal Gesture Utilities
  *
  * Border gesture has two types:
  * -# #WM_GESTURE_CROSS_RECT: starts a cross, on mouse click it changes to border.
  * -# #WM_GESTURE_RECT: starts immediate as a border, on mouse click or release it ends.
  *
  * It stores 4 values (xmin, xmax, ymin, ymax) and event it ended with (event_type).
  *
  * \{ */
 
+
+#ifdef WITH_APPLE_CROSSPLATFORM
+static int gesture_ipad_selection_kind(const wmOperator *op)
+{
+  /* Resolve registration before dereferencing a saved operator type. */
+  if (!op || op->opm) return 0;
+  wmOperatorType *box = WM_operatortype_find("VIEW3D_OT_select_box", true);
+  wmOperatorType *lasso = WM_operatortype_find("VIEW3D_OT_select_lasso", true);
+  if (box && op->type == box && box->ipad_lifetime_id &&
+      box->invoke == WM_gesture_box_invoke && box->modal == WM_gesture_box_modal &&
+      box->cancel == WM_gesture_box_cancel) return WM_GESTURE_RECT;
+  if (lasso && op->type == lasso && lasso->ipad_lifetime_id &&
+      lasso->invoke == WM_gesture_lasso_invoke && lasso->modal == WM_gesture_lasso_modal &&
+      lasso->cancel == WM_gesture_lasso_cancel) return WM_GESTURE_LASSO;
+  return 0;
+}
+
+static bool gesture_ipad_selection_tool(const bContext *C, const int kind)
+{
+  const bToolRef *tool = WM_toolsystem_ref_from_context(C);
+  return tool && STREQ(tool->idname, kind == WM_GESTURE_RECT ? "builtin.select_box" :
+                                                                "builtin.select_lasso");
+}
+
+static void gesture_ipad_selection_begin(bContext *C, wmOperator *op, const wmEvent *event,
+                                         const wmEventHandler_Op *handler)
+{
+  wmGesture *gesture = static_cast<wmGesture *>(op->customdata);
+  gesture->ipad_selection_cue = false;
+  const int kind = gesture_ipad_selection_kind(op);
+  if (!kind || !handler || handler->op != op || !event || event->type != LEFTMOUSE ||
+      event->val != KM_PRESS_DRAG || !(event->flag & WM_EVENT_IS_DIRECT_TOOL) ||
+      event->modifier || event->keymodifier != EVENT_NONE || gesture->type != kind ||
+      gesture->wait_for_input || !gesture_ipad_selection_tool(C, kind) ||
+      !UI_ipad_context_capture(C, gesture->ipad_selection_context)) return;
+  /* Both exact native operators own this fixed scalar enum. No getter is used during draw. */
+  const int mode = RNA_enum_get(op->ptr, "mode");
+  if (!ELEM(mode, SEL_OP_SET, SEL_OP_ADD, SEL_OP_SUB)) return;
+  gesture->ipad_selection_operator_lifetime = WM_operator_touch_lifetime_id(op);
+  gesture->ipad_selection_type_lifetime = op->type->ipad_lifetime_id;
+  gesture->ipad_selection_mode = mode;
+  gesture->ipad_selection_cue = gesture->ipad_selection_operator_lifetime != 0;
+}
+
+void WM_gesture_ipad_selection_draw(bContext *C)
+{
+  wmWindow *window = CTX_wm_window(C);
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || !window || BLI_findindex(&wm->windows, window) == -1) return;
+  bScreen *screen = WM_window_get_active_screen(window);
+  if (!screen) return;
+  /* The window overlay is above native menus. Never promote this noninteractive cue over them. */
+  LISTBASE_FOREACH (const ARegion *, popup, &screen->regionbase) {
+    if (popup->runtime->visible) return;
+  }
+  LISTBASE_FOREACH (wmEventHandler *, base, &window->modalhandlers) {
+    if (base->type != WM_HANDLER_TYPE_OP || (base->flag & WM_HANDLER_DO_FREE)) continue;
+    const wmEventHandler_Op *handler = reinterpret_cast<const wmEventHandler_Op *>(base);
+    wmOperator *op = handler->op;
+    if (!op || !op->customdata || BLI_findindex(&window->gesture, op->customdata) == -1) continue;
+    wmGesture *gesture = static_cast<wmGesture *>(op->customdata);
+    if (!gesture->ipad_selection_cue) continue;
+    const int kind = gesture_ipad_selection_kind(op);
+    if (!kind || gesture->type != kind || gesture->wait_for_input ||
+        !WM_operator_touch_lifetime_matches(op, gesture->ipad_selection_operator_lifetime) ||
+        op->type->ipad_lifetime_id != gesture->ipad_selection_type_lifetime ||
+        (handler->context.win && handler->context.win != window)) {
+      gesture->ipad_selection_cue = false;
+      continue;
+    }
+    ScrArea *area = nullptr;
+    ARegion *region = nullptr;
+    LISTBASE_FOREACH (ScrArea *, candidate, &screen->areabase) {
+      if (uintptr_t(candidate) == gesture->ipad_selection_context[3] &&
+          candidate == handler->context.area) { area = candidate; break; }
+    }
+    if (area) {
+      LISTBASE_FOREACH (ARegion *, candidate, &area->regionbase) {
+        if (uintptr_t(candidate) == gesture->ipad_selection_context[4] &&
+            candidate == handler->context.region && candidate->regiontype == RGN_TYPE_WINDOW) {
+          region = candidate;
+          break;
+        }
+      }
+    }
+    if (!region || region->winrct.xmin != gesture->winrct.xmin ||
+        region->winrct.xmax != gesture->winrct.xmax ||
+        region->winrct.ymin != gesture->winrct.ymin ||
+        region->winrct.ymax != gesture->winrct.ymax) {
+      gesture->ipad_selection_cue = false;
+      continue;
+    }
+    ScrArea *previous_area = CTX_wm_area(C);
+    ARegion *previous_region = CTX_wm_region(C);
+    CTX_wm_area_set(C, area);
+    CTX_wm_region_set(C, region);
+    if (!UI_ipad_context_matches(C, gesture->ipad_selection_context) ||
+        !gesture_ipad_selection_tool(C, kind)) {
+      gesture->ipad_selection_cue = false;
+    }
+    else {
+      const char *status = nullptr;
+      if (kind == WM_GESTURE_RECT) {
+        switch (gesture->ipad_selection_mode) {
+          case SEL_OP_SET: status = IFACE_("Box · Replace"); break;
+          case SEL_OP_ADD: status = IFACE_("Box · Add"); break;
+          case SEL_OP_SUB: status = IFACE_("Box · Remove"); break;
+        }
+      }
+      else {
+        switch (gesture->ipad_selection_mode) {
+          case SEL_OP_SET: status = IFACE_("Lasso · Replace"); break;
+          case SEL_OP_ADD: status = IFACE_("Lasso · Add"); break;
+          case SEL_OP_SUB: status = IFACE_("Lasso · Remove"); break;
+        }
+      }
+      /* Caller restored the full window projection after native gesture drawing.
+       * The shared cue uses region-local pixels; translate from that exact live WINDOW. */
+      GPU_matrix_push();
+      GPU_matrix_translate_2f(float(region->winrct.xmin), float(region->winrct.ymin));
+      UI_ipad_stroke_cue_draw(C, region, gesture->ipad_selection_context, status);
+      GPU_matrix_pop();
+    }
+    /* Native area setter clears region, even when restoring the same area. */
+    CTX_wm_area_set(C, previous_area);
+    CTX_wm_region_set(C, previous_region);
+    return; /* One native admitted pointer stream, no callbacks or saved owners retained. */
+  }
+}
+#endif
+
 static void gesture_modal_end(bContext *C, wmOperator *op)
 {
   wmWindow *win = CTX_wm_window(C);
   wmGesture *gesture = static_cast<wmGesture *>(op->customdata);
 
   WM_gesture_end(win, gesture); /* Frees gesture itself, and unregisters from window. */
   op->customdata = nullptr;
 
   ED_area_tag_redraw(CTX_wm_area(C));
 
   if (RNA_struct_find_property(op->ptr, "cursor")) {
     WM_cursor_modal_restore(win);
   }
 }
 
 static void gesture_modal_state_to_operator(wmOperator *op, int modal_state)
 {
   PropertyRNA *prop;
 
   switch (modal_state) {
     case GESTURE_MODAL_SELECT:
     case GESTURE_MODAL_DESELECT:
       if ((prop = RNA_struct_find_property(op->ptr, "deselect"))) {
         RNA_property_boolean_set(op->ptr, prop, (modal_state == GESTURE_MODAL_DESELECT));
       }
       if ((prop = RNA_struct_find_property(op->ptr, "mode"))) {
         RNA_property_enum_set(
             op->ptr, prop, (modal_state == GESTURE_MODAL_DESELECT) ? SEL_OP_SUB : SEL_OP_ADD);
       }
       break;
     case GESTURE_MODAL_IN:
     case GESTURE_MODAL_OUT:
       if ((prop = RNA_struct_find_property(op->ptr, "zoom_out"))) {
         RNA_property_boolean_set(op->ptr, prop, (modal_state == GESTURE_MODAL_OUT));
       }
       break;
   }
 }
 
 static int UNUSED_FUNCTION(gesture_modal_state_from_operator)(wmOperator *op)
 {
   PropertyRNA *prop;
 
   if ((prop = RNA_struct_find_property(op->ptr, "deselect"))) {
     if (RNA_property_is_set(op->ptr, prop)) {
       return RNA_property_boolean_get(op->ptr, prop) ? GESTURE_MODAL_DESELECT :
                                                        GESTURE_MODAL_SELECT;
     }
   }
   if ((prop = RNA_struct_find_property(op->ptr, "mode"))) {
     if (RNA_property_is_set(op->ptr, prop)) {
       return RNA_property_enum_get(op->ptr, prop) == SEL_OP_SUB ? GESTURE_MODAL_DESELECT :
                                                                   GESTURE_MODAL_SELECT;
     }
   }
   if ((prop = RNA_struct_find_property(op->ptr, "zoom_out"))) {
     if (RNA_property_is_set(op->ptr, prop)) {
       return RNA_property_boolean_get(op->ptr, prop) ? GESTURE_MODAL_OUT : GESTURE_MODAL_IN;
     }
   }
   return GESTURE_MODAL_NOP;
 }
 
