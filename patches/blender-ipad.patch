+static wmOperator *ui_ipad_popup_operator_resolve(bContext *C, const uiAfterFunc &after)
+{
+  if (!after.ipad_action_origin.present()) return after.popup_op;
+  uiPopupBlockHandle *handle = ui_ipad_registered_popup_resolve(
