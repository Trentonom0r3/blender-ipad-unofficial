+bool UI_ipad_numbers_operator_owned(bContext *C, wmOperator *op)
+{
+  const auto origin = ui_ipad_action_origin_current();
+  /* Disposal ownership is independent of semantic context acceptance. A
+   * cancelled first constructor must still free its genuinely owned operator. */
+  if (!origin.present()) return false;
+  UNUSED_VARS(C);
+  wmOperatorType *ot = WM_operatortype_find("VIEW3D_OT_ipad_transform_numbers", true);
+  return ot && op && op->type == ot;
+}
