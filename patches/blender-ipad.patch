 void uiLayout::prop_with_popover(PointerRNA *ptr,
                                  PropertyRNA *prop,
                                  int index,
                                  int value,
                                  const eUI_Item_Flag flag,
                                  const std::optional<StringRefNull> name,
                                  int icon,
