+static bool widget_draw_ipad_ring_label(const uiFontStyle *fstyle,
+                                        const uiWidgetColors *wcol,
+                                        uiBut *but, const rcti *rect)
+{
+  if (!(but->block->pie_data.flags & UI_PIE_IPAD_TOOLS) ||
+      !but->block->ipad_ring_lifetime || !but->block->ipad_ring_full_labels ||
+      but->editstr) return false;
+  /* Native tool/icon/extra-icon spacing has already reduced this rectangle.
+   * Keyboard hints stay in native tooltips, rather than consuming Pencil label
+   * space. Do not rewrite either the native label or the cached draw string. */
+  std::string_view label(but->drawstr);
+  if (but->flag & UI_BUT_HAS_SEP_CHAR) label = label.substr(0, label.find(UI_SEP_CHAR));
+  if (label.empty()) { but->ipad_ring_label_fit = true; return true; }
+  const float inset = std::max(1.f, UI_SCALE_FAC);
+  const float gap = UI_SCALE_FAC;
+  FontFlags glyph_flags = FontFlags(0);
+  if (fstyle->bold) glyph_flags |= BLF_BOLD;
+  if (fstyle->italic) glyph_flags |= BLF_ITALIC;
+  /* Apply the same native style for both metrics and drawing. */
+  BLF_enable(fstyle->uifont_id, glyph_flags);
+  const auto measure = [&](std::string_view text, float scale) {
+    uiFontStyle font = *fstyle;
+    font.points *= scale;
+    UI_fontstyle_set(&font);
+    rcti bounds{};
+    BLF_boundbox(font.uifont_id, text.data(), text.size(), &bounds);
+    const float xmin = std::min(0.f, float(bounds.xmin));
+    const float width = std::max(BLF_width(font.uifont_id, text.data(), text.size()),
+                                 float(bounds.xmax)) - xmin;
+    return blender::ui::ipad::RingLabelMetrics{width, xmin,
+                                               float(bounds.ymin), float(bounds.ymax)};
+  };
+  const auto fitted = blender::ui::ipad::ring_label_fit(label,
+      BLI_rcti_size_x(rect) - 2 * inset, BLI_rcti_size_y(rect) - 2 * inset, gap, measure);
+  but->ipad_ring_label_fit = fitted.fits;
+  if (fitted.fits) {
+    uiFontStyle font = *fstyle;
+    font.points *= fitted.scale;
+    UI_fontstyle_set(&font);
+    FontFlags draw_flags = glyph_flags | BLF_CLIPPING;
+    if (font.shadow) {
+      draw_flags |= BLF_SHADOW;
+      const float color[4] = {font.shadowcolor, font.shadowcolor,
+                              font.shadowcolor, font.shadowalpha};
+      BLF_shadow(font.uifont_id, FontShadowType(font.shadow), color);
+      BLF_shadow_offset(font.uifont_id, font.shadx, font.shady);
+    }
+    BLF_enable(font.uifont_id, draw_flags);
+    BLF_clipping(font.uifont_id, rect->xmin, rect->ymin, rect->xmax, rect->ymax);
+    BLF_color4ubv(font.uifont_id, wcol->text);
+    float top = rect->ymax - (BLI_rcti_size_y(rect) - fitted.height) / 2.f;
+    for (const auto &line : fitted.lines) {
+      const float left = (but->drawflag & UI_BUT_TEXT_LEFT) ? rect->xmin + inset :
+          rect->xmin + (BLI_rcti_size_x(rect) - line.metrics.width) / 2.f;
+      BLF_position(font.uifont_id, left - line.metrics.xmin, top - line.metrics.ymax, 0);
+      BLF_draw(font.uifont_id, line.text.c_str(), line.text.size());
+      top -= line.metrics.ymax - line.metrics.ymin + gap;
+    }
+    BLF_disable(font.uifont_id, draw_flags);
+  }
+  /* Font state is shared by native widgets, including those drawn immediately
+   * after this owned ring. Never leave the fitted size installed. */
+  BLF_disable(fstyle->uifont_id, glyph_flags);
+  UI_fontstyle_set(fstyle);
+  return true;
+}
