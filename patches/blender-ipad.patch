+/* This is a bounded 3D mesh brush profile. Missing settings and other native
+ * editors/tools retain fallback; do not use generic mode getters that assume
+ * every Scene has a nonnull sculpt/vpaint/wpaint allocation. */
+bool ED_ipad_finger_paint_capture(bContext *C, IPadFingerPaintOwner &owner)
+{
+  owner = {};
+  if (!UI_ipad_context_capture(C, owner.values.data())) return false;
+  Object *object = CTX_data_active_object(C);
+  Scene *scene = CTX_data_scene(C);
+  if (!object || object->type != OB_MESH || !scene || !scene->toolsettings) return false;
+  ToolSettings *settings = scene->toolsettings;
+  Paint *paint = nullptr;
+  switch (object->mode) {
+    case OB_MODE_SCULPT: if (settings->sculpt) paint = &settings->sculpt->paint; break;
+    case OB_MODE_VERTEX_PAINT: if (settings->vpaint) paint = &settings->vpaint->paint; break;
+    case OB_MODE_WEIGHT_PAINT: if (settings->wpaint) paint = &settings->wpaint->paint; break;
+    case OB_MODE_TEXTURE_PAINT: paint = &settings->imapaint.paint; break;
+    default: return false;
+  }
+  const bToolRef *tool = WM_toolsystem_ref_from_context(C);
+  if (!paint || !tool || !tool->runtime || tool->idname_pending[0] ||
+      !(tool->runtime->flag & TOOLREF_FLAG_USE_BRUSHES)) return false;
+  /* Native getter is callback-free. Copy flags/UID immediately; asset brushes
+   * need not belong to Main.brushes and no Brush is retained in the receipt. */
+  Brush *brush = BKE_paint_brush(paint);
+  if (!brush || (brush->flag & BRUSH_CURVE)) return false;
+  BLI_strncpy(owner.tool.data(), tool->idname, owner.tool.size());
+  const wmWindowManager *wm = CTX_wm_manager(C);
+  const UndoStack *undo = wm->runtime ? wm->runtime->undo_stack : nullptr;
+  if (undo) {
+    owner.values[13] = uint64_t(uintptr_t(undo));
+    owner.values[14] = undo->ipad_lifetime_id;
+    owner.values[15] = undo->ipad_mutation_generation;
+  }
+  owner.values[16] = brush->id.session_uid;
+  owner.values[17] = uint64_t(uintptr_t(settings));
+  owner.values[18] = uint64_t(uintptr_t(paint));
+  owner.valid = true;
+  return true;
+}
+
+bool ED_ipad_finger_brush_invoke_block(bContext *C, const wmEvent *event, const int mode)
+{
+  if (!event) return false;
+  if (event->ipad_pencil_paint_serial) {
+    return !WM_ipad_pencil_paint_contact_validate(C, event, mode);
+  }
+  if (!(event->flag & WM_EVENT_IS_DIRECT_FINGER) ||
+      event->modifier || event->keymodifier) return false;
+  IPadFingerPaintOwner owner;
+  return ED_ipad_finger_paint_capture(C, owner) && int(owner.values[9]) == mode;
+}
