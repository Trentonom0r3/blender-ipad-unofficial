 /** \name Main Event Queue (Every Window)
  *
  * Handle events for all windows, run from the #WM_main event loop.
  * \{ */
 
 #ifdef WITH_XR_OPENXR
 /**
  * Special handling for XR events.
  *
  * Although XR events are added to regular window queues, they are handled in an "off-screen area"
  * context that is owned entirely by XR runtime data and not tied to a window.
  */
 static void wm_event_handle_xrevent(bContext *C,
                                     wmWindowManager *wm,
                                     wmWindow *win,
                                     wmEvent *event)
 {
   ScrArea *area = WM_xr_session_area_get(&wm->xr);
   if (!area) {
     return;
   }
   BLI_assert(area->spacetype == SPACE_VIEW3D && area->spacedata.first);
 
   /* Find a valid region for XR operator execution and modal handling. */
   ARegion *region = BKE_area_find_region_type(area, RGN_TYPE_WINDOW);
   if (!region) {
     return;
   }
   BLI_assert(WM_region_use_viewport(area, region)); /* For operators using GPU-based selection. */
 
   CTX_wm_area_set(C, area);
   CTX_wm_region_set(C, region);
 
   eHandlerActionFlag action = wm_handlers_do(C, event, &win->modalhandlers);
 
   if ((action & WM_HANDLER_BREAK) == 0) {
     wmXrActionData *actiondata = static_cast<wmXrActionData *>(event->customdata);
     if (actiondata->ot->modal && event->val == KM_RELEASE) {
       /* Don't execute modal operators on release. */
     }
     else {
       PointerRNA properties{};
       properties.type = actiondata->ot->srna;
       properties.data = actiondata->op_properties;
       if (actiondata->ot->invoke) {
         /* Invoke operator, either executing operator or transferring responsibility to window
          * modal handlers. */
         wm_operator_invoke(C,
                            actiondata->ot,
                            event,
                            actiondata->op_properties ? &properties : nullptr,
                            nullptr,
                            false,
                            false);
       }
       else {
         /* Execute operator. */
         wmOperator *op = wm_operator_create(
             wm, actiondata->ot, actiondata->op_properties ? &properties : nullptr, nullptr);
         if ((WM_operator_call(C, op) & OPERATOR_HANDLED) == 0) {
           WM_operator_free(op);
         }
       }
     }
   }
 
   CTX_wm_region_set(C, nullptr);
   CTX_wm_area_set(C, nullptr);
 }
 #endif /* WITH_XR_OPENXR */
 
 static eHandlerActionFlag wm_event_do_region_handlers(bContext *C, wmEvent *event, ARegion *region)
 {
   if (region->runtime->type->do_lock) {
     /* If the region is locked, we ignore the events. Handling them can trigger depsgraph
      * evaluations in some cases which is not safe to do because another thread may evaluate the
      * depsgraph already. */
     if (wm_event_always_pass(event)) {
       return WM_HANDLER_CONTINUE;
     }
     return WM_HANDLER_BREAK;
   }
 
   CTX_wm_region_set(C, region);
 
   /* Call even on non mouse events, since the handlers may still use this value. */
   wm_region_mouse_co(C, event);
 
   const wmWindowManager *wm = CTX_wm_manager(C);
   if (!BLI_listbase_is_empty(&wm->runtime->drags)) {
     /* Does polls for drop regions and checks #uiButs. */
     /* Need to be here to make sure region context is true. */
     if (ELEM(event->type, MOUSEMOVE, EVT_DROP) || ISKEYMODIFIER(event->type)) {
       wm_drags_check_ops(C, event);
     }
   }
 
   return wm_handlers_do(C, event, &region->runtime->handlers);
 }
 
 /**
  * Send event to region handlers in \a area.
  *
  * Two cases:
  * 1) Always pass events (#wm_event_always_pass()) are sent to all regions.
  * 2) Event is passed to the region visually under the cursor (#ED_area_find_region_xy_visual()).
  */
 static eHandlerActionFlag wm_event_do_handlers_area_regions(bContext *C,
                                                             wmEvent *event,
                                                             ScrArea *area)
 {
   /* Case 1. */
   if (wm_event_always_pass(event)) {
     eHandlerActionFlag action = WM_HANDLER_CONTINUE;
 
     LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
       action |= wm_event_do_region_handlers(C, event, region);
     }
 
     wm_event_handler_return_value_check(C, event, action);
     return action;
   }
 
   /* Case 2. */
   ARegion *region_hovered = ED_area_find_region_xy_visual(area, RGN_TYPE_ANY, event->xy);
   if (!region_hovered) {
     return WM_HANDLER_CONTINUE;
   }
 
   return wm_event_do_region_handlers(C, event, region_hovered);
 }
 
+#ifdef WITH_APPLE_CROSSPLATFORM
+static const char *wm_ipad_pencil_paint_operator_id(const int mode)
+{
+  switch (mode) {
+    case OB_MODE_SCULPT: return "SCULPT_OT_brush_stroke";
+    case OB_MODE_VERTEX_PAINT: return "PAINT_OT_vertex_paint";
+    case OB_MODE_WEIGHT_PAINT: return "PAINT_OT_weight_paint";
+    case OB_MODE_TEXTURE_PAINT: return "PAINT_OT_image_paint";
+    default: return nullptr;
+  }
+}
+
+static bool wm_ipad_pencil_paint_rect_contains(const int rect[4], const int xy[2])
+{
+  return xy[0] >= rect[0] && xy[0] <= rect[2] && xy[1] >= rect[1] && xy[1] <= rect[3];
+}
+
+static bool wm_ipad_pencil_paint_rcti_equal(const int rect[4], const rcti &r)
+{
+  return rect[0] == r.xmin && rect[1] == r.ymin && rect[2] == r.xmax && rect[3] == r.ymax;
+}
+
+/* The region address is an untrusted value until found in the active screen.
+ * The exact texture receipt, stable typed owner and frozen origin must still
+ * describe that live visible canvas before a native stroke can receive it. */
+bool WM_ipad_pencil_paint_contact_validate(bContext *C, const wmEvent *event, const int mode)
+{
+  if (!C || !event || !wm_ipad_pencil_paint_operator_id(mode) ||
+      !event->ipad_pencil_paint_down || !event->ipad_pencil_paint_serial ||
+      !event->ipad_pencil_paint_generation || !event->ipad_pencil_paint_region ||
+      !ELEM(event->ipad_pencil_paint_phase,
+            WM_PENCIL_PAINT_PHASE_BEGIN,
+            WM_PENCIL_PAINT_PHASE_MOTION,
+            WM_PENCIL_PAINT_PHASE_END) ||
+      (event->ipad_pencil_paint_phase == WM_PENCIL_PAINT_PHASE_BEGIN &&
+       (event->type != LEFTMOUSE || event->val != KM_PRESS || event->modifier ||
+        event->keymodifier || (event->flag & WM_EVENT_IS_DIRECT_TOOL)))) return false;
+
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmWindow *win = CTX_wm_window(C);
+  bScreen *screen = win ? WM_window_get_active_screen(win) : nullptr;
+  if (!wm || !wm->runtime || !win || wm->runtime->winactive != win || !screen ||
+      CTX_wm_screen(C) != screen) return false;
+
+  ScrArea *owner_area = nullptr;
+  ARegion *owner_region = nullptr;
+  LISTBASE_FOREACH (ScrArea *, area, &screen->areabase) {
+    LISTBASE_FOREACH (ARegion *, region, &area->regionbase) {
+      if (uintptr_t(region) == event->ipad_pencil_paint_region) {
+        owner_area = area;
+        owner_region = region;
+        break;
+      }
+    }
+    if (owner_region) break;
+  }
+  if (!owner_region || !owner_region->runtime || owner_region->regiontype != RGN_TYPE_WINDOW ||
+      CTX_wm_area(C) != owner_area || CTX_wm_region(C) != owner_region ||
+      !owner_region->runtime->visible || !owner_region->runtime->ipad_canvas ||
+      (owner_region->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_TOO_SMALL | RGN_FLAG_POLL_FAILED))) return false;
+
+  const wmDrawBuffer *buffer = owner_region->runtime->draw_buffer;
+  if (!buffer || buffer->stereo ||
+      buffer->ipad_finger_paint_generation != event->ipad_pencil_paint_generation ||
+      buffer->ipad_finger_paint_screen_uid != screen->id.session_uid ||
+      buffer->ipad_finger_paint_window_id != uint64_t(win->winid) ||
+      buffer->ipad_finger_paint_unknown_widgets ||
+      !wm_ipad_pencil_paint_rcti_equal(buffer->ipad_finger_paint_region, owner_region->winrct)) return false;
+
+  const int origin[2] = {event->ipad_pencil_paint_origin_xy[0],
+                         event->ipad_pencil_paint_origin_xy[1]};
+  const rcti &canvas = owner_region->runtime->ipad_canvas_rect;
+  const int canvas_rect[4] = {owner_region->winrct.xmin + canvas.xmin,
+                              owner_region->winrct.ymin + canvas.ymin,
+                              owner_region->winrct.xmin + canvas.xmax,
+                              owner_region->winrct.ymin + canvas.ymax};
+  if (!wm_ipad_pencil_paint_rect_contains(buffer->ipad_finger_paint_rect, origin) ||
+      origin[0] < canvas_rect[0] || origin[0] > canvas_rect[2] ||
+      origin[1] < canvas_rect[1] || origin[1] > canvas_rect[3]) return false;
+  if (buffer->ipad_finger_paint_navigation_present &&
+      wm_ipad_pencil_paint_rect_contains(buffer->ipad_finger_paint_navigation, origin)) return false;
+  if (wm_ipad_pencil_paint_rcti_equal(buffer->ipad_finger_paint_navigation,
+                                       owner_area->runtime.ipad_navigation_rect) == false) return false;
+
+  IPadFingerPaintOwner current;
+  if (!ED_ipad_finger_paint_capture(C, current) || int(current.values[9]) != mode) return false;
+  for (int i = 0; i <= 12; i++) {
+    if (buffer->ipad_finger_paint_owner_values[i] != current.values[i]) return false;
+  }
+  for (int i : {17, 18}) {
+    if (buffer->ipad_finger_paint_owner_values[i] != current.values[i]) return false;
+  }
+  return std::strcmp(buffer->ipad_finger_paint_owner_tool, current.tool.data()) == 0;
+}
