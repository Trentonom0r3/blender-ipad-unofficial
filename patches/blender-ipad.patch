+static bool ui_ipad_rna_tool_root(bContext *C, const uiIPadRNAReceipt &receipt,
+                                 PointerRNA &root)
+{
+  bToolRef *tool = WM_toolsystem_ref_from_context(C);
+  if (!tool || ui_ipad_rna_address(tool) != receipt.tool_address ||
+      tool->space_type != receipt.tool_space || tool->mode != receipt.tool_mode ||
+      receipt.tool_id != tool->idname || !tool->properties ||
+      tool->properties->type != IDP_GROUP ||
+      ui_ipad_rna_address(tool->properties) != receipt.tool_root_address) return false;
+  IDProperty *group = IDP_GetPropertyFromGroup(tool->properties, tool->idname);
+  if (!group || group->type != IDP_GROUP ||
+      ui_ipad_rna_address(group) != receipt.tool_group_address) return false;
+  IDProperty *subgroup = IDP_GetPropertyFromGroup(group, receipt.subgroup.c_str());
+  if (!subgroup || subgroup->type != IDP_GROUP ||
+      ui_ipad_rna_address(subgroup) != receipt.subgroup_address) return false;
+  StructRNA *type = nullptr;
+  if (receipt.owner == uiIPadRNAOwner::ToolOperator) {
+    wmOperatorType *ot = WM_operatortype_find(receipt.subgroup.c_str(), true);
+    if (ot) type = ot->srna;
+  }
+  else if (receipt.owner == uiIPadRNAOwner::ToolGizmo) {
+    wmGizmoGroupType *gt = WM_gizmogrouptype_find(receipt.subgroup.c_str(), true);
+    if (gt) type = gt->srna;
+  }
+  if (!type || ui_ipad_rna_address(type) != receipt.root_type_address) return false;
+  /* This is find-only. Its native implementation does not validate group
+   * types, so the complete existing hierarchy is checked above first. */
+  return WM_toolsystem_ref_properties_get_ex(tool, receipt.subgroup.c_str(), type, &root) &&
+         root.data == subgroup && root.type == type;
+}
