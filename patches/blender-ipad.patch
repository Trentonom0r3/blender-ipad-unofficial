 {
   if (!(but->flag & UI_HAS_ICON)) {
     return ICON_NONE;
   }

   const bool is_preview = (but->flag & UI_BUT_ICON_PREVIEW) != 0;

   /* While icon is loading, show loading icon at the normal icon size. */
   if (ui_icon_is_preview_deferred_loading(but->icon, is_preview)) {
