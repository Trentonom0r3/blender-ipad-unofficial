+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Runtime-only iPad workspace geometry. No dependency on Blender DNA or editor types. */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <cstddef>
+#include <vector>
+#include <utility>
+
+namespace blender::ed::ipad::panels {
+
+/* Half-open rectangles, origin at the lower left. Convert inclusive Blender rcti
+ * coordinates at the integration boundary, not by changing saved screen vertices. */
+struct Rect {
+  int xmin = 0, ymin = 0, xmax = 0, ymax = 0;
+  int width() const { return std::max(0, xmax - xmin); }
+  int height() const { return std::max(0, ymax - ymin); }
+  bool empty() const { return width() == 0 || height() == 0; }
+};
+
+enum class Role { Content, Service, Canvas, Working };
+enum class Edge { Side, Bottom, Tools };
+
+struct Area {
+  int id;
+  Rect original;
+  Role role = Role::Content;
+};
+
+struct Panel {
+  int id;
+  Edge edge;
+  Rect original;
+};
+
+struct Mapping {
+  int primary_id = -1;
+  std::vector<Panel> panels;
+  std::vector<Area> working;
+};
+
+/* Find the largest editor in the original top content row. Outliner/Properties
+ * are passed as Service; every other editor remains eligible, including node,
+ * image, animation, text and sequence editors. No editor is replaced by VIEW3D. */
+inline Mapping classify(const std::vector<Area> &areas, const int tolerance = 1)
+{
+  Mapping result;
+  const Area *primary = nullptr;
+  int top = 0;
+  bool have_content = false;
+  const Area *canvas = nullptr;
+  auto size = [](const Area &area) {
+    return static_cast<long long>(area.original.width()) * area.original.height();
+  };
+  long long largest_content = 0;
+  for (const Area &area : areas) {
+    if (area.id >= 0 && !area.original.empty() && area.role != Role::Service) {
+      top = have_content ? std::max(top, area.original.ymax) : area.original.ymax;
+      have_content = true;
+      largest_content = std::max(largest_content, size(area));
+      if (area.role == Role::Canvas && (!canvas || size(area) > size(*canvas))) {
+        canvas = &area;
+      }
+    }
+  }
+  /* Tracking/Masking put small graphs above the large footage canvas. A small
+   * clip editor in a custom layout must not displace a larger working editor. */
+  const bool dominant_canvas = canvas && size(*canvas) >= largest_content;
+  if (dominant_canvas) {
+    primary = canvas;
+  }
+  /* A workspace containing only service editors still needs a usable primary. */
+  if (!have_content) {
+    bool have_area = false;
+    for (const Area &area : areas) {
+      if (area.id >= 0 && !area.original.empty()) {
+        top = have_area ? std::max(top, area.original.ymax) : area.original.ymax;
+        have_area = true;
+      }
+    }
+  }
+  for (const Area &area : areas) {
+    if (dominant_canvas || area.id < 0 || area.original.empty() ||
+        (have_content && area.role == Role::Service) ||
+        area.original.ymax < top - std::max(0, tolerance)) {
+      continue;
+    }
+    const auto size = static_cast<long long>(area.original.width()) * area.original.height();
+    const auto previous_size = primary ? static_cast<long long>(primary->original.width()) *
+                                            primary->original.height() :
+                                        -1;
+    if (!primary || size > previous_size ||
+        (size == previous_size && (area.original.xmin < primary->original.xmin ||
+                                  (area.original.xmin == primary->original.xmin &&
+                                   area.id < primary->id)))) {
+      primary = &area;
+    }
+  }
+  if (!primary) {
+    return result;
+  }
+  result.primary_id = primary->id;
+  result.working.push_back(*primary);
+  int row_bottom = primary->original.ymin;
+  if (!dominant_canvas) {
+    /* A full-height Text Editor can share its top row with a shorter viewport.
+     * Lower Console/Info editors belong below that row, not beside the text. */
+    for (const Area &area : areas) {
+      if (area.id >= 0 && !area.original.empty() && area.role != Role::Service &&
+          area.original.ymax >= top - std::max(0, tolerance))
+      {
+        row_bottom = std::max(row_bottom, area.original.ymin);
+      }
+    }
+  }
+  for (const Area &area : areas) {
+    if (area.id < 0 || area.id == primary->id || area.original.empty()) {
+      continue;
+    }
+    const bool overlaps_x = area.original.xmax > primary->original.xmin &&
+                            area.original.xmin < primary->original.xmax;
+    const bool below = area.original.ymax <= row_bottom + std::max(0, tolerance);
+    if (area.role == Role::Working || (!below && area.role != Role::Service)) {
+      result.working.push_back(area);
+      continue;
+    }
+    result.panels.push_back(
+        {area.id, below && (area.role != Role::Service || overlaps_x) ? Edge::Bottom : Edge::Side,
+         area.original});
+  }
+  /* Match spatial reading order rather than storage order: upper side editors
+   * first; bottom editors left-to-right, then upper-to-lower. */
+  std::stable_sort(result.panels.begin(), result.panels.end(), [](const Panel &a, const Panel &b) {
+    if (a.edge != b.edge) {
+      return a.edge == Edge::Side;
+    }
+    if (a.edge == Edge::Bottom && a.original.xmin != b.original.xmin) {
+      return a.original.xmin < b.original.xmin;
+    }
+    if (a.original.ymax != b.original.ymax) {
+      return a.original.ymax > b.original.ymax;
+    }
+    return a.id < b.id;
+  });
+  return result;
+}
+
+/* A displayed seam retains the saved-coordinate mapping of its recursive node.
+ * IDs describe the partition, so capture can reject topology changes on redraw. */
+struct WorkingSeam {
+  bool vertical;
+  int coordinate;
+  Rect saved_bounds;
+  Rect display_bounds;
+  Rect line;
+  std::vector<int> before, after;
+};
+
+/* Fallback nodes are distinct from recursive cuts. Their shared-vertex mapping
+ * uses saved_bounds.width()/height() - 1, unlike recursive WorkingSeam mapping. */
+struct WorkingFallback {
+  Rect saved_bounds, display_bounds;
+  std::vector<int> members;
+};
+
+/* Reconstruct working splits from saved geometry after auxiliary editors move
+ * into panels. Recursively preserve full-span cuts and their relative proportions.
+ * A shorter editor next to a full-height editor grows into the space vacated below
+ * it; editor identity and saved vertices remain untouched. */
+inline std::vector<Area> working_layout(const std::vector<Area> &areas, const Rect bounds,
+                                       const int gap = 4,
+                                       std::vector<WorkingSeam> *seams = nullptr,
+                                       std::vector<WorkingFallback> *fallbacks = nullptr)
+{
+  if (areas.empty() || bounds.empty()) {
+    return {};
+  }
+  if (areas.size() == 1) {
+    return {{areas.front().id, bounds, areas.front().role}};
+  }
+  Rect original = areas.front().original;
+  for (const Area &area : areas) {
+    original.xmin = std::min(original.xmin, area.original.xmin);
+    original.xmax = std::max(original.xmax, area.original.xmax);
+    original.ymin = std::min(original.ymin, area.original.ymin);
+    original.ymax = std::max(original.ymax, area.original.ymax);
+  }
+  for (const bool vertical : {true, false}) {
+    std::vector<int> candidates;
+    for (const Area &area : areas) {
+      candidates.push_back(vertical ? area.original.xmax : area.original.ymax);
+    }
+    std::sort(candidates.begin(), candidates.end());
+    for (const int cut : candidates) {
+      std::vector<Area> before, after;
+      bool crosses = false;
+      for (const Area &area : areas) {
+        const int lo = vertical ? area.original.xmin : area.original.ymin;
+        const int hi = vertical ? area.original.xmax : area.original.ymax;
+        if (hi <= cut) {
+          before.push_back(area);
+        }
+        else if (lo >= cut - 1) { /* Blender areas share inclusive border vertices. */
+          after.push_back(area);
+        }
+        else {
+          crosses = true;
+          break;
+        }
+      }
+      if (crosses || before.empty() || after.empty()) {
+        continue;
+      }
+      const int low = vertical ? original.xmin : original.ymin;
+      const int extent = vertical ? original.width() : original.height();
+      const int available = vertical ? bounds.width() : bounds.height();
+      const int seam = std::min(std::max(0, gap), available / 8);
+      const int split = std::clamp(int(static_cast<long long>(cut - low) * available /
+                                       std::max(1, extent)),
+                                    std::min(1, available / 2),
+                                    std::max(0, available - seam - 1));
+      Rect first = bounds, second = bounds;
+      if (vertical) {
+        first.xmax = bounds.xmin + split;
+        second.xmin = first.xmax + seam;
+      }
+      else {
+        first.ymax = bounds.ymin + split;
+        second.ymin = first.ymax + seam;
+      }
+      if (seams) {
+        WorkingSeam info{vertical, cut - 1, original, bounds,
+                         vertical ? Rect{first.xmax, bounds.ymin, second.xmin, bounds.ymax} :
+                                    Rect{bounds.xmin, first.ymax, bounds.xmax, second.ymin}, {}, {}};
+        for (const Area &area : before) { info.before.push_back(area.id); }
+        for (const Area &area : after) { info.after.push_back(area.id); }
+        std::sort(info.before.begin(), info.before.end());
+        std::sort(info.after.begin(), info.after.end());
+        seams->push_back(std::move(info));
+      }
+      auto result = working_layout(before, first, gap, seams, fallbacks);
+      const auto next = working_layout(after, second, gap, seams, fallbacks);
+      result.insert(result.end(), next.begin(), next.end());
+      return result;
+    }
+  }
+  /* Non-slicing layouts retain saved vertex proportions. Area maxima include
+   * the shared border pixel; scale the vertex itself so both neighbors use one
+   * display boundary, then leave a gap without moving either outside its cell. */
+  std::vector<Area> result;
+  if (fallbacks) {
+    WorkingFallback node{original, bounds, {}};
+    for (const Area &area : areas) { node.members.push_back(area.id); }
+    std::sort(node.members.begin(), node.members.end());
+    fallbacks->push_back(std::move(node));
+  }
+  const int inset_low = std::max(0, gap) / 2;
+  const int inset_high = std::max(0, gap) - inset_low;
+  for (const Area &area : areas) {
+    auto x = [&](int v) { return bounds.xmin + int(static_cast<long long>(v - original.xmin) *
+                                                 bounds.width() / std::max(1, original.width() - 1)); };
+    auto y = [&](int v) { return bounds.ymin + int(static_cast<long long>(v - original.ymin) *
+                                                 bounds.height() / std::max(1, original.height() - 1)); };
+    Rect cell{x(area.original.xmin), y(area.original.ymin),
+              x(area.original.xmax - 1), y(area.original.ymax - 1)};
+    auto inset = [&](int &lo, int &hi, const bool internal_low, const bool internal_high) {
+      /* Preserve at least one pixel where the raw cell has one. Never expand
+       * collapsed cells or cross a neighboring cell's shared boundary. */
+      int available = std::max(0, hi - lo - 1);
+      const int low = internal_low ? std::min(inset_high, available / 2) : 0;
+      lo += low;
+      available -= low;
+      hi -= internal_high ? std::min(inset_low, available) : 0;
+    };
+    inset(cell.xmin, cell.xmax, area.original.xmin != original.xmin,
+          area.original.xmax != original.xmax);
+    inset(cell.ymin, cell.ymax, area.original.ymin != original.ymin,
+          area.original.ymax != original.ymax);
+    result.push_back({area.id, cell, area.role});
+  }
+  return result;
+}
+
+
+/* Local adjacency describes two faces, not a full-span recursive partition.
+ * Native integration must bind the exact edge/connected vertices separately;
+ * disconnected collinear segments must never be merged by coordinate alone. */
+struct WorkingAdjacency {
+  bool vertical;
+  int before_id, after_id; /* Left/right or bottom/top editor IDs. */
+  int coordinate, saved_min, saved_max; /* Native vertex coordinates, max inclusive. */
+  Rect line; /* Displayed gap restricted to the two visible faces' overlap. */
+  WorkingFallback node;
+};
+
+inline std::vector<WorkingAdjacency> working_adjacencies(
+    const std::vector<Area> &saved, const std::vector<Area> &displayed,
+    const std::vector<WorkingFallback> &fallbacks)
+{
+  std::vector<WorkingAdjacency> result;
+  auto find = [](const std::vector<Area> &areas, const int id) -> const Area * {
+    const auto found = std::find_if(areas.begin(), areas.end(),
+                                     [&](const Area &area) { return area.id == id; });
+    return found == areas.end() ? nullptr : &*found;
+  };
+  for (const WorkingFallback &node : fallbacks) {
+    for (std::size_t i = 0; i < node.members.size(); ++i) {
+      for (std::size_t j = i + 1; j < node.members.size(); ++j) {
+        const Area *a = find(saved, node.members[i]), *b = find(saved, node.members[j]);
+        if (!a || !b || a->id == b->id || a->original.empty() || b->original.empty()) {
+          continue;
+        }
+        for (const bool vertical : {true, false}) {
+          const Area *before = a, *after = b;
+          auto low = [&](const Area *area) {
+            return vertical ? area->original.xmin : area->original.ymin;
+          };
+          auto high = [&](const Area *area) {
+            return (vertical ? area->original.xmax : area->original.ymax) - 1;
+          };
+          if (high(before) != low(after)) { std::swap(before, after); }
+          if (high(before) != low(after)) { continue; }
+          const Rect &s = before->original, &t = after->original;
+          const int saved_min = std::max(vertical ? s.ymin : s.xmin,
+                                         vertical ? t.ymin : t.xmin);
+          const int saved_max = std::min(vertical ? s.ymax : s.xmax,
+                                         vertical ? t.ymax : t.xmax) - 1;
+          if (saved_min >= saved_max) { continue; } /* Corner contact is not an edge. */
+          const Area *display_before = find(displayed, before->id);
+          const Area *display_after = find(displayed, after->id);
+          if (!display_before || !display_after || display_before->original.empty() ||
+              display_after->original.empty()) { continue; }
+          const Rect &u = display_before->original, &v = display_after->original;
+          const int along_min = std::max(vertical ? u.ymin : u.xmin,
+                                         vertical ? v.ymin : v.xmin);
+          const int along_max = std::min(vertical ? u.ymax : u.xmax,
+                                         vertical ? v.ymax : v.xmax);
+          const int cross_min = vertical ? u.xmax : u.ymax;
+          const int cross_max = vertical ? v.xmin : v.ymin;
+          if (along_min >= along_max || cross_min > cross_max) { continue; }
+          const Rect line = vertical ? Rect{cross_min, along_min, cross_max, along_max} :
+                                       Rect{along_min, cross_min, along_max, cross_max};
+          result.push_back({vertical, before->id, after->id, high(before),
+                            saved_min, saved_max, line, node});
+        }
+      }
+    }
+  }
+  return result;
+}
+
+/* Prefer the center, then search both directions along the seam. Every candidate
+ * shares the same rectangle for drawing, pointer hit testing and touch capture. */
+inline Rect seam_handle_rect(const WorkingSeam &seam, const Rect bounds,
+                              const std::vector<Rect> &occluders, const int requested_extent)
+{
+  const int extent = std::max(1, requested_extent);
+  const int low = seam.vertical ? seam.line.ymin : seam.line.xmin;
+  const int high = seam.vertical ? seam.line.ymax : seam.line.xmax;
+  for (int step = 0; step <= 2 * std::max(0, high - low) / extent; ++step) {
+    const int along = (low + high) / 2 + ((step + 1) / 2) * extent * (step % 2 ? -1 : 1);
+    if (along - extent / 2 < low || along + extent - extent / 2 > high) { continue; }
+    const int cross = seam.vertical ? (seam.line.xmin + seam.line.xmax) / 2 : seam.line.ymax;
+    const Rect handle = seam.vertical ? Rect{cross - extent / 2, along - extent / 2,
+                                              cross + extent - extent / 2, along + extent - extent / 2} :
+                                         Rect{along - extent / 2, cross,
+                                              along + extent - extent / 2, cross + extent};
+    if (handle.xmin < bounds.xmin || handle.ymin < bounds.ymin ||
+        handle.xmax > bounds.xmax || handle.ymax > bounds.ymax) { continue; }
+    const bool blocked = std::any_of(occluders.begin(), occluders.end(), [&](const Rect &r) {
+      return !r.empty() && handle.xmin < r.xmax && r.xmin < handle.xmax &&
+                          handle.ymin < r.ymax && r.ymin < handle.ymax;
+    });
+    if (!blocked) { return handle; }
+  }
+  return {};
+}
+
+/* Saved topology uses native shared inclusive vertices; do not substitute the
+ * adapted WINDOW rectangles for these coordinates or constraints. */
+struct SeamVertex {
+  int x, y;
+};
+struct SeamEdge {
+  std::size_t a, b;
+};
+struct SeamFace {
+  /* Native corner order: bottom-left, top-left, top-right, bottom-right. */
+  std::array<std::size_t, 4> vertices;
+  /* Adapter-supplied native minima can include per-area interior border padding. */
+  int minimum_width = 0, minimum_height = 0;
+};
+
+inline std::vector<bool> seam_connected_vertices(const std::vector<SeamVertex> &vertices,
+                                                  const std::vector<SeamEdge> &edges,
+                                                  const std::size_t seed,
+                                                  const bool vertical)
+{
+  if (seed >= edges.size()) {
+    return {};
+  }
+  for (const SeamEdge &edge : edges) {
+    if (edge.a >= vertices.size() || edge.b >= vertices.size()) {
+      return {};
+    }
+  }
+  auto coordinate = [&](std::size_t v) { return vertical ? vertices[v].x : vertices[v].y; };
+  const int line = coordinate(edges[seed].a);
+  if (line != coordinate(edges[seed].b) ||
+      (vertices[edges[seed].a].x == vertices[edges[seed].b].x &&
+       vertices[edges[seed].a].y == vertices[edges[seed].b].y)) {
+    return {};
+  }
+  std::vector<bool> selected(vertices.size(), false);
+  selected[edges[seed].a] = selected[edges[seed].b] = true;
+  bool changed;
+  do {
+    changed = false;
+    for (const SeamEdge &edge : edges) {
+      if (coordinate(edge.a) == line && coordinate(edge.b) == line &&
+          selected[edge.a] != selected[edge.b])
+      {
+        selected[edge.a] = selected[edge.b] = true;
+        changed = true;
+      }
+    }
+  } while (changed);
+  return selected;
+}
+
+struct SeamLimits {
+  int minimum = 0, maximum = 0;
+  bool valid = false;
+};
+
+/* Intersect native size constraints for ALL faces, including hidden auxiliary
+ * editors connected to the moved edge. Minima are vertex distances (inclusive
+ * area dimension minus one); callers supply border-aware per-face minima.
+ * Existing undersized faces may grow but
+ * must not shrink further. No selection flags or saved vertices are modified. */
+inline SeamLimits seam_saved_limits(const std::vector<SeamVertex> &vertices,
+                                    const std::vector<SeamFace> &faces,
+                                    const std::vector<bool> &selected,
+                                    const bool vertical,
+                                    const int minimum_width,
+                                    const int minimum_height)
+{
+  SeamLimits limits{std::numeric_limits<int>::min(), std::numeric_limits<int>::max(), false};
+  if (vertices.empty() || faces.empty() || selected.size() != vertices.size() ||
+      std::none_of(selected.begin(), selected.end(), [](bool v) { return v; })) {
+    return {};
+  }
+  int outer_min = std::numeric_limits<int>::max();
+  int outer_max = std::numeric_limits<int>::min();
+  for (const SeamVertex &v : vertices) {
+    if (v.x < std::numeric_limits<short>::min() || v.x > std::numeric_limits<short>::max() ||
+        v.y < std::numeric_limits<short>::min() || v.y > std::numeric_limits<short>::max()) {
+      return {};
+    }
+    const int coordinate = vertical ? v.x : v.y;
+    outer_min = std::min(outer_min, coordinate);
+    outer_max = std::max(outer_max, coordinate);
+  }
+  for (std::size_t i = 0; i < vertices.size(); ++i) {
+    if (!selected[i]) { continue; }
+    const int coordinate = vertical ? vertices[i].x : vertices[i].y;
+    if (coordinate <= outer_min || coordinate >= outer_max) {
+      return {}; /* The outer window border is never an internal resize seam. */
+    }
+    limits.minimum = std::max(limits.minimum, int(std::numeric_limits<short>::min()) - coordinate);
+    limits.maximum = std::min(limits.maximum, int(std::numeric_limits<short>::max()) - coordinate);
+  }
+  for (const SeamFace &face : faces) {
+    for (const std::size_t i : face.vertices) {
+      if (i >= vertices.size()) { return {}; }
+    }
+    const auto [a, b, c, d] = face.vertices;
+    const SeamVertex &v1 = vertices[a], &v2 = vertices[b], &v3 = vertices[c], &v4 = vertices[d];
+    if (v1.x != v2.x || v2.y != v3.y || v3.x != v4.x || v4.y != v1.y ||
+        v4.x <= v1.x || v2.y <= v1.y) {
+      return {};
+    }
+    const bool low = selected[a];
+    const bool high = selected[c];
+    if (vertical ? (low != selected[b] || high != selected[d]) :
+                   (low != selected[d] || high != selected[b])) {
+      return {}; /* Reject a partial edge that would turn a rectangle into a trapezoid. */
+    }
+    const int size = vertical ? v4.x - v1.x : v2.y - v1.y;
+    const int required = std::min(size, std::max({1, vertical ? minimum_width : minimum_height,
+                                                  vertical ? face.minimum_width : face.minimum_height}));
+    if (low && !high) {
+      limits.maximum = std::min(limits.maximum, size - required);
+    }
+    else if (!low && high) {
+      limits.minimum = std::max(limits.minimum, required - size);
+    }
+  }
+  limits.valid = limits.minimum <= 0 && limits.maximum >= 0;
+  return limits;
+}
+
+/* Convert from the gesture-start recursive node mapping. Recomputing this scale
+ * from each already-moved layout would compound rounding and cause drag drift. */
+inline int seam_saved_delta(const WorkingSeam &seam, const int display_delta)
+{
+  const int saved = seam.vertical ? seam.saved_bounds.width() : seam.saved_bounds.height();
+  const int displayed = seam.vertical ? seam.display_bounds.width() : seam.display_bounds.height();
+  if (saved <= 0 || displayed <= 0) { return 0; }
+  const long long numerator = static_cast<long long>(display_delta) * saved;
+  const long long rounded = (numerator + (numerator < 0 ? -displayed / 2 : displayed / 2)) / displayed;
+  return int(std::clamp(rounded, static_cast<long long>(std::numeric_limits<int>::min()),
+                                static_cast<long long>(std::numeric_limits<int>::max())));
+}
+
+/* Display constraints complement saved topology constraints. Compare by editor
+ * identity, permit already-small windows, and reject overlap/editor loss. */
+inline bool seam_display_valid(const std::vector<Area> &original,
+                                const std::vector<Area> &candidate,
+                                const Rect bounds, const int minimum_width,
+                                const int minimum_height)
+{
+  if (original.empty() || original.size() != candidate.size()) { return false; }
+  std::vector<int> ids;
+  for (std::size_t i = 0; i < candidate.size(); ++i) {
+    const Area &area = candidate[i];
+    if (std::find(ids.begin(), ids.end(), area.id) != ids.end()) { return false; }
+    ids.push_back(area.id);
+    const auto old = std::find_if(original.begin(), original.end(),
+                                  [&](const Area &v) { return v.id == area.id; });
+    const Rect &r = area.original;
+    if (old == original.end() || r.empty() || r.xmin < bounds.xmin || r.ymin < bounds.ymin ||
+        r.xmax > bounds.xmax || r.ymax > bounds.ymax ||
+        r.width() < std::min(old->original.width(), std::max(1, minimum_width)) ||
+        r.height() < std::min(old->original.height(), std::max(1, minimum_height))) {
+      return false;
+    }
+    for (std::size_t j = 0; j < i; ++j) {
+      const Rect &other = candidate[j].original;
+      if (r.xmin < other.xmax && other.xmin < r.xmax &&
+          r.ymin < other.ymax && other.ymin < r.ymax) { return false; }
+    }
+  }
+  return true;
+}
+
+struct Slot {
+  int active_id = -1;
+  bool locked = false;
+  bool open() const { return active_id >= 0; }
+};
+
+enum class TapResult { Opened, Switched, Closed, Locked, Invalid };
+
+/* One instance per runtime workspace/screen. Never serialize this into screen
+ * area coordinates. The adapter assigns nonnegative IDs to editor and region tabs. */
+struct State {
+  Slot side;
+  Slot bottom;
+  Slot tools;
+  bool panels_locked = false;
+  /* Zero means automatic maximum useful size; positive values remember an
+   * explicit user resize. Passive relayout never replaces this preference. */
+  int side_width = 0;
+  int bottom_height = 0;
+  int side_height = 0; /* Zero retains the available full-height default. */
+  int bottom_width = 0; /* Zero retains the available full-width default. */
+
+  Slot &slot(const Edge edge) { return edge == Edge::Side ? side : edge == Edge::Bottom ? bottom : tools; }
+  const Slot &slot(const Edge edge) const { return edge == Edge::Side ? side : edge == Edge::Bottom ? bottom : tools; }
+
+  TapResult tap(const Edge edge, const int id)
+  {
+    if (id < 0) {
+      return TapResult::Invalid;
+    }
+    Slot &target = slot(edge);
+    if (target.active_id == id && (panels_locked || target.locked)) {
+      return TapResult::Locked;
+    }
+    if (target.active_id == id) {
+      target = {};
+      return TapResult::Closed;
+    }
+    const bool was_open = target.open();
+    const bool area_locked = was_open && target.locked;
+    target = {id, area_locked};
+    return was_open ? TapResult::Switched : TapResult::Opened;
+  }
+
+  void toggle_panels_lock() { panels_locked = !panels_locked; }
+
+  bool toggle_lock(const Edge edge)
+  {
+    Slot &target = slot(edge);
+    if (!target.open()) {
+      return false;
+    }
+    target.locked = !target.locked;
+    return true;
+  }
+
+  bool dismiss(const Edge edge)
+  {
+    Slot &target = slot(edge);
+    if (!target.open() || panels_locked || target.locked) {
+      return false;
+    }
+    target = {};
+    return true;
+  }
+
+  /* Use when an editor was removed or its placement changed. Include region
+   * tabs in available_tabs so reconciliation preserves an open Item/Tool/View. */
+  void reconcile(const std::vector<Panel> &available_tabs)
+  {
+    for (const Edge edge : {Edge::Side, Edge::Bottom, Edge::Tools}) {
+      Slot &target = slot(edge);
+      const bool exists = std::any_of(available_tabs.begin(), available_tabs.end(),
+                                      [&](const Panel &panel) {
+                                        return panel.id == target.active_id && panel.edge == edge;
+                                      });
+      if (!exists) {
+        target = {};
+      }
+    }
+  }
+};
+
+/* Sculpt's shipped startup shelf is hidden. iPad's first-use default opens it,
+ * but only after its native poll succeeds and never over a chosen bottom editor. */
+inline bool open_default_sculpt_shelf(State &state, const bool sculpt,
+                                       const bool initialized, const bool eligible, const int id)
+{
+  if (!sculpt || initialized || !eligible || state.bottom.open() || id < 0) {
+    return false;
+  }
+  state.bottom.active_id = id;
+  return true;
+}
+
+struct Metrics {
+  int inset = 8;
+  int gap = 8;
+  int side_rail_extent = 44;
+  int minimum_side_rail_extent = 28;
+  int tools_width = 48;
+  bool left_rail = true;
+  int bottom_rail_extent = 0;
+  int resize_extent = 24;
+  int corner_extent = 44;
+  int minimum_canvas_width = 160;
+  int minimum_canvas_height = 120;
+  int minimum_side_width = 160;
+  int minimum_side_height = 120;
+  int minimum_bottom_width = 320;
+  int minimum_bottom_height = 120;
+  int automatic_side_percent = 45;
+  int automatic_bottom_percent = 55;
+  bool side_rail = true;
+  /* Bottom launchers normally live in the native status bar outside bounds.
+   * This opt-in remains useful for non-status-bar hosts and geometry tests. */
+  bool bottom_rail = false;
+};
+
+struct Layout {
+  Rect bounds;
+  Rect canvas;
+  Rect side_rail;
+  Rect left_rail;
+  Rect tools_panel;
+  Rect bottom_rail;
+  Rect side_panel;
+  Rect bottom_panel;
+  Rect side_resize;
+  Rect bottom_resize;
+  Rect side_corner;
+  Rect bottom_corner;
+};
+
+inline int fit_dimension(const int requested, const int minimum, const int maximum)
+{
+  return std::clamp(requested, std::min(std::max(0, minimum), std::max(0, maximum)),
+                    std::max(0, maximum));
+}
+
+/* The caller excludes OS safe areas and mandatory global/header chrome from
+ * bounds. All metrics and bounds use the same units (usually UI-scaled pixels).
+ * The editor may render behind panels; canvas identifies its unobstructed area. */
+inline Layout layout(const Rect bounds, const State &state, const Metrics &metrics = {})
+{
+  Layout result;
+  result.bounds = bounds;
+  if (bounds.empty()) {
+    return result;
+  }
+  const int inset_x = std::min(std::max(0, metrics.inset), bounds.width() / 8);
+  const int inset_y = std::min(std::max(0, metrics.inset), bounds.height() / 8);
+  const Rect interior{bounds.xmin + inset_x, bounds.ymin + inset_y,
+                      bounds.xmax - inset_x, bounds.ymax - inset_y};
+  const int rail_limit = std::max(0, metrics.side_rail_extent);
+  const int rail_floor = std::clamp(metrics.minimum_side_rail_extent, 0, rail_limit);
+  const int side_rail_width = metrics.side_rail ?
+                                  std::min(std::clamp(interior.width() / 16, rail_floor, rail_limit),
+                                           interior.width() / 4) :
+                                  0;
+  const int bottom_rail_height = metrics.bottom_rail ?
+                                     std::min(std::max(0, metrics.bottom_rail_extent), interior.height() / 4) :
+                                     0;
+  const int gap_x = std::min(std::max(0, metrics.gap), interior.width() / 16);
+  const int gap_y = std::min(std::max(0, metrics.gap), interior.height() / 16);
+  const int content_right = interior.xmax - side_rail_width - (side_rail_width ? gap_x : 0);
+  const int content_bottom = interior.ymin + bottom_rail_height + (bottom_rail_height ? gap_y : 0);
+  const int left_width = metrics.left_rail ? side_rail_width : 0;
+  const int left = interior.xmin + left_width + (left_width ? gap_x : 0);
+  if (left_width) {
+    result.left_rail = {interior.xmin, content_bottom, interior.xmin + left_width, interior.ymax};
+  }
+  const int tools_width = state.tools.open() ?
+                              std::min(std::max(0, metrics.tools_width),
+                                       std::max(0, content_right - left) / 4) : 0;
+  if (tools_width) {
+    result.tools_panel = {left, content_bottom, left + tools_width, interior.ymax};
+  }
+  const Rect content{left + tools_width + (tools_width ? gap_x : 0),
+                      content_bottom, content_right, interior.ymax};
+  if (side_rail_width) {
+    result.side_rail = {interior.xmax - side_rail_width, content_bottom,
+                        interior.xmax, interior.ymax};
+  }
+  if (bottom_rail_height) {
+    result.bottom_rail = {interior.xmin, interior.ymin,
+                          content_right, interior.ymin + bottom_rail_height};
+  }
+  const int canvas_reserve_x = std::min(std::max(0, metrics.minimum_canvas_width), content.width() / 2);
+  const int canvas_reserve_y = std::min(std::max(0, metrics.minimum_canvas_height), content.height() / 2);
+  const int bottom_reserve_x = state.bottom.open() ?
+                                   std::min(std::max(0, metrics.minimum_bottom_width), content.width() / 2) :
+                                   0;
+  const int width_limit = std::max(0, content.width() -
+                                      std::max(canvas_reserve_x, bottom_reserve_x) - gap_x);
+  const int height_limit = std::max(0, content.height() - canvas_reserve_y - gap_y);
+  const int requested_side = state.side_width > 0 ? state.side_width :
+                             int(static_cast<long long>(content.width()) *
+                                 std::clamp(metrics.automatic_side_percent, 1, 90) / 100);
+  const int requested_bottom = state.bottom_height > 0 ? state.bottom_height :
+                               int(static_cast<long long>(content.height()) *
+                                   std::clamp(metrics.automatic_bottom_percent, 1, 90) / 100);
+  const int side_width = state.side.open() ?
+                             fit_dimension(requested_side, metrics.minimum_side_width, width_limit) :
+                             0;
+  const int bottom_height = state.bottom.open() ?
+                                fit_dimension(requested_bottom, metrics.minimum_bottom_height, height_limit) :
+                                0;
+  const int canvas_right = content.xmax - side_width - (side_width ? gap_x : 0);
+  const int canvas_bottom = content.ymin + bottom_height + (bottom_height ? gap_y : 0);
+  result.canvas = {content.xmin, canvas_bottom, canvas_right, content.ymax};
+  if (side_width) {
+    const int side_height = fit_dimension(state.side_height > 0 ? state.side_height : content.height(),
+                                           metrics.minimum_side_height, content.height());
+    result.side_panel = {content.xmax - side_width, content.ymax - side_height,
+                          content.xmax, content.ymax};
+    result.side_resize = {result.side_panel.xmin, result.side_panel.ymin,
+                          result.side_panel.xmin + std::min(std::max(0, metrics.resize_extent), side_width),
+                          result.side_panel.ymax};
+  }
+  if (bottom_height) {
+    const int bottom_width = fit_dimension(state.bottom_width > 0 ? state.bottom_width :
+                                                                    canvas_right - content.xmin,
+                                             metrics.minimum_bottom_width,
+                                             canvas_right - content.xmin);
+    result.bottom_panel = {content.xmin, content.ymin, content.xmin + bottom_width,
+                            content.ymin + bottom_height};
+    result.bottom_resize = {result.bottom_panel.xmin,
+                            result.bottom_panel.ymax - std::min(std::max(0, metrics.resize_extent), bottom_height),
+                            result.bottom_panel.xmax, result.bottom_panel.ymax};
+  }
+  const int corner_extent = std::max(0, metrics.corner_extent);
+  if (!result.side_panel.empty() && corner_extent) {
+    const Rect &r = result.side_panel;
+    result.side_corner = {r.xmin, r.ymin, r.xmin + std::min(corner_extent, r.width()),
+                           r.ymin + std::min(corner_extent, r.height())};
+  }
+  if (!result.bottom_panel.empty() && corner_extent) {
+    const Rect &r = result.bottom_panel;
+    result.bottom_corner = {r.xmax - std::min(corner_extent, r.width()),
+                             r.ymax - std::min(corner_extent, r.height()), r.xmax, r.ymax};
+  }
+  return result;
+}
+
+/* Use the actual clamped handle, including windows smaller than its preferred
+ * extent. Content must never invert or intrude into the chrome hit rectangle. */
+inline Rect panel_content(const Layout &layout, const Edge edge)
+{
+  if (edge == Edge::Tools) {
+    return layout.tools_panel;
+  }
+  Rect result = edge == Edge::Side ? layout.side_panel : layout.bottom_panel;
+  if (edge == Edge::Side) {
+    result.xmin = std::clamp(layout.side_resize.xmax, result.xmin, result.xmax);
+    /* Keep the primary strip narrow; the wider diagonal grip gets a bottom row.
+     * Native content is rectangular and must exclude its complete footprint. */
+    if (!layout.side_corner.empty() && layout.side_corner.xmax > result.xmin) {
+      result.ymin = std::clamp(layout.side_corner.ymax, result.ymin, result.ymax);
+    }
+  }
+  else {
+    result.ymax = std::clamp(layout.bottom_resize.ymin, result.ymin, result.ymax);
+    if (!layout.bottom_corner.empty() && layout.bottom_corner.ymin < result.ymax) {
+      result.xmax = std::clamp(layout.bottom_corner.xmin, result.xmin, result.xmax);
+    }
+  }
+  return result;
+}
+
+struct ShelfRegions {
+  Rect header;
+  Rect body;
+};
+
+inline ShelfRegions shelf_regions(const Rect content, const int preferred_header_height)
+{
+  if (content.empty()) {
+    return {};
+  }
+  const int height = std::clamp(preferred_header_height, 0, content.height());
+  ShelfRegions result{content, content};
+  /* The native bottom shelf has its category header above its assets. */
+  result.header.ymin = content.ymax - height;
+  result.body.ymax = result.header.ymin;
+  return result;
+}
+
+/* Record the actual clamped result of a user drag. Passive layout/rotation never
+ * mutates preferred dimensions, so returning to a large window restores them.
+ * This operation is independent of which tab is active or locked. */
+inline void resize(State &state, const Edge edge, const int requested,
+                   const Rect bounds, const Metrics &metrics = {})
+{
+  if (bounds.empty()) {
+    return;
+  }
+  State probe = state;
+  if (edge == Edge::Side) {
+    probe.side.active_id = 0;
+    /* Zero is an automatic-layout sentinel, never the result of a drag. */
+    probe.side_width = std::max(1, requested);
+    state.side_width = layout(bounds, probe, metrics).side_panel.width();
+  }
+  else {
+    probe.bottom.active_id = 0;
+    probe.bottom_height = std::max(1, requested);
+    state.bottom_height = layout(bounds, probe, metrics).bottom_panel.height();
+  }
+}
+
+/* A user diagonal drag records both fitted dimensions atomically. Passive layout
+ * never changes preferences, including the zero full-extent defaults. */
+inline void resize_2d(State &state, const Edge edge, const int requested_width,
+                       const int requested_height, const Rect bounds, const Metrics &metrics = {})
+{
+  if (bounds.empty() || edge == Edge::Tools) { return; }
+  State probe = state;
+  if (edge == Edge::Side) {
+    probe.side.active_id = 0;
+    probe.side_width = std::max(1, requested_width);
+    probe.side_height = std::max(1, requested_height);
+    const Rect fitted = layout(bounds, probe, metrics).side_panel;
+    state.side_width = fitted.width();
+    state.side_height = fitted.height();
+  }
+  else {
+    probe.bottom.active_id = 0;
+    probe.bottom_width = std::max(1, requested_width);
+    probe.bottom_height = std::max(1, requested_height);
+    const Rect fitted = layout(bounds, probe, metrics).bottom_panel;
+    state.bottom_width = fitted.width();
+    state.bottom_height = fitted.height();
+  }
+}
+
+struct RailPage {
+  std::size_t first = 0;
+  std::size_t count = 0;
+  std::size_t page = 0;
+  std::size_t pages = 0;
+  int button_extent = 0;
+  int gap = 0;
+  bool paged = false;
+  bool previous = false;
+  bool next = false;
+};
+
+/* Overflow never collapses the rail. Reserve previous/next buttons only when
+ * needed. On extremely short windows, shrink all three targets equally rather
+ * than making a selected tab or a paging control unreachable. */
+inline RailPage rail_page(const std::size_t total, const int extent,
+                          const std::size_t requested_page = 0,
+                          const int desired_button = 44, const int desired_gap = 6)
+{
+  RailPage result;
+  if (total == 0 || extent <= 0) {
+    return result;
+  }
+  result.button_extent = std::min(std::max(1, desired_button), extent);
+  result.gap = std::min(std::max(0, desired_gap), extent / 8);
+  const auto capacity = static_cast<std::size_t>(
+      std::max(1, (extent + result.gap) / (result.button_extent + result.gap)));
+  if (total <= capacity) {
+    result.count = total;
+    result.pages = 1;
+    return result;
+  }
+  result.paged = true;
+  result.gap = std::min(result.gap, extent / 8);
+  result.button_extent = std::min(result.button_extent, std::max(1, (extent - 2 * result.gap) / 3));
+  const int body_extent = std::max(0, extent - 2 * (result.button_extent + result.gap));
+  const auto body_capacity = static_cast<std::size_t>(
+      std::max(1, (body_extent + result.gap) / (result.button_extent + result.gap)));
+  result.pages = 1 + (total - 1) / body_capacity;
+  result.page = std::min(requested_page, result.pages - 1);
+  result.first = result.page * body_capacity;
+  result.count = std::min(body_capacity, total - result.first);
+  result.previous = result.page > 0;
+  result.next = result.page + 1 < result.pages;
+  return result;
+}
+
+
+/* Editor-local editing shelf. Coordinates share the exposed canvas with the
+ * native panel compositor; no saved screen vertices or editor sizes change. */
+inline Rect editing_shelf(const Rect &canvas, const Rect &navigation, const float scale,
+                          const bool expanded = true)
+{
+  const int margin = std::max(1, int(12 * scale));
+  const int padding = std::max(1, int(8 * scale));
+  const int width = std::min(int((expanded ? 736 : 336) * scale), canvas.width() - 2 * margin);
+  if (width < int(208 * scale)) {
+    return {};
+  }
+  const int inner_width = width - 2 * padding;
+  /* Python uses the same thresholds. Compact wraps history together; the
+   * optional full shelf includes an explicit Collapse cell without shrinking. */
+  const int height = int((expanded ? (inner_width >= 560 * scale ? 176 :
+                                      inner_width < 308 * scale ? 220 : 268) :
+                                    (inner_width >= 264 * scale ? 120 : 164)) * scale);
+  if (canvas.height() < height + 2 * margin + int(80 * scale)) {
+    return {};
+  }
+  Rect shelf{canvas.xmin + (canvas.width() - width) / 2, canvas.ymin + margin,
+             canvas.xmin + (canvas.width() + width) / 2, canvas.ymin + margin + height};
+  const auto overlaps = [](const Rect &a, const Rect &b) {
+    return !a.empty() && !b.empty() && a.xmin < b.xmax && a.xmax > b.xmin &&
+           a.ymin < b.ymax && a.ymax > b.ymin;
+  };
+  if (overlaps(shelf, navigation)) {
+    shelf.xmax = navigation.xmin - margin;
+    shelf.xmin = shelf.xmax - width;
+    if (shelf.xmin < canvas.xmin + margin || overlaps(shelf, navigation)) {
+      return {};
+    }
+  }
+  return shelf;
+}
+
+/* Direct editing must never begin through a native UI shelf, including padding. */
+inline std::vector<Rect> editing_canvas_parts(const Rect &canvas, const Rect &shelf)
+{
+  if (shelf.empty()) {
+    return {canvas};
+  }
+  std::vector<Rect> result;
+  for (const Rect &part : {Rect{canvas.xmin, canvas.ymin, canvas.xmax, shelf.ymin},
+                          Rect{canvas.xmin, shelf.ymax, canvas.xmax, canvas.ymax},
+                          Rect{canvas.xmin, shelf.ymin, shelf.xmin, shelf.ymax},
+                          Rect{shelf.xmax, shelf.ymin, canvas.xmax, shelf.ymax}})
+  {
+    if (!part.empty()) {
+      result.push_back(part);
+    }
+  }
+  return result;
+}
+
